                                            description "Number of bytes discarded by the IOMs after the ISA-AA MDA(s) due to ingress IOM congestion in the network-to-subscriber direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets discarded by the IOMs after the ISA-AA MDA(s) due to ingress IOM congestion in the network-to-subscriber direction.";
                                        }

                                    } // container congestion

                                    container errors {
                                        description "Enter the errors context";

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description
                                                "Number of packets discarded due to an error detected by the P-chip while attempting to return
                                                 the packet to the normal forwarding path in the network-to-subscriber direction.";
                                        }

                                    } // container errors

                                } // container returned-discards

                                container returned-traffic {
                                    description "Enter the returned-traffic context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes returned to the normal forwarding path that are sent to egress IOMs from the ISA-AA MDA(s) in the network-to-subscriber direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets returned to the normal forwarding path that are sent to egress IOMs from the ISA-AA MDA(s) in the network-to-subscriber direction.";
                                    }

                                } // container returned-traffic

                            } // container statistics

                        } // container net-to-sub

                        container traffic {
                            description "Enter the traffic context";

                            container statistics {
                                description "Enter the statistics context";

                                container sub-to-net {
                                    description "Enter the sub-to-net context";

                                    container tcp-total {
                                        description "Enter the tcp-total context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of TCP total octets in the subscriber to network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "The number of TCP total packets in the subscriber to network direction.";
                                        }

                                    } // container tcp-total

                                    container tcp-retransmissions {
                                        description "Enter the tcp-retransmissions context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of retransmitted TCP octets in the subscriber to network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "The number of retransmitted TCP packets in the subscriber to network direction.";
                                        }

                                    } // container tcp-retransmissions

                                } // container sub-to-net

                                container net-to-sub {
                                    description "Enter the net-to-sub context";

                                    container tcp-total {
                                        description "Enter the tcp-total context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of TCP total octets in the network to subscriber direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "The number of TCP total packets in the network to subscriber direction.";
                                        }

                                    } // container tcp-total

                                    container tcp-retransmissions {
                                        description "Enter the tcp-retransmissions context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of retransmitted TCP octets in the network to subscriber direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "The number of retransmitted TCP packets in the network to subscriber direction.";
                                        }

                                    } // container tcp-retransmissions

                                } // container net-to-sub

                            } // container statistics

                        } // container traffic

                    } // container summary

                } // container status

