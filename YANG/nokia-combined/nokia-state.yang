                                container statistics {
                                    description "Enter the statistics context";

                                    leaf count {
                                        type yang:counter64;
                                        description "The number of times the bit rate TCA (tmnxBsxIsaAaGrpBitRate) was raised since system startup.";
                                    }

                                    leaf duration {
                                        type yang:counter64;
                                        units "seconds";
                                        description "The amount time the bit rate TCA (tmnxBsxIsaAaGrpBitRate) was in the raised state since system startup.";
                                    }

                                } // container statistics

                            } // container traffic-rate

                            container packet-rate {
                                description "Enter the packet-rate context";

                                leaf state {
                                    type types-aa:tca-state;
                                    description "The state of the packet rate TCA (tmnxBsxIsaAaGrpPacketRate).";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf count {
                                        type yang:counter64;
                                        description "The number of times the packet rate TCA (tmnxBsxIsaAaGrpPacketRate) was raised since system startup.";
                                    }

                                    leaf duration {
                                        type yang:counter64;
                                        units "seconds";
                                        description "The amount of time the packet rate TCA (tmnxBsxIsaAaGrpPacketRate) was in the raised state since system startup.";
                                    }

                                } // container statistics

                            } // container packet-rate

                            container datapath-cpu-usage {
                                description "Enter the datapath-cpu-usage context";

                                leaf state {
                                    type types-aa:tca-state;
                                    description "The state of the datapath CPU TCA (tmnxBsxDatapathCpuUsage).";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf count {
                                        type yang:counter64;
                                        description "The number of times the datapath CPU TCA (tmnxBsxDatapathCpuUsage) was raised since system startup.";
                                    }

                                    leaf duration {
                                        type yang:counter64;
                                        units "seconds";
                                        description "The amount of time the datapath CPU TCA (tmnxBsxDatapathCpuUsage) was in the raised state since system startup.";
                                    }

                                } // container statistics

                            } // container datapath-cpu-usage

                            container isa-overload {
                                description "Enter the isa-overload context";

                                leaf state {
                                    type types-aa:tca-state;
                                    description "The state of the overload cut-through TCA (tmnxBsxIsaAaGrpOvrldCutthru).";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf count {
                                        type yang:counter64;
                                        description "The number of times the overload cut-through TCA (tmnxBsxIsaAaGrpOvrldCutthru) was raised since system startup.";
                                    }

                                    leaf duration {
                                        type yang:counter64;
                                        units "seconds";
                                        description "The amount of time the overload cut-through TCA (tmnxBsxIsaAaGrpOvrldCutthru) was in the raised state since system startup.";
                                    }

                                } // container statistics

                            } // container isa-overload

                        } // container tca

                        container sub-to-net {
                            description "Enter the sub-to-net context";

                            container overload-cut-through-tca {
                                description "Enter the overload-cut-through-tca context";

                                leaf state {
                                    type types-aa:tca-state;
                                    description "The state of the subscriber to network weighted average shared buffer TCA (tmnxBsxIsaAaGrpFmSbWaSBufOvld).";
                                }

                                leaf current-wa-buffer-depth {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The percent utilization of the subscriber to network weighted average shared buffer on the ISA-AA MDA(s).";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf count {
                                        type yang:counter64;
                                        description "The number of times the subscriber to network weighted average shared buffer TCA (tmnxBsxIsaAaGrpFmSbWaSBufOvld) was raised since system startup.";
                                    }

                                    leaf duration {
                                        type yang:counter64;
                                        units "seconds";
                                        description "The amount of time the subscriber to network weighted average shared buffer TCA (tmnxBsxIsaAaGrpFmSbWaSBufOvld) was in the raised state since system startup.";
                                    }

                                } // container statistics

                            } // container overload-cut-through-tca

                            container statistics {
                                description "Enter the statistics context";

                                container diverted-traffic {
                                    description "Enter the diverted-traffic context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes diverted from ingress IOMs towards the ISA-AA MDA(s) in the subscriber-to-network direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets diverted from ingress IOMs towards the ISA-AA MDA(s) in the subscriber-to-network direction.";
                                    }

                                } // container diverted-traffic

                                container diverted-discards {
                                    description "Enter the diverted-discards context";

                                    container congestion {
                                        description "Enter the congestion context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of bytes discarded by the IOMs prior to the ISA-AA MDA(s) due to egress IOM congestion in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets discarded by the IOMs prior to the ISA-AA MDA(s) due to egress IOM congestion in the subscriber-to-network direction.";
                                        }

                                    } // container congestion

                                    container errors {
                                        description "Enter the errors context";

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets discarded by the egress P-chip due to errors in the packets in the subscriber-to-network direction.";
                                        }

                                    } // container errors

                                } // container diverted-discards

                                container entered-aa {
                                    description "Enter the entered-aa context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes sent from an IOM which enter the ISA-AA MDA(s) in the subscriber-to-network direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets sent from an IOM which enter the ISA-AA MDA(s) in the subscriber-to-network direction.";
                                    }

                                } // container entered-aa

                                container buffered-in-aa {
                                    description "Enter the buffered-in-aa context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes buffered by the ISA-AA MDA(s) in the subscriber-to-network direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets buffered by the ISA-AA MDA(s) in the subscriber-to-network direction.";
                                    }

                                } // container buffered-in-aa

                                container discarded-in-aa {
                                    description "Enter the discarded-in-aa context";

                                    container policy {
                                        description "Enter the policy context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of bytes discarded by the ISA-AA MDA(s) due to policy in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets discarded by the ISA-AA MDA(s) due to policy in the subscriber-to-network direction.";
                                        }

                                    } // container policy

                                    container congestion {
                                        description "Enter the congestion context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of bytes discarded by the ISA-AA MDA(s) due to congestion in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets discarded by the ISA-AA MDA(s) due to congestion in the subscriber-to-network direction.";
                                        }

                                    } // container congestion

                                    container errors {
                                        description "Enter the errors context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of bytes discarded due to unrecoverable errors in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets discarded due to unrecoverable errors in the subscriber-to-network direction.";
                                        }

                                    } // container errors

                                    container tcp-optimization {
                                        description "Enter the tcp-optimization context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description
                                                "Number of octets that the ISA-AA MDA has discarded due to the TCP optimization
                                                 configuration in tmnxBsxTcpOptTable in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description
                                                "Number of packets that the ISA-AA MDA has discarded due to the TCP optimization
                                                 configuration in tmnxBsxTcpOptTable in the subscriber-to-network direction.";
                                        }

                                    } // container tcp-optimization




                                } // container discarded-in-aa

                                container modified-in-aa {
                                    description "Enter the modified-in-aa context";

                                    container packet-size-increased {
                                        description "Enter the packet-size-increased context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of additional octets the ISA-AA MDA injected into the packets in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets that the ISA-AA MDA has increased in size in the subscriber-to-network direction.";
                                        }

                                    } // container packet-size-increased

                                    container packet-size-decreased {
                                        description "Enter the packet-size-decreased context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of octets the ISA-AA MDA has removed from packets in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets that the ISA-AA MDA has decreased in size in the subscriber-to-network direction.";
                                        }

                                    } // container packet-size-decreased

                                } // container modified-in-aa

                                container errors {
                                    description "Enter the errors context";

                                    container policy-bypass {
                                        description "Enter the policy-bypass context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description
                                                "Number of octets which pass untouched that did not have statistics or policy applied.
                                                 These bytes are counted as policy bypass errors in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description
                                                "Number of packets which passed untouched that did not have statistics or policy applied.
                                                 These packets are counted as policy bypass errors in the subscriber-to-network direction.";
                                        }

                                    } // container policy-bypass

                                    container cut-through {
                                        description "Enter the cut-through context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description
                                                "Number of octets which passed untouched, but have policy applied in the subscriber-to-network direction.
                                                 These octets are counted as cut-through errors.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description
                                                "Number of packets which passed untouched, but have policy applied in the subscriber-to-network direction.
                                                 These packets are counted as cut-through errors.";
                                        }

                                    } // container cut-through

                                } // container errors

                                container generated-in-aa {
                                    description "Enter the generated-in-aa context";

                                    container tcp-optimization {
                                        description "Enter the tcp-optimization context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description
                                                "Number of octets that the ISA-AA MDA has created due to the TCP optimization configuration
                                                 in tmnxBsxTcpOptTable in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description
                                                "Number of packets that the ISA-AA MDA has created due to the TCP optimization configuration
                                                 in tmnxBsxTcpOptTable in the subscriber-to-network direction.";
                                        }

                                    } // container tcp-optimization




                                    container http-redirect {
                                        description "Enter the http-redirect context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of octets that the ISA-AA MDA has created to redirect HTTP and HTTPS in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets that the ISA-AA MDA has created to redirect HTTP and HTTPS in the subscriber-to-network direction.";
                                        }

                                    } // container http-redirect

                                } // container generated-in-aa

                                container exited-aa {
                                    description "Enter the exited-aa context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes which exit the ISA-AA MDA(s) and are sent to the local IOM in the subscriber-to-network direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets which exit the ISA-AA MDA(s) and are sent to the local IOM in the subscriber-to-network direction.";
                                    }

                                } // container exited-aa

                                container returned-discards {
                                    description "Enter the returned-discards context";

                                    container congestion {
                                        description "Enter the congestion context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of bytes discarded by the IOMs after the ISA-AA MDA(s) due to ingress IOM congestion in the subscriber-to-network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets discarded by the IOMs after the ISA-AA MDA(s) due to ingress IOM congestion in the subscriber-to-network direction.";
                                        }

                                    } // container congestion

                                    container errors {
                                        description "Enter the errors context";

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description
                                                "Number of packets discarded due to an error detected by the P-chip while attempting to return
                                                 the packet to the normal forwarding path in the subscriber-to-network direction.";
                                        }

                                    } // container errors

                                } // container returned-discards

                                container returned-traffic {
                                    description "Enter the returned-traffic context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes returned to the normal forwarding path that are sent to egress IOMs from the ISA-AA MDA(s) in the subscriber-to-network direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets returned to the normal forwarding path that are sent to egress IOMs from the ISA-AA MDA(s) in the subscriber-to-network direction.";
                                    }

                                } // container returned-traffic

                            } // container statistics

                        } // container sub-to-net

                        container net-to-sub {
                            description "Enter the net-to-sub context";

                            container overload-cut-through-tca {
                                description "Enter the overload-cut-through-tca context";

                                leaf current-wa-buffer-depth {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The percent utilization of the network to subscriber weighted average shared buffer on the ISA-AA MDA(s).";
                                }

                                leaf state {
                                    type types-aa:tca-state;
                                    description "The state of the network to subscriber weighted average shared buffer TCA (tmnxBsxIsaAaGrpToSbWaSBufOvld).";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf count {
                                        type yang:counter64;
                                        description "The number of times the network to subscriber weighted average shared buffer TCA (tmnxBsxIsaAaGrpToSbWaSBufOvld) was raised since system startup.";
                                    }

                                    leaf duration {
                                        type yang:counter64;
                                        units "seconds";
                                        description "The amount of time the network to subscriber weighted average shared buffer TCA (tmnxBsxIsaAaGrpToSbWaSBufOvld) was in the raised state since system startup.";
                                    }

                                } // container statistics

                            } // container overload-cut-through-tca

