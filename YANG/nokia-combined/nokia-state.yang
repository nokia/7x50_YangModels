                                                                type int32;
                                                                description "Queue identifier";
                                                            }

                                                            leaf subscriber-id {
                                                                type types-submgt:subscriber-id;
                                                                description "Subscriber Identification string";
                                                            }

                                                            leaf sla-profile-instance-id {
                                                                type types-submgt:sla-profile-instance-id;
                                                                description "SLA profile instance Identification string";
                                                            }

                                                            leaf fp {
                                                                type int32;
                                                                description "FP number";
                                                            }

                                                        } // list queue

                                                    } // container sla-profile-instance

                                                } // container queue

                                                container scheduler {
                                                    description "Enter the scheduler context";

                                                    container subscriber {
                                                        description "Enter the subscriber context";

                                                        list scheduler {
                                                            key "member";
                                                            description "Enter the scheduler list instance";

                                                            leaf member {
                                                                type uint32;
                                                                description "Member information";
                                                            }

                                                            leaf scheduler-name {
                                                                type string;
                                                                description "Name";
                                                            }

                                                            leaf subscriber-id {
                                                                type types-submgt:subscriber-id;
                                                                description "Subscriber Identification string";
                                                            }

                                                        } // list scheduler

                                                    } // container subscriber

                                                    container sla-profile-instance {
                                                        description "Enter the sla-profile-instance context";

                                                        list scheduler {
                                                            key "member";
                                                            description "Enter the scheduler list instance";

                                                            leaf member {
                                                                type uint32;
                                                                description "Member information";
                                                            }

                                                            leaf scheduler-name {
                                                                type string;
                                                                description "Name";
                                                            }

                                                            leaf subscriber-id {
                                                                type types-submgt:subscriber-id;
                                                                description "Subscriber Identification string";
                                                            }

                                                            leaf sla-profile-instance-id {
                                                                type types-submgt:sla-profile-instance-id;
                                                                description "SLA profile instance Identification string";
                                                            }

                                                        } // list scheduler

                                                        list t0-scheduler {
                                                            key "member";
                                                            description "Enter the t0-scheduler list instance";

                                                            leaf member {
                                                                type uint32;
                                                                description "Member information";
                                                            }

                                                            leaf scheduler-name {
                                                                type string;
                                                                description "Name";
                                                            }

                                                            leaf subscriber-id {
                                                                type types-submgt:subscriber-id;
                                                                description "Subscriber Identification string";
                                                            }

                                                            leaf sla-profile-instance-id {
                                                                type types-submgt:sla-profile-instance-id;
                                                                description "SLA profile instance Identification string";
                                                            }

                                                        } // list t0-scheduler

                                                    } // container sla-profile-instance

