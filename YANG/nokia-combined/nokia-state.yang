                    } // container ip-identification-assist

                    list protocol {
                        key "protocol-name";
                        description "Enter the protocol list instance";

                        leaf protocol-name {
                            type types-sros:named-item;
                            description "Protocol configured to collect statistics for each aa-sub.";
                        }

                        container statistics {
                            description "Enter the statistics context";

                            leaf active-subscribers {
                                type yang:gauge32;
                                description "The number of subscribers at the most recent 5-minute snapshot of statistics.";
                            }

                            container sub-to-net {
                                description "Enter the sub-to-net context";

                                leaf active-flows {
                                    type yang:counter32;
                                    description "Number of allowed flows in the subscriber to network direction that are active.";
                                }

                                container admitted {
                                    description "Enter the admitted context";

                                    leaf octets {
                                        type yang:counter64;
                                        description "Number of bytes permitted for the subscriber to network direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        description "Number of packets permitted for the subscriber to network direction.";
                                    }

                                    leaf flows {
                                        type yang:counter64;
                                        description "Number of flows permitted for the subscriber to network direction.";
                                    }

                                } // container admitted

                                container denied {
                                    description "Enter the denied context";

                                    leaf octets {
                                        type yang:counter64;
                                        description "Number of bytes dropped for the subscriber to network direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        description "Number of packets dropped for the subscriber to network direction.";
                                    }

                                    leaf flows {
                                        type yang:counter64;
                                        description "Number of flows that dropped subsequent packets in the subscriber to network direction.";
                                    }

                                } // container denied

                            } // container sub-to-net

                            container net-to-sub {
                                description "Enter the net-to-sub context";

                                leaf active-flows {
                                    type yang:counter32;
                                    description "Number of allowed flows in the network to subscriber direction that are active.";
                                }

                                container admitted {
                                    description "Enter the admitted context";

                                    leaf octets {
                                        type yang:counter64;
                                        description "Number of bytes permitted for the network to subscriber direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        description "Number of packets permitted for the network to subscriber direction.";
                                    }

                                    leaf flows {
                                        type yang:counter64;
                                        description "Number of flows permitted for the network to subscriber direction.";
                                    }

                                } // container admitted

                                container denied {
                                    description "Enter the denied context";

                                    leaf octets {
                                        type yang:counter64;
                                        description "Number of bytes dropped for the network to subscriber direction.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        description "Number of packets dropped for the network to subscriber direction.";
                                    }

                                    leaf flows {
                                        type yang:counter64;
                                        description "Number of flows that dropped subsequent packets in the network to subscriber direction.";
                                    }

                                } // container denied

                            } // container net-to-sub

                            container flow {
                                description "Enter the flow context";

                                leaf terminated {
                                    type yang:counter64;
                                    description "Number of allowed flows in both directions that have terminated.";
                                }

                                container duration {
                                    description "Enter the duration context";

                                    leaf short {
                                        type yang:counter64;
                                        description "Number of flows with a duration less than or equal to 30 seconds, that have completed.";
                                    }

                                    leaf medium {
                                        type yang:counter64;
                                        description "Number of flows with a duration less than or equal to 180 seconds, but greater than 30 seconds, that have completed.";
                                    }

                                    leaf long {
                                        type yang:counter64;
                                        description "Number of flows with a duration greater than 180 seconds, that have completed.";
                                    }

                                    leaf total {
                                        type yang:counter64;
                                        description "The sum of all flow durations from first packet seen to last packet seen for flows that have terminated.";
                                    }

                                } // container duration

                            } // container flow

                        } // container statistics

                    } // list protocol

                    list sctp-filter {
                        key "sctp-filter-name";
                        description "Enter the sctp-filter list instance";

                        leaf sctp-filter-name {
                            type types-sros:named-item;
                            description "Specifies a name that uniquely identifies an AA SCTP filter within a AA partition.";
                        }

                        list esa {
                            key "esa-id vm";
                            description "Enter the esa list instance";

                            leaf esa-id {
                                type types-esa:esa-id;
                                description "Specifies an ESA identifier.";
                            }

                            leaf vm {
                                type types-esa:vm-id;
                                description "Specifies the VM identifier within the ESA.";
                            }

                            container statistics {
                                description "Enter the statistics context";

                                leaf packets-permitted {
                                    type yang:counter64;
                                    description "Number of packets permitted through the SCTP filter.";
                                }

                                container packets-denied {
                                    description "Enter the packets-denied context";

                                    leaf malformed-packet {
                                        type yang:counter64;
                                        description "Number of packets denied by the SCTP filter due to the packet being malformed.";
                                    }

                                    leaf ppid-out-of-range {
                                        type yang:counter64;
                                        description
                                            "Number of packets denied by the SCTP filter due to PPID being out of range of the
                                             corresponding ppid-range-mix/ppid-range-max.";
                                    }

                                    leaf ppid-denied {
                                        type yang:counter64;
                                        description "Number of packets denied by the SCTP filter due to PPID value configuration in ppid.";
                                    }

                                } // container packets-denied

                            } // container statistics

                        } // list esa

                        list isa {
                            key "mda-id";
                            description "Enter the isa list instance";

                            leaf mda-id {
                                type types-isa:slot-mda;
                                description "Specifies an MDA/ISA identifier <card slot number>/<mda slot number>";
                            }

                            container statistics {
                                description "Enter the statistics context";

                                leaf packets-permitted {
                                    type yang:counter64;
                                    description "Number of packets permitted through the SCTP filter.";
                                }

                                container packets-denied {
                                    description "Enter the packets-denied context";

                                    leaf malformed-packet {
                                        type yang:counter64;
                                        description "Number of packets denied by the SCTP filter due to the packet being malformed.";
                                    }

                                    leaf ppid-out-of-range {
                                        type yang:counter64;
                                        description
                                            "Number of packets denied by the SCTP filter due to PPID being out of range of the
                                             corresponding ppid-range-mix/ppid-range-max.";
                                    }

                                    leaf ppid-denied {
                                        type yang:counter64;
                                        description "Number of packets denied by the SCTP filter due to PPID value configuration in ppid.";
                                    }

                                } // container packets-denied

                            } // container statistics

                        } // list isa

                        container summary {
                            description "Enter the summary context";

                            container statistics {
                                description "Enter the statistics context";

                                leaf packets-permitted {
                                    type yang:counter64;
                                    description "Number of packets permitted through the SCTP filter.";
                                }

                                container packets-denied {
                                    description "Enter the packets-denied context";

                                    leaf malformed-packet {
                                        type yang:counter64;
                                        description "Number of packets denied by the SCTP filter due to the packet being malformed.";
                                    }

                                    leaf ppid-out-of-range {
                                        type yang:counter64;
                                        description
                                            "Number of packets denied by the SCTP filter due to PPID being out of range of the
                                             corresponding ppid-range-mix/ppid-range-max.";
                                    }

                                    leaf ppid-denied {
                                        type yang:counter64;
                                        description "Number of packets denied by the SCTP filter due to PPID value configuration in ppid.";
                                    }

                                } // container packets-denied

                            } // container statistics

                        } // container summary

                        container ppid {
                            description "Enter the ppid context";

                            list entry {
                                key "entry-id";
                                description "Enter the entry list instance";

                                leaf entry-id {
                                    type uint32 {
                                        range "1..255";
                                    }
                                    description "Specifies an identifier that uniquely identifies a PPID entry within an SCTP filter.";
                                }

                            } // list entry

                        } // container ppid

                    } // list sctp-filter

                    list tcp-validate {
                        key "tcp-validate-name";
                        description "Enter the tcp-validate list instance";

                        leaf tcp-validate-name {
                            type types-sros:named-item;
                            description "Specifies a name that uniquely identifies a TCP validate object within an AA partition.";
                        }

                        list direction {
                            key "traffic-direction units";
                            description "Enter the direction list instance";

                            leaf traffic-direction {
                                type types-aa:traffic-direction;
                                description "Specify direction of the traffic for tcp-validate state.";
                            }

                            leaf units {
                                type enumeration {
                                    enum octets                         { value 1; }
                                    enum packets                        { value 2; }
                                }
                                description "Specifies whether to request octet or packet state.";
                            }

                            list esa {
