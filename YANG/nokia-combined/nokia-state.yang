                                        leaf index {
                                            type uint32 {
                                                range "1..5";
                                            }
                                            description "Unique number which identifies a specific RADIUS server.";
                                        }

                                        leaf accepted-logins {
                                            type uint32;
                                            description "Indicates the number of accepted logins.";
