                                    type yang:zero-based-counter64;
                                    description
                                        "Indicates the number of bytes of all egress packets that were subjected to
                                         this filter policer instance.";
                                }

                                leaf forwarded-pkt {
                                    type yang:zero-based-counter64;
                                    description
