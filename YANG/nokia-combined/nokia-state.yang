                list isa-aa {
                    key "mda-id";
                    description "Enter the isa-aa list instance";

                    leaf mda-id {
                        type types-isa:slot-mda;
                        description "AA ISA used by the ISA WLAN-GW group";
                    }

                    leaf oper-state {
                        type enumeration {
                            enum down                           { value 0; }
                            enum active                         { value 1; }
                            enum standby                        { value 2; }
                            enum needs-audit                    { value 3; }
                            enum out-of-resources               { value 4; }
                        }
                        description "The operational state of the AA ISA or ESA-VM";
                    }

                    list isa-bb {
                        key "bb-mda-id";
                        description "Enter the isa-bb list instance";

                        leaf bb-mda-id {
                            type types-isa:slot-mda;
                            description "BB ISA used by the ISA WLAN-GW group";
                        }

                    } // list isa-bb

                } // list isa-aa

                list esa-aa {
                    key "esa-id vm";
                    description "Enter the esa-aa list instance";

                    leaf esa-id {
                        type types-esa:esa-id;
                        description "AA ESA used by the ISA WLAN-GW group";
                    }

                    leaf vm {
                        type types-esa:vm-id;
                        description "AA ESA-VM used by the ISA WLAN-GW group";
                    }

                    leaf oper-state {
                        type enumeration {
                            enum down                           { value 0; }
                            enum active                         { value 1; }
                            enum standby                        { value 2; }
                            enum needs-audit                    { value 3; }
                            enum out-of-resources               { value 4; }
                        }
                        description "The operational state of the AA ISA or ESA-VM";
                    }

                    list esa-bb {
                        key "bb-esa-id bb-vm";
                        description "Enter the esa-bb list instance";

                        leaf bb-esa-id {
                            type types-esa:esa-id;
                            description "BB ESA used by the ISA WLAN-GW group";
                        }

                        leaf bb-vm {
                            type types-esa:vm-id;
                            description "BB ESA-VM used by the ISA WLAN-GW group";
                        }

                    } // list esa-bb

                } // list esa-aa

            } // list wlan-gw-group

            list lns-group {
                key "id";
                description "Enter the lns-group list instance";

                leaf id {
                    type types-l2tp:lns-group-id;
                    description "The lns tunnel-group identifier";
                }

                leaf oper-state {
                    type types-sros:oper-state;
                    description "Operational state.";
                }

                list mda {
                    key "mda-id";
                    description "Enter the mda list instance";

                    leaf mda-id {
                        type types-isa:slot-mda;
                        description "The MDA-id";
                    }

                    leaf oper-state {
                        type types-l2tp:isa-member-oper-state;
                        description "The operation state of the ISA MDA";
                    }

                    leaf sessions {
                        type yang:gauge32;
                        description "The number of sessions handled by the ISA MDA";
                    }

                    list statistics {
                        key "counter";
                        description "Enter the statistics list instance";

                        leaf counter {
                            type uint32 {
                                range "0..70";
                            }
                            description "The counter";
                        }

                        leaf description {
                            type string {
                                length "0..70";
                            }
                            description "The human-readable identifier of the statistic.";
                        }

                        leaf value {
                            type yang:counter64;
                            description "The counter value";
                        }

                    } // list statistics

                } // list mda

                list esa {
                    key "esa-id vm";
                    description "Enter the esa list instance";

                    leaf esa-id {
                        type leafref {
                            path "../../../../esa/esa-id";
                        }
                        description "ESA used by the ISA LNS group";
                    }

                    leaf vm {
                        type leafref {
                            path "../../../../esa[esa-id=current()/../esa-id]/vm/vm-id";
                        }
                        description "ESA-VM used by the ISA LNS group";
                    }

                    leaf oper-state {
                        type types-l2tp:isa-member-oper-state;
                        description "The operation state of the ESA-VM";
                    }

                    leaf sessions {
                        type yang:gauge32;
                        description "The number of sessions handled by the ESA-VM";
                    }

                    list statistics {
                        key "counter";
                        description "Enter the statistics list instance";

                        leaf counter {
                            type uint32 {
                                range "0..70";
                            }
                            description "The counter";
                        }

                        leaf description {
                            type string {
                                length "0..70";
                            }
                            description "The human-readable identifier of the statistic.";
                        }

                        leaf value {
                            type yang:counter64;
                            description "The counter value";
                        }

                    } // list statistics

                } // list esa

            } // list lns-group

            list application-assurance-group {
                key "aa-group-id";
                description "Enter the application-assurance-group list instance";

                leaf aa-group-id {
                    type types-aa:isa-aa-grp-id;
                    description "Specifies an identifier that uniquely identifies an AA group within the system.";
                }

                leaf oper-state {
                    type types-sros:oper-state;
                    description
                        "The operational state for the ISA-AA group.
                         When 'outOfService', traffic destined to this ISA-AA group
                         will apply its configured failure behaviour.";
                }

                leaf wlan-gw-group-id {
                    type types-isa:wlan-gw-group-id;
                    description "The identifier of the WLAN Gateway Integrated Service Adaptor group associated with this ISA-AA group.";
                }

                leaf last-active-change {
                    type yang:date-and-time;
                    description "The most recent time that an ISA within the group changed to or from the active state.";
                }

                leaf load-balance-state {
                    type types-aa:balance-state;
                    description "The status of the load-balance operation for the ISA-AA group.";
                }

                list esa {
                    key "esa-id vm";
                    description "Enter the esa list instance";

                    leaf esa-id {
                        type types-esa:esa-id;
                        description "Specifies an ESA identifier.";
                    }

                    leaf vm {
                        type types-esa:vm-id;
                        description "Specifies the VM identifier within the ESA.";
                    }

                    leaf activity-state {
                        type types-aa:isa-activity-state;
                        description "The current activity status of the ISA (MDA or ESA-VM) in the group.";
                    }

                    leaf avoid-subs-mode {
                        type types-aa:avoid-subs-mode;
                        description "The status of subscriber load-balancing for the ISA-AA MDA in the group.";
                    }

                    container statistics {
                        description "Enter the statistics context";

                        leaf capacity-cost {
                            type yang:gauge32;
                            description "The current capacity cost assigned to the ISA-AA MDA in the group.";
                        }

                        leaf aa-subs {
                            type yang:gauge32;
                            description "The current number of Application Assurance subscriber resources in use on the ISA-AA MDA in the group.";
                        }

                        leaf aa-sub-stats {
                            type yang:gauge32;
                            description "The current number of Application Assurance subscriber statistics resources in use on the ISA-AA MDA in the group.";
                        }

                        leaf transit-ip-addresses {
                            type yang:gauge32;
                            description "The current number of Transit IP subscriber addresses associated with the ISA-AA MDA in the group.";
                        }

                        container transit-prefix-entries {
                            description "Enter the transit-prefix-entries context";

                            leaf ipv4 {
                                type yang:gauge32;
                                description "The current number of transit prefix IPv4 entries active on the ISA-AA MDA in the group.";
                            }

                            leaf ipv4-remote {
                                status obsolete;
                                type yang:gauge32;
                                description "The current number of transit prefix IPv4 remote entries active on the ISA-AA MDA in the group.";
                            }

                            leaf ipv6 {
                                type yang:gauge32;
                                description "The current number of transit prefix IPv6 entries active on the ISA-AA MDA in the group.";
                            }

                            leaf ipv6-remote {
                                status obsolete;
                                type yang:gauge32;
                                description "The current number of transit prefix IPv6 remote entries active on the ISA-AA MDA in the group.";
                            }

                        } // container transit-prefix-entries

                        container assigned-subscribers {
                            description "Enter the assigned-subscribers context";

                            leaf esm {
                                type yang:gauge32;
                                description "The current number of Enhanced Subscriber Management (ESM) subscribers assigned on the ISA-AA MDA in the group.";
                            }

                            leaf sap {
                                type yang:gauge32;
                                description "The current number of Service Access Point (SAP) subscribers assigned on the ISA-AA MDA in the group.";
                            }

                            leaf spoke-sdp {
                                type yang:gauge32;
                                description "The current number of Spoke SDP subscribers assigned on the ISA-AA MDA in the group.";
                            }

                            leaf transit {
                                type yang:gauge32;
                                description "The current number of transit subscribers assigned on the ISA-AA MDA in the group.";
                            }

                            leaf esm-mac {
                                type yang:gauge32;
                                description "The current number of Enhanced Subscriber Management (ESM) MAC host subscribers assigned on the ISA-AA MDA in the group.";
                            }

                        } // container assigned-subscribers

                    } // container statistics

                    container shared-resources {
                        description "Enter the shared-resources context";

                        leaf tcp-buffer-memory {
                            type uint64;
                            description "The TCP buffer memory size of TCP advanced functions.";
                        }

                        leaf tcp-buffer-utilization {
                            type yang:gauge32 {
                                range "0..100";
                            }
                            units "percent";
                            description "The TCP buffer utilization of TCP advanced functions.";
                        }

                        leaf session-resource-utilization {
                            type yang:gauge32 {
                                range "0..100";
                            }
                            units "percent";
                            description "The TCP session utilization of TCP advanced functions.";
                        }

                        leaf gtp-tunnel-database-size {
                            type uint64;
                            description "The number of entries in the shared resources GTP Tunnel Database.";
                        }

                        leaf gtp-tunnel-database-utilization {
                            type yang:gauge32 {
                                range "0..100";
                            }
                            units "percent";
                            description "The utilization level of the shared resources GTP Tunnel Database.";
                        }

                        container max-number-concurrent-sessions {
                            description "Enter the max-number-concurrent-sessions context";

                            leaf tcp-optimizer {
                                type uint32;
                                description "The maximum number of concurrent sessions the TCP advanced functions can handle at any point in time for TCP Optimizer.";
                            }

                        } // container max-number-concurrent-sessions

                    } // container shared-resources

                } // list esa

                list isa {
                    key "mda-id";
                    description "Enter the isa list instance";

                    leaf mda-id {
                        type types-isa:slot-mda;
                        description "Specifies an MDA/ISA identifier <card slot number>/<mda slot number>";
                    }

                    leaf activity-state {
                        type types-aa:isa-activity-state;
                        description "The current activity status of the ISA (MDA or ESA-VM) in the group.";
                    }

                    leaf avoid-subs-mode {
                        type types-aa:avoid-subs-mode;
                        description "The status of subscriber load-balancing for the ISA-AA MDA in the group.";
                    }

                    container statistics {
                        description "Enter the statistics context";

                        leaf capacity-cost {
                            type yang:gauge32;
                            description "The current capacity cost assigned to the ISA-AA MDA in the group.";
                        }

                        leaf aa-subs {
                            type yang:gauge32;
                            description "The current number of Application Assurance subscriber resources in use on the ISA-AA MDA in the group.";
                        }

                        leaf aa-sub-stats {
                            type yang:gauge32;
                            description "The current number of Application Assurance subscriber statistics resources in use on the ISA-AA MDA in the group.";
                        }

                        leaf transit-ip-addresses {
                            type yang:gauge32;
                            description "The current number of Transit IP subscriber addresses associated with the ISA-AA MDA in the group.";
                        }

                        container transit-prefix-entries {
                            description "Enter the transit-prefix-entries context";

                            leaf ipv4 {
                                type yang:gauge32;
                                description "The current number of transit prefix IPv4 entries active on the ISA-AA MDA in the group.";
                            }

                            leaf ipv4-remote {
                                status obsolete;
                                type yang:gauge32;
                                description "The current number of transit prefix IPv4 remote entries active on the ISA-AA MDA in the group.";
                            }

                            leaf ipv6 {
                                type yang:gauge32;
                                description "The current number of transit prefix IPv6 entries active on the ISA-AA MDA in the group.";
                            }

                            leaf ipv6-remote {
                                status obsolete;
                                type yang:gauge32;
                                description "The current number of transit prefix IPv6 remote entries active on the ISA-AA MDA in the group.";
                            }

                        } // container transit-prefix-entries

                        container assigned-subscribers {
                            description "Enter the assigned-subscribers context";

                            leaf esm {
                                type yang:gauge32;
                                description "The current number of Enhanced Subscriber Management (ESM) subscribers assigned on the ISA-AA MDA in the group.";
                            }

                            leaf sap {
                                type yang:gauge32;
                                description "The current number of Service Access Point (SAP) subscribers assigned on the ISA-AA MDA in the group.";
                            }

                            leaf spoke-sdp {
                                type yang:gauge32;
                                description "The current number of Spoke SDP subscribers assigned on the ISA-AA MDA in the group.";
                            }

                            leaf transit {
                                type yang:gauge32;
                                description "The current number of transit subscribers assigned on the ISA-AA MDA in the group.";
                            }

                            leaf esm-mac {
                                type yang:gauge32;
                                description "The current number of Enhanced Subscriber Management (ESM) MAC host subscribers assigned on the ISA-AA MDA in the group.";
                            }

                        } // container assigned-subscribers

                    } // container statistics

                    container shared-resources {
                        description "Enter the shared-resources context";

                        leaf tcp-buffer-memory {
                            type uint64;
                            description "The TCP buffer memory size of TCP advanced functions.";
                        }

                        leaf tcp-buffer-utilization {
                            type yang:gauge32 {
                                range "0..100";
                            }
                            units "percent";
                            description "The TCP buffer utilization of TCP advanced functions.";
                        }

                        leaf session-resource-utilization {
                            type yang:gauge32 {
                                range "0..100";
                            }
                            units "percent";
                            description "The TCP session utilization of TCP advanced functions.";
                        }

                        leaf gtp-tunnel-database-size {
                            type uint64;
                            description "The number of entries in the shared resources GTP Tunnel Database.";
                        }

                        leaf gtp-tunnel-database-utilization {
                            type yang:gauge32 {
                                range "0..100";
                            }
                            units "percent";
                            description "The utilization level of the shared resources GTP Tunnel Database.";
                        }

                        container max-number-concurrent-sessions {
                            description "Enter the max-number-concurrent-sessions context";

                            leaf tcp-optimizer {
                                type uint32;
                                description "The maximum number of concurrent sessions the TCP advanced functions can handle at any point in time for TCP Optimizer.";
                            }

                        } // container max-number-concurrent-sessions

                    } // container shared-resources

                } // list isa

                container unassigned-subscribers {
                    description "Enter the unassigned-subscribers context";

                    container statistics {
                        description "Enter the statistics context";

                        leaf esm {
                            type yang:gauge32;
                            description
                                "The number of Enhanced Subscriber Management (ESM) subscribers
                                 that have not been assigned to an ISA-AA MDA within a group.";
                        }

                        leaf sap {
                            type yang:gauge32;
                            description
                                "The number of Service Access Point (SAP) subscribers that
                                 have not been assigned to an ISA-AA MDA within a group.";
                        }

                        leaf spoke-sdp {
                            type yang:gauge32;
                            description
                                "The number of Spoke SDP subscribers that have not been assigned
                                 to an ISA-AA MDA within a group.";
                        }

                        leaf esm-mac {
                            type yang:gauge32;
                            description
                                "The number of Enhanced Subscriber Management (ESM) MAC host subscribers
                                 that have not been assigned to an ISA-AA MDA within a group.";
                        }

                        leaf transit {
                            type yang:gauge32;
                            description
                                "The number of AA transit subscribers that have not been assigned to
                                 an ISA-AA MDA within a group.";
                        }

                    } // container statistics

                    container transit {
                        description "Enter the transit context";

                        list sap {
                            key "sap-id";
                            description "Enter the sap list instance";

                            leaf sap-id {
                                type types-sros:sap;
                                description "Specifies an AA subscriber on a sap Id.";
                            }

                            container statistics {
                                description "Enter the statistics context";

                                leaf transits {
                                    type yang:gauge32;
                                    description
                                        "The number of transit subscribers under the parent subscriber tmnxBsxIsaLoadBalUnSub
                                         which have not been assigned to an ISA-AA MDA.";
                                }

                            } // container statistics

                        } // list sap

                        list spoke-sdp {
                            key "sdp-bind-id";
                            description "Enter the spoke-sdp list instance";

                            leaf sdp-bind-id {
                                type types-services:sdp-bind-id;
                                description "Specifies an AA subscriber on a spoke sdp Id.";
                            }

                            container statistics {
                                description "Enter the statistics context";

                                leaf transits {
                                    type yang:gauge32;
                                    description
                                        "The number of transit subscribers under the parent subscriber tmnxBsxIsaLoadBalUnSub
                                         which have not been assigned to an ISA-AA MDA.";
                                }

                            } // container statistics

                        } // list spoke-sdp

                    } // container transit

                } // container unassigned-subscribers

            } // list application-assurance-group

            list video-group {
                key "video-group-id";
                description "Enter the video-group list instance";

                leaf video-group-id {
                    type uint32 {
                        range "1..4";
                    }
                    description "Video group identifier.";
                }

                leaf oper-state {
                    type types-sros:oper-state;
                    description "Oerational state of the ISA video group.";
                }

                list mda {
                    key "mda-id";
                    description "Enter the mda list instance";

                    leaf mda-id {
                        type types-isa:slot-mda;
                        description
                            "MDA identifier.

                             <card slot number>/<mda slot number>";
                    }

                    leaf admin-state {
                        type types-services:oper-admin-state;
                        description
                            "The value indicates the administrative
                             state of the video group on this MDA.";
                    }

                    leaf oper-state {
                        type types-sros:oper-state;
                        description
                            "The value indicates the current operational
                             state of the video group on this MDA.";
                    }

                    leaf used-memory {
                        type yang:gauge64;
                        units "bytes";
                        description
                            "The value indicates the amount of cache
                             being used by the video group for storing the video stream.";
                    }

                    leaf available-memory {
                        type yang:gauge64;
                        units "bytes";
                        description
                            "The value indicates the amount of
                             cache available on the MDA for storing the video stream.";
                    }

                    leaf channels {
                        type yang:gauge32;
                        description
                            "The value indicates the number of channels
                             being served on this MDA.";
                    }

                    leaf channel-alloc-fails {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             failed channel allocations on this MDA.";
                    }

                    leaf max-bw-exeeded {
                        type yang:counter32;
                        description
                            "The value indicates the number of times
                             maximum allowed bandwidth has been exceeded for each egress stream.";
                    }

                    leaf bw-in-use {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the total aggregate
                             bandwidth of the currently running egress streams.";
                    }

                    leaf active-rtcp-sessions {
                        type yang:gauge32;
                        description
                            "The value indicates the number
                             of active Real Time Transport Control Protocol (RTCP) sessions on
                             this MDA.";
                    }

                    leaf egress-stream-resets {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             egress stream resets on this MDA. An egress stream reset occurs when
                             there are no packets to transmit on the MDA.";
                    }

                    leaf ingress-steram-resets {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             ingress stream resets on this MDA. An ingress stream reset occurs when
                             the ingress stream stopped coming in for more than one second.";
                    }

                    leaf ads-stream-resets {
                        status obsolete;
                        type yang:counter32;
                        description
                            "The value indicates the number of ad
                             stream resets on this MDA. An ad stream reset occurs when the ingress
                             ad stream stops.";
                    }

                    leaf ad-stream-aborts {
                        status obsolete;
                        type yang:counter32;
                        description
                            "The value indicates the number of ad
                             stream aborts on this MDA. An ad stream abort could happen when an
                             egress reset happens.";
                    }

                    leaf ssr-collisions {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             synchronization source (SSRC) id collisions on this MDA.";
                    }

                    leaf rx-data-packets {
                        type yang:counter64;
                        description
                            "The value indicates the number of data
                             packets received on this MDA.";
                    }

                    leaf rx-data-packets-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaRxDataPackets.";
                    }

                    leaf rx-data-packets-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaRxDataPackets.";
                    }

                    leaf rx-data-octets {
                        type yang:counter64;
                        description
                            "The value indicates the number of data
                             octets received on this MDA.";
                    }

                    leaf rx-data-octets-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaRxDataOctets.";
                    }

                    leaf rx-data-octets-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaRxDataOctets.";
                    }

                    leaf rx-data-packet-errors {
                        type yang:counter64;
                        description
                            "The value indicates the number of
                             malformed or non-RTP (Real Time Transport Protocol) packets received
                             on this MDA.";
                    }

                    leaf rx-data-pkt-errs-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaRxDataPacketErrors.";
                    }

                    leaf rx-data-pkt-errs-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaRxDataPacketErrors.";
                    }

                    leaf tx-data-packets {
                        type yang:counter64;
                        description
                            "The value indicates the number of data
                             packets transmitted on this MDA.";
                    }

                    leaf tx-data-packets-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaTxDataPackets.";
                    }

                    leaf tx-data-packets-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaTxDataPackets.";
                    }

                    leaf tx-data-octets {
                        type yang:counter64;
                        description
                            "The value indicates the number of data
                             octets transmitted on this MDA.";
                    }

                    leaf tx-data-octets-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaTxDataOctets.";
                    }

                    leaf tx-data-octets-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaTxDataOctets.";
                    }

                    leaf tx-data-packet-errors {
                        type yang:counter64;
                        description
                            "The value indicates the number of
                             failed data packets due to lack of resources to be transmitted on
                             this MDA.";
                    }

                    leaf tx-data-pkt-errs-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaTxDataPacketErrors.";
                    }

                    leaf tx-data-pkt-errs-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaTxDataPacketErrors.";
                    }

                    leaf rtcp-perse-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) packet parsing errors on
                             this MDA.";
                    }

                    leaf rtcp-config-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) config errors on
                             this MDA. These errors occur when there is inconsistency between the
                             RTCP values and the configured values.";
                    }

                    leaf rtcp-ipc-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) inter-process communication
                             message processing errors on this MDA.";
                    }

                    leaf rtcp-sg-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) channel errors on
                             this MDA. These errors occur when a channel is not found for a given
                             interface to process RTCP packets.";
                    }

                    leaf rtcp-sub-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) subscriber parameter errors
                             on this MDA. These errors occur when the subscriber calculations
                             exceed the maximum allowed bandwidth.";
                    }

                    leaf rtcp-int-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) interface related errors
                             on this MDA.";
                    }

                    leaf tx-lost-packets {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             packets not found in the video MDA buffer for retransmission. When a
                             retransmission request arrives, packets are checked in the buffer and
                             if they are not found, the value of this object is incremented.";
                    }

                    leaf request-rtp-pkts {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Protocol (RTP) packets requested in the Real-time
                             Transport Control Protocol (RTCP) feedback (FB) messages received on
                             this MDA.";
                    }

                    leaf high-pkt-pool-limit-hit {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             times the high packet pool limit has been hit. A high value of this
                             object indicates potential failure in ingress packet storage.";
                    }

                    leaf malloc-failures {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             memory allocation failures on the management core of the video MDA.";
                    }

                    leaf dent-dropped-pkts {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             packets dropped by the video MDA due to denting.";
                    }

                    leaf bw-peak {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the maximum bandwidth
                             of the currently running egress streams since the last clear event.";
                    }

                    leaf cur-total-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the current total
                             Retransmission (RET) bandwidth in use.";
                    }

                    leaf peak-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the maximum
                             Retransmission (RET) bandwidth used since the last clear event.";
                    }

                    leaf cur-fcc-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the current Fast Channel
                             Change (FCC) bandwidth in use.";
                    }

                    leaf fcc-drop-cnt-req {
                        type yang:gauge32;
                        description
                            "The value indicates the drop count
                             for the Fast Channel Change (FCC) requests due to reserved
                             Retransmission (RET) bandwidth.";
                    }

                    leaf mc-rtcp {
                        type yang:counter64;
                        description
                            "The value indicates the number of
                             multicast retransmissions done in response to Real Time Transport
                             Control Protocol (RTCP) requests.";
                    }

                    leaf mc-rtcp-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaMcRtcp.";
                    }

                    leaf mc-rtcp-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaMcRtcp.";
                    }

                    leaf mc-rudp {
                        type yang:counter64;
                        description
                            "The value indicates the number of
                             multicast retransmissions done in response to Reliable User Datagram
                             Protocol (RUDP) requests.";
                    }

                    leaf mc-rudp-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaMcRudp.";
                    }

                    leaf mc-rudp-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaMcRudp.";
                    }

                    leaf mc-ret-req-crt {
                        type yang:counter64;
                        description
                            "The value indicates the total number
                             of mcast retransmission requests created in response to the unicast
                             retransmission requests.";
                    }

                    leaf mc-ret-req-crt-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaMcRetReqCrt.";
                    }

                    leaf mc-ret-req-crt-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaMcRetReqCrt.";
                    }

                    leaf ret-req-qnc {
                        type yang:counter64;
                        description
                            "The value indicates the total
                             number of unicast retransmission requests quenched with the multicast
                             retransmission.";
                    }

                    leaf ret-req-qnc-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpMdaRetReqQnc.";
                    }

                    leaf ret-req-qnc-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpMdaRetReqQnc.";
                    }

                    leaf pkt-lost-in-seq-10 {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 2 to 10 consecutive lost packets of the
                             video group on this MDA.";
                    }

                    leaf pkt-lost-in-seq-20 {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 11 to 20 consecutive lost packets of the
                             video group on this MDA.";
                    }

                    leaf pkt-lost-in-seq-30 {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 21 to 30 consecutive lost packets of the
                             video group on this MDA.";
                    }

                    leaf pkt-lost-in-seq-40 {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 31 to 40 consecutive lost packets of the
                             video group on this MDA.";
                    }

                    leaf pkt-lost-in-seq-more {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 41 or more consecutive lost packets of
                             the video group on this MDA.";
                    }

                    leaf peak-fcc-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the peak value of
                             bandwidth for Fast Channel Change (FCC) requests since the last
                             reboot/clear.";
                    }

                    leaf peak-fcc-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccBw occurred since the last reboot/clear.";
                    }

                    leaf peak-abs-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the absolute peak value of
                             bandwidth for Retransmission requests (RET) since the last reboot/clear.";
                    }

                    leaf peak-abs-ret-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakAbsRetBw occurred since the last reboot/clear.";
                    }

                    leaf peak-fcc-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Fast Channel Change (FCC) sessions since the last reboot/clear.";
                    }

                    leaf peak-fcc-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccSession occurred since the last reboot/clear.";
                    }

                    leaf peak-ret-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Retransmission (RET) sessions since the last reboot/clear.";
                    }

                    leaf peak-ret-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakRetSession occurred since the last reboot/clear.";
                    }

                    leaf peak-fcc-ret-to-bw {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak value
                             of bandwidth for Channel Change (FCC) and Retransmission (RET) requests
                             since the last reboot/clear.";
                    }

                    leaf peak-fcc-ret-tot-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccRetTotBw occurred since the last reboot/clear.";
                    }

                    leaf peak-fcc-ret-to-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak number
                             of sessions for Fast Channel Change (FCC) and Retransmission (RET) since the last
                             reboot/clear.";
                    }

                    leaf peak-fcc-ret-tot-se-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccRetTotSess occurred since the last reboot/clear.";
                    }

                    leaf cur-abs-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the current Retransmission
                             (RET) bandwidth in use.";
                    }

                    leaf cur-fcc-ret-total-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the current total
                             Fast Channel Change (FCC) and  Retransmission (RET) bandwidth in use.";
                    }

                    leaf act-fcc-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the number of active
                             Real Time Transport Control Protocol (RTCP) sessions allocated for
                             Fast Channel Change (FCC) on this MDA.";
                    }

                    leaf act-ret-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the number of active
                             Real Time Transport Control Protocol (RTCP) sessions allocated for
                             Retransmission (RET) on this MDA.";
                    }

                    leaf act-fcc-ret-total-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the number of
                             active Real Time Transport Control Protocol (RTCP) sessions allocated
                             for Fast Channel Change (FCC) and Retransmission (RET) on this MDA.";
                    }

                    leaf peak-last-hour-abs-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the absolute peak value of
                             bandwidth for Retransmission requests (RET) since the last hour.";
                    }

                    leaf peak-last-hour-abs-ret-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakAbsRetBw occurred since the last hour..";
                    }

                    leaf peak-last-hour-fcc-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the peak value of
                             bandwidth for Fast Channel Change (FCC) requests since the last
                             hour.";
                    }

                    leaf peak-last-hour-fcc-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccBw occurred since the last hour.";
                    }

                    leaf peak-last-hour-fcc-ret-to-bw {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak value
                             of bandwidth for Channel Change (FCC) and Retransmission (RET) requests
                             since the last hour.";
                    }

                    leaf peak-last-hour-fcc-ret-tot-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccRetTotBw occurred since the last hour.";
                    }

                    leaf peak-last-hour-fcc-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Fast Channel Change (FCC) sessions since the last hour.";
                    }

                    leaf peak-last-hour-fcc-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccSession occurred since the last hour.";
                    }

                    leaf peak-last-hour-ret-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Retransmission (RET) sessions since the last hour.";
                    }

                    leaf peak-last-hour-ret-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakRetSession occurred since the last hour.";
                    }

                    leaf peak-last-hour-fcc-ret-to-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak number
                             of sessions for Fast Channel Change (FCC) and Retransmission (RET) since the last
                             hour.";
                    }

                    leaf peak-last-hour-fcc-ret-tot-se-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccRetTotSess occurred since the last hour.";
                    }

                    leaf peak-current-hour-abs-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the absolute peak value of
                             bandwidth for Retransmission requests (RET) since the last hour.";
                    }

                    leaf peak-current-hour-abs-ret-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakAbsRetBw occurred since the last hour..";
                    }

                    leaf peak-current-hour-fcc-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the peak value of
                             bandwidth for Fast Channel Change (FCC) requests since the last
                             hour.";
                    }

                    leaf peak-current-hour-fcc-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccBw occurred since the last hour.";
                    }

                    leaf peak-current-hour-fcc-ret-to-bw {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak value
                             of bandwidth for Channel Change (FCC) and Retransmission (RET) requests
                             since the last hour.";
                    }

                    leaf peak-current-hour-fcc-ret-tot-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccRetTotBw occurred since the last hour.";
                    }

                    leaf peak-current-hour-fcc-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Fast Channel Change (FCC) sessions since the last hour.";
                    }

                    leaf peak-current-hour-fcc-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccSession occurred since the last hour.";
                    }

                    leaf peak-current-hour-ret-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Retransmission (RET) sessions since the last hour.";
                    }

                    leaf peak-current-hour-ret-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakRetSession occurred since the last hour.";
                    }

                    leaf peak-current-hour-fcc-ret-to-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak number
                             of sessions for Fast Channel Change (FCC) and Retransmission (RET) since the last
                             hour.";
                    }

                    leaf peak-current-hour-fcc-ret-tot-se-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpMdaPeakFccRetTotSess occurred since the last hour.";
                    }

                } // list mda

                list vapp {
                    key "esa-id vapp-id";
                    description "Enter the vapp list instance";

                    leaf esa-id {
                        type leafref {
                            path "../../../../esa/esa-id";
                        }
                        description "ESA indentifier.";
                    }

                    leaf vapp-id {
                        type leafref {
                            path "../../../../esa[esa-id=current()/../esa-id]/vm/vm-id";
                        }
                        description "Virtual Application identifier.";
                    }

                    leaf admin-state {
                        type types-services:oper-admin-state;
                        description
                            "The value indicates the administrative
                             state of the video group on this virtual application.";
                    }

                    leaf oper-state {
                        type types-sros:oper-state;
                        description
                            "The value indicates the current operational
                             state of the video group on this virtual application.";
                    }

                    leaf used-memory {
                        type yang:gauge64;
                        units "bytes";
                        description
                            "The value indicates the amount of cache
                             being used by the video group for storing the video stream.";
                    }

                    leaf available-memory {
                        type yang:gauge64;
                        units "bytes";
                        description
                            "The value indicates the amount of
                             cache available on the virtual application for storing the video stream.";
                    }

                    leaf channels {
                        type yang:gauge32;
                        description
                            "The value indicates the number of channels
                             being served on this virtual application.";
                    }

                    leaf channel-alloc-fails {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             failed channel allocations on this virtual application.";
                    }

                    leaf max-bw-exceeded {
                        type yang:counter32;
                        description
                            "The value indicates the number of times
                             maximum allowed bandwidth has been exceeded for each egress stream.";
                    }

                    leaf bw-in-use {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the total aggregate
                             bandwidth of the currently running egress streams.";
                    }

                    leaf active-rtcp-sessions {
                        type yang:gauge32;
                        description
                            "The value indicates the number
                             of active Real Time Transport Control Protocol (RTCP) sessions on
                             this virtual application.";
                    }

                    leaf egress-stream-resets {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             egress stream resets on this virtual application. An egress stream reset occurs when
                             there are no packets to transmit on the virtual application.";
                    }

                    leaf ingress-stream-resets {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             ingress stream resets on this virtual application. An ingress stream reset occurs when
                             the ingress stream stopped coming in for more than one second.";
                    }

                    leaf ad-stream-resets {
                        status obsolete;
                        type yang:counter32;
                        description
                            "The value indicates the number of ad
                             stream resets on this virtual application. An ad stream reset occurs when the ingress
                             ad stream stops.";
                    }

                    leaf ad-stream-aborts {
                        status obsolete;
                        type yang:counter32;
                        description
                            "The value indicates the number of ad
                             stream aborts on this virtual application. An ad stream abort could happen when an
                             egress reset happens.";
                    }

                    leaf ssrc-collisions {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             synchronization source (SSRC) id collisions on this virtual application.";
                    }

                    leaf rx-data-packets {
                        type yang:counter64;
                        description
                            "The value indicates the number of data
                             packets received on this virtual application.";
                    }

                    leaf rx-data-packets-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappRxDataPackets.";
                    }

                    leaf rx-data-packets-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappRxDataPackets.";
                    }

                    leaf rx-data-octets {
                        type yang:counter64;
                        description
                            "The value indicates the number of data
                             octets received on this virtual application.";
                    }

                    leaf rx-data-octets-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappRxDataOctets.";
                    }

                    leaf rx-data-octets-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappRxDataOctets.";
                    }

                    leaf rx-data-packet-errors {
                        type yang:counter64;
                        description
                            "The value indicates the number of
                             malformed or non-RTP (Real Time Transport Protocol) packets received
                             on this virtual application.";
                    }

                    leaf rx-data-pkt-errs-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappRxDataPacketErrors.";
                    }

                    leaf rx-data-pkt-errs-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappRxDataPacketErrors.";
                    }

                    leaf tx-data-packets {
                        type yang:counter64;
                        description
                            "The value indicates the number of data
                             packets transmitted on this virtual application.";
                    }

                    leaf tx-data-packets-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappTxDataPackets.";
                    }

                    leaf tx-data-packets-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappTxDataPackets.";
                    }

                    leaf tx-data-octets {
                        type yang:counter64;
                        description
                            "The value indicates the number of data
                             octets transmitted on this virtual application.";
                    }

                    leaf tx-data-octets-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappTxDataOctets.";
                    }

                    leaf tx-data-octets-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappTxDataOctets.";
                    }

                    leaf tx-data-packet-errors {
                        type yang:counter64;
                        description
                            "The value indicates the number of
                             failed data packets due to lack of resources to be transmitted on
                             this virtual application.";
                    }

                    leaf tx-data-pkt-errs-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappTxDataPacketErrors.";
                    }

                    leaf tx-data-pkt-errs-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappTxDataPacketErrors.";
                    }

                    leaf rtcp-parse-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) packet parsing errors on
                             this virtual application.";
                    }

                    leaf rtcp-config-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) config errors on
                             this virtual application. These errors occur when there is inconsistency between the
                             RTCP values and the configured values.";
                    }

                    leaf rtcp-ipc-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) inter-process communication
                             message processing errors on this virtual application.";
                    }

                    leaf rtcp-sg-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) channel errors on
                             this virtual application. These errors occur when a channel is not found for a given
                             interface to process RTCP packets.";
                    }

                    leaf rtcp-sub-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) subscriber parameter errors
                             on this virtual application. These errors occur when the subscriber calculations
                             exceed the maximum allowed bandwidth.";
                    }

                    leaf rtcp-int-errors {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Control Protocol (RTCP) interface related errors
                             on this virtual application.";
                    }

                    leaf tx-lost-packets {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             packets not found in the video virtual application buffer for retransmission. When a
                             retransmission request arrives, packets are checked in the buffer and
                             if they are not found, the value of this object is incremented.";
                    }

                    leaf request-rtp-pkts {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             Real-time Transport Protocol (RTP) packets requested in the Real-time
                             Transport Control Protocol (RTCP) feedback (FB) messages received on
                             this virtual application.";
                    }

                    leaf high-pkt-pool-limit-hit {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             times the high packet pool limit has been hit. A high value of this
                             object indicates potential failure in ingress packet storage.";
                    }

                    leaf malloc-failures {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             memory allocation failures on the management core of the video virtual application.";
                    }

                    leaf dent-dropped-pkts {
                        type yang:counter32;
                        description
                            "The value indicates the number of
                             packets dropped by the video virtual application due to denting.";
                    }

                    leaf bw-peak {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the maximum bandwidth
                             of the currently running egress streams since the last clear event.";
                    }

                    leaf cur-total-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the current total
                             Retransmission (RET) bandwidth in use.";
                    }

                    leaf peak-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the maximum
                             Retransmission (RET) bandwidth used since the last clear event.";
                    }

                    leaf cur-fcc-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the current Fast Channel
                             Change (FCC) bandwidth in use.";
                    }

                    leaf fcc-drop-cnt-req {
                        type yang:gauge32;
                        description
                            "The value indicates the drop count
                             for the Fast Channel Change (FCC) requests due to reserved
                             Retransmission (RET) bandwidth.";
                    }

                    leaf mc-rtcp {
                        type yang:counter64;
                        description
                            "The value indicates the number of
                             multicast retransmissions done in response to Real Time Transport
                             Control Protocol (RTCP) requests.";
                    }

                    leaf mc-rtcp-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappMcRtcp.";
                    }

                    leaf mc-rtcp-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappMcRtcp.";
                    }

                    leaf mc-rudp {
                        type yang:counter64;
                        description
                            "The value indicates the number of
                             multicast retransmissions done in response to Reliable User Datagram
                             Protocol (RUDP) requests.";
                    }

                    leaf mc-rudp-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappMcRudp.";
                    }

                    leaf mc-rudp-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappMcRudp.";
                    }

                    leaf mc-ret-req-crt {
                        type yang:counter64;
                        description
                            "The value indicates the total number
                             of mcast retransmission requests created in response to the unicast
                             retransmission requests.";
                    }

                    leaf mc-ret-req-crt-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappMcRetReqCrt.";
                    }

                    leaf mc-ret-req-crt-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappMcRetReqCrt.";
                    }

                    leaf ret-req-qnc {
                        type yang:counter64;
                        description
                            "The value indicates the total
                             number of unicast retransmission requests quenched with the multicast
                             retransmission.";
                    }

                    leaf ret-req-qnc-low-32 {
                        type yang:counter32;
                        description
                            "The value indicates the lower 32
                             bits of the value of tmnxVdoGrpVappRetReqQnc.";
                    }

                    leaf ret-req-qnc-high-32 {
                        type yang:counter32;
                        description
                            "The value indicates the higher 32
                             bits of the value of tmnxVdoGrpVappRetReqQnc.";
                    }

                    leaf pkt-lost-in-seq-10 {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 2 to 10 consecutive lost packets of the
                             video group on this virtual application.";
                    }

                    leaf pkt-lost-in-seq-20 {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 11 to 20 consecutive lost packets of the
                             video group on this virtual application.";
                    }

                    leaf pkt-lost-in-seq-30 {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 21 to 30 consecutive lost packets of the
                             video group on this virtual application.";
                    }

                    leaf pkt-lost-in-seq-40 {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 31 to 40 consecutive lost packets of the
                             video group on this virtual application.";
                    }

                    leaf pkt-lost-in-seq-more {
                        type yang:counter32;
                        description
                            "The value indicates the total number
                             of packets within sequences of 41 or more consecutive lost packets of
                             the video group on this virtual application.";
                    }

                    leaf peak-fcc-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the peak value of
                             bandwidth for Fast Channel Change (FCC) requests since the last
                             reboot/clear.";
                    }

                    leaf peak-fcc-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccBw occurred since the last reboot/clear.";
                    }

                    leaf peak-abs-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the absolute peak value of
                             bandwidth for Retransmission requests (RET) since the last reboot/clear.";
                    }

                    leaf peak-abs-ret-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakAbsRetBw occurred since the last reboot/clear.";
                    }

                    leaf peak-fcc-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Fast Channel Change (FCC) sessions since the last reboot/clear.";
                    }

                    leaf peak-fcc-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccSession occurred since the last reboot/clear.";
                    }

                    leaf peak-ret-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Retransmission (RET) sessions since the last reboot/clear.";
                    }

                    leaf peak-ret-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakRetSession occurred since the last reboot/clear.";
                    }

                    leaf peak-fcc-ret-tot-bw {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak value
                             of bandwidth for Channel Change (FCC) and Retransmission (RET) requests
                             since the last reboot/clear.";
                    }

                    leaf peak-fcc-ret-tot-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccRetTotBw occurred since the last reboot/clear.";
                    }

                    leaf peak-fcc-ret-tot-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak number
                             of sessions for Fast Channel Change (FCC) and Retransmission (RET) since the last
                             reboot/clear.";
                    }

                    leaf peak-fcc-ret-tot-sess-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccRetTotSess occurred since the last reboot/clear.";
                    }

                    leaf cur-abs-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the current Retransmission
                             (RET) bandwidth in use.";
                    }

                    leaf cur-fcc-ret-total-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the current total
                             Fast Channel Change (FCC) and  Retransmission (RET) bandwidth in use.";
                    }

                    leaf act-fcc-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the number of active
                             Real Time Transport Control Protocol (RTCP) sessions allocated for
                             Fast Channel Change (FCC) on this virtual application.";
                    }

                    leaf act-ret-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the number of active
                             Real Time Transport Control Protocol (RTCP) sessions allocated for
                             Retransmission (RET) on this virtual application.";
                    }

                    leaf act-fcc-ret-total-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the number of
                             active Real Time Transport Control Protocol (RTCP) sessions allocated
                             for Fast Channel Change (FCC) and Retransmission (RET) on this virtual application.";
                    }

                    leaf peak-last-hour-abs-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the absolute peak value of
                             bandwidth for Retransmission requests (RET) since the last hour.";
                    }

                    leaf peak-last-hour-abs-ret-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakAbsRetBw occurred since the last hour..";
                    }

                    leaf peak-last-hour-fcc-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the peak value of
                             bandwidth for Fast Channel Change (FCC) requests since the last
                             hour.";
                    }

                    leaf peak-last-hour-fcc-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccBw occurred since the last hour.";
                    }

                    leaf peak-last-hour-fcc-ret-to-bw {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak value
                             of bandwidth for Channel Change (FCC) and Retransmission (RET) requests
                             since the last hour.";
                    }

                    leaf peak-last-hour-fcc-ret-tot-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccRetTotBw occurred since the last hour.";
                    }

                    leaf peak-last-hour-fcc-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Fast Channel Change (FCC) sessions since the last hour.";
                    }

                    leaf peak-last-hour-fcc-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccSession occurred since the last hour.";
                    }

                    leaf peak-last-hour-ret-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Retransmission (RET) sessions since the last hour.";
                    }

                    leaf peak-last-hour-ret-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakRetSession occurred since the last hour.";
                    }

                    leaf peak-last-hour-fcc-ret-to-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak number
                             of sessions for Fast Channel Change (FCC) and Retransmission (RET) since the last
                             hour.";
                    }

                    leaf peak-last-hour-fcc-ret-tot-se-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccRetTotSess occurred since the last hour.";
                    }

                    leaf peak-current-hour-abs-ret-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the absolute peak value of
                             bandwidth for Retransmission requests (RET) since the last hour.";
                    }

                    leaf peak-current-hour-abs-ret-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakAbsRetBw occurred since the last hour..";
                    }

                    leaf peak-current-hour-fcc-bw {
                        type yang:gauge32;
                        units "kilobps";
                        description
                            "The value indicates the peak value of
                             bandwidth for Fast Channel Change (FCC) requests since the last
                             hour.";
                    }

                    leaf peak-current-hour-fcc-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccBw occurred since the last hour.";
                    }

                    leaf peak-current-hour-fcc-ret-to-bw {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak value
                             of bandwidth for Channel Change (FCC) and Retransmission (RET) requests
                             since the last hour.";
                    }

                    leaf peak-current-hour-fcc-ret-tot-bw-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccRetTotBw occurred since the last hour.";
                    }

                    leaf peak-current-hour-fcc-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Fast Channel Change (FCC) sessions since the last hour.";
                    }

                    leaf peak-current-hour-fcc-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccSession occurred since the last hour.";
                    }

                    leaf peak-current-hour-ret-session {
                        type yang:gauge32;
                        description
                            "The value indicates the peak number of
                             Retransmission (RET) sessions since the last hour.";
                    }

                    leaf peak-current-hour-ret-session-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakRetSession occurred since the last hour.";
                    }

                    leaf peak-current-hour-fcc-ret-to-sess {
                        type yang:gauge32;
                        description
                            "The value indicates the total peak number
                             of sessions for Fast Channel Change (FCC) and Retransmission (RET) since the last
                             hour.";
                    }

                    leaf peak-current-hour-fcc-ret-tot-se-time {
                        type yang:date-and-time;
                        description
                            "The value indicates the time (timestamp)
                             when tmnxVdoGrpVappPeakFccRetTotSess occurred since the last hour.";
                    }

                } // list vapp

            } // list video-group

        } // container isa

        list lag {
            key "lag-name";
            description "Enter the lag list instance";

            leaf lag-name {
                type types-sros:lag-interface;
                description "LAG Name always to start with lag-";
            }

            leaf lag-id {
                type uint32;
                description "internal lag-id";
            }

            leaf oper-state {
                type types-sros:oper-state;
                description "Operational state of the LAG.";
            }

            leaf lacp-admin-key-autogen {
                type boolean;
                description
                    "lacp-admin-key-autogen is set to 'true' if the LAG administrative key
                     in the lag-configwas auto generated.
                     lacp-admin-key-autogen is set to 'false', if the LAG administrative
                     key was manually configured.";
            }

            leaf threshold-rising {
                type yang:counter32;
                description
                    "counts the number of linkUp or dynamic/static-cost events for the
                     LAG caused by the number of physical ports
                     being greater than tLagPortThreshold value.";
            }

            leaf threshold-falling {
                type yang:counter32;
                description
                    "counts the number of linkDown or dynamic/static-cost events for the
                     LAG caused by the number of physical ports
                     being less or equal than tLagPortThreshold value.";
            }

            leaf if-index {
                type uint32;
                description "ifIndex for the LAG.";
            }

            leaf hardware-mac-address {
                type yang:mac-address;
                description "System generated MAC address for the LAG.";
            }

            leaf forced {
                type enumeration {
                    enum not-appl                       { value 0; }
                    enum active                         { value 1; }
                    enum standby                        { value 2; }
                }
                description "Selection state forced by the tools command";
            }

            leaf available-bandwidth {
                type yang:counter64;
                units "kilobps";
                description "The administrative bandwidth that is still free for booking on this LAG.";
            }

            leaf booked-bandwidth {
                type yang:counter64;
                units "kilobps";
                description "The administrative bandwidth that has been booked.";
            }

            leaf remaining-hold-time {
                type union {
                    type int32 {
                        range "0..2000";
                    }
                    type enumeration {
                        enum infinite                       { value -1; }
                    }
                }
                units "deciseconds";
                description
                    "The value indicates the time
                     remaining before this system would switch to the newly
                     eligible sub-group.
                     The value zero indicates that the system would immediately switch
                     back.
                     The value all ones indicates that the system would never switch
                     back autonomously.";
            }

            leaf selected-sub-group {
                type union {
                    type uint32 {
                        range "0..16";
                    }
                    type enumeration {
                        enum mc-peer                        { value -1; }
                    }
                }
                description
                    "This value indicates
                     the currently selected sub-group.

                     The value zero indicates that the value is not applicable.

                     The value minus one can appear in a multi-chassis LAG configuration
                     and indicates that the selected sub-group is in
                     the scope of the multi-chassis peer.";
            }

            leaf candidate-sub-group {
                type union {
                    type uint32 {
                        range "1..16";
                    }
                    type enumeration {
                        enum mc-peer                        { value -1; }
                    }
                }
                description
                    "This value indicates
                     the candidate sub-group.

                     The value zero indicates that the value is not applicable.

                     The value minus one can appear in a multi-chassis LAG configuration
                     and indicates that the candidate sub-group is in
                     the scope of the multi-chassis peer.";
            }

            leaf sub-group-count {
                type uint32;
                description
                    "This value indicates the number of subgroups
                     configured in this LAG.";
            }

            leaf operational-key {
                type int32 {
                    range "0..65535";
                }
                description "LACP operational key";
            }

            leaf system-id {
                type yang:mac-address;
                description "LACP system identifier.";
            }

            leaf system-priority {
                type int32 {
                    range "0..65535";
                }
                description "LACP system priority.";
            }

            leaf partner-system-id {
                type yang:mac-address;
                description "LACP partner system identifier.";
            }

            leaf partner-priority {
                type int32 {
                    range "0..65535";
                }
                description "LACP partner priority.";
            }

            leaf partner-operational-key {
                type int32 {
                    range "0..65535";
                }
                description "LACP partner operational key";
            }

            leaf number-weight-up {
                type yang:gauge32;
                description
                    "This value indicates
                     the weight of the physical ports that are operational (link up).";
            }

            leaf bandwidth {
                type yang:gauge64;
                description
                    "This value indicates
                     the bandwidth of the lag.";
            }

            leaf number-port-up {
                type yang:gauge32;
                description
                    "This value indicates
                     the number of physical ports that are operational (link up).";
            }

            leaf total-weight {
                type yang:gauge32;
                description "This value indicates the total weight of the physical ports.";
            }

            leaf adaptive-load-balancing-number-rebalance {
                type yang:gauge32;
                description "This value indicates the total number of rebalances.";
            }

            leaf adaptive-load-balancing-diff-most-least-loaded-link {
                type types-sros:percent {
                    range "0..100";
                }
                description "This value indicates the diff in percentage between the most and least loaded link.";
            }

            leaf lacp-fallback-time-remaining {
                type int32;
                units "seconds";
                description
                    "The value indicates the time remaining for LACP
                     fallback mode to become active.
                     It is reset to the configured fallback timeout value
                     whenever a LACP PDU is received.";
            }

            container network {
                description "Enter the network context";

                container egress {
                    description "Enter the egress context";

                    list queue {
                        key "queue-id";
                        description "Enter the queue list instance";

                        leaf queue-id {
                            type types-qos:ingress-queue-id;
                            description "Specifies the ingress queue group queue identifier.";
                        }

                        container statistics {
                            description "Enter the statistics context";

                            leaf in-profile-forwarded-packets {
                                type yang:counter64;
                                description "The number of in-inplus profile forwarded packets.";
                            }

                            leaf in-profile-forwarded-octets {
                                type yang:counter64;
                                description "The number of in-inplus profile forwarded octets.";
                            }

                            leaf in-profile-dropped-packets {
                                type yang:counter64;
                                description "The number of in-inplus profile dropped packets.";
                            }

                            leaf in-profile-dropped-octets {
                                type yang:counter64;
                                description "The number of in-inplus profile dropped octets.";
                            }

                            leaf out-profile-forwarded-packets {
                                type yang:counter64;
                                description "The number of out-exceed profile forwarded packets.";
                            }

                            leaf out-profile-forwarded-octets {
                                type yang:counter64;
                                description "The number of out-exceed profile forwarded octets.";
                            }

                            leaf out-profile-dropped-packets {
                                type yang:counter64;
                                description "The number of out-exceed profile dropped packets.";
                            }

                            leaf out-profile-dropped-octets {
                                type yang:counter64;
                                description "The number of out-exceed profile dropped octets.";
                            }

                        } // container statistics

                    } // list queue

                } // container egress

                container ingress {
                    description "Enter the ingress context";

                    list queue {
                        key "queue-id";
                        description "Enter the queue list instance";

                        leaf queue-id {
                            type types-qos:ingress-queue-id;
                            description "Specifies the ingress queue group queue identifier.";
                        }

                        container statistics {
                            description "Enter the statistics context";

                            leaf in-profile-forwarded-packets {
                                type yang:counter64;
                                description "The number of in-inplus profile forwarded packets.";
                            }

                            leaf in-profile-forwarded-octets {
                                type yang:counter64;
                                description "The number of in-inplus profile forwarded octets.";
                            }

                            leaf in-profile-dropped-packets {
                                type yang:counter64;
                                description "The number of in-inplus profile dropped packets.";
                            }

                            leaf in-profile-dropped-octets {
                                type yang:counter64;
                                description "The number of in-inplus profile dropped octets.";
                            }

                            leaf out-profile-forwarded-packets {
                                type yang:counter64;
                                description "The number of out-exceed profile forwarded packets.";
                            }

                            leaf out-profile-forwarded-octets {
                                type yang:counter64;
                                description "The number of out-exceed profile forwarded octets.";
                            }

                            leaf out-profile-dropped-packets {
                                type yang:counter64;
                                description "The number of out-exceed profile dropped packets.";
                            }

                            leaf out-profile-dropped-octets {
                                type yang:counter64;
                                description "The number of out-exceed profile dropped octets.";
                            }

                        } // container statistics

                    } // list queue

                } // container ingress

            } // container network

            container multi-chassis {
                description "Enter the multi-chassis context";

                leaf active-standby {
                    type enumeration {
                        enum active                         { value 1; }
                        enum stand-by                       { value 2; }
                    }
                    description "Indicates active standby state of the MC-LAG.";
                }

                leaf selection-reason {
                    type types-sros:display-string-or-empty {
                        length "0..255";
                    }
                    description "Selection reason";
                }

                leaf config-mismatch-reason {
                    type types-sros:display-string-or-empty {
                        length "0..255";
                    }
                    description "Configuration mismatch reason";
                }

                leaf extended-timeout {
                    type boolean;
                    description "Extended timeout";
                }

            } // container multi-chassis

            container eth-cfm {
                description "Enter the eth-cfm context";

                list mep {
                    key "md-admin-name ma-admin-name mep-id";
                    description "Enter the mep list instance";

                    leaf md-admin-name {
                        type leafref {
                            path "../../../../eth-cfm/domain/md-admin-name";
                        }
                        description "A unique administratively assigned name used to identify a domain.";
                    }

                    leaf ma-admin-name {
                        type leafref {
                            path "../../../../eth-cfm/domain[md-admin-name=current()/../md-admin-name]/association/ma-admin-name";
                        }
                        description "A unique administratively assigned name used to identify an association.";
                    }

                    leaf mep-id {
                        type types-eth-cfm:mep-id-type;
                        description
                            "A CFM Virtual Maintenance Endpoint

                             Specifies a local Maintenance association End Point identifier unique
                             over a given maintanance association.";
                    }

                    leaf if-index {
                        type uint32;
                        description "Port ID of the MEP.";
                    }

                    leaf oper-mac-address {
                        type yang:mac-address;
                        description "Operational MAC address of the MEP.";
                    }

                    container ais {
                        description "Enter the ais context";

                        container received {
                            description "Enter the received context";

                            leaf ais-packet {
                                type boolean;
                                description "Indicates if the MEP is receiving AIS test frames from one or more of its sub-layer MEPs.";
                            }

                            leaf interval {
                                type uint32 {
                                    range "1|60";
                                }
                                units "seconds";
                                description "Indicates the AIS Interval received in the last AIS Frame.";
                            }

                        } // container received

                        container transmitted {
                            description "Enter the transmitted context";

                            leaf ais-packet {
                                type enumeration {
                                    enum no-transmit                    { value 0; }
                                    enum transmit                       { value 1; }
                                    enum pending                        { value 2; }
                                }
                                description "Indicates if the MEP is transmitting AIS test frames from one or more of its sub-layer MEPs.";
                            }

                        } // container transmitted

                    } // container ais

                    container csf {
                        description "Enter the csf context";

                        container received {
                            description "Enter the received context";

                            leaf state {
                                type enumeration {
                                    enum los                            { value 0; }
                                    enum ais                            { value 1; }
                                    enum rdi                            { value 2; }
                                    enum dci                            { value 3; }
                                }
                                description
                                    "Indicates the state of the received CSF frames for the MEP.
                                        los (0) - Client Loss of Signal
                                        ais (1) - Client Forward Defect Indication
                                        rdi (2) - Client Reverse Defect Indication
                                        dci (3) - Client Defect Clear Indication.";
                            }

                            leaf interval {
                                type uint32 {
                                    range "1|60";
                                }
                                units "seconds";
                                description "Indicates the CSF Interval received in the most recent CSF frame.";
                            }

                        } // container received

                    } // container csf

                    container grace {
                        description "Enter the grace context";

                        container transmitted {
                            description "Enter the transmitted context";

                            leaf grace-notification {
                                type enumeration {
                                    enum no-transmit                    { value 0; }
                                    enum grace                          { value 1; }
                                    enum eth-ed                         { value 2; }
                                }
                                description "Indicates the state of the MEP grace period PDU transmission.";
                            }

                        } // container transmitted

                        container received {
                            description "Enter the received context";

                            leaf process-grace-notification {
                                type boolean;
                                description
                                    "Indicates whether the local MEP is receiving and processing grace notifications
                                     from one or more peer MEPs. A value of 'true ' indicates the local MEP is
                                     receiving and processing grace from at least one peer MEP. A value
                                     of 'false' indicates that no peer grace notifications are being
                                     received and processed.";
                            }

                        } // container received

                    } // container grace

                    container ccm-states {
                        description "Enter the ccm-states context";

                        leaf transmit-status {
                            type enumeration {
                                enum no-transmit                    { value 0; }
                                enum transmit                       { value 1; }
                                enum suppressed                     { value 2; }
                            }
                            description
                                "Indicates the state of the MEP CCM PDU transmission.

                                 Values:
                                    noTransmit (0) - no CCM PDUs are being transmitted by the MEP
                                    transmit   (1) - MEP is currently transmitting CCM PDUs
                                    suppressed (2) - MEP should be transmitting CCM PDUs but is suppressing
                                                    them due to an internal condition";
                        }

                        leaf sequence-error {
                            type yang:counter32;
                            description "The total number of out-of-sequence CCMs received from all remote MEPs.";
                        }

                        leaf fng-state {
                            type types-eth-cfm:fng-state-type;
                            description "Current state of the MEP Fault Notification Generator State Machine.";
                        }

                        container transmitted {
                            description "Enter the transmitted context";

                            leaf count {
                                type yang:counter32;
                                description "Total number of CCMs transmitted.";
                            }

                            leaf interface-status {
                                type types-eth-cfm:interface-status;
                                description
                                    "Indicates the interface status TLV information included in the most
                                     recent Connectivity Check Message (CCM) transmission from the local MEP.
                                     If the local MEP CCM transmissions are not enabled, or if no interface
                                     status TLV was included in the most recent transmission, then
                                     ccm-tx-if-status will return a value of is-no-interface-status-tlv (0).";
                            }

                            leaf port-status {
                                type types-eth-cfm:port-status;
                                description
                                    "Indicates the port status TLV information included in the most recent
                                     Connectivity Check Message (CCM) transmission from the local MEP.

                                     If the local MEP CCM transmissions are not enabled, or if no port
                                     status TLV was included in the most recent transmission, then
                                     ccm-tx-port-status will return a value of ps-no-port-state-tlv (0).";
                            }

                            leaf remote-defect-indicator {
                                type boolean;
                                description
                                    "Indicates whether or not the Remote Defect Indication (RDI) bit was set
                                     on the most recent Connectivity Check Message (CCM) transmission from the
                                     local MEP.

                                     If the local MEP CCM transmissions are not eanbled, or if the RDI bit
                                     was not set in the most recent transmission, then ccm-tx-rdi will return
                                     a value of 'false (2)'.";
                            }

                        } // container transmitted

                        container received {
                            description "Enter the received context";

                            leaf highest-priority-defect {
                                type types-eth-cfm:highest-priority-defect-type;
                                description
                                    "The highest priority defect that has been present since the
                                     MEPs Fault Notification Generator State Machine was last in
                                     the reset state.";
                            }

                            leaf defect-flags {
                                type types-eth-cfm:mep-defect-flags;
                                description "A vector of boolean error conditions, any of which may be true.";
                            }

                            list remote-mep-peer {
                                key "remote-mep-id";
                                description "Enter the remote-mep-peer list instance";

                                leaf remote-mep-id {
                                    type types-eth-cfm:mep-id-type;
                                    description "The Remote MEP ID within the same Maintenance Association.";
                                }

                                leaf auto-discovered {
                                    type boolean;
                                    description
                                        "Specifies whether or not the remote peer was automatically discovered
                                         ('true') or not. Auto-discovered remote peers are created by the system
                                         only, and are of a 'volatile' storage type. Specifying the value of
                                         'false' will mark an auto-discovered remote peer as permanently configured.";
                                }

                                leaf receiving-ccm {
                                    type types-eth-cfm:remote-mep-state-type;
                                    description "The operational CCM receiving state of the remote MEP.";
                                }

                                leaf ccm-status-since {
                                    type yang:date-and-time;
                                    description
                                        "The time at which the Remote MEP
                                         last entered either the mep-failed or mep-ok state. ";
                                }

                                leaf peer-mac-address {
                                    type yang:mac-address;
                                    description "The MAC address of the remote MEP.";
                                }

                                leaf receiving-remote-defect-indicator {
                                    type boolean;
                                    description
                                        "State of the RDI bit in the last received CCM (true for rdi=1), or false
                                         if none has been received.";
                                }

                                leaf port-status-tlv {
                                    type types-eth-cfm:port-status;
                                    description
                                        "An enumerated value of the Port status TLV received in the
                                         last CCM from the remote MEP or the default value
                                         ps-no-port-state-tlv indicating either no CCM has been received,
                                         or that no port status TLV was received in the last CCM. ";
                                }

                                leaf interface-status-tlv {
                                    type types-eth-cfm:interface-status;
                                    description
                                        "An enumerated value of the Interface status TLV received
                                         in the last CCM from the remote MEP or the default value
                                         is-no-interface-status-tlv indicating either no CCM has been
                                         received, or that no interface status TLV was received in
                                         the last CCM.";
                                }

                            } // list remote-mep-peer

                        } // container received

                    } // container ccm-states

                    container mc-lag {
                        description "Enter the mc-lag context";

                        leaf inactive-state {
                            type enumeration {
                                enum not-applicable                 { value 0; }
                                enum standby                        { value 1; }
                                enum active                         { value 2; }
                            }
                            description
                                "Indicates the MC-LAG inactive state of the mep.  The value of
                                 system/eth-cfm/redundancy/mc-lag/standby-mep must be 'true (1)' 
                                 on the node for this leaf to have meaning.";
                        }

                    } // container mc-lag

                    container statistics {
                        description "Enter the statistics context";

                        list opcode {
                            key "opcode-name";
                            description "Enter the opcode list instance";

                            leaf opcode-name {
                                type types-eth-cfm:statistics-opcode-name;
                                description "Integer that defines which CFM PDU Opcode the statictics refer to.";
                            }

                            leaf transmitted {
                                type yang:counter32;
                                description "The total number of PDUs transmitted from the node with the specified Opcode.";
                            }

                            leaf received {
                                type yang:counter32;
                                description "The total number of PDUs received on the node with the specified Opcode.";
                            }

                        } // list opcode

                    } // container statistics

                } // list mep

            } // container eth-cfm

            list port {
                key "port-id";
                description "Enter the port list instance";

                leaf port-id {
                    type leafref {
                        path "../../../port/port-id";
                    }
                    description "The identifier which uniquely identifies the port in the LAG.";
                }

                leaf active-standby {
                    type enumeration {
                        enum active                         { value 1; }
                        enum stand-by                       { value 2; }
                    }
                    description "Active/standby selection state of the port in the LAG.";
                }

                leaf oper-state {
                    status obsolete;
                    type types-sros:oper-state;
                    description
                        "Operational state of the member port.
                         This leaf was deprecated in release 21.10 on Nokia SROS series systems.
                         It is replaced by /state/port/oper-state.";
                }

                leaf primary {
                    type boolean;
                    description "Primary port indication.";
                }

                leaf forced {
                    type enumeration {
                        enum not-appl                       { value 0; }
                        enum active                         { value 1; }
                        enum standby                        { value 2; }
                    }
                    description "Selection state forced by the tools command";
                }

                leaf actor-oper-state {
                    type bits {
                        bit lacp-activity                  { position 0; }
                        bit lacp-timeout                   { position 1; }
                        bit aggregation                    { position 2; }
                        bit synchronization                { position 3; }
                        bit collecting                     { position 4; }
                        bit distributing                   { position 5; }
                        bit defaulted                      { position 6; }
                        bit expired                        { position 7; }
                    }
                    description "Actor states for LACP protocol.";
                }

                leaf partner-oper-state {
                    type bits {
                        bit lacp-activity                  { position 0; }
                        bit lacp-timeout                   { position 1; }
                        bit aggregation                    { position 2; }
                        bit synchronization                { position 3; }
                        bit collecting                     { position 4; }
                        bit distributing                   { position 5; }
                        bit defaulted                      { position 6; }
                        bit expired                        { position 7; }
                    }
                    description "Partner states for LACP protocol.";
                }

                leaf actor-port {
                    type int32;
                    description "Actor port for LACP protocol.";
                }

                leaf partner-port {
                    type int32;
                    description "Partner port for LACP protocol.";
                }

                leaf partner-port-priority {
                    type int32;
                    description "Partner port priority for LACP protocol.";
                }

                leaf adaptive-load-balancing-egress-rate {
                    type int64;
                    units "kilobps";
                    description "egress rate in kilobps";
                }

                leaf lacp-fallback-active {
                    type boolean;
                    description "LACP fallback port is active.";
                }

                container bfd {
                    description "Enter the bfd context";

                    leaf bfd-state {
                        type enumeration {
                            enum idle                           { value 0; }
                            enum failed                         { value 1; }
                            enum failed-fwd                     { value 2; }
                            enum waiting                        { value 3; }
                            enum waiting-fwd                    { value 4; }
                            enum up                             { value 5; }
                            enum down                           { value 6; }
                        }
                        description "The state of the micro-BFD session of this port in this LAG.";
                    }

                    leaf admin-down-time-left {
                        type uint32;
                        units "seconds";
                        description "The time left before this system will react upon the 'AdminDown' State indication.";
                    }

                    leaf setup-time-left {
                        type uint32;
                        units "milliseconds";
                        description "The set-up time left.";
                    }

                } // container bfd

                container lacp-statistics {
                    description "Enter the lacp-statistics context";

                    leaf rx-packets {
                        type yang:counter32;
                        description "number of valid lacp pdu packets received";
                    }

                    leaf tx-packets {
                        type yang:counter32;
                        description "number of valid lacp pdu packets transmitted";
                    }

                    leaf rx-illegal {
                        type yang:counter32;
                        description "number of illegal lacp pdu packets received";
                    }

                    leaf rx-errors {
                        type yang:counter32;
                        description "number of errornous lacp pdu packets received";
                    }

                    leaf tx-errors {
                        type yang:counter32;
                        description "number of errornous lacp pdu packets sent";
                    }

                } // container lacp-statistics

            } // list port

            list link-map-profile {
                key "link-map-profile-id";
                description "Enter the link-map-profile list instance";

                leaf link-map-profile-id {
                    type int32 {
                        range "1..64";
                    }
                    description "The LAG link map profile identifier.";
                }

                leaf active-link {
                    type types-sros:port;
                    description "The active link port for the link map profile.";
                }

            } // list link-map-profile

            container subscriber-management {
                description "Enter the subscriber-management context";

                container statistics {
                    description "Enter the statistics context";

                    leaf last-reset-peak-values {
                        type yang:date-and-time;
                        description "Timestamp of the last reset of the peak values";
                    }

                    list ipv4-hosts {
                        key "counter";
                        description "Enter the ipv4-hosts list instance";

                        leaf counter {
                            type types-submgt:submgt-statistics-ipv4-type;
                            description "Type of submgt ipv4 hosts counter";
                        }

                        leaf current-value {
                            type uint32;
                            description "Current value of submgt counter";
                        }

                        leaf peak-value {
                            type uint32;
                            description "Peak value of submgt counter";
                        }

                        leaf peak-timestamp {
                            type yang:date-and-time;
                            description "Peak timestamp of submgt counter";
                        }

                    } // list ipv4-hosts

                    list ipv6-hosts {
                        key "counter";
                        description "Enter the ipv6-hosts list instance";

                        leaf counter {
                            type types-submgt:submgt-statistics-ipv6-type;
                            description "Type of submgt ipv6 hosts counter";
                        }

                        leaf current-value {
                            type uint32;
                            description "Current value of submgt counter";
                        }

                        leaf peak-value {
                            type uint32;
                            description "Peak value of submgt counter";
                        }

                        leaf peak-timestamp {
                            type yang:date-and-time;
                            description "Peak timestamp of submgt counter";
                        }

                    } // list ipv6-hosts

                    list total-hosts {
                        key "counter";
                        description "Enter the total-hosts list instance";

                        leaf counter {
                            type types-submgt:submgt-statistics-total-type;
                            description "Type of submgt total hosts counter";
                        }

                        leaf current-value {
                            type uint32;
                            description "Current value of submgt counter";
                        }

                        leaf peak-value {
                            type uint32;
                            description "Peak value of submgt counter";
                        }

                        leaf peak-timestamp {
                            type yang:date-and-time;
                            description "Peak timestamp of submgt counter";
                        }

                    } // list total-hosts

                    list sessions {
                        key "counter";
                        description "Enter the sessions list instance";

                        leaf counter {
                            type types-submgt:submgt-statistics-session-type;
                            description "Type of submgt sessions counter";
                        }

                        leaf current-value {
                            type uint32;
                            description "Current value of submgt counter";
                        }

                        leaf peak-value {
                            type uint32;
                            description "Peak value of submgt counter";
                        }

                        leaf peak-timestamp {
                            type yang:date-and-time;
                            description "Peak timestamp of submgt counter";
                        }

                    } // list sessions

                } // container statistics

                list svlan {
                    key "vlan-id";
                    description "Enter the svlan list instance";

                    leaf vlan-id {
                        type uint32 {
                            range "0..4094";
                        }
                        description "The VLAN identifier.";
                    }

                    leaf active-subscriber-hosts {
                        type yang:counter32;
                        description "The number of active subscriber hosts on this port and VLAN.";
                    }

                    container statistics {
                        description "Enter the statistics context";

                        leaf last-cleared-time {
                            type yang:date-and-time;
                            description "The time when the counters were last cleared.";
                        }

                        leaf ingress-packets {
                            type yang:counter64;
                            description "The number of IP packets received through this port and VLAN.";
                        }

                        leaf ingress-octets {
                            type yang:counter64;
                            description "The number of octets in IP packets received through this port and VLAN.";
                        }

                        leaf egress-packets {
                            type yang:counter64;
                            description "The number of IP packets sent through this port and VLAN.";
                        }

                        leaf egress-octets {
                            type yang:counter64;
                            description "The number of octets in IP packets sent through this port and VLAN.";
                        }

                    } // container statistics

                } // list svlan

            } // container subscriber-management

            container statistics {
                description "Enter the statistics context";

                leaf last-cleared-time {
                    type yang:date-and-time;
                    description
                        "Indicates the time, since system startup, when the counters in
                         IF-MIB::ifTable were last cleared.";
                }

                leaf in-discards {
                    type yang:counter64;
                    description
                        "Indicates the number of inbound packets which were chosen to be
                         discarded even though no errors had been detected to prevent
                         their being deliverable to a higher-layer protocol.  One
                         possible reason for discarding such a packet could be to
                         free up buffer space.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf in-errors {
                    type yang:counter64;
                    description
                        "Indicates for packet-oriented interfaces, the number of inbound
                         packets that contained errors preventing them from being
                         deliverable to a higher-layer protocol.  For character-
                         oriented or fixed-length interfaces, the number of inbound
                         transmission units that contained errors preventing them
                         from being deliverable to a higher-layer protocol.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf in-octets {
                    type yang:counter64;
                    description
                        "Indicates the total number of octets received on the interface,
                         including framing characters.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf in-packets {
                    type yang:counter64;
                    description
                        "Indicates the total number of packets received on the interface,
                         including framing characters.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf in-unknown-protocol-discards {
                    type yang:counter64;
                    description
                        "Indicates for packet-oriented interfaces, the number of packets
                         received via the interface which were discarded because of
                         an unknown or unsupported protocol.  For character-oriented
                         or fixed-length interfaces that support protocol
                         multiplexing the number of transmission units received via
                         the interface which were discarded because of an unknown or
                         unsupported protocol.  For any interface that does not
                         support protocol multiplexing, this counter will always be
                         0.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf in-broadcast-packets {
                    type yang:counter64;
                    description
                        "Indicates the number of packets, delivered by this sub-layer to a
                         higher (sub-)layer, which were addressed to a broadcast
                         address at this sub-layer.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf in-multicast-packets {
                    type yang:counter64;
                    description
                        "Indicates the number of packets, delivered by this sub-layer to a
                         higher (sub-)layer, which were addressed to a multicast
                         address at this sub-layer.  For a MAC layer protocol, this
                         includes both Group and Functional addresses.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf in-unicast-packets {
                    type yang:counter64;
                    description
                        "Indicates the number of packets, delivered by this sub-layer to a
                         higher (sub-)layer, which were not addressed to a multicast
                         or broadcast address at this sub-layer.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf out-discards {
                    type yang:counter64;
                    description
                        "Indicates the number of outbound packets which were chosen to be
                         discarded even though no errors had been detected to prevent
                         their being transmitted.  One possible reason for discarding
                         such a packet could be to free up buffer space.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf out-errors {
                    type yang:counter64;
                    description
                        "Indicates for packet-oriented interfaces, the number of outbound
                         packets that could not be transmitted because of errors.
                         For character-oriented or fixed-length interfaces, the
                         number of outbound transmission units that could not be
                         transmitted because of errors.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf out-octets {
                    type yang:counter64;
                    description
                        "Indicates the total number of octets transmitted out of the
                         interface, including framing characters.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf out-packets {
                    type yang:counter64;
                    description
                        "Indicates the total number of packets transmitted out of the
                         interface, including framing characters.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf out-broadcast-packets {
                    type yang:counter64;
                    description
                        "Indicates the total number of packets that higher-level protocols
                         requested be transmitted, and which were addressed to a
                         broadcast address at this sub-layer, including those that
                         were discarded or not sent.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf out-multicast-packets {
                    type yang:counter64;
                    description
                        "Indicates the total number of packets that higher-level protocols
                         requested be transmitted, and which were addressed to a
                         multicast address at this sub-layer, including those that
                         were discarded or not sent.  For a MAC layer protocol, this
                         includes both Group and Functional addresses.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                leaf out-unicast-packets {
                    type yang:counter64;
                    description
                        "Indicates the total number of packets that higher-level protocols
                         requested be transmitted, and which were not addressed to a
                         multicast or broadcast address at this sub-layer, including
                         those that were discarded or not sent.

                         Discontinuities in the value of this counter can occur at
                         re-initialization of the management system, and at other
                         times as indicated by the value of
                         counter-discontinuity-time.";
                }

                container aggregate-queue {
                    description "Enter the aggregate-queue context";

                    leaf ingress-forward-packets {
                        type yang:counter64;
                        description
                            "Indicates the total number of ingress packets forwarded by all queues on
                             the member ports.";
                    }

                    leaf ingress-forward-octets {
                        type yang:counter64;
                        description
                            "Indicates the total number of ingress octets forwarded by all queues on
                             the member ports.";
                    }

                    leaf egress-forward-packets {
                        type yang:counter64;
                        description
                            "Indicates the total number of egress packets forwarded by all queues on
                             the member ports.";
                    }

                    leaf egress-forward-octets {
                        type yang:counter64;
                        description
                            "Indicates the total number of egress octets forwarded by all queues on
                             the member ports.";
                    }

                    leaf ingress-drop-packets {
                        type yang:counter64;
                        description
                            "Indicates the total number of dropped ingress packets by all queues on
                             the member ports.";
                    }

                    leaf ingress-drop-octets {
                        type yang:counter64;
                        description
                            "Indicates the total number of dropped ingress octets by all queues on
                             the member ports.";
                    }

                    leaf egress-drop-packets {
                        type yang:counter64;
                        description
                            "Indicates the total number of dropped egress packets by all queues on
                             the member ports.";
                    }

                    leaf egress-drop-octets {
                        type yang:counter64;
                        description
                            "Indicates the total number of dropped egress octets by all queues on
                             the member ports.";
                    }

                } // container aggregate-queue

            } // container statistics

            container port-scheduler-policy {
                description "Enter the port-scheduler-policy context";

                container statistics {
                    description "Enter the statistics context";

                    leaf policy-name {
                        type types-sros:named-item-or-empty;
                        description "Specifies an port scheduler policy.";
                    }

                    leaf total-forwarded-octets {
                        type yang:counter64;
                        description "Indicates the total number of octets forwarded.";
                    }

                    leaf total-forwarded-packets {
                        type yang:counter64;
                        description "Indicates the total number of packets forwarded.";
                    }

                    leaf total-dropped-octets {
                        type yang:counter64;
                        description "Indicates the total number of octets dropped.";
                    }

                    leaf total-dropped-packets {
                        type yang:counter64;
                        description "Indicates the total number of packets dropped.";
                    }

                    list level {
                        key "priority-level";
                        description "Enter the level list instance";

                        leaf priority-level {
                            type uint32 {
                                range "1..8";
                            }
                            description "Specifies the priority level of the port scheduler policy.";
                        }

                        leaf forwarded-octets {
                            type yang:counter64;
                            description "Indicates the number of octets forwarded for this level.";
                        }

                        leaf forwarded-packets {
                            type yang:counter64;
                            description "Indicates the number of packets forwarded for this level.";
                        }

                        leaf dropped-octets {
                            type yang:counter64;
                            description "Indicates the number of octets dropped for this level.";
                        }

                        leaf dropped-packets {
                            type yang:counter64;
                            description "Indicates the number of packets dropped for this level.";
                        }

                    } // list level

                } // container statistics

            } // container port-scheduler-policy

            container lldp-member-template {
                description "Enter the lldp-member-template context";

                list dest-mac {
                    key "mac-type";
                    description "Enter the dest-mac list instance";

                    leaf mac-type {
                        type types-lldp:mac-addr-type;
                        description "The identifier which uniquely identifies the MAC address type.";
                    }

                    list tx-mgmt-address {
                        key "mgmt-address-system-type";
                        description "Enter the tx-mgmt-address list instance";

                        leaf mgmt-address-system-type {
                            type enumeration {
                                enum oob                            { value 0; }
                                enum system                         { value 1; }
                                enum system-ipv6                    { value 2; }
                                enum oob-ipv6                       { value 3; }
                            }
                            description "The identifier which uniquely identifies the management address.";
                        }

                        leaf mgmt-address {
                            type types-sros:ip-address;
                            description "Indicates the management address.";
                        }

                    } // list tx-mgmt-address

                } // list dest-mac

            } // container lldp-member-template

        } // list lag

        container log {
            description "Enter the log context";

            list accounting-policy {
                key "policy-id";
                description "Enter the accounting-policy list instance";

                leaf policy-id {
                    type types-log:log-policy-id;
                    description "Accounting policy unique identifier.";
                }

                leaf oper-state {
                    type types-sros:oper-state;
                    description
                        "The value of the this object indicates the operational
                         state of the accounting policy.";
                }

                leaf port-type {
                    type types-log:accounting-port-type;
                    description
                        "Indicates the type of facility associated with the specified
                         accounting policy's record type.";
                }

                leaf data-loss-count {
                    type yang:counter32;
                    description
