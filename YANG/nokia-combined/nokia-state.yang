                list url-list {
                    key "url-list-name";
                    description "Enter the url-list list instance";

                    leaf url-list-name {
                        type types-sros:named-item;
                        description "Specifies the name that uniquely identifies an URL-list within an AA group.";
                    }

                    leaf oper-state {
                        type types-sros:oper-state;
                        description
                            "The operational state of the URL list.
                             When the value is 'down' the URL list is not active.";
                    }

                    leaf oper-flags {
                        type types-aa:url-list-flags;
                        description "The conditions that affect the operating status of the URL list.";
                    }

                    leaf deployed-to-isas {
                        type boolean;
                        description
                            "Indicates whether or not the configured file has been deployed to all AA ISAs or ESA-VMs in this group.

                             A value of 'true' indicates the configured url-list file is currently deployed
                             on AA ISAs or ESA-VMs in this group.

                             A value of 'false' indicates the configured url-list file is different from the one currently
                             deployed on AA ISAs or ESA-VMs in this group. An admin/application-assurance/group/url-list upgrade
                             or url-list admin-state enable can trigger the current file to be imported and deployed.";
                    }

                    container file-import {
                        description "Enter the file-import context";

                        container success {
                            description "Enter the success context";

                            leaf last-time {
                                type yang:date-and-time;
                                description
                                    "The most recent time of a successful file import.  When a file import is successful attempt/last-time
                                     and success/last-time will be the same and attempt/in-progress will be 'false'.";
                            }

                            leaf file-name {
                                type types-sros:display-string-or-empty {
                                    length "0..180";
                                }
                                description "The filename on compact flash at the time of the most recent successful URL list file import.";
                            }

                            leaf url-entries {
                                type yang:gauge32;
                                description "The number of entries in the URL list retrieved from the specified file.";
                            }

                            leaf url-characters {
                                type yang:gauge32;
                                description "The number of characters in the URLs retrieved from the specified file.";
                            }

                            leaf url-host-expressions {
                                type yang:gauge32;
                                description "The number of host expressions in the URLs retrieved from the specified file.";
                            }

                            leaf blank-or-comment-lines {
                                type yang:gauge32;
                                description "The number of blank or comment lines that were skipped while processing the specified file.";
                            }

                        } // container success

                        container attempt {
                            description "Enter the attempt context";

                            leaf last-time {
                                type yang:date-and-time;
                                description
                                    "The most recent time of an attempted file import.  When a file import is successful attempt/last-time
                                     and success/last-time will be the same and attempt/in-progress will be 'false'.";
                            }

                            leaf in-progress {
                                type boolean;
                                description "Indicates 'true' if there is a file import attempt currently in progress.";
                            }

                            leaf file-name {
                                type types-sros:display-string-or-empty {
                                    length "0..180";
                                }
                                description "The filename on compact flash at the time of the most recent attempted URL list file import.";
                            }

                            leaf error-line {
                                type uint32 {
                                    range "0..2147483647";
                                }
                                description
                                    "The approximate line from the specified file which had an error while performing a URL list file import.
                                     A value of 0 indicates there was an error not associated with any line.";
                            }

                            leaf error-reason {
                                type types-aa:url-list-flags;
                                description "The reason for the failure of the URL list file import.";
                            }

                            leaf error-detail {
                                type types-sros:display-string;
                                description "The text reason for the failure of the URL list file import.";
                            }

                        } // container attempt

                    } // container file-import

                } // list url-list

                list url-filter {
                    key "url-filter-name";
                    description "Enter the url-filter list instance";

                    leaf url-filter-name {
                        type types-sros:named-item;
                        description "Specifies the name which uniquely identifies a URL filter within an AA group.";
                    }

                    list esa {
                        key "esa-id vm";
                        description "Enter the esa list instance";

                        leaf esa-id {
                            type types-esa:esa-id;
                            description "Specifies an ESA identifier.";
                        }

                        leaf vm {
                            type types-esa:vm-id;
                            description "Specifies the VM identifier within the ESA.";
                        }

                        leaf oper-state {
                            type types-sros:oper-state;
                            description "The operational state of the URL Filter.";
                        }

                        leaf oper-flags {
                            type bits {
                                bit admin-down                     { position 0; }
                                bit no-aa-interface                { position 1; }
                                bit aa-interface-down              { position 2; }
                                bit icap-server-down               { position 3; }
                                bit url-list-down                  { position 4; }
                                bit web-service-down               { position 5; }
                            }
                            description "The conditions that affect the operating status of the URL Filter";
                        }

                        container statistics {
                            description "Enter the statistics context";

                            leaf client-requests {
                                type yang:counter64;
                                description
                                    "The number of URL requests made by clients to web servers that were
                                     analyzed by the url-filter.";
                            }

                            leaf client-request-errors {
                                type yang:counter64;
                                description "The number of times the URL request was unable to be analyzed.";
                            }

                            leaf server-response-allow {
                                type yang:counter64;
                                description
                                    "The number of URL responses from web servers to clients that were
                                     allowed based on the url-filter analysis of the client-request
                                     resulting in a url-allow decision.";
                            }

                            leaf server-response-redirect {
                                type yang:counter64;
                                description
                                    "The number of URL responses from web servers to clients that were
                                     redirected based on the url-filter analysis of the client-request
                                     resulting in a url-block-redirect decision and the conversation
                                     being redirectable.";
                            }

                            leaf server-response-block {
                                type yang:counter64;
                                description
                                    "The number of URL responses from web servers to clients that were
                                     blocked or TCP reset based on the url-filter analysis of the client-request
                                     resulting in a url-block-redirect decision and the conversation
                                     not being redirectable.";
                            }

                            leaf server-response-default {
                                type yang:counter64;
                                description
                                    "The number of URL responses from web servers to clients that took
                                     a default-actions based on the url-filter analysis of the client-request
                                     resulting in a url-default-action decision.";
                            }

                            leaf url-allow {
                                type yang:counter64;
                                description
                                    "The total number of URL lookup requests that resulted in an 'allow'
                                     decision by the url-filter.";
                            }

                            leaf url-block-redirect {
                                type yang:counter64;
                                description
                                    "The total number of URL lookup requests that resulted in a 'redirect'
                                     or 'block' decision by the last filtering function within the url-filter.";
                            }

                            leaf url-default-action {
                                type yang:counter64;
                                description
                                    "The total number of URL lookup requests that resulted in a 'default-action'
                                     decision by the last filtering function within the url-filter.";
                            }

                        } // container statistics

                        container local-filtering {
                            description "Enter the local-filtering context";

                            container statistics {
                                description "Enter the statistics context";

                                container allow-list {
                                    description "Enter the allow-list context";

                                    leaf lookup {
                                        type yang:counter64;
                                        description "The number of allow-list URL lookups.";
                                    }

                                    leaf match {
                                        type yang:counter64;
                                        description "The number of allow-list URL lookups that matched and were allowed.";
                                    }

                                } // container allow-list

                            } // container statistics

                        } // container local-filtering

                        container icap {
                            description "Enter the icap context";

                            container statistics {
                                description "Enter the statistics context";

                                leaf late-response {
                                    type yang:counter64;
                                    description "The number of times the HTTP response was received prior to the ICAP response.";
                                }

                                leaf late-response-packets-discarded {
                                    type yang:counter64;
                                    description "The number of packets dropped while waiting for an ICAP response.";
                                }

                                leaf late-response-octets-discarded {
                                    type yang:counter64;
                                    description "The number of bytes dropped while waiting for an ICAP response.";
                                }

                                leaf default-action {
                                    type yang:counter64;
                                    description
                                        "The number of times the ICAP url-filter took the default-action due
                                         to the url filter's inability to send the request to the ICAP server
                                         or due to receiving a malformed response from it.";
                                }

                            } // container statistics

                        } // container icap

                        container web-service {
                            description "Enter the web-service context";

                            leaf cache-entries {
                                type yang:gauge32;
                                description "The current number of cache entries in use for url-filtering web-service.";
                            }

                            leaf cache-entries-maximum {
                                type uint32;
                                description
                                    "The maximum number of cache entries that can be allocated per URL filter providing
                                     web-service per ISA.";
                            }

                            leaf connections-established {
                                type yang:gauge32;
                                description "The current number of TCP connections which are established with the web-service server.";
                            }

                            leaf connections-maximum {
                                type uint32;
                                description "The maximum number of TCP connections which can be established with the web-service server.";
                            }

                            leaf dns-oper-state {
                                type types-sros:oper-state;
                                description "The operational state of DNS resolution for the web-service FQDN.";
                            }

                            leaf dns-oper-flags {
                                type bits {
                                    bit not-applicable                 { position 0; }
                                    bit filter-admin-down              { position 1; }
                                    bit no-aa-if                       { position 2; }
                                    bit aa-if-down                     { position 3; }
                                    bit dns-down                       { position 4; }
                                    bit look-up-failure                { position 5; }
                                    bit unreachable                    { position 6; }
                                }
                                description "The different conditions that affect the operating status of the web-service DNS resolution.";
                            }

                            leaf request-rate {
                                type yang:gauge32;
                                description "The average number of web-service requests sent per second over the last 10 second period.";
                            }

                            leaf round-trip-time {
                                type yang:gauge32;
                                units "microseconds";
                                description "The average amount of time it took to receive web-service Responses over the last 10 second period.";
                            }

                            container statistics {
                                description "Enter the statistics context";

                                leaf requests {
                                    type yang:counter64;
                                    description "The number of web service requests which have been sent to the web-service server.";
                                }

                                leaf request-errors {
                                    type yang:counter64;
                                    description "The number of web service requests that were unable to be sent to the web-service server.";
                                }

                                leaf late-response {
                                    type yang:counter64;
                                    description "The number of times the HTTP response was received prior to the web-service server response.";
                                }

                                leaf late-response-packets-discarded {
                                    type yang:counter64;
                                    description "The number of packets dropped while waiting for a web-service response.";
                                }

                                leaf late-response-octets-discarded {
                                    type yang:counter64;
                                    description "The number of bytes dropped while waiting for a web-service response.";
                                }

                                leaf cache-hit {
                                    type yang:counter64;
                                    description "The number of cache hits while performing url category classification requests.";
                                }

                                leaf cache-miss {
                                    type yang:counter64;
                                    description "The number of cache misses while performing url category classification requests.";
                                }

                                leaf override-hit {
                                    type yang:counter64;
                                    description "The number of URL lookups that matched entries in the classification override entries.";
                                }

                                leaf override-miss {
                                    type yang:counter64;
                                    description "The number of URL lookups that missed entries in the classification override entries.";
                                }

                                container result {
                                    description "Enter the result context";

                                    leaf allow {
                                        type yang:counter64;
                                        description "The number of web-service classifications which allowed the url for the subscriber's profile.";
                                    }

                                    leaf block {
                                        type yang:counter64;
                                        description "The number of web-service classifications which blocked the url for the subscriber's profile.";
                                    }

                                    leaf redirect {
                                        type yang:counter64;
                                        description "The number of web-service classifications which redirected the url for the subscriber's profile.";
                                    }

                                    leaf default-action {
                                        type yang:counter64;
                                        description
                                            "The number of times the web-service url-filter took the default-action due
                                             to the url filter's inability to send the request to the web-service server
                                             or due to receiving a malformed response from the web-service server.";
                                    }

                                } // container result

                            } // container statistics

                        } // container web-service

                    } // list esa

