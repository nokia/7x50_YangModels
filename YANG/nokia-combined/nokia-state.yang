                container subscriber-management {
                    description "Enter the subscriber-management context";

                    container wlan-gw {
                        description "Enter the wlan-gw context";

                        leaf in-use {
                            type boolean;
                            description "Whether WLAN Gateway functionalities are in use.";
                        }

                    } // container wlan-gw


                } // container subscriber-management

            } // container resource-usage

            container switch-fabric {
                description "Enter the switch-fabric context";

                container failure-recovery {
                    description "Enter the failure-recovery context";

                    leaf oper-state {
                        type enumeration {
                            enum disabled                       { value 0; }
                            enum hold-down                      { value 1; }
                            enum ready                          { value 2; }
                            enum recovery-in-progress           { value 3; }
                            enum detected-disabled              { value 4; }
                            enum detected-hold-down             { value 5; }
                            enum detected-xrs40-migration       { value 6; }
                            enum detected-sfm-upgrade-pending   { value 7; }
                        }
                        description
                            "Indicates the operational state of the automatic switch fabric
                             failure recovery process.";
                    }

                    list sfm {
                        key "sfm-slot";
                        description "Enter the sfm list instance";

                        leaf sfm-slot {
                            type leafref {
                                path "../../../../../sfm/sfm-slot";
                            }
                            description
                                "The unique value which identifies this SFM slot within a
                                 chassis in the system.";
                        }

                        leaf state {
                            type enumeration {
                                enum complete                       { value 0; }
                                enum in-progress                    { value 1; }
                                enum pending                        { value 2; }
                                enum aborted                        { value 3; }
                                enum failed                         { value 4; }
                            }
                            description
                                "Indicates the current state of the SFM in the automatic
                                 switch fabric recovery process.

                                 Values:
                                     complete    - this SFM has already been reset as part of
                                                   the recovery process
                                     in-progress - this SFM is currently being reset
                                     pending     - this SFM has not yet been reset
                                     aborted     - the recovery was aborted before this SFM
                                                   was processed
                                     failed      - the SFM has not successfully completed";
                        }

                        leaf state-time {
                            type yang:date-and-time;
                            description "Indicates the date and time the state changed.";
                        }

                    } // list sfm

                } // container failure-recovery

                list utilization {
                    key "card-slot fp-number sample-period";
                    description "Enter the utilization list instance";

                    leaf card-slot {
                        type union {
                            type types-card:iom-card-slot;
                            type types-card:cpm-card-slot;
                        }
                        description "The IOM or CPM slot.";
                    }

                    leaf fp-number {
                        type uint32;
                        description "The forwarding plane number. This value is 0 for a CPM slot.";
                    }

                    leaf sample-period {
                        type types-sros:time-duration {
                            range "60|300";
                        }
                        units "seconds";
                        description "The sample time to collect switch fabric utilization information.";
                    }

                    leaf usage {
                        type uint32 {
                            range "0..100";
                        }
                        units "percent";
                        description "The switch fabric usage.";
                    }

                } // list utilization

            } // container switch-fabric

            container last-reboot {
                description "Enter the last-reboot context";

                leaf reason {
                    type enumeration {
                        enum admin                          { value 1; }
                        enum other                          { value 2; }
                    }
                    description "Indicates whether the last reboot was due to admin action.";
                }

                leaf user {
                    type types-sros:named-item-or-empty;
                    description "The unique identifier of the user who initiated the last reboot.";
                }

                leaf router {
                    type types-sros:router-instance-base-management-vprn-loose;
                    description
                        "Router-instance of the management session which initiated the last
                         reboot command.";
                }

                leaf ip-address {
                    type types-sros:ip-address;
                    description
                        "Ip-address sourcing the management session which initiated the last
                         reboot command.";
                }

                leaf time {
                    type yang:date-and-time;
                    description "The date and time the last reboot was initiated.";
                }

            } // container last-reboot

            container bluetooth {
                description "Enter the bluetooth context";

                list module {
                    key "cpm-slot";
                    description "Enter the module list instance";

                    leaf cpm-slot {
                        type types-card:cpm-card-slot;
                        description "CPM slot on which the module resides.";
                    }

                    leaf identifier {
                        type types-sros:display-string {
                            length "1..32";
                        }
                        description "The identifier to be used for broadcasting the module.";
                    }

                    leaf remote-device-connection {
                        type boolean;
                        description
                            "Whether a remote client Bluetooth device is currently connected with
                             this Bluetooth module.";
                    }

                    leaf remote-device-mac-address {
                        type yang:mac-address;
                        description "The remote client Bluetooth device MAC address, if connection exists.";
                    }

                } // list module

            } // container bluetooth

            container bootup {
                description "Enter the bootup context";

                leaf bof-source {
                    type types-sros:display-string-or-empty;
                    description
                        "The compact flash slot where the Boot Options File (BOF) file
                         was found when the system last rebooted.";
                }

                leaf image-source {
                    type enumeration {
                        enum unknown                        { value 0; }
                        enum primary                        { value 1; }
                        enum secondary                      { value 2; }
                        enum tertiary                       { value 3; }
                    }
                    description
                        "The location in the BOF where the software image file was found
                         when the system last rebooted.";
                }

                leaf config-source {
                    type enumeration {
                        enum unknown                        { value 0; }
                        enum primary                        { value 1; }
                        enum secondary                      { value 2; }
                        enum tertiary                       { value 3; }
                    }
                    description
                        "The location in the BOF where the configuration file was found
                         when the system last rebooted.";
                }

                leaf last-booted-config-file {
                    type types-sros:display-string-or-empty;
                    description
                        "The location and name of the configuration file from which
                         the system last rebooted.";
                }

                leaf last-boot-config-version {
                    type types-sros:description-or-empty;
                    description
                        "The version of the configuration file from which the system
                         last rebooted.";
                }

                leaf last-boot-config-header {
                    type string {
                        length "1..512";
                    }
                    description
                        "The header of the configuration file from which the system
                         last rebooted.";
                }

                leaf last-boot-index-version {
                    type types-sros:description-or-empty;
                    description
                        "The version of the index file read when this CPM card was
                         last rebooted.";
                }

                leaf last-boot-index-header {
                    type string {
                        length "1..512";
                    }
                    description
                        "The header of the index file from which the system
                         last rebooted.";
                }

                leaf config-status {
                    type enumeration {
                        enum config-read                    { value 1; }
                        enum config-ok                      { value 2; }
                        enum default-booted                 { value 3; }
                        enum boot-config-failed             { value 4; }
                        enum boot-restore-failed            { value 5; }
                        enum auto-provisioning              { value 6; }
                    }
                    description
                        "Indicates the result of the last attempt to execute
                         the configuration file upon reboot of the system.";
                }

                leaf persist-status {
                    type enumeration {
                        enum persist-ok                     { value 1; }
                        enum no-persist-file                { value 2; }
                        enum persist-mismatch               { value 3; }
                        enum persist-index-failure          { value 4; }
                        enum persist-disabled               { value 5; }
                        enum persist-invalid                { value 6; }
                        enum persist-boot                   { value 7; }
                        enum persist-init                   { value 8; }
                        enum persist-in-progress            { value 9; }
                    }
                    description
                        "Indicates the state of the rebuild of the SNMP persistent index
                         database upon reboot of the system.";
                }

                leaf persist-index {
                    type boolean;
                    description
                        "When index has a value of 'true', the SNMP persistent index
                         database was rebuilt when the system was rebooted.
                         When index has a value of 'false' the system was reconfigured
                         without maintaining persistent SNMP index values and the SNMP
                         daemon was enabled.";
                }

            } // container bootup

            container central-frequency-clock {
                description "Enter the central-frequency-clock context";

                list cpm {
                    key "cpm-slot";
                    description "Enter the cpm list instance";

                    leaf cpm-slot {
