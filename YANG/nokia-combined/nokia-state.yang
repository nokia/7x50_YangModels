                                             with this filter.";
                                    }

                                    list entry {
                                        key "entry-id";
                                        description "Enter the entry list instance";

                                        leaf entry-id {
                                            type types-filter:entry-id;
                                            description
                                                "This is the secondary index for the entry. Filters can have multiple entries. Each
                                                 entry is identified by the respective filter-id and entry-id.

                                                 Refer to the description of entry-id for more info on the allowed values for this
                                                 object.";
                                        }

                                    } // list entry

                                } // list ipv6-filter

                                list mac-filter {
                                    key "filter-name";
                                    description "Enter the mac-filter list instance";

                                    leaf filter-name {
                                        type types-filter:filter-name;
                                        description
