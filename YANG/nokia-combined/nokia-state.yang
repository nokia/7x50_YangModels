                    container local-filtering {
                        description "Enter the local-filtering context";

                        list deny-list {
                            key "url-list-name";
                            description "Enter the deny-list list instance";

                            leaf url-list-name {
                                type leafref {
                                    path "../../../../url-list/url-list-name";
                                }
                                description "Specifies the name which uniquely identifies a URL list within AA group.";
                            }

                            list esa {
                                key "esa-id vm";
                                description "Enter the esa list instance";

                                leaf esa-id {
                                    type types-esa:esa-id;
                                    description "Specifies an ESA identifier.";
                                }

                                leaf vm {
                                    type types-esa:vm-id;
                                    description "Specifies the VM identifier within the ESA.";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf lookup {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups.";
                                    }

                                    leaf match {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups that matched and were blocked/redirected.";
                                    }

                                    leaf default-action {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups that could not be performed and took the default-action.";
                                    }

                                } // container statistics

                            } // list esa

                            list isa {
                                key "mda-id";
                                description "Enter the isa list instance";

                                leaf mda-id {
                                    type types-isa:slot-mda;
                                    description "Specifies an MDA/ISA identifier <card slot number>/<mda slot number>";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf lookup {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups.";
                                    }

                                    leaf match {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups that matched and were blocked/redirected.";
                                    }

                                    leaf default-action {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups that could not be performed and took the default-action.";
                                    }

                                } // container statistics

                            } // list isa

                            container summary {
                                description "Enter the summary context";

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf lookup {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups.";
                                    }

                                    leaf match {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups that matched and were blocked/redirected.";
                                    }

                                    leaf default-action {
                                        type yang:counter64;
                                        description "The number of url-list URL lookups that could not be performed and took the default-action.";
                                    }

                                } // container statistics

                            } // container summary

                        } // list deny-list

                    } // container local-filtering

                    container icap {
                        description "Enter the icap context";

                        list server {
                            key "ip-address port";
                            description "Enter the server list instance";

                            leaf ip-address {
                                type types-sros:ip-unicast-address;
                                description "Specifies the AA ICAP server IP address. IPv6 is not supported in this release.";
                            }

                            leaf port {
                                type types-sros:tcp-udp-port-non-zero;
                                description "Specifies the AA ICAP server port.";
                            }

                            list esa {
                                key "esa-id vm";
                                description "Enter the esa list instance";

                                leaf esa-id {
                                    type types-esa:esa-id;
                                    description "Specifies an ESA identifier.";
                                }

                                leaf vm {
                                    type types-esa:vm-id;
                                    description "Specifies the VM identifier within the ESA.";
                                }

                                leaf oper-state {
                                    type types-sros:oper-state;
                                    description "The operational state of the ICAP server.";
                                }

                                leaf oper-flags {
                                    type bits {
                                        bit admin-down                     { position 0; }
                                        bit tcp-conn-error                 { position 1; }
                                    }
                                    description "The different conditions that affect the operating status of an ICAP server.";
                                }

                                leaf allowed-connections {
                                    type uint32;
                                    description "The maximum number of TCP connections which can be established with the ICAP server.";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf established-connections {
                                        type yang:gauge32;
                                        description "The current number of TCP connections which are established with the ICAP server.";
                                    }

                                    leaf connection-utilization {
                                        type yang:gauge32 {
                                            range "0..100";
                                        }
                                        units "percent";
                                        description "The percentage of TCP connections utilized over the last 10 second period.";
                                    }

                                    leaf round-trip-time {
                                        type yang:gauge32;
                                        units "microseconds";
                                        description "The average amount of time it took to receive ICAP Responses over the last 10 second period.";
                                    }

                                    leaf request-rate {
                                        type yang:gauge32;
                                        description "The average number of ICAP requests sent per second over the last 10 second period.";
                                    }

                                    leaf icap-requests {
                                        type yang:counter64;
                                        description "The number of HTTP requests received.";
                                    }

                                    leaf icap-request-errors {
                                        type yang:counter64;
                                        description "The number of times the HTTP request that were unable to be sent to the ICAP server.";
                                    }

                                    container icap-response {
                                        description "Enter the icap-response context";

                                        leaf allow {
                                            type yang:counter64;
                                            description "The number of ICAP allow responses which have been received from the ICAP server.";
                                        }

                                        leaf block {
                                            type yang:counter64;
                                            description "The number of ICAP block responses which have been received from the ICAP server.";
                                        }

                                        leaf redirect {
                                            type yang:counter64;
                                            description "The number of ICAP redirect responses which have been received from the ICAP server.";
                                        }

                                    } // container icap-response

                                } // container statistics

                            } // list esa

                            list isa {
                                key "mda-id";
                                description "Enter the isa list instance";

                                leaf mda-id {
                                    type types-isa:slot-mda;
                                    description "Specifies an MDA/ISA identifier <card slot number>/<mda slot number>";
                                }

                                leaf oper-state {
                                    type types-sros:oper-state;
                                    description "The operational state of the ICAP server.";
                                }

                                leaf oper-flags {
                                    type bits {
                                        bit admin-down                     { position 0; }
                                        bit tcp-conn-error                 { position 1; }
                                    }
                                    description "The different conditions that affect the operating status of an ICAP server.";
                                }

                                leaf allowed-connections {
                                    type uint32;
                                    description "The maximum number of TCP connections which can be established with the ICAP server.";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf established-connections {
                                        type yang:gauge32;
                                        description "The current number of TCP connections which are established with the ICAP server.";
                                    }

                                    leaf connection-utilization {
                                        type yang:gauge32 {
                                            range "0..100";
                                        }
                                        units "percent";
                                        description "The percentage of TCP connections utilized over the last 10 second period.";
                                    }

                                    leaf round-trip-time {
                                        type yang:gauge32;
                                        units "microseconds";
                                        description "The average amount of time it took to receive ICAP Responses over the last 10 second period.";
                                    }

                                    leaf request-rate {
                                        type yang:gauge32;
                                        description "The average number of ICAP requests sent per second over the last 10 second period.";
                                    }

                                    leaf icap-requests {
                                        type yang:counter64;
                                        description "The number of HTTP requests received.";
                                    }

                                    leaf icap-request-errors {
                                        type yang:counter64;
                                        description "The number of times the HTTP request that were unable to be sent to the ICAP server.";
                                    }

                                    container icap-response {
                                        description "Enter the icap-response context";

                                        leaf allow {
                                            type yang:counter64;
                                            description "The number of ICAP allow responses which have been received from the ICAP server.";
                                        }

                                        leaf block {
                                            type yang:counter64;
                                            description "The number of ICAP block responses which have been received from the ICAP server.";
                                        }

                                        leaf redirect {
                                            type yang:counter64;
                                            description "The number of ICAP redirect responses which have been received from the ICAP server.";
                                        }

                                    } // container icap-response

                                } // container statistics

                            } // list isa

                            container summary {
                                description "Enter the summary context";

                                leaf oper-state {
                                    type types-sros:oper-state;
                                    description "The operational state of the ICAP server.";
                                }

                                leaf oper-flags {
                                    type bits {
                                        bit admin-down                     { position 0; }
                                        bit tcp-conn-error                 { position 1; }
                                    }
                                    description "The different conditions that affect the operating status of an ICAP server.";
                                }

                                leaf allowed-connections {
                                    type uint32;
                                    description "The maximum number of TCP connections which can be established with the ICAP server.";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf established-connections {
                                        type yang:gauge32;
                                        description "The current number of TCP connections which are established with the ICAP server.";
                                    }

                                    leaf connection-utilization {
                                        type yang:gauge32 {
                                            range "0..100";
                                        }
                                        units "percent";
                                        description "The percentage of TCP connections utilized over the last 10 second period.";
                                    }

                                    leaf round-trip-time {
                                        type yang:gauge32;
                                        units "microseconds";
                                        description "The average amount of time it took to receive ICAP Responses over the last 10 second period.";
                                    }

                                    leaf request-rate {
                                        type yang:gauge32;
                                        description "The average number of ICAP requests sent per second over the last 10 second period.";
                                    }

                                    leaf icap-requests {
                                        type yang:counter64;
                                        description "The number of HTTP requests received.";
                                    }

                                    leaf icap-request-errors {
                                        type yang:counter64;
                                        description "The number of times the HTTP request that were unable to be sent to the ICAP server.";
                                    }

                                    container icap-response {
                                        description "Enter the icap-response context";

                                        leaf allow {
                                            type yang:counter64;
                                            description "The number of ICAP allow responses which have been received from the ICAP server.";
                                        }

                                        leaf block {
                                            type yang:counter64;
                                            description "The number of ICAP block responses which have been received from the ICAP server.";
                                        }

                                        leaf redirect {
                                            type yang:counter64;
                                            description "The number of ICAP redirect responses which have been received from the ICAP server.";
                                        }

                                    } // container icap-response

                                } // container statistics

                            } // container summary

                        } // list server

                    } // container icap

                    container web-service {
                        description "Enter the web-service context";

                        list server {
                            key "ip-address port";
                            description "Enter the server list instance";

                            leaf ip-address {
                                type types-sros:ip-unicast-address;
                                description "Specifies the AA web-service server IP address. IPv6 is not supported in this release.";
                            }

                            leaf port {
                                type types-sros:tcp-udp-port-non-zero;
                                description "Specifies the AA w3eb-service server port.";
                            }

                            list esa {
                                key "esa-id vm";
                                description "Enter the esa list instance";

                                leaf esa-id {
                                    type types-esa:esa-id;
                                    description "Specifies an ESA identifier.";
                                }

                                leaf vm {
                                    type types-esa:vm-id;
                                    description "Specifies the VM identifier within the ESA.";
                                }

                                leaf oper-state {
                                    type types-sros:oper-state;
                                    description "The operational state of the web-service server.";
                                }

                                leaf oper-flags {
                                    type bits {
                                        bit admin-down                     { position 0; }
                                        bit tcp-conn-error                 { position 1; }
                                    }
                                    description "The different conditions that affect the operating status of a web-service server.";
                                }

                                leaf allowed-connections {
                                    type uint32;
                                    description "The maximum number of TCP connections which can be established with the web-service server.";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf established-connections {
                                        type yang:gauge32;
                                        description "The current number of TCP connections which are established with the web-service server.";
                                    }

                                    leaf request-rate {
                                        type yang:gauge32;
                                        description "The average number of web-service requests sent per second over the last 10 second period.";
                                    }

                                    leaf requests {
                                        type yang:counter64;
                                        description "The number of URL classification requests sent to the server.";
                                    }

                                    leaf request-errors {
                                        type yang:counter64;
                                        description "The number of times the URL classification request was unable to be sent to the server.";
                                    }

                                    leaf responses {
                                        type yang:counter64;
                                        description "The number of successful URL classification responses received from the server.";
                                    }

                                    leaf response-errors {
                                        type yang:counter64;
                                        description "The number of errored URL classification responses from the server.";
                                    }

                                    leaf round-trip-time {
                                        type yang:gauge32;
                                        units "microseconds";
                                        description "The average amount of time it took to receive web-service responses over the last 10 second period.";
                                    }

                                } // container statistics

                            } // list esa

                            list isa {
                                key "mda-id";
                                description "Enter the isa list instance";

                                leaf mda-id {
                                    type types-isa:slot-mda;
                                    description "Specifies an MDA/ISA identifier <card slot number>/<mda slot number>";
                                }

                                leaf oper-state {
                                    type types-sros:oper-state;
                                    description "The operational state of the web-service server.";
                                }

                                leaf oper-flags {
                                    type bits {
                                        bit admin-down                     { position 0; }
                                        bit tcp-conn-error                 { position 1; }
                                    }
                                    description "The different conditions that affect the operating status of a web-service server.";
                                }

                                leaf allowed-connections {
                                    type uint32;
                                    description "The maximum number of TCP connections which can be established with the web-service server.";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf established-connections {
                                        type yang:gauge32;
                                        description "The current number of TCP connections which are established with the web-service server.";
                                    }

                                    leaf request-rate {
                                        type yang:gauge32;
                                        description "The average number of web-service requests sent per second over the last 10 second period.";
                                    }

                                    leaf requests {
                                        type yang:counter64;
                                        description "The number of URL classification requests sent to the server.";
                                    }

                                    leaf request-errors {
                                        type yang:counter64;
                                        description "The number of times the URL classification request was unable to be sent to the server.";
                                    }

                                    leaf responses {
                                        type yang:counter64;
                                        description "The number of successful URL classification responses received from the server.";
                                    }

                                    leaf response-errors {
                                        type yang:counter64;
                                        description "The number of errored URL classification responses from the server.";
                                    }

                                    leaf round-trip-time {
                                        type yang:gauge32;
                                        units "microseconds";
                                        description "The average amount of time it took to receive web-service responses over the last 10 second period.";
                                    }

                                } // container statistics

                            } // list isa

                            container summary {
                                description "Enter the summary context";

                                leaf oper-state {
                                    type types-sros:oper-state;
                                    description "The operational state of the web-service server.";
                                }

                                leaf oper-flags {
                                    type bits {
                                        bit admin-down                     { position 0; }
                                        bit tcp-conn-error                 { position 1; }
                                    }
                                    description "The different conditions that affect the operating status of a web-service server.";
                                }

                                leaf allowed-connections {
                                    type uint32;
                                    description "The maximum number of TCP connections which can be established with the web-service server.";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf established-connections {
                                        type yang:gauge32;
                                        description "The current number of TCP connections which are established with the web-service server.";
                                    }

                                    leaf request-rate {
                                        type yang:gauge32;
                                        description "The average number of web-service requests sent per second over the last 10 second period.";
                                    }

                                    leaf requests {
                                        type yang:counter64;
                                        description "The number of URL classification requests sent to the server.";
                                    }

                                    leaf request-errors {
                                        type yang:counter64;
                                        description "The number of times the URL classification request was unable to be sent to the server.";
                                    }

                                    leaf responses {
                                        type yang:counter64;
                                        description "The number of successful URL classification responses received from the server.";
                                    }

                                    leaf response-errors {
                                        type yang:counter64;
                                        description "The number of errored URL classification responses from the server.";
                                    }

                                    leaf round-trip-time {
                                        type yang:gauge32;
                                        units "microseconds";
                                        description "The average amount of time it took to receive web-service responses over the last 10 second period.";
                                    }

                                } // container statistics

                            } // container summary

                        } // list server

                    } // container web-service

                } // list url-filter

                container policer {
                    description "Enter the policer context";


                    list dual-bucket-bandwidth-policer {
                        key "policer-name";
                        description "Enter the dual-bucket-bandwidth-policer list instance";

                        leaf policer-name {
                            type types-sros:named-item;
                            description "Specifies the name that uniquely identifies a policer within an AA group.";
                        }

                        leaf oper-mbs {
                            type types-aa:policer-burst-size;
                            description "The current operational maximum burst size (MBS) value.";
                        }

                        leaf oper-pir {
                            type types-aa:policer-ir;
                            description "The current operational peak information rate (PIR) value.";
                        }

                        leaf oper-cbs {
                            type types-aa:policer-burst-size;
                            description "The current operational committed burst size when the ANL, to which the subscriber belongs, is in a congested state.";
                        }

                        leaf oper-cir {
                            type types-aa:policer-cir;
                            description "The current operational committed information rate (CIR) value.";
                        }

                    } // list dual-bucket-bandwidth-policer

                    list flow-bandwidth-policer {
                        key "policer-name";
                        description "Enter the flow-bandwidth-policer list instance";

                        leaf policer-name {
                            type types-sros:named-item;
                            description "Specifies the name that uniquely identifies a policer within an AA group.";
                        }

                        leaf oper-mbs {
                            type types-aa:policer-burst-size;
                            description "The current operational maximum burst size (MBS) value.";
                        }

                        leaf oper-pir {
                            type types-aa:policer-ir;
                            description "The current operational peak information rate (PIR) value.";
                        }

                    } // list flow-bandwidth-policer

                    list flow-count-limit-policer {
                        key "policer-name";
                        description "Enter the flow-count-limit-policer list instance";

                        leaf policer-name {
                            type types-sros:named-item;
                            description "Specifies the name that uniquely identifies a policer within an AA group.";
                        }

                        leaf oper-peak-flow-count {
                            type types-aa:policer-flow-count-limit;
                            description "The current operational peak flow count limit value.";
                        }

                    } // list flow-count-limit-policer

                    list flow-setup-rate-policer {
                        key "policer-name";
                        description "Enter the flow-setup-rate-policer list instance";

                        leaf policer-name {
                            type types-sros:named-item;
                            description "Specifies the name that uniquely identifies a policer within an AA group.";
                        }

                        leaf oper-peak-flow-setup-rate {
                            type types-aa:policer-flow-rate;
                            description "The current operational peak flow rate value.";
                        }

                        leaf oper-flow-setup-rate-burst-size {
                            type types-aa:policer-flow-burst-size;
                            description "The current operational maximum flow burst value.";
                        }

                    } // list flow-setup-rate-policer

                    list single-bucket-bandwidth-policer {
                        key "policer-name";
                        description "Enter the single-bucket-bandwidth-policer list instance";

                        leaf policer-name {
                            type types-sros:named-item;
                            description "Specifies the name that uniquely identifies a policer within an AA group.";
                        }

                        leaf oper-mbs {
                            type types-aa:policer-burst-size;
                            description "The current operational maximum burst size (MBS) value.";
                        }

                        leaf oper-pir {
                            type types-aa:policer-ir;
                            description "The current operational peak information rate (PIR) value.";
                        }

                    } // list single-bucket-bandwidth-policer

                } // container policer

                list partition {
                    key "aa-partition-id";
                    description "Enter the partition list instance";

                    leaf aa-partition-id {
                        type types-aa:aa-grp-part-id;
                        description "The identifier which uniquely identifies the partition within the parent AA group.";
                    }

                    list aa-sub {
                        key "aa-sub-type aa-sub-name";
                        description "Enter the aa-sub list instance";

                        leaf aa-sub-type {
                            type types-aa:stats-aa-sub-type;
                            description "Specifies the AA subscriber type for statistics.";
                        }

                        leaf aa-sub-name {
                            type union {
                                type types-sros:sap;
                                type types-services:sdp-bind-id;
                                type types-sros:named-item;
                            }
                            description "Specifies AA subscriber identifier string.";
                        }

                        leaf has-overrides {
                            type boolean;
                            description "Indicates if the subscriber has policy overrides.";
                        }

                        leaf circuit-id {
                            type types-sros:display-string-or-empty {
                                length "0..64";
                            }
                            description "Indicates if the subscriber has policy overrides.";
                        }

                        leaf remote-id {
                            type types-sros:display-string-or-empty {
                                length "0..64";
                            }
                            description "Indicates if the subscriber has policy overrides.";
                        }

                        leaf isa-assigned {
                            type types-isa:slot-mda;
                            description "Specifies an MDA/ISA identifier <card slot number>/<mda slot number>";
                        }

                        leaf esa-assigned {
                            type types-esa:esa-id;
                            description "Specifies an ESA identifier";
                        }

                        leaf esa-vm-assigned {
                            type types-esa:vm-id;
                            description "Specifies an ESA VM identifier";
                        }

                        leaf app-profile-name {
                            type types-sros:named-item;
                            description "The name of the ISA-AA application profile associated with the subscriber.";
                        }

                        leaf aarp-id {
                            type types-services:bsx-aarp-id;
                            description "The AARP instance id to which this subscriber belongs.";
                        }

                        leaf quarantined {
                            type boolean;
                            description "Indicates if the subscriber is currently quarantined.";
                        }

                        leaf http-url-parameters {
                            type types-sros:http-redirect-url {
                                length "1..32";
                            }
                            description "The HTTP URL Parameters associated with this subscriber.";
                        }

                        leaf last-http-notified {
                            type yang:date-and-time;
                            description "Indicates when the last HTTP Notification occurred for this subscriber.";
                        }

                        leaf sap {
                            type types-sros:sap;
                            description "The VLAN ID on which the ISA-AA is expected to be emitting traffic.";
                        }

                        leaf mac {
                            type yang:mac-address;
                            description "The MAC address of the subscriber.";
                        }

                        leaf transit-ip-policy-id {
                            type uint32 {
                                range "1..65535";
                            }
                            description "Specifies the transit ip policy to which this subscriber belongs.";
                        }

                        leaf transit-prefix-policy-id {
                            type uint32 {
                                range "1..65535";
                            }
                            description "Specifies the transit prefix policy to which this subscriber belongs.";
                        }

                        leaf imsi {
                            type types-sros:display-string-or-empty {
                                length "0..15";
                            }
                            description "Indicates the International Mobile Subscriber Identity (IMSI) of this subscriber.";
                        }

                        leaf imei {
                            type types-sros:display-string-or-empty {
                                length "0..16";
                            }
                            description "Indicates the International Mobile Equipment Identity (IMEI) of this subscriber.";
                        }

                        leaf msisdn {
                            type types-sros:display-string-or-empty {
                                length "0..15";
                            }
                            description "Indicates the Mobile Subscriber Integrated Services Digital Network (MSISDN) number of this subscriber.";
                        }

                        leaf apn {
                            type types-sros:display-string-or-empty {
                                length "0..100";
                            }
                            description "Indicates the Access Point Name (APN) of this subscriber.";
                        }

                        leaf user-location {
                            type types-sros:display-string-or-empty {
                                length "0..255";
                            }
                            description "Indicates the mobile User Location Information (ULI) of this subscriber.";
                        }

                        leaf rat-type {
                            type types-aa:mobile-rat-type;
                            description "Indicates the Radio Access Technology (RAT) type of this subscriber";
                        }

                        leaf charging-id {
                            type uint32;
                            description "Indicates the mobile charging ID of this subscriber.";
                        }

                        leaf billing-type {
                            type uint32;
                            description "Indicates the mobile billing type of this subscriber.";
                        }

                        leaf plmn-id {
                            type uint32;
                            description "Indicates the Public Land Mobile Network (PLMN) of this subscriber.";
                        }

                        leaf pdn-gateway-addr {
                            type types-sros:ip-address;
                            description "Indicates the address of the connected PDN gateway interface of this subscriber.";
                        }

                        leaf pdn-gateway-addr-type {
                            type enumeration {
                                enum unknown                        { value 0; }
                                enum ipv4                           { value 1; }
                                enum ipv6                           { value 2; }
                                enum ipv4z                          { value 3; }
                                enum ipv6z                          { value 4; }
                                enum dns                            { value 16; }
                            }
                            description "Indicates the type of pdn-gateway-addr of this subscriber.";
                        }

                        leaf traffic-dist-by-ip {
                            type boolean;
                            description "Indicates whether the subscriber traffic is distributed by IP.";
                        }

                        leaf qci {
                            type uint32;
                            description "Indicates the QCI for this fixed wireless access subscriber.";
                        }

                        leaf slice-identifier {
                            type uint32;
                            description "Indicates the mobile network slice identifier for this fixed wireless access subscriber.";
                        }

                        leaf mme-amf-address {
                            type types-sros:ip-address;
                            description "Indicates the IP address of the MME (4G) or AMF (5G) for this fixed wireless access subscriber.";
                        }

                        leaf policy-rule-name {
                            type types-sros:display-string-or-empty {
                                length "0..64";
                            }
                            description "Indicates the policy rule name for this fixed wireless access subscriber.";
                        }

                        leaf content-filter-policy-id {
                            type uint32;
                            description "Indicates the content filtering policy identifier for this fixed wireless access subscriber.";
                        }

                        list characteristic {
                            key "characteristic-name";
                            description "Enter the characteristic list instance";

                            leaf characteristic-name {
                                type types-sros:named-item;
                                description "Specifies an AA partition policy ASO characteristic name.";
                            }

                            leaf value {
                                type types-sros:named-item;
                                description "Specifies an AA partition policy ASO characteristic name.";
                            }

                            leaf derived-from {
                                type types-aa:aso-val-derived-from;
                                description "Indicates from where the characteristic value is derived from for the Application Assurance subscriber.";
                            }

                        } // list characteristic

                        list policer {
                            key "policer-type direction index";
                            description "Enter the policer list instance";

                            leaf policer-type {
                                type types-aa:policer-type;
                                description
                                    "Indicates if the policer being applied to the subscriber is a bandwidth,
                                     flow rate, or a flow count policer.";
                            }

                            leaf direction {
                                type types-aa:traffic-direction;
                                description "The traffic direction of the policer being applied to the subscriber.";
                            }

                            leaf index {
                                type uint32 {
                                    range "1..4096";
                                }
                                description "Indicates the index into a list of policers being applied to the subscriber.";
                            }

                            leaf applied-policer {
                                type types-sros:named-item;
                                description "The policer name being applied to the subscriber.";
                            }

                            leaf aqp-entry {
                                type uint32 {
                                    range "1..max";
                                }
                                description "The entry-id that references the policer.";
                            }

                        } // list policer

                        list statistics-scope {
                            key "stats-scope";
                            description "Enter the statistics-scope list instance";

                            leaf stats-scope {
                                type types-aa:stats-scope;
                                description "Specifies to provide stats from most recent snapshot of closed flows or all-flows including realtime information from active flows.";
                            }

                            leaf tethering-state {
                                type types-aa:sub-tether-state;
                                description "The tethering state of an Application Assurance Subscriber.";
                            }

                            container statistics {
                                description "Enter the statistics context";

                                container sub-to-net {
                                    description "Enter the sub-to-net context";

                                    leaf active-flows {
                                        type yang:counter32;
                                        description "Number of allowed flows in the subscriber to network direction that are active.";
                                    }

                                    container admitted {
                                        description "Enter the admitted context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "Number of bytes permitted for the subscriber to network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "Number of packets permitted for the subscriber to network direction.";
                                        }

                                        leaf flows {
                                            type yang:counter64;
                                            description "Number of flows permitted for the subscriber to network direction.";
                                        }

                                    } // container admitted

                                    container denied {
                                        description "Enter the denied context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "Number of bytes dropped for the subscriber to network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "Number of packets dropped for the subscriber to network direction.";
                                        }

                                        leaf flows {
                                            type yang:counter64;
                                            description "Number of flows that dropped subsequent packets in the subscriber to network direction.";
                                        }

                                    } // container denied

                                } // container sub-to-net

                                container net-to-sub {
                                    description "Enter the net-to-sub context";

                                    leaf active-flows {
                                        type yang:counter32;
                                        description "Number of allowed flows in the network to subscriber direction that are active.";
                                    }

                                    container admitted {
                                        description "Enter the admitted context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "Number of bytes permitted for the network to subscriber direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "Number of packets permitted for the network to subscriber direction.";
                                        }

                                        leaf flows {
                                            type yang:counter64;
                                            description "Number of flows permitted for the network to subscriber direction.";
                                        }

                                    } // container admitted

                                    container denied {
                                        description "Enter the denied context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "Number of bytes dropped for the network to subscriber direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "Number of packets dropped for the network to subscriber direction.";
                                        }

                                        leaf flows {
                                            type yang:counter64;
                                            description "Number of flows that dropped subsequent packets in the network to subscriber direction.";
                                        }

                                    } // container denied

                                } // container net-to-sub

                                container flow {
                                    description "Enter the flow context";

                                    leaf terminated {
                                        type yang:counter64;
                                        description "Number of allowed flows in both directions that have terminated.";
                                    }

                                    container duration {
                                        description "Enter the duration context";

                                        leaf short {
                                            type yang:counter64;
                                            description "Number of flows with a duration less than or equal to 30 seconds, that have completed.";
                                        }

                                        leaf medium {
                                            type yang:counter64;
                                            description "Number of flows with a duration less than or equal to 180 seconds, but greater than 30 seconds, that have completed.";
                                        }

                                        leaf long {
                                            type yang:counter64;
                                            description "Number of flows with a duration greater than 180 seconds, that have completed.";
                                        }

                                        leaf total {
                                            type yang:counter64;
                                            description "The sum of all flow durations from first packet seen to last packet seen for flows that have terminated.";
                                        }

                                    } // container duration

                                } // container flow

                            } // container statistics

                            list statistics-type {
                                key "stats-type stats-name";
                                description "Enter the statistics-type list instance";

                                leaf stats-type {
                                    type enumeration {
                                        enum protocol                       { value 1; }
                                        enum application                    { value 2; }
                                        enum app-group                      { value 3; }
                                        enum charging-group                 { value 4; }
                                    }
                                    description "Specifies the statistic type (protocol or application) that the study is using.";
                                }

                                leaf stats-name {
                                    type types-sros:named-item;
                                    description "Specifies the AA stats name of the correct type for which statistics are requested.";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    container sub-to-net {
                                        description "Enter the sub-to-net context";

                                        leaf active-flows {
                                            type yang:counter32;
                                            description "Number of allowed flows in the subscriber to network direction that are active.";
                                        }

                                        container admitted {
                                            description "Enter the admitted context";

                                            leaf octets {
                                                type yang:counter64;
                                                description "Number of bytes permitted for the subscriber to network direction.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                description "Number of packets permitted for the subscriber to network direction.";
                                            }

                                            leaf flows {
                                                type yang:counter64;
                                                description "Number of flows permitted for the subscriber to network direction.";
                                            }

                                        } // container admitted

                                        container denied {
                                            description "Enter the denied context";

                                            leaf octets {
                                                type yang:counter64;
                                                description "Number of bytes dropped for the subscriber to network direction.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                description "Number of packets dropped for the subscriber to network direction.";
                                            }

                                            leaf flows {
                                                type yang:counter64;
                                                description "Number of flows that dropped subsequent packets in the subscriber to network direction.";
                                            }

                                        } // container denied

                                    } // container sub-to-net

                                    container net-to-sub {
                                        description "Enter the net-to-sub context";

                                        leaf active-flows {
                                            type yang:counter32;
                                            description "Number of allowed flows in the network to subscriber direction that are active.";
                                        }

                                        container admitted {
                                            description "Enter the admitted context";

                                            leaf octets {
                                                type yang:counter64;
                                                description "Number of bytes permitted for the network to subscriber direction.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                description "Number of packets permitted for the network to subscriber direction.";
                                            }

                                            leaf flows {
                                                type yang:counter64;
                                                description "Number of flows permitted for the network to subscriber direction.";
                                            }

                                        } // container admitted

                                        container denied {
                                            description "Enter the denied context";

                                            leaf octets {
                                                type yang:counter64;
                                                description "Number of bytes dropped for the network to subscriber direction.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                description "Number of packets dropped for the network to subscriber direction.";
                                            }

                                            leaf flows {
                                                type yang:counter64;
                                                description "Number of flows that dropped subsequent packets in the network to subscriber direction.";
                                            }

                                        } // container denied

                                    } // container net-to-sub

                                    container flow {
                                        description "Enter the flow context";

                                        leaf terminated {
                                            type yang:counter64;
                                            description "Number of allowed flows in both directions that have terminated.";
                                        }

                                        container duration {
                                            description "Enter the duration context";

                                            leaf short {
                                                type yang:counter64;
                                                description "Number of flows with a duration less than or equal to 30 seconds, that have completed.";
                                            }

                                            leaf medium {
                                                type yang:counter64;
                                                description "Number of flows with a duration less than or equal to 180 seconds, but greater than 30 seconds, that have completed.";
                                            }

                                            leaf long {
                                                type yang:counter64;
                                                description "Number of flows with a duration greater than 180 seconds, that have completed.";
                                            }

                                            leaf total {
                                                type yang:counter64;
                                                description "The sum of all flow durations from first packet seen to last packet seen for flows that have terminated.";
                                            }

                                        } // container duration

                                    } // container flow

                                } // container statistics

                                container usage-monitoring {
                                    description "Enter the usage-monitoring context";

                                    leaf status {
                                        type types-aa:usage-monitor-oper-state;
                                        description "The operational state for the usage monitor.";
                                    }

                                    container net-to-sub {
                                        description "Enter the net-to-sub context";

                                        leaf grant-status {
                                            type types-aa:usage-monitor-grant-state;
                                            description "The grant status for the network to subscriber direction.";
                                        }

                                        container statistics {
                                            description "Enter the statistics context";

                                            leaf granted {
                                                type yang:counter64;
                                                description
                                                    "The amount of credits allocated by the policy server
                                                     for the network to subscriber direction.";
                                            }

                                            leaf used {
                                                type yang:counter64;
                                                description "The amount of credits used by the network to subscriber direction.";
                                            }

                                            leaf used-percent {
                                                type uint32 {
                                                    range "0..10000";
                                                }
                                                units "centipercent";
                                                description "The amount of credits used by the network to subscriber direction.";
                                            }

                                        } // container statistics

                                    } // container net-to-sub

                                    container sub-to-net {
                                        description "Enter the sub-to-net context";

                                        leaf grant-status {
                                            type types-aa:usage-monitor-grant-state;
                                            description "The grant status for the subscriber to network direction.";
                                        }

                                        container statistics {
                                            description "Enter the statistics context";

                                            leaf granted {
                                                type yang:counter64;
                                                description
                                                    "The amount of credits allocated by the policy server
                                                     for the subscriber to network direction.";
                                            }

                                            leaf used {
                                                type yang:counter64;
                                                description "The amount of credits used by the subscriber to network direction.";
                                            }

                                            leaf used-percent {
                                                type uint32 {
                                                    range "0..10000";
                                                }
                                                units "centipercent";
                                                description "The amount of credits used by the subscriber to network direction.";
                                            }

                                        } // container statistics

                                    } // container sub-to-net

                                    container both {
                                        description "Enter the both context";

                                        leaf grant-status {
                                            type types-aa:usage-monitor-grant-state;
                                            description "The grant status for either direction.";
                                        }

                                        container statistics {
                                            description "Enter the statistics context";

                                            leaf granted {
                                                type yang:counter64;
                                                description
                                                    "The amount of credits allocated by the policy server
                                                     for either direction.";
                                            }

                                            leaf used {
                                                type yang:counter64;
                                                description "The amount of credits used by either direction.";
                                            }

                                            leaf used-percent {
                                                type uint32 {
                                                    range "0..10000";
                                                }
                                                units "centipercent";
                                                description "The amount of credits used by either direction.";
                                            }

                                        } // container statistics

                                    } // container both

                                } // container usage-monitoring

                            } // list statistics-type

                        } // list statistics-scope

                    } // list aa-sub

