                                            type yang:counter64;
                                            description "The number of packets denied by the GTP filter due to a missing, invalid, or malformed information element.";
                                        }

                                        leaf gtpv2-message-type {
                                            type yang:counter64;
                                            description "The number of GTPv2 packets denied by the GTP filter due to GTPv2 message ID configuration for the gtp-filter.";
