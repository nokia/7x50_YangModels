                        container qos {
                            description "Enter the qos context";

                            container ingress {
                                description "Enter the ingress context";

                                list direction {
                                    key "direction queue-id";
                                    description "Enter the direction list instance";

                                    leaf direction {
                                        type types-aa:queue-traffic-direction;
                                        description "The traffic direction (net-to-sub or sub-to-net).";
                                    }

                                    leaf queue-id {
                                        type types-qos:ingress-queue-id;
                                        description "The ingress queue identifier.";
                                    }

                                    container statistics {
                                        description "Enter the statistics context";

                                        container in-profile-forwarded {
                                            description "Enter the in-profile-forwarded context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of in profile bytes diverted towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of in profile packets diverted towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container in-profile-forwarded

                                        container in-profile-dropped {
                                            description "Enter the in-profile-dropped context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of in profile bytes discarded towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of in profile packets discarded towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container in-profile-dropped

                                        container out-profile-forwarded {
                                            description "Enter the out-profile-forwarded context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of out of profile bytes diverted towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of out of profile packets diverted towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container out-profile-forwarded

                                        container out-profile-dropped {
                                            description "Enter the out-profile-dropped context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of out of profile bytes discarded towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of out of profile packets discarded towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container out-profile-dropped

                                    } // container statistics

                                } // list direction

                            } // container ingress

                            container egress {
                                description "Enter the egress context";

                                list direction {
                                    key "direction queue-id";
                                    description "Enter the direction list instance";

                                    leaf direction {
                                        type types-aa:queue-traffic-direction;
                                        description "The traffic direction (net-to-sub or sub-to-net).";
                                    }

                                    leaf queue-id {
                                        type types-qos:egress-queue-id;
                                        description "The ingress queue identifier.";
                                    }

                                    container statistics {
                                        description "Enter the statistics context";

                                        container in-profile-forwarded {
                                            description "Enter the in-profile-forwarded context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of in profile bytes diverted from ingress IOMs towards the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of in profile packets diverted from ingress IOMs towards the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container in-profile-forwarded

                                        container in-profile-dropped {
                                            description "Enter the in-profile-dropped context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of in profile bytes discarded from ingress IOMs towards the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of in profile packets discarded from ingress IOMs towards the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container in-profile-dropped

                                        container out-profile-forwarded {
                                            description "Enter the out-profile-forwarded context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of out of profile bytes diverted from ingress IOMs towards the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of out of profile packets diverted from ingress IOMs towards the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container out-profile-forwarded

                                        container out-profile-dropped {
                                            description "Enter the out-profile-dropped context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of out of profile bytes discarded from ingress IOMs towards the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of out of profile packets discarded from ingress IOMs towards the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container out-profile-dropped

                                    } // container statistics

                                } // list direction

                            } // container egress

                        } // container qos

                        container traffic {
                            description "Enter the traffic context";

                            container statistics {
                                description "Enter the statistics context";

                                container sub-to-net {
                                    description "Enter the sub-to-net context";

                                    container tcp-total {
                                        description "Enter the tcp-total context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of TCP total octets in the subscriber to network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "The number of TCP total packets in the subscriber to network direction.";
                                        }

                                    } // container tcp-total

                                    container tcp-retransmissions {
                                        description "Enter the tcp-retransmissions context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of retransmitted TCP octets in the subscriber to network direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "The number of retransmitted TCP packets in the subscriber to network direction.";
                                        }

                                    } // container tcp-retransmissions

                                } // container sub-to-net

                                container net-to-sub {
                                    description "Enter the net-to-sub context";

                                    container tcp-total {
                                        description "Enter the tcp-total context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of TCP total octets in the network to subscriber direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "The number of TCP total packets in the network to subscriber direction.";
                                        }

                                    } // container tcp-total

                                    container tcp-retransmissions {
                                        description "Enter the tcp-retransmissions context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of retransmitted TCP octets in the network to subscriber direction.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            description "The number of retransmitted TCP packets in the network to subscriber direction.";
                                        }

                                    } // container tcp-retransmissions

                                } // container net-to-sub

                            } // container statistics

                        } // container traffic

                    } // list isa

                    container summary {
                        description "Enter the summary context";

                        leaf max-flow-resources {
                            type yang:gauge32;
                            units "flows";
                            description "The maximum number of flow resources on the ISA-AA MDA(s).";
                        }

                        container statistics {
                            description "Enter the statistics context";

                            leaf flows {
                                type yang:counter64;
                                units "flows";
                                description "The total number of flows created on the ISA-AA MDA(s).";
                            }

                            leaf aa-subscribers-created {
                                type yang:counter64;
                                description "The number of subscribers created.";
                            }

                            leaf aa-subscribers-deleted {
                                type yang:counter64;
                                description "The number of subscribers deleted.";
                            }

                            leaf aa-subscribers-modified {
                                type yang:counter64;
                                description "The number of subscribers modified.";
                            }

                            leaf aa-subscribers-quarantined {
                                type yang:counter64;
                                description "The number of subscribers quarantined.";
                            }

                            leaf seen-ip-requests-sent {
                                type yang:counter64;
                                description
                                    "The number of requests sent from the ISA-AA MDA to initiate dynamic transit subscriber creation when traffic
                                     is detected on a parent SAP or Spoke SDP.";
                            }

                            leaf seen-ip-requests-dropped {
                                type yang:counter64;
                                description "The number of Seen IP requests dropped by the ISA-AA MDA due to congestion control mechanisms.";
                            }

                            container diverted-discards {
                                description "Enter the diverted-discards context";

                                container congestion {
                                    description "Enter the congestion context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes discarded by the IOMs prior to the ISA-AA MDA(s) due to egress IOM congestion.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets discarded by the IOMs prior to the ISA-AA MDA(s) due to egress IOM congestion.";
                                    }

                                } // container congestion

                                container errors {
                                    description "Enter the errors context";

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets discarded by the egress P-chip due to errors in the packets.";
                                    }

                                } // container errors

                            } // container diverted-discards

                            container returned-discards {
                                description "Enter the returned-discards context";

                                container congestion {
                                    description "Enter the congestion context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes discarded by the IOMs after the ISA-AA MDA(s) due to ingress IOM congestion.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets discarded by the IOMs after the ISA-AA MDA(s) due to ingress IOM congestion.";
                                    }

                                } // container congestion

                                container errors {
                                    description "Enter the errors context";

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets discarded due to an error detected by the P-chip while attempting to return the packet to the normal forwarding path.";
                                    }

                                } // container errors

                            } // container returned-discards

                            container congestion-discards {
                                description "Enter the congestion-discards context";

                                leaf octets {
                                    type yang:counter64;
                                    units "bytes";
                                    description "Number of bytes discarded by the IOMs after the ISA-AA MDA(s) due IOM congestion.";
                                }

                                leaf packets {
                                    type yang:counter64;
                                    units "packets";
                                    description "Number of packets discarded by the IOMs after the ISA-AA MDA(s) due to IOM congestion.";
                                }

                            } // container congestion-discards

                            container active-flows {
                                description "Enter the active-flows context";

                                leaf current {
                                    type yang:gauge32;
                                    units "flows";
                                    description "The number of active flows currently being tracked by the ISA-AA MDA(s).";
                                }

                                leaf average {
                                    type yang:gauge32;
                                    units "flows";
                                    description "The average number of active flows being tracked by the ISA-AA MDA(s) within the last 60 minutes.";
                                }

                                leaf peak {
                                    type yang:gauge32;
                                    units "flows";
                                    description "The peak number of active flows being tracked by the ISA-AA MDA(s) since system startup.";
                                }

                            } // container active-flows

                            container aa-subscribers-downloaded {
                                description "Enter the aa-subscribers-downloaded context";

                                leaf current {
                                    type yang:gauge32;
                                    description
                                        "The number of subscribers defined in TIMETRA-SUBSCRIBER-MGMT-MIB::tmnxSubInfoAppProfile
                                         in the tmnxSubscriberInfoTable with tmnxBsxAppProfDivert set to 'true'.";
                                }

                                leaf average {
                                    type yang:gauge32;
                                    description
                                        "The average number of subscribers defined in TIMETRA-SUBSCRIBER-MGMT-MIB::tmnxSubInfoAppProfile
                                         in the tmnxSubscriberInfoTable with tmnxBsxAppProfDivert set to 'true' within the last 60 minutes.";
                                }

                                leaf peak {
                                    type yang:gauge32;
                                    description
                                        "The peak number of subscribers defined in TIMETRA-SUBSCRIBER-MGMT-MIB::tmnxSubInfoAppProfile
                                         in the tmnxSubscriberInfoTable with tmnxBsxAppProfDivert set to 'true' since system startup.";
                                }

                            } // container aa-subscribers-downloaded

                            container active-subscribers {
                                description "Enter the active-subscribers context";

                                leaf current {
                                    type yang:gauge32;
                                    description "The number of subscribers currently with flow records in the ISA-AA MDA(s).";
                                }

                                leaf average {
                                    type yang:gauge32;
                                    description "The average number of subscribers with flow records in the ISA-AA MDA(s) within the last 60 minutes.";
                                }

                                leaf peak {
                                    type yang:gauge32;
                                    description "The peak number of subscribers with flow records in the ISA-AA MDA(s) since system startup.";
                                }

                            } // container active-subscribers

                            container diverted-traffic {
                                description "Enter the diverted-traffic context";

                                leaf octets {
                                    type yang:counter64;
                                    units "bytes";
                                    description "Number of bytes diverted from ingress IOMs towards the ISA-AA MDA(s).";
                                }

                                leaf packets {
                                    type yang:counter64;
                                    units "packets";
                                    description "Number of packets diverted from ingress IOMs towards the ISA-AA MDA(s).";
                                }

                            } // container diverted-traffic

                            container entered-aa {
                                description "Enter the entered-aa context";

                                leaf octets {
                                    type yang:counter64;
                                    units "bytes";
                                    description "Number of bytes sent from an IOM which enter the ISA-AA MDA(s).";
                                }

                                leaf packets {
                                    type yang:counter64;
                                    units "packets";
                                    description "Number of packets sent from an IOM which enter the ISA-AA MDA(s).";
                                }

                            } // container entered-aa

                            container inspected {
                                description "Enter the inspected context";

                                leaf octets {
                                    type yang:counter64;
                                    units "bytes";
                                    description "Number of bytes sent for protocol determination in the ISA-AA MDA(s).";
                                }

                                leaf packets {
                                    type yang:counter64;
                                    units "packets";
                                    description "Number of packets sent for protocol determination in the ISA-AA MDA(s).";
                                }

                            } // container inspected

                            container exited-aa {
                                description "Enter the exited-aa context";

                                leaf octets {
                                    type yang:counter64;
                                    units "bytes";
                                    description "Number of bytes which exit the ISA-AA MDA(s) and are sent to the local IOM.";
                                }

                                leaf packets {
                                    type yang:counter64;
                                    units "packets";
                                    description "Number of packets which exit the ISA-AA MDA(s) and are sent to the local IOM.";
                                }

                            } // container exited-aa

                            container buffered-in-aa {
                                description "Enter the buffered-in-aa context";

                                leaf octets {
                                    type yang:counter64;
                                    units "bytes";
                                    description "Number of bytes buffered by the ISA-AA MDA(s).";
                                }

                                leaf packets {
                                    type yang:counter64;
                                    units "packets";
                                    description "Number of packets buffered by the ISA-AA MDA(s).";
                                }

                            } // container buffered-in-aa

                            container discarded-in-aa {
                                description "Enter the discarded-in-aa context";

                                container policy {
                                    description "Enter the policy context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes discarded by the ISA-AA MDA(s) due to policy.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets discarded by the ISA-AA MDA(s) due to policy.";
                                    }

                                } // container policy

                                container congestion {
                                    description "Enter the congestion context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes discarded by the ISA-AA MDA(s) due to congestion.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets discarded by the ISA-AA MDA(s) due to congestion.";
                                    }

                                } // container congestion

                                container errors {
                                    description "Enter the errors context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of bytes discarded due to unrecoverable errors.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets discarded due to unrecoverable errors.";
                                    }

                                } // container errors

                                container tcp-optimization {
                                    description "Enter the tcp-optimization context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of octets that the ISA-AA MDA has discarded due to the TCP optimization configuration in tmnxBsxTcpOptTable.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets that the ISA-AA MDA has discarded due to the TCP optimization configuration in tmnxBsxTcpOptTable.";
                                    }

                                } // container tcp-optimization




                            } // container discarded-in-aa

                            container modified-in-aa {
                                description "Enter the modified-in-aa context";

                                container packet-size-increased {
                                    description "Enter the packet-size-increased context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of additional octets the ISA-AA MDA injected into the packets.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets that the ISA-AA MDA has increased in size.";
                                    }

                                } // container packet-size-increased

                                container packet-size-decreased {
                                    description "Enter the packet-size-decreased context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of octets the ISA-AA MDA has removed from packets.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets that the ISA-AA MDA has decreased in size.";
                                    }

                                } // container packet-size-decreased

                            } // container modified-in-aa

                            container errors {
                                description "Enter the errors context";

                                container policy-bypass {
                                    description "Enter the policy-bypass context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description
                                            "Number of octets which pass untouched that did not have statistics or policy applied.
                                             These bytes are counted as policy bypass errors.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description
                                            "Number of packets which passed untouched that did not have statistics or policy applied.
                                             These packets are counted as policy bypass errors.";
                                    }

                                } // container policy-bypass

                                container cut-through {
                                    description "Enter the cut-through context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description
                                            "Number of octets which passed untouched, but have policy applied.
                                             These octets are counted as cut-through errors.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description
                                            "Number of packets which passed untouched, but have policy applied.
                                             These packets are counted as cut-through errors.";
                                    }

                                    container flow-resource {
                                        description "Enter the flow-resource context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of octets that the ISA-AA MDA(s) have cut-through due to flow resource exhaustion.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of packets that the ISA-AA MDA(s) have cut-through due to flow resource exhaustion.";
                                        }

                                    } // container flow-resource

                                    container overload {
                                        description "Enter the overload context";

                                        leaf octets {
                                            type yang:counter64;
                                            units "bytes";
                                            description "Number of octets that the ISA-AA MDA has cut-through due to the overload cut-through configuration as indicated by the object tmnxBsxIsaAaGrpOverloadCutThru.";
                                        }

                                        leaf packets {
                                            type yang:counter64;
                                            units "packets";
                                            description "Number of octets that the ISA-AA MDA has cut-through due to the overload cut-through configuration as indicated by the object tmnxBsxIsaAaGrpOverloadCutThru.";
                                        }

                                    } // container overload

                                } // container cut-through

                            } // container errors

                            container generated-in-aa {
                                description "Enter the generated-in-aa context";

                                container tcp-optimization {
                                    description "Enter the tcp-optimization context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of octets that the ISA-AA MDA has created due to the TCP optimization configuration in tmnxBsxTcpOptTable.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets that the ISA-AA MDA has created due to the TCP optimization configuration in tmnxBsxTcpOptTable.";
                                    }

                                } // container tcp-optimization


                                container http-redirect {
                                    description "Enter the http-redirect context";

                                    leaf octets {
                                        type yang:counter64;
                                        units "bytes";
                                        description "Number of octets that the ISA-AA MDA has created to redirect HTTP and HTTPS.";
                                    }

                                    leaf packets {
                                        type yang:counter64;
                                        units "packets";
                                        description "Number of packets that the ISA-AA MDA has created to redirect HTTP and HTTPS.";
                                    }

                                } // container http-redirect



                            } // container generated-in-aa

                            container returned-traffic {
                                description "Enter the returned-traffic context";

                                leaf octets {
                                    type yang:counter64;
                                    units "bytes";
                                    description "Number of bytes returned to the normal forwarding path that are sent to egress IOMs from the ISA-AA MDA(s).";
                                }

                                leaf packets {
                                    type yang:counter64;
                                    units "packets";
                                    description "Number of packets returned to the normal forwarding path that are sent to egress IOMs from the ISA-AA MDA(s).";
                                }

                            } // container returned-traffic

                            container flow-resources {
                                description "Enter the flow-resources context";

                                leaf current {
                                    type yang:gauge32;
                                    description "The number of flow resources currently in-use on the ISA-AA MDA(s).";
                                }

                                leaf average {
                                    type yang:gauge32;
                                    units "flows";
                                    description "The average number of flow resources in use on the ISA-AA MDA(s) within the last 60 minutes.";
                                }

                                leaf peak {
                                    type yang:gauge32;
                                    units "flows";
                                    description "The peak number of flow resources in use on the ISA-AA MDA(s) since system startup.";
                                }

                                leaf current-percent {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The current percentage of total flow resources in-use on the ISA-AA MDA.";
                                }

                                leaf average-percent {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The average percentage of total flow resources in-use on the ISA-AA MDA.";
                                }

                                leaf peak-percent {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The peak percentage of total flow resources in-use on the ISA-AA MDA.";
                                }

                            } // container flow-resources

                            container flow-setup-rate {
                                description "Enter the flow-setup-rate context";

                                leaf current {
                                    type yang:gauge32;
                                    units "flows per second";
                                    description "The number of flow setups per second over the most recent 10 second period.";
                                }

                                leaf average {
                                    type yang:gauge32;
                                    units "flows per second";
                                    description "The average number of flow setups per second being tracked by the ISA-AA MDA(s) within the last 60 minutes.";
                                }

                                leaf peak {
                                    type yang:gauge32;
                                    units "flows per second";
                                    description "The peak number of flow setups per second being tracked by the ISA-AA MDA(s) since system startup.";
                                }

                            } // container flow-setup-rate

                            container traffic-rate {
                                description "Enter the traffic-rate context";

                                leaf current {
                                    type yang:gauge32;
                                    units "megabps";
                                    description "The traffic rate in megabits(s) per second (mbps) incoming to the ISA-AA MDA(s).";
                                }

                                leaf average {
                                    type yang:gauge32;
                                    units "megabps";
                                    description "The average traffic rate in megabits(s) per second (mbps) incoming to the ISA-AA MDA(s) within the last 60 minutes.";
                                }

                                leaf peak {
                                    type yang:gauge32;
                                    units "megabps";
                                    description "The peak traffic rate in megabits(s) per second (mbps) incoming to the ISA-AA MDA(s) since system startup.";
                                }

                            } // container traffic-rate

                            container packet-rate {
                                description "Enter the packet-rate context";

                                leaf current {
                                    type yang:gauge32;
                                    units "packets per second";
                                    description "The current number of packets per second incoming to the ISA-AA MDA(s).";
                                }

                                leaf average {
                                    type yang:gauge32;
                                    units "packets per second";
                                    description "The average number of packets per second incoming to the ISA-AA MDA(s) within the last 60 minutes.";
                                }

                                leaf peak {
                                    type yang:gauge32;
                                    units "packets per second";
                                    description "The peak number of packets per second incoming to the ISA-AA MDA(s) since system startup.";
                                }

                            } // container packet-rate

                            container datapath-cpu-usage {
                                description "Enter the datapath-cpu-usage context";

                                leaf current {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The percent utilization of the datapath CPU on the ISA-AA MDA(s).";
                                }

                                leaf average {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The average percent utilization of the datapath CPU on the ISA-AA MDA(s) within the last 60 minutes.";
                                }

                                leaf peak {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The peak percent utilization of the datapath CPU on the ISA-AA MDA(s) since system startup.";
                                }

                            } // container datapath-cpu-usage

                            container management-cpu-usage {
                                description "Enter the management-cpu-usage context";

                                leaf current {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The percent utilization of the management CPU on the ISA-AA MDA(s).";
                                }

                                leaf average {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The average percent utilization of the management CPU on the ISA-AA MDA(s) within the last 60 minutes.";
                                }

                                leaf peak {
                                    type uint32 {
                                        range "0..10000";
                                    }
                                    units "centipercent";
                                    description "The peak percent utilization of the management CPU on the ISA-AA MDA(s) since system startup.";
                                }

                            } // container management-cpu-usage

                        } // container statistics

                        container tca {
                            description "Enter the tca context";

                            container flow-resources {
                                description "Enter the flow-resources context";

                                leaf state {
                                    type types-aa:tca-state;
                                    description "The state of the flow resource TCA (tmnxBsxIsaAaGrpFlowFull).";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf count {
                                        type yang:counter64;
                                        description "The number of times the flow resource TCA (tmnxBsxIsaAaGrpFlowFull) was raised since system startup.";
                                    }

                                    leaf duration {
                                        type yang:counter64;
                                        units "seconds";
                                        description "The amount of time the flow resource TCA (tmnxBsxIsaAaGrpFlowFull) was in the raised state since system startup.";
                                    }

                                } // container statistics

                            } // container flow-resources

                            container flow-setup-rate {
                                description "Enter the flow-setup-rate context";

                                leaf state {
                                    type types-aa:tca-state;
                                    description "The state of the flow setup rate TCA (tmnxBsxIsaAaGrpFlowSetup).";
                                }

                                container statistics {
                                    description "Enter the statistics context";

                                    leaf count {
                                        type yang:counter64;
