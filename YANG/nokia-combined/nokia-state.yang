                        container traffic {
                            description "Enter the traffic context";

                            container statistics {
                                description "Enter the statistics context";

                                container sub-to-net {
                                    description "Enter the sub-to-net context";

                                    container tcp-total {
                                        description "Enter the tcp-total context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of TCP total octets in the subscriber to network direction.";
                                        }

