                        container qos {
                            description "Enter the qos context";

                            container ingress {
                                description "Enter the ingress context";

                                list direction {
                                    key "direction queue-id";
                                    description "Enter the direction list instance";

                                    leaf direction {
                                        type types-aa:queue-traffic-direction;
                                        description "The traffic direction (net-to-sub or sub-to-net).";
                                    }

                                    leaf queue-id {
                                        type types-qos:ingress-queue-id;
                                        description "The ingress queue identifier.";
                                    }

                                    container statistics {
                                        description "Enter the statistics context";

                                        container in-profile-forwarded {
                                            description "Enter the in-profile-forwarded context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of in profile bytes diverted towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of in profile packets diverted towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container in-profile-forwarded

                                        container in-profile-dropped {
                                            description "Enter the in-profile-dropped context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of in profile bytes discarded towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of in profile packets discarded towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container in-profile-dropped

                                        container out-profile-forwarded {
                                            description "Enter the out-profile-forwarded context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of out of profile bytes diverted towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of out of profile packets diverted towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container out-profile-forwarded

                                        container out-profile-dropped {
                                            description "Enter the out-profile-dropped context";

                                            leaf octets {
                                                type yang:counter64;
                                                units "bytes";
                                                description "Number of out of profile bytes discarded towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                            leaf packets {
                                                type yang:counter64;
                                                units "packets";
                                                description "Number of out of profile packets discarded towards egress IOMs from the ISA-AA MDA within this group for the particular queue.";
                                            }

                                        } // container out-profile-dropped

                                    } // container statistics

                                } // list direction

