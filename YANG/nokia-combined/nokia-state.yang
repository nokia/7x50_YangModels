                                            leaf unknown-protocol {
                                                type yang:counter64;
                                                description "Number of packets dropped in the downstream direction due to unknown protocol(not TCP/UDP/ICMP)";
                                            }

                                            leaf fragments-rx {
                                                type yang:counter64;
                                                description "Number of fragmented packets dropped received in the downstream direction";
                                            }

                                            leaf fragmentation-required {
                                                type yang:counter64;
                                                description "Number of packets dropped in the downstream direction due to fragmentation";
                                            }

                                            leaf icmpv4 {
                                                type yang:counter64;
                                                description "Number of icmpv4 packets dropped in the downstream direction";
                                            }

                                        } // container dropped

                                        container forwarded {
                                            description "Enter the forwarded context";

                                            leaf total-packets {
                                                type yang:counter64;
                                                description "Number of packets forwarded in the downstream direction";
                                            }

                                            leaf total-octets {
                                                type yang:counter64;
                                                description "Number of octets forwarded in the downstream direction";
                                            }

                                        } // container forwarded

                                    } // container downstream

                                } // container statistics

                            } // list esa

                        } // list mapping-rule

                    } // list domain

                    container statistics {
                        description "Enter the statistics context";

                        container fragmentation {
                            description "Enter the fragmentation context";

                            leaf rx-resolved {
                                type yang:counter64;
                                description "Fragments that are resolved without buffering";
                            }

                            leaf rx-unresolved {
                                type yang:counter64;
                                description
                                    "Number of fragments that were queued in the system
                                     since the last clearing of the stats";
                            }

                            leaf tx-frags {
                                type yang:counter64;
                                description
                                    "Number of fragments that were resolved and
                                     forwarded out of the fragmentation logic";
                            }

                            leaf dropped {
                                type yang:counter64;
                                description "Number of dropped fragments";
                            }

                            leaf created-flows {
                                type yang:counter64;
                                description
                                    "Number of flow records created since the last
                                     clearing of the statistics. Flow record creation
                                     is triggered by the first fragment of a packet.";
                            }

                            leaf flow-collisions {
                                type yang:counter64;
                                description
                                    "Number of flow collisions (overlapping first
                                     fragments) since the last clearing of the statistics";
                            }

                            leaf exceeded-max-flows {
                                type yang:counter64;
                                description "Number of times the maximum number of flows is exceeded";
                            }

                            leaf exceeded-max-timeouts {
                                type yang:counter64;
                                description
                                    "Number of fragments that have timed out since the
                                     last clearing of the statistics";
                            }

                            leaf exceeded-max-buffers {
                                type yang:counter64;
                                description "Number of times the maximum number of buffers is exceeded";
                            }

                            leaf exceeded-max-buffers-per-flow {
                                type yang:counter64;
                                description
                                    "Number of times a fragment count per flow has
                                     exceeded the maximum value";
                            }

                            leaf in-use-flows {
                                type types-sros:percent;
                                description "Percentage of currently processed flows (flow records)";
                            }

                            leaf max-flows {
                                type types-sros:percent;
                                description
                                    "Maximum number of flows (flow records) reached
                                     since the last clearing of the statistics";
                            }

                            leaf in-use-buffers {
                                type types-sros:percent;
                                description "Percentage of in-use buffers";
                            }

                            leaf max-buffers {
                                type types-sros:percent;
                                description
                                    "Maximum number of buffers allocated in the system
                                     since the last clearing of the statistics";
                            }

                        } // container fragmentation

                    } // container statistics

                } // container map-t

                container statistics {
                    description "Enter the statistics context";

                    container dropped {
                        description "Enter the dropped context";

                        leaf radius-interim-updates {
                            type yang:counter64;
                            description
                                "The number of dropped RADIUS accounting interim update
                                 messages generated by NAT";
                        }

                    } // container dropped

                } // container statistics

            } // container nat

            list sdp {
                key "sdp-id";
                description "Enter the sdp list instance";

                leaf sdp-id {
                    type types-services:sdp-id;
                    description "Service Destination Point (SDP) identifier.";
                }

                leaf sdp-oper-state {
                    type enumeration {
                        enum up                             { value 1; }
                        enum down                           { value 6; }
                    }
                    description "This object indicates the operating state of this SDP.";
                }

                leaf sdp-oper-path-mtu {
                    type int32;
                    description "This object indicates the operation path MTU.";
                }

                leaf sdp-oper-flags {
                    type bits {
                        bit sdp-admin-down                 { position 0; }
                        bit signaling-session-down         { position 1; }
                        bit transport-tunnel-down          { position 2; }
                        bit keep-alive-failure             { position 3; }
                        bit invalid-egress-interface       { position 4; }
                        bit no-system-ip-address           { position 5; }
                        bit transport-tunnel-unstable      { position 6; }
                        bit not-on-binding-port            { position 7; }
                    }
                    description "This object indicates the operating status of this SDP.";
                }

                leaf mvpls-mgmt-service {
                    type uint32 {
                        range "0..2148007980";
                    }
                    description
                        "This object indicates the service Id where the STP instance is
                         running that is managing this SDP.";
                }

                leaf mvpls-mgmt-sdp-bind-id {
                    type types-services:state-sdp-bind-id-or-zero;
                    description
                        "This object indicates the SDP bind in the mVPLS instance
                         specified in sdpMvplsMgmtService is controlling this SDP.";
                }

                leaf sdp-oper-bandwidth {
                    type uint32;
                    description "This object indicates the operational Bandwidth available for this SDP.";
                }

                leaf sdp-available-bandwidth {
                    type uint32;
                    description
                        "This object indicates the Bandwidth still free for booking by
                         the SDP bindings on the SDP.";
                }

                leaf sdp-creation-origin {
                    type types-sros:creation-origin;
                    description "Creation origin of this SDP.";
                }

                leaf lsp-revert-time-countdown {
                    type int32 {
                        range "-1|0..600";
                    }
                    description
                        "This object indicates the timer countdown before reverting back
                         from LDP on this SDP.";
                }

                leaf ldp-lsp-id {
                    type uint32;
                    description "This object indicates the LDP LSP Id.";
                }

                leaf egress-ifs-net-domain-consistent {
                    type enumeration {
                        enum not-applicable                 { value 1; }
                        enum consistent                     { value 2; }
                        enum inconsistent                   { value 3; }
                    }
                    description
                        "This object indicates whether all the egress network interfaces
                         that can carry traffic on this SDP are associated with the
                         network-domain configured on this SDP.";
                }

                leaf bgp-tunnel-lsp-id {
                    type uint32;
                    description "This object indicates the Id for the BGP tunnel LSP.";
                }

                leaf active-lsp-type {
                    type enumeration {
                        enum not-applicable                 { value 0; }
                        enum rsvp                           { value 1; }
                        enum ldp                            { value 2; }
                        enum bgp                            { value 3; }
                        enum none                           { value 4; }
                        enum mpls-tp                        { value 5; }
                        enum sr-isis                        { value 6; }
                        enum sr-ospf                        { value 7; }
                        enum sr-te-lsp                      { value 8; }
                        enum fpe                            { value 9; }
                    }
                    description "This object indicates the type of LSP that is currently active on this SDP.";
                }

                leaf control-pw-is-active {
                    type boolean;
                    description
                        "This object indicates whether control pseudo-wire is considered
                         active  on the Backbone Edge Bridge (BEB).";
                }

                leaf fpe-lsp-id {
                    type uint32;
                    description "Identifier of the forward-path-extension LSP when the SDP is created using 'fpe'.";
                }

                leaf oper-tunnel-far-end-inet-address {
                    type types-sros:ip-address;
                    description "IP address of the remote end of the transport tunnel for this SDP.";
                }

                container keep-alive {
                    description "Enter the keep-alive context";

                    leaf oper-state {
                        type enumeration {
                            enum alive                          { value 1; }
                            enum no-response                    { value 2; }
                            enum sender-id-invalid              { value 3; }
                            enum responder-id-error             { value 4; }
                            enum disabled                       { value 5; }
                        }
                        description "This object indicates the current status of the keep-alive protocol.";
                    }

                    leaf hello-request-messages {
                        type uint32;
                        description
                            "This object indicates the number of SDP Echo Request messages
                             transmitted since the keep-alive was administratively enabled
                             or the counter was cleared.";
                    }

                    leaf hello-response-messages {
                        type uint32;
                        description
                            "This object indicates the number of SDP Echo Response messages
                             since the keep-alive was administratively enabled or the
                             counter was cleared.";
                    }

                    leaf late-hello-response-messages {
                        type uint32;
                        description
                            "This object indicates the number of SDP Echo Response messages
                             received after the corresponding request timeout timer expired.";
                    }

                } // container keep-alive

            } // list sdp

            list vpls {
                key "service-name";
                description "Enter the vpls list instance";

                leaf service-name {
                    type types-services:service-name;
                    description "Name of the service";
                }

                leaf oper-service-id {
                    type types-services:service-id;
                    description "Service identifier";
                }

                leaf oper-state {
                    type types-sros:oper-state;
                    description "Operational state.";
                }

                leaf sap-count {
                    type int32;
                    description "Number of SAPs";
                }

                leaf sdp-bind-count {
                    type int32;
                    description "Number of SDP binds";
                }

                leaf template-used {
                    type string;
                    description "Template used to create this service";
                }

                leaf creation-origin {
                    type types-sros:creation-origin;
                    description "Creation origin of the service";
                }

                leaf l2pt-term-enabled {
                    type boolean;
                    description
                        "If 'l2pt-termination' and/or 'bpdu-translation'
                         is in use in this service by at least one SAP or
                         spoke SDP Bind. If the value is 'true', it means that
                         at least one of 'l2pt-termination' or 'bpdu-translation'
                         is enabled.";
                }

                container fdb {
                    description "Enter the fdb context";

                    leaf mac-relearn-only {
                        type boolean;
                        description
                            "When set to 'true' either the FDB table of this VPLS
                             service is full, or that the maximum system wide number of
                             MACs supported by the node has been reached, and thus
                             MAC learning is temporary disabled, and only MAC relearns
                             can take place.";
                    }

                    leaf table-high-utilization {
                        type boolean;
                        description "Set to 'true' when the FDB table utilization reaches the high watermark and 'false' when it reaches the low watermark.";
                    }

                    leaf relearn-attempt-for-pinned-mac-address {
                        type yang:mac-address;
                        description "The MAC address being assigned to an interface while pinned.";
                    }

                    leaf relearn-attempt-for-pinned-mac-address-last-changed {
                        type yang:date-and-time;
                        description "Timestamp when the MAC address being assigned to an interface while pinned was detected.";
                    }

                    container statistics {
                        description "Enter the statistics context";

                        leaf total {
                            type int32;
                            description "Number of entries allocated in the FDB ";
                        }

                        leaf in-use {
                            type int32;
                            description "Number of entries currently in use in the FDB";
                        }

                        leaf static {
                            type int32;
                            description "Number of static entries in the FDB";
                        }

                        leaf learned {
                            type int32;
                            description "Number of learned entries in the FDB";
                        }

                        leaf oam {
                            type int32;
                            description "Number of OAM entries in the FDB";
                        }

                        leaf conditional-static {
                            type int32;
                            description "Number of conditional static entries in the FDB";
                        }

                        leaf dhcp {
                            type int32;
                            description "Number of dhcp-learned entries in the FDB";
                        }

                        leaf host {
                            type int32;
                            description "Number of host-learned entries in the FDB";
                        }

                        leaf interface {
                            type int32;
                            description "Number of interface entries in the FDB";
                        }

                        leaf bgp-evpn {
                            type int32;
                            description "Number of bgp-evpn entries in the FDB";
                        }

                        leaf evpn-static {
                            type int32;
                            description "Number of evpn static entries in the FDB";
                        }

                        leaf spb {
                            type int32;
                            description "Number of SPB entries in the FDB";
                        }

                        leaf eth-cfm {
                            type int32;
                            description "Number of eth-cfm entries in FDB";
                        }

                    } // container statistics

                    container bgp-evpn {
                        description "Enter the bgp-evpn context";

                        leaf duplicate-mac-address-detected {
                            type boolean;
                            description "Indicates if a duplicated MAC address is detected";
                        }

                        leaf black-hole-dup-mac-address-detected {
                            type yang:mac-address;
                            description "The black hole duplicated MAC address";
                        }

                        leaf black-hole-dup-mac-address-detected-last-changed {
                            type yang:date-and-time;
                            description "Timestamp when the black hole duplicated MAC address was detected";
                        }

                        leaf protected-mac-address-received {
                            type yang:mac-address;
                            description "The protected MAC address received";
                        }

                        leaf protected-mac-address-received-last-changed {
                            type yang:date-and-time;
                            description "Timestamp when the protected MAC address was receieved";
                        }

                    } // container bgp-evpn

                    container backbone-vpls {
                        description "Enter the backbone-vpls context";

                        leaf pbb-protected-mac-address-received {
                            type yang:mac-address;
                            description "The PBB protected MAC address received";
                        }

                        leaf pbb-protected-mac-address-received-last-changed {
                            type yang:date-and-time;
                            description "Timestamp when the PBB protected MAC address was receieved";
                        }

                    } // container backbone-vpls

                    list endpoint {
                        key "name";
                        description "Enter the endpoint list instance";

                        leaf name {
                            type types-sros:named-item;
                            description "Name of the service endpoint";
                        }

                        leaf mac-addresses-learned-crossed-high-watermark {
                            type boolean;
                            description "Set to 'true' when the numberof MAC addresses in the FDB table for this endpoint reaches the high watermark and 'false' when it reaches the low watermark.";
                        }

                    } // list endpoint

                    container card-status {
                        description "Enter the card-status context";

                        list card {
                            key "slot-id";
                            description "Enter the card list instance";

                            leaf slot-id {
                                type uint32;
                                description "Slot id";
                            }

                            leaf allocated {
                                type uint32;
                                description "Number of slots allocated";
                            }

                            leaf pending-allocated {
                                type uint32;
                                description "Number of slots pending to be allocated";
                            }

                            leaf pending-free {
                                type uint32;
                                description "Number of slots pending to be free";
                            }

                        } // list card

                    } // container card-status

                    list mac {
                        key "address";
                        description "Enter the mac list instance";

                        leaf address {
                            type yang:mac-address;
                            description "MAC address";
                        }

                        leaf locale {
                            type types-services:vpls-fdb-locale;
                            description "locality of the this FDB entry.";
                        }

                        leaf sap {
                            type types-sros:sap;
                            description "SAP for this FDB entry.";
                        }

                        leaf sdp-bind {
                            type types-services:state-sdp-bind-id-or-zero;
                            description "SDP binding of the SDP for this FDB entry.";
                        }

                        leaf ivpls-mac-count {
                            type uint32;
                            description
                                "Number of ISID VPLS service MAC addressess which are using
                                 this FDB MAC entry.";
                        }

                        leaf pbb-epipes-count {
                            type uint32;
                            description "Number of EPipes that resolve to this MAC Address.";
                        }

                        leaf backbone-destination-address {
                            type yang:mac-address;
                            description
                                "Backbone VPLS service MAC address used as destination MAC address
                                 in the Provider Backbone Bridging frames for this FDB Entry.";
                        }

                        leaf type {
                            type types-services:fdb-mac-type;
                            description "Type for FDB MAC address.";
                        }

                        leaf last-update {
                            type types-sros:date-time;
                            description "Time this entry was last updated.";
                        }

                        leaf age {
                            type uint32;
                            description "Age for this MAC address.";
                        }

                        leaf protected-mac {
                            type boolean;
                            description "If this FDB MAC entry is protected.";
                        }

                        container endpoint {
                            description "Enter the endpoint context";

                            leaf name {
                                type types-sros:named-item;
                                description "Endpoint name for this FDB entry.";
                            }

                            leaf sdp-bind {
                                type types-services:state-sdp-bind-id-or-zero;
                                description "Endpoint SDP ID for this FDB entry.";
                            }

                        } // container endpoint

                        container vxlan {
                            description "Enter the vxlan context";

                            leaf esi {
                                type string;
                                description "Ethernet Segment Identifier for this FDB entry.";
                            }

                            leaf instance {
                                type int32;
                                description "Vxlan Instace for this FDB entry.";
                            }

                            leaf tep {
                                type types-sros:ip-address;
                                description "Vxlan Tunnel Endpoint address for this FDB entry.";
                            }

                            leaf vni {
                                type types-services:vxlan-vni;
                                description "Vxlan Network Identifier for this FDB entry.";
                            }

                        } // container vxlan

                        container evpn-mpls {
                            description "Enter the evpn-mpls context";

                            leaf etree-leaf {
                                type boolean;
                                description "Indicates if this MAC entry was learned from EVPN etree leaf.";
                            }

                            leaf esi {
                                type string;
                                description "Ethernet Segment Identifier for this FDB entry.";
                            }

                            leaf tep {
                                type types-sros:ip-address;
                                description "EVPN MPLS Tunnel Endpoint address for this FDB entry.";
                            }

                            leaf label {
                                type uint32;
                                description "MPLS label of endpoint of ethernet VPN (EVPN).";
                            }

                            leaf tunnel-identifier {
                                type uint32;
                                description "Tunnel identifier associated to the non multi-homing EVPN MPLS destination.";
                            }

                            leaf transport-type {
                                type types-mpls:mpls-transport-type;
                                description "Transport type used for this FDB entry.";
                            }

                        } // container evpn-mpls

                        container srv6 {
                            description "Enter the srv6 context";

                            leaf instance {
                                type int32;
                                description "EVPN SRv6 instance";
                            }

                            leaf tep {
                                type types-sros:ip-address;
                                description "Tunnel endpoint address";
                            }

                            leaf sid-address {
                                type types-sros:ip-address;
                                description "SID address";
                            }

                            leaf esi {
                                type string;
                                description "Ethernet Segment Identifier for this FDB entry.";
                            }

                        } // container srv6

                    } // list mac

                } // container fdb

                container mfib {
                    description "Enter the mfib context";

                    container table {
                        description "Enter the table context";

                        leaf high-utilization {
                            type boolean;
                            description "Set to 'true' when the utilization of the MFIB table reaches the high watermark and 'false' when it reaches the low watermark.";
                        }

                        list mac-based-stream {
                            key "mac-address";
                            description "Enter the mac-based-stream list instance";

                            leaf mac-address {
                                type yang:mac-address;
                            }

                            leaf matched-packets {
                                type yang:zero-based-counter64;
                                description "The number of multicast packets that matched this entry.";
                            }

                            leaf matched-octets {
                                type yang:zero-based-counter64;
                                description "The number of forwarded octets that matched this entry.";
                            }

                            leaf forwarding-rate {
                                type yang:zero-based-counter64;
                                units "kilobps";
                                description "The forwarded rate that matched this entry.";
                            }

                            list sap {
                                key "sap-id";
                                description "Enter the sap list instance";

                                leaf sap-id {
                                    type types-sros:sap;
                                    description "SAP identifier";
                                }

                                leaf forwarding-state {
                                    type types-igmp:forwarding-state;
                                    description "The traffic forwarding state on this port.";
                                }

                                leaf port-service-name {
                                    type types-services:service-name;
                                    description "The service to which this port belongs";
                                }

                            } // list sap

                            list sdp {
                                key "sdp-bind-id";
                                description "Enter the sdp list instance";

                                leaf sdp-bind-id {
                                    type types-services:sdp-bind-id;
                                    description
                                        "SDP Binding identifier as <sdp-id>:<vc-id>.
                                         sdp-id - [1..32767]
                                         vc-id - [1..4294967295].";
                                }

                                leaf forwarding-state {
                                    type types-igmp:forwarding-state;
                                    description "The traffic forwarding state on this port.";
                                }

                                leaf port-service-name {
                                    type types-services:service-name;
                                    description "The service to which this port belongs";
                                }

                            } // list sdp

                            list vxlan {
                                key "vtep vni";
                                description "Enter the vxlan list instance";

                                leaf vtep {
                                    type types-sros:ip-unicast-address;
                                }

                                leaf vni {
                                    type types-services:vxlan-vni;
                                }

                                leaf forwarding-state {
                                    type types-igmp:forwarding-state;
                                    description "The traffic forwarding state on this port.";
                                }

                                leaf port-service-name {
                                    type types-services:service-name;
                                    description "The service to which this port belongs";
                                }

                            } // list vxlan

                            list evpn-mpls {
                                key "tep label";
                                description "Enter the evpn-mpls list instance";

                                leaf tep {
                                    type types-sros:ip-unicast-address;
                                }

                                leaf label {
                                    type uint32;
                                }

                                leaf forwarding-state {
                                    type types-igmp:forwarding-state;
                                    description "The traffic forwarding state on this port.";
                                }

                                leaf port-service-name {
                                    type types-services:service-name;
                                    description "The service to which this port belongs";
                                }

                            } // list evpn-mpls

                        } // list mac-based-stream

                        list ipv4-based-stream {
                            key "group-address source-address";
                            description "Enter the ipv4-based-stream list instance";

                            leaf group-address {
                                type types-sros:ipv4-address;
                                description "Group address of multicast channel.";
                            }

                            leaf source-address {
                                type types-sros:ipv4-address;
                                description "Source address of multicast channel.";
                            }

                            leaf matched-packets {
                                type yang:zero-based-counter64;
                                description "The number of multicast packets that matched this entry.";
                            }

                            leaf matched-octets {
                                type yang:zero-based-counter64;
                                description "The number of forwarded octets that matched this entry.";
                            }

                            leaf forwarding-rate {
                                type yang:zero-based-counter64;
                                units "kilobps";
                                description "The forwarded rate that matched this entry.";
                            }

                            list sap {
                                key "sap-id";
                                description "Enter the sap list instance";

                                leaf sap-id {
                                    type types-sros:sap;
                                    description "SAP identifier";
                                }

                                leaf forwarding-state {
                                    type types-igmp:forwarding-state;
                                    description "The traffic forwarding state on this port.";
                                }

                                leaf port-service-name {
                                    type types-services:service-name;
                                    description "The service to which this port belongs";
                                }

                            } // list sap

                            list sdp {
                                key "sdp-bind-id";
                                description "Enter the sdp list instance";

                                leaf sdp-bind-id {
                                    type types-services:sdp-bind-id;
                                    description
                                        "SDP Binding identifier as <sdp-id>:<vc-id>.
                                         sdp-id - [1..32767]
                                         vc-id - [1..4294967295].";
                                }

                                leaf forwarding-state {
                                    type types-igmp:forwarding-state;
                                    description "The traffic forwarding state on this port.";
                                }

                                leaf port-service-name {
                                    type types-services:service-name;
                                    description "The service to which this port belongs";
                                }

                            } // list sdp

                            list vxlan {
                                key "vtep vni";
                                description "Enter the vxlan list instance";

                                leaf vtep {
                                    type types-sros:ip-unicast-address;
                                }

                                leaf vni {
                                    type types-services:vxlan-vni;
                                }

                                leaf forwarding-state {
                                    type types-igmp:forwarding-state;
                                    description "The traffic forwarding state on this port.";
                                }

                                leaf port-service-name {
                                    type types-services:service-name;
                                    description "The service to which this port belongs";
                                }

                            } // list vxlan

                            list evpn-mpls {
                                key "tep label";
                                description "Enter the evpn-mpls list instance";

                                leaf tep {
                                    type types-sros:ip-unicast-address;
                                }

                                leaf label {
                                    type uint32;
                                }

                                leaf forwarding-state {
                                    type types-igmp:forwarding-state;
                                    description "The traffic forwarding state on this port.";
                                }

                                leaf port-service-name {
                                    type types-services:service-name;
                                    description "The service to which this port belongs";
                                }

                            } // list evpn-mpls

                            list multicast-management-operational-data {
                                key "chassis-number slot-number fp-number";
                                description "Enter the multicast-management-operational-data list instance";

                                leaf chassis-number {
                                    type uint32;
                                    description "The unique index identifying this physical chassis.";
                                }

                                leaf slot-number {
                                    type uint32;
                                    description
                                        "The unique value which identifies the IOM slot within a
                                         chassis in the system.";
                                }

                                leaf fp-number {
                                    type uint32;
                                    description "Forwarding plane within a specific IOM card";
                                }

                                leaf bandwith {
                                    type yang:gauge32;
                                    units "kilobps";
                                    description "Current bandwidth";
                                }

                                leaf current-path {
                                    type enumeration {
                                        enum none                           { value 0; }
                                        enum primary                        { value 1; }
                                        enum secondary                      { value 2; }
                                        enum ancillary                      { value 3; }
                                        enum blackhole                      { value 4; }
                                    }
                                    description "Explicit sf path.";
                                }

                                leaf explicit-path {
                                    type boolean;
                                    description "???";
                                }

                                leaf admin-bw {
                                    type yang:gauge32;
                                    description "Admin bandwidth.";
                                }

                                leaf preference {
                                    type yang:gauge32;
                                    description "Preference level.";
                                }

                                leaf blackholed {
                                    type boolean;
                                    description "In black-hole state";
                                }

                                leaf blackhole-rate {
                                    type yang:gauge32;
                                    description "The current rate at which this channel will be placed in black-hole state";
                                }

                                leaf highest-bw {
                                    type yang:gauge32;
                                    description "The highest multicast bandwidth that has been accounted.";
                                }

                                leaf second-highest-bw {
                                    type yang:gauge32;
                                    description "The second highest multicast bandwidth that has been accounted.";
                                }

                                leaf expiry-time {
                                    type uint32;
                                    units "seconds";
                                    description "Remaining time before the bandwidth update timer on the FP expires";
                                }

                                leaf plane {
                                    type uint32;
                                    description "Forwarding plane";
                                }

                            } // list multicast-management-operational-data

                        } // list ipv4-based-stream

                        list ipv6-based-stream {
                            key "group-address source-address";
                            description "Enter the ipv6-based-stream list instance";

                            leaf group-address {
                                type types-sros:ipv6-address;
                                description "Group address of multicast channel.";
                            }

                            leaf source-address {
                                type types-sros:ipv6-address;
                                description "Source address of multicast channel.";
                            }

                            leaf matched-packets {
                                type yang:zero-based-counter64;
                                description "The number of multicast packets that matched this entry.";
                            }

                            leaf matched-octets {
                                type yang:zero-based-counter64;
                                description "The number of forwarded octets that matched this entry.";
                            }

                            leaf forwarding-rate {
                                type yang:zero-based-counter64;
                                units "kilobps";
