                                type boolean;
                            }

                            leaf bit14 {
                                type boolean;
                            }

                            leaf bit15 {
                                type boolean;
                            }

                        } // container charging-characteristics

                        container user-location-information {
                            description "Enter the user-location-information context";

                            container cgi {
                                description "Enter the cgi context";

                                leaf mcc {
                                    type string;
                                    description "Mobile Country Code";
                                }

