                                    }

                                    leaf label-mode {
                                        type enumeration {
                                            enum next-hop                       { value 1; }
                                            enum per-prefix                     { value 2; }
                                            enum epe                            { value 3; }
                                            enum explicit-null                  { value 4; }
                                        }
                                    }

                                    leaf label-value {
                                        type uint32;
                                        description "The MPLS label value.";
