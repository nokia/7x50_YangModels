                    container ip-identification-assist {
                        description "Enter the ip-identification-assist context";

                        list esa {
                            key "esa-id vm";
                            description "Enter the esa list instance";

                            leaf esa-id {
                                type types-esa:esa-id;
                                description "Specifies an ESA identifier.";
                            }

                            leaf vm {
                                type types-esa:vm-id;
                                description "Specifies the VM identifier within the ESA.";
                            }

                            container statistics {
                                description "Enter the statistics context";

                                container passive-dns-monitor {
                                    description "Enter the passive-dns-monitor context";

                                    leaf match-ipv4-addresses {
                                        type yang:counter64;
                                        description
                                            "The number of IPv4 addresses that Passive DNS Monitoring reported
                                             to IP Identification Assist as potential mappings to supported
                                             applications.  Passive DNS Monitoring bases these potential mappings
                                             on the IPv4 addresses in the DNS responses that matched.  This
                                             statistic only counts how many potential IPv4 mappings Passive DNS
                                             Monitoring reported and does not account for what IP Identification
                                             Assist did with them.";
                                    }

                                    leaf match-ipv6-addresses {
                                        type yang:counter64;
                                        description
                                            "The number of IPv6 addresses that Passive DNS Monitoring reported
                                             to IP Identification Assist as potential mappings to supported
                                             applications.  Passive DNS Monitoring bases these potential mappings
                                             on the IPv6 addresses in the DNS responses that matched.  This
                                             statistic only counts how many potential IPv6 mappings Passive DNS
                                             Monitoring reported and does not account for what IP Identification
                                             Assist did with them.";
                                    }

                                    leaf miss-ipv4-addresses {
                                        type yang:counter64;
                                        description
                                            "The number of IPv4 addresses that Passive DNS Monitoring reported
                                             to IP Identification Assist as potential mappings to an unknown
                                             application.  Passive DNS Monitoring bases these potential mappings
                                             on the IPv4 addresses in the DNS responses that missed.  This
                                             statistic only counts how many potential IPv4 mappings Passive DNS
                                             Monitoring reported and does not account for what IP Identification
                                             Assist did with them.";
                                    }

                                    leaf miss-ipv6-addresses {
                                        type yang:counter64;
                                        description
                                            "The number of IPv6 addresses that Passive DNS Monitoring reported
                                             to IP Identification Assist as potential mappings to an unknown
                                             application.  Passive DNS Monitoring bases these potential mappings
                                             on the IPv6 addresses in the DNS responses that matched.  This
                                             statistic only counts how many potential IPv6 mappings Passive DNS
                                             Monitoring reported and does not account for what IP Identification
                                             Assist did with them.";
                                    }

                                    container dns-responses {
                                        description "Enter the dns-responses context";

                                        leaf total {
                                            type yang:counter64;
                                            description "The total number of DNS responses that Passive DNS Monitoring has seen";
                                        }

                                        leaf ignored-no-reverse-flow {
                                            type yang:counter64;
                                            description
                                                "The number of DNS responses that Passive DNS Monitoring ignored because
                                                 they did not have a corresponding DNS request (no reverse flow)";
                                        }

                                        leaf ignored-wrong-direction {
                                            type yang:counter64;
                                            description
                                                "The number of DNS responses that Passive DNS Monitoring ignored because
                                                 they came from the wrong direction (from-sub, where to-sub is expected)";
                                        }

                                        leaf ignored-untrusted {
                                            type yang:counter64;
                                            description
                                                "The number of DNS responses that Passive DNS Monitoring ignored because
                                                 they did not come from a trusted DNS server, and a list of trusted DNS
                                                 servers was configured";
                                        }

                                        leaf match {
                                            type yang:counter64;
                                            description
                                                "The number of DNS responses in which Passive DNS Monitoring matched
                                                 a domain name that is related to an application supported by IP
                                                 Identification Assist.";
                                        }

                                        leaf miss {
                                            type yang:counter64;
                                            description
                                                "The number of DNS responses where Passive DNS Monitoring looked
                                                 at a domain name but was unable to match it to an application
                                                 supported by IP Identification Assist.  Passive DNS Monitoring
                                                 counts these DNS responses as related to an unknown application.";
                                        }

                                    } // container dns-responses

                                } // container passive-dns-monitor

                                container positive-app-id {
                                    description "Enter the positive-app-id context";

                                    container identified-sessions {
                                        description "Enter the identified-sessions context";

                                        leaf total {
                                            type yang:counter64;
                                            description
                                                "The total number of sessions (pair of flows) that were positively identified
                                                 as a global application supported in ip-identification-assist.  Some of these
                                                 sessions do not contribute to the ip-identification-assist database.";
                                        }

                                        container non-contributing {
                                            description "Enter the non-contributing context";

                                            leaf matching {
                                                type yang:counter64;
                                                description
                                                    "The number of sessions (pair of flows) that were identified as a global
                                                     application through an app-filter entry using the ip-identification-assist
                                                     mechanism.  These sessions do not contribute to the ip-identification-assist
                                                     database/cache.";
                                            }

                                            leaf non-matching {
                                                type yang:counter64;
                                                description
                                                    "The number of sessions (pair of flows) that were identified as a global
                                                     application through an app-filter entry that did not contain an expression
                                                     match.  These sessions do not contribute to the ip-identification-assist
                                                     database/cache.";
                                            }

                                        } // container non-contributing

                                    } // container identified-sessions

                                    container contributed {
                                        description "Enter the contributed context";

                                        leaf sessions {
                                            type yang:counter64;
                                            description
                                                "The number of sessions (pair of flows) that were identified as a global
                                                 application and contributed to the ip-identification-assist database/cache.";
                                        }

                                        container addresses {
                                            description "Enter the addresses context";

                                            leaf ipv4 {
                                                type yang:counter64;
                                                description
                                                    "The number of IPv4 addresses populated in the ip-identification-assist
                                                     database/cache by contributing sessions.";
                                            }

                                            leaf ipv6 {
                                                type yang:counter64;
                                                description
                                                    "The number of IPv6 addresses populated in the ip-identification-assist
                                                     database/cache by contributing sessions.";
                                            }

                                        } // container addresses

                                    } // container contributed

                                } // container positive-app-id

                            } // container statistics

                        } // list esa

                        list isa {
                            key "mda-id";
                            description "Enter the isa list instance";

                            leaf mda-id {
                                type types-isa:slot-mda;
                                description "Specifies an MDA/ISA identifier <card slot number>/<mda slot number>";
