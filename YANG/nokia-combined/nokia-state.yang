                                    leaf interface-name {
                                        type types-sros:interface-name;
                                        description "The name of the interface.This is only applicable for layer 3 SAPs or spoke SDPs.";
                                    }

                                    leaf periods {
                                        type yang:counter32;
                                        description
                                            "The number of times the rate limit violation was detected.
