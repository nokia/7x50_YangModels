                                description "Uplink Aggregate Maximum Bit Rate";
                            }

                            leaf downlink-ambr {
                                type uint32;
                                units "kilobps";
                                description "Downlink Aggregate Maximum Bit Rate";
                            }

                        } // container qos

                        container charging-characteristics {
                            description "Enter the charging-characteristics context";

                            leaf roaming {
                                type boolean;
                            }

                            leaf bit0 {
                                type boolean;
                            }

                            leaf bit1 {
                                type boolean;
                            }

                            leaf bit2 {
                                type boolean;
                            }

                            leaf bit3 {
                                type boolean;
                            }

                            leaf bit4 {
                                type boolean;
                            }

                            leaf bit5 {
                                type boolean;
                            }

                            leaf bit6 {
                                type boolean;
                            }

                            leaf bit7 {
                                type boolean;
                            }

                            leaf bit8 {
                                type boolean;
                            }

                            leaf bit9 {
                                type boolean;
                            }

