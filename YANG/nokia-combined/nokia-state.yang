                                            description "Indicates the number of rejected logins.";
                                        }

                                    } // list server

                                } // container radius

                                container tacplus {
                                    description "Enter the tacplus context";

                                    list server {
                                        key "index";
                                        description "Enter the server list instance";

                                        leaf index {
                                            type uint32 {
                                                range "1..5";
                                            }
