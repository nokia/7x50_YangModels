                                        description "Count of routes of a routing protocol active in the FIB.";
                                    }

                                    leaf available-routes {
                                        type uint32;
                                        description
                                            "Count of routes of a routing protocol, both active in the FIB
                                             and inactive in the RIB.";
                                    }

                                } // container esm-bcast

                                container evpn-iff {
