                                        type enumeration {
                                            enum be                             { value 0; }
                                            enum l2                             { value 1; }
                                            enum af                             { value 2; }
                                            enum l1                             { value 3; }
                                            enum h2                             { value 4; }
                                            enum ef                             { value 5; }
                                            enum h1                             { value 6; }
                                            enum nc                             { value 7; }
                                        }
                                        description "QoS association of the routes";
