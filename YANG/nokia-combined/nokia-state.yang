                                container net-to-sub {
                                    description "Enter the net-to-sub context";

                                    container tcp-total {
                                        description "Enter the tcp-total context";

                                        leaf octets {
                                            type yang:counter64;
                                            description "The number of TCP total octets in the network to subscriber direction.";
