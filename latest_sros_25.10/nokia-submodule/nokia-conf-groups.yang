                                description "Enter the egress context";

                                leaf-list queue {
                                    type int8 {
                                        range "1..8";
                                    }
                                    max-elements 8;
                                    description "Egress queues for this category";
                                }

                                leaf-list policer {
                                    type int8 {
                                        range "1..63";
                                    }
