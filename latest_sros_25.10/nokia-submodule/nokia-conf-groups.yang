                                } // container video-template

                                container voice-template {
                                    status obsolete;
                                    presence "Enable the voice-template context";
                                    description "Enable the voice-template context";

                                    leaf field-selection {
                                        status obsolete;
                                        type types-aa:aa-grp-cflowd-template-select;
                                        description "Field selection method";
                                    }

                                    container dynamic-fields {
                                        status obsolete;
                                        description "Enter the dynamic-fields context";

                                        leaf admin-state {
                                            status obsolete;
                                            type types-sros:admin-state;
                                            description "Administrative state of the dynamic fields";
                                        }

                                        list field {
                                            status obsolete;
                                            key "field-name";
                                            description "Add a list entry for field";

                                            leaf field-name {
                                                status obsolete;
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:named-item;
                                                }
                                                description "Cflowd template dynamic field name";
                                            }

                                        } // list field

                                    } // container dynamic-fields

                                } // container voice-template

                            } // container rtp-performance

                            container tcp-performance {
                                presence "Enable the tcp-performance context";
                                description "Enable the tcp-performance context";

                                leaf flow-rate {
                                    type types-aa:cflowd-sample-rate;
                                    description "Cflowd flow sampling rate";
                                }

                                leaf flow-rate-2 {
                                    type types-aa:cflowd-sample-rate;
                                    description "Cflowd per-flow second sampling rate";
                                }

                                container template {
                                    presence "Enable the template context";
                                    description "Enable the template context";

                                    leaf field-selection {
                                        type types-aa:aa-grp-cflowd-template-select;
                                        description "Field selection method";
                                    }

                                    container dynamic-fields {
                                        description "Enter the dynamic-fields context";

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the dynamic fields";
                                        }

                                        list field {
                                            key "field-name";
                                            description "Add a list entry for field";

                                            leaf field-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:named-item;
                                                }
                                                description "Cflowd template dynamic field name";
                                            }

                                        } // list field

                                    } // container dynamic-fields

                                } // container template

                            } // container tcp-performance

                            container volume {
                                description "Enter the volume context";

                                leaf rate {
                                    type uint32 {
                                        range "1..10000";
                                    }
                                    description "Cflowd packet sampling rate";
                                }

                                container template {
                                    presence "Enable the template context";
                                    description "Enable the template context";

                                    leaf field-selection {
                                        type types-aa:aa-grp-cflowd-template-select;
                                        description "Field selection method";
                                    }

                                    container dynamic-fields {
                                        description "Enter the dynamic-fields context";

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the dynamic fields";
                                        }

                                        list field {
                                            key "field-name";
                                            description "Add a list entry for field";

                                            leaf field-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:named-item;
                                                }
                                                description "Cflowd template dynamic field name";
                                            }

                                        } // list field

                                    } // container dynamic-fields

                                } // container template

                            } // container volume

                        } // container cflowd

                        list dns-enrich {
                            key "dns-enrich-name";
                            description "Enter the dns-enrich list instance";

                            leaf dns-enrich-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "DNS enrichment object name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the DNS enrichment object";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf gateway-id {
                                type uint32;
                                description "Gateway ID portion of the enriched device ID";
                            }

                            leaf packet-size-limit {
                                type uint32 {
                                    range "256..9212";
                                }
                                units "octets";
                                description "Maximum packet size after DNS enrichment";
                            }

                            list option {
                                key "option-type";
                                description "Add a list entry for option";

                                leaf option-type {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-aa:dns-enrich-option-type;
                                    }
                                    description "Name of the DNS option to enrich by AA";
                                }

                            } // list option

                        } // list dns-enrich

                        list dns-ip-cache {
                            key "dns-ip-cache-name";
                            description "Enter the dns-ip-cache list instance";

                            leaf dns-ip-cache-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "DNS IP cache name within the AA group";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the AA DNS IP cache object";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            container dns-match {
                                description "Enter the dns-match context";

                                list domain {
                                    key "domain-name";
                                    description "Enter the domain list instance";

                                    leaf domain-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "DNS IP cache domain name";
                                    }

                                    leaf expression {
                                        type types-sros:display-string;
                                        description "AA DNS domain expression to match";
                                    }

                                } // list domain

                                list trusted-server-address {
                                    key "dns-server-address";
                                    description "Enter the trusted-server-address list instance";

                                    leaf dns-server-address {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:ip-address;
                                        }
                                        description "Trusted DNS server address";
                                    }

                                    leaf server-name {
                                        type types-sros:named-item;
                                        description "DNS server name";
                                    }

                                } // list trusted-server-address

                            } // container dns-match

                            container ip-cache {
                                description "Enter the ip-cache context";

                                leaf high-watermark {
                                    type uint32 {
                                        range "0..100";
                                    }
                                    description "High watermark value for the DNS IP cache";
                                }

                                leaf low-watermark {
                                    type uint32 {
                                        range "0..100";
                                    }
                                    description "Low watermark value for the DNS IP cache";
                                }

                                leaf size {
                                    type uint32 {
                                        range "10..64000";
                                    }
                                    description "Maximum number of IP addresses stored in the cache";
                                }

                                list static-address {
                                    key "static-ip-address";
                                    description "Add a list entry for static-address";

                                    leaf static-ip-address {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:ip-address;
                                        }
                                        description "Trusted IP address for the DNS IP cache";
                                    }

                                } // list static-address

                            } // container ip-cache

                        } // list dns-ip-cache

                        list http-enrich {
                            key "http-enrich-name";
                            description "Enter the http-enrich list instance";

                            leaf http-enrich-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "HTTP header enrichment policy name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the HTTP enrichment policy";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            list field {
                                key "field-name";
                                description "Enter the field list instance";

                                leaf field-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Field name to insert into the HTTP header";
                                }

                                leaf aes-initialization-vector {
                                    type types-sros:hex-string {
                                        length "34";
                                        pattern "0x[0-9a-fA-F]+";
                                    }
                                    description "Initialization vector for the AES CBC encryption";
                                }

                                leaf anti-spoof {
                                    type boolean;
                                    description "Enable anti-spoofing";
                                }

                                leaf calling-line-id {
                                    type boolean;
                                    description "Enable calling line identification";
                                }

                                leaf md5-salt {
                                    type types-sros:string-not-all-spaces {
                                        length "1..16";
                                    }
                                    description "MD5 salt string";
                                }

                                leaf name {
                                    type types-sros:named-item;
                                    sros-ext:immutable;
                                    description "HTTP header field name";
                                }

                                leaf static-string {
                                    type types-sros:string-not-all-spaces {
                                        length "1..16";
                                    }
                                    description "HTTP header enrichment template field static string";
                                }

                                container encode {
                                    description "Enter the encode context";

                                    choice encode-choice {
                                        case cert-profile {

                                            leaf cert-profile {
                                                type types-sros:named-item;
                                                description "Certificate profile name used for encryption";
                                            }

                                        }
                                        case key {

                                            container key {
                                                description "Enter the key context";

                                                leaf type {
                                                    type types-aa:http-field-encoding;
                                                    description "Encoding type";
                                                }

                                                leaf value {
                                                    type types-sros:encrypted-leaf {
                                                        length "1..114";
                                                    }
                                                    description "Secret key for encrypting the field";
                                                }

                                            } // container key

                                        }
                                        case cert-base64 {

                                            leaf cert-base64 {
                                                type types-sros:named-item;
                                                description "Certificate profile name";
                                            }

                                        }
                                    }
                                } // container encode

                            } // list field

                            container rat-type-enrichment {
                                description "Enter the rat-type-enrichment context";

                                list rat-type {
                                    key "rat-type-name";
                                    description "Enter the rat-type list instance";

                                    leaf rat-type-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-aa:mobile-rat-type;
                                        }
                                        description "RAT type name";
                                    }

                                    leaf rat-string {
                                        type types-sros:string-not-all-spaces {
                                            length "1..31";
                                        }
                                        description "Customised RAT type value";
                                    }

                                } // list rat-type

                            } // container rat-type-enrichment


                        } // list http-enrich

                        list http-error-redirect {
                            key "http-error-redirect-name";
                            description "Enter the http-error-redirect list instance";

                            leaf http-error-redirect-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "HTTP error redirect policy name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the HTTP error redirect object";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf http-host {
                                type types-sros:display-string;
                                description "HTTP host for the HTTP error redirect object";
                            }

                            leaf participant-id {
                                type types-sros:named-item;
                                description "Participant ID for the HTTP error redirect object";
                            }

                            leaf template {
                                type uint32;
                                description "Template ID for the HTTP error redirect object";
                            }

                            list error-code {
                                key "error-code-value";
                                description "Enter the error-code list instance";

                                leaf error-code-value {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "400..999";
                                        }
                                    }
                                    description "HTTP error code value for an HTTP error redirect";
                                }

                                leaf custom-message-size {
                                    type uint32;
                                    units "octets";
                                    description "HTTP error redirect error code custom message size";
                                }

                            } // list error-code

                        } // list http-error-redirect

                        list http-notification {
                            key "http-notification-name";
                            description "Enter the http-notification list instance";

                            leaf http-notification-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "HTTP notification policy name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the AA HTTP notification object";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf interval {
                                type types-aa:http-notif-interval;
                                description "Minimum HTTP response notification interval";
                            }

                            leaf script-url {
                                type types-sros:http-redirect-url;
                                description "Script URL inserted into the HTTP response";
                            }

                            leaf template {
                                type uint32;
                                description "Template ID for the AA HTTP notification object";
                            }

                        } // list http-notification


                        list http-redirect {
                            key "http-redirect-name";
                            description "Enter the http-redirect list instance";

                            leaf http-redirect-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "HTTP redirect policy name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the AA HTTP redirect object";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf redirect-https {
                                type boolean;
                                description "Enable HTTPS redirect";
                            }

                            leaf redirect-url {
                                type types-sros:http-redirect-url;
                                description "HTTP redirect URL";
                            }

                            leaf tcp-client-reset {
                                type boolean;
                                description "Enable TCP client reset";
                            }

                            leaf template {
                                type uint32;
                                description "Template ID for the HTTP redirect object";
                            }

                            container captive-redirect {
                                description "Enter the captive-redirect context";

                                leaf vlan-id {
                                    type types-sros:vlan-id;
                                    description "Captive redirect VLAN ID";
                                }

                            } // container captive-redirect

                        } // list http-redirect

                        container ip-identification-assist {
                            presence "Enable the ip-identification-assist context";
                            description "Enable the ip-identification-assist context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of IP identification assist";
                            }

                            container passive-dns {
                                description "Enter the passive-dns context";

                                leaf monitor {
                                    type boolean;
                                    description "Use passive DNS monitoring to collect IP addresses";
                                }

                                list trusted-server {
                                    key "ip-address";
                                    description "Enter the trusted-server list instance";

                                    leaf ip-address {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:ip-unicast-address;
                                        }
                                        description "IP address of the DNS server";
                                    }

                                    leaf comment {
                                        type types-sros:named-item-or-empty {
                                            length "0..32";
                                        }
                                        description "Name or description to associate with the DNS server";
                                    }

                                } // list trusted-server

                            } // container passive-dns

                            container positive-app-id {
                                description "Enter the positive-app-id context";

                                leaf enabled {
                                    type boolean;
                                    description "Use the positive application identification mechanism";
                                }

                            } // container positive-app-id

                        } // container ip-identification-assist


                        list tcp-optimizer {
                            key "tcp-optimizer-name";
                            description "Enter the tcp-optimizer list instance";

                            leaf tcp-optimizer-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "TCP optimizer name";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf dack-timeout {
                                type uint32 {
                                    range "200";
                                }
                                units "milliseconds";
                                description "Delayed acknowledgment timeout for client and server";
                            }

                            leaf initial-cwnd {
                                type uint32 {
                                    range "1..256";
                                }
                                description "MSS of the TCP optimizer initial congestion window";
                            }

                            leaf initial-ss-threshold {
                                type union {
                                    type uint32 {
                                        range "0..1000000";
                                    }
                                    type enumeration {
                                        enum auto                           { value 1000001; }
                                    }
                                }
                                units "kilobytes";
                                description "Initial TCP Slow Start threshold for client and server";
                            }

                            leaf network-rtt-threshold {
                                type uint32 {
                                    range "1..100";
                                }
                                units "milliseconds";
                                description "Network round trip time threshold";
                            }

                            leaf tcp-stack {
                                type types-aa:tcp-optimizer-stack;
                                description "TCP stack congestion control algorithm";
                            }

                            leaf high-cpu-backoff {
                                type boolean;
                                description "Stop optimizing sessions when CPU capacity is limited";
                            }

                        } // list tcp-optimizer

                        list url-list {
                            key "url-list-name";
                            description "Enter the url-list list instance";

                            leaf url-list-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "URL list name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the URL list";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf file {
                                type types-sros:display-string {
                                    length "1..180";
                                }
                                description "File name of the URL list on compact flash";
                            }

                            leaf host-expressions {
                                type boolean;
                                description "Allow URL list to contain hostnames with wildcards";
                            }

                            leaf key {
                                type types-sros:encrypted-leaf {
                                    length "1..115";
                                }
                                description "URL list decryption key";
                            }

                            leaf size {
                                type enumeration {
                                    enum standard                       { value 1; }
                                    enum extended                       { value 2; }
                                }
                                description "Size limit of the URL list";
                            }

                        } // list url-list

                        list url-filter {
                            key "url-filter-name";
                            description "Enter the url-filter list instance";

                            leaf url-filter-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "URL filter name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the AA URL filter";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf apply-function-specific-behaviour {
                                type boolean;
                                description "Use function-specific behavior for action or redirect";
                            }

                            leaf http-redirect {
                                type types-sros:named-item;
                                description "HTTP redirect for a blocked HTTP request";
                            }

                            leaf http-request-filtering {
                                type enumeration {
                                    enum all                            { value 1; }
                                    enum first                          { value 2; }
                                }
                                description "HTTP filtering for all HTTP requests";
                            }

                            container default-action {
                                description "Enter the default-action context";

                                choice action-choice {
                                    case allow {

                                        leaf allow {
                                            type empty;
                                            description "Allow all requests as the default URL filter action";
                                        }

                                    }
                                    case block-all {

                                        leaf block-all {
                                            type empty;
                                            description "Block all requests as the default URL filter action";
                                        }

                                    }
                                    case block-http-redirect {

                                        leaf block-http-redirect {
                                            type types-sros:named-item;
                                            description "HTTP URL name for block and redirect request action";
                                        }

                                    }
                                }
                            } // container default-action

                            container local-filtering {
                                description "Enter the local-filtering context";

                                leaf allow-list {
                                    type types-sros:named-item;
                                    description "Local filtering URL list for allowed URLs";
                                }

                                list deny-list {
                                    key "url-list-name";
                                    description "Enter the deny-list list instance";

                                    leaf url-list-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "URL list name";
                                    }

                                    leaf http-redirect {
                                        type types-sros:named-item;
                                        description "HTTP redirect object applied to blocked HTTP requests";
                                    }

                                    container default-action {
                                        description "Enter the default-action context";

                                        choice action-choice {
                                            case allow {

                                                leaf allow {
                                                    type empty;
                                                    description "Allow all requests as the default action";
                                                }

                                            }
                                            case block-all {

                                                leaf block-all {
                                                    type empty;
                                                    description "Block all requests as the default action";
                                                }

                                            }
                                            case block-http-redirect {

                                                leaf block-http-redirect {
                                                    type types-sros:named-item;
                                                    description "HTTP URL for redirection when URL filter cannot be used";
                                                }

                                            }
                                        }
                                    } // container default-action

                                } // list deny-list

                            } // container local-filtering

                            container icap {
                                description "Enter the icap context";

                                leaf custom-x-header {
                                    type types-sros:named-item;
                                    description "Custom x-header field name to include in ICAP requests";
                                }

                                leaf http-redirect {
                                    type types-sros:named-item;
                                    description "HTTP redirect object used when ICAP blocks HTTP request";
                                }

                                leaf vlan-id {
                                    type types-sros:vlan-id;
                                    description "VLAN ID of the ICAP server service port";
                                }

                                container default-action {
                                    description "Enter the default-action context";

                                    choice action-choice {
                                        case allow {

                                            leaf allow {
                                                type empty;
                                                description "Allow all requests as the default action";
                                            }

                                        }
                                        case block-all {

                                            leaf block-all {
                                                type empty;
                                                description "Block all requests as the default action";
                                            }

                                        }
                                        case block-http-redirect {

                                            leaf block-http-redirect {
                                                type types-sros:named-item;
                                                description "HTTP URL for redirection when URL filter cannot be used";
                                            }

                                        }
                                    }
                                } // container default-action

                                list server {
                                    key "ip-address port";
                                    description "Enter the server list instance";

                                    leaf ip-address {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:ip-unicast-address;
                                        }
                                        description "ICAP server IP address";
                                    }

                                    leaf port {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:tcp-udp-port-non-zero;
                                        }
                                        description "ICAP server port";
                                    }

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of this URL filter ICAP server";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                } // list server

                            } // container icap

                            container web-service {
                                description "Enter the web-service context";

                                leaf classifier {
                                    type types-aa:web-serv-classifier-id;
                                    description "Web service classifier";
                                }

                                leaf category-set {
                                    type uint32 {
                                        range "1..65535";
                                    }
                                    description "Web service category ID";
                                }

                                leaf default-profile {
                                    type types-sros:named-item;
                                    description "Web service default profile";
                                }

                                leaf dns-server {
                                    type types-sros:ip-unicast-address;
                                    description "Web service DNS server";
                                }

                                leaf fqdn {
                                    type types-sros:display-string;
                                    description "Web service fully qualified domain name";
                                }

                                leaf http-redirect {
                                    type types-sros:named-item;
                                    description "Web service HTTP redirect";
                                }

                                leaf vlan-id {
                                    type types-sros:vlan-id;
                                    description "Web-service VLAN ID";
                                }

                                container default-action {
                                    description "Enter the default-action context";

                                    choice action-choice {
                                        case allow {

                                            leaf allow {
                                                type empty;
                                                description "Allow all requests as the default action";
                                            }

                                        }
                                        case block-all {

                                            leaf block-all {
                                                type empty;
                                                description "Block all requests as the default action";
                                            }

                                        }
                                        case block-http-redirect {

                                            leaf block-http-redirect {
                                                type types-sros:named-item;
                                                description "HTTP URL for redirection when traffic is blocked";
                                            }

                                        }
                                    }
                                } // container default-action

                                container classification-overrides {
                                    description "Enter the classification-overrides context";

                                    list entry {
                                        key "entry-id";
                                        description "Enter the entry list instance";

                                        leaf entry-id {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..65535";
                                                }
                                            }
                                            description "Classification override entry ID";
                                        }

                                        leaf expression {
                                            type types-sros:display-string;
                                            description "Hostname of the configured override category";
                                        }

                                        leaf category-name {
                                            type types-sros:named-item;
                                            description "Web service category name";
                                        }

                                    } // list entry

                                } // container classification-overrides

                                list profile {
                                    key "profile-name";
                                    description "Enter the profile list instance";

                                    leaf profile-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "Web service profile name";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    container block {
                                        description "Enter the block context";

                                        list category {
                                            key "category-name";
                                            description "Add a list entry for category";

                                            leaf category-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-aa:web-serv-category-name;
                                                }
                                                description "Web service profile category name to be blocked";
                                            }

                                        } // list category

                                    } // container block

                                } // list profile

                                list server {
                                    key "ip-address port";
                                    description "Enter the server list instance";

                                    leaf ip-address {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:ip-unicast-address;
                                        }
                                        description "AA web service server IP address";
                                    }

                                    leaf port {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:tcp-udp-port-non-zero;
                                        }
                                        description "AA web service server port";
                                    }

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of URL filter web service server";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                } // list server

                            } // container web-service

                        } // list url-filter

