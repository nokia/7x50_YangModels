                                        type uint32 {
                                            range "3..65535";
                                        }
                                        units "seconds";
                                        description "Timeout value for keepalive";
                                    }

                                    leaf factor {
                                        type uint32 {
                                            range "1..255";
                                        }
                                        description "Factor value for keepalive";
