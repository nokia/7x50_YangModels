                                        type types-sros:named-item;
                                    }
                                    description "Name of the TLS 1.3 server signature list";
                                }

                                list tls13-signature {
                                    key "index";
                                    description "Enter the tls13-signature list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..255";
                                            }
                                        }
                                        description "Index number of the TLS 1.3 signature";
                                    }

                                    leaf name {
                                        type enumeration {
                                            enum tls-rsa-pkcs1-sha256           { value 1025; }
                                            enum tls-ecdsa-secp256r1-sha256     { value 1027; }
                                            enum tls-rsa-pkcs1-sha384           { value 1281; }
                                            enum tls-ecdsa-secp384r1-sha384     { value 1283; }
                                            enum tls-rsa-pkcs1-sha512           { value 1537; }
                                            enum tls-ecdsa-secp521r1-sha512     { value 1539; }
                                            enum tls-rsa-pss-rsae-sha256        { value 2052; }
                                            enum tls-rsa-pss-rsae-sha384        { value 2053; }
                                            enum tls-rsa-pss-rsae-sha512        { value 2054; }
                                            enum tls-ed25519                    { value 2055; }
                                            enum tls-ed448                      { value 2056; }
                                            enum tls-rsa-pss-pss-sha256         { value 2057; }
                                            enum tls-rsa-pss-pss-sha384         { value 2058; }
                                            enum tls-rsa-pss-pss-sha512         { value 2059; }
                                        }
                                        description "Name of the TLS 1.3 signature suite code";
