                                        type uint32 {
                                            range "0..4294967294";
                                        }
                                        description "Low watermark threshold";
                                    }

                                } // list tcp-validate

                            } // container threshold-crossing-alert

                            container policy-override {
                                description "Enter the policy-override context";

                                container aa-sub {
                                    description "Enter the aa-sub context";

                                    list sap {
                                        key "sap-id";
                                        description "Enter the sap list instance";

                                        leaf sap-id {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type types-sros:sap;
                                            }
                                            description "AA subscriber SAP ID";
                                        }

                                        list characteristic {
                                            key "characteristic-name";
                                            description "Enter the characteristic list instance";

                                            leaf characteristic-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:named-item;
                                                }
                                                description "ASO characteristic name";
                                            }

                                            leaf value {
                                                type types-sros:named-item;
                                                description "Characteristic value used in subscriber policy override";
                                            }

                                        } // list characteristic

                                    } // list sap

                                    list spoke-sdp {
                                        key "sdp-bind-id";
                                        description "Enter the spoke-sdp list instance";

                                        leaf sdp-bind-id {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type types-services:sdp-bind-id;
                                            }
                                            description "Spoke SDP ID for an AA subscriber";
                                        }

                                        list characteristic {
                                            key "characteristic-name";
                                            description "Enter the characteristic list instance";

                                            leaf characteristic-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:named-item;
                                                }
                                                description "ASO characteristic name";
                                            }

                                            leaf value {
                                                type types-sros:named-item;
                                                description "Characteristic value used in subscriber policy override";
                                            }

                                        } // list characteristic

                                    } // list spoke-sdp

                                    list transit {
                                        key "transit-sub-name";
                                        description "Enter the transit list instance";

                                        leaf transit-sub-name {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type types-sros:named-item;
                                            }
                                            description "Transit subscriber name";
                                        }

                                        list characteristic {
                                            key "characteristic-name";
                                            description "Enter the characteristic list instance";

                                            leaf characteristic-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:named-item;
                                                }
                                                description "ASO characteristic name";
                                            }

                                            leaf value {
                                                type types-sros:named-item;
                                                description "Characteristic value used in subscriber policy override";
                                            }

                                        } // list characteristic

                                    } // list transit

                                } // container aa-sub

                            } // container policy-override

                        } // list partition

                    } // list group

                } // container application-assurance

                list aps {
                    key "group-id";
                    description "Enter the aps list instance";

                    leaf group-id {
                        type union {
                            type string {
                                length "1..64";
                                pattern "<.*>" {
                                    error-message "Config Groups Regex Pattern";
                                }
                            }
                            type uint32 {
                                range "1..128";
                            }
                        }
                        description "APS group ID";
                    }

                    leaf advertise-interval {
                        type uint32 {
                            range "10..650";
                        }
                        units "deciseconds";
                        description "Time between subsequent advertisement messages";
                    }

                    leaf hold-time {
                        type uint32 {
                            range "10..650";
                        }
                        units "deciseconds";
                        description "Time to wait for an advertisement packet";
                    }

                    leaf switching-mode {
                        type enumeration {
                            enum uni-directional                { value 1; }
                            enum bi-directional                 { value 2; }
                        }
                        description "Switching mode for the APS port";
                    }

                    choice annexb-choice {
                        case annexb {

                            container annexb {
                                presence "Enable the annexb context";
                                description "Enable the annexb context";

                                leaf wait-to-restore-time {
                                    type uint32 {
                                        range "0..3600";
                                    }
                                    units "seconds";
                                    description "Annex B mode operation wait to restore time";
                                }

                                leaf-list working-circuit {
                                    type types-sros:port;
                                    max-elements 2;
                                    ordered-by user;
                                    description "Working circuit port for the APS group";
                                }

                            } // container annexb

                        }
                        case non-annexb {

                            leaf neighbor {
                                type types-sros:ip-address;
                                description "Neighbor IP address for multi-chassis APS";
                            }

                            leaf protect-circuit {
                                type types-sros:port;
                                description "Protection circuit port for the APS group";
                            }

                            leaf working-circuit {
                                type types-sros:port;
                                description "Working circuit port for the APS group";
                            }

                            container revert {
                                presence "Enable the revert context";
                                description "Enable the revert context";

                                leaf time {
                                    type uint32 {
                                        range "0|60..3600";
                                    }
                                    units "seconds";
                                    description "Wait time before switching back to the working circuit";
                                }

                            } // container revert

                        }
                    }
                } // list aps

                container bfd {
                    presence "Enable the bfd context";
                    description "Enable the bfd context";

                    list bfd-template {
                        key "name";
                        description "Enter the bfd-template list instance";

                        leaf name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "BFD template name";
                        }

                        leaf echo-receive {
                            type uint32 {
                                range "100..100000";
                            }
                            units "milliseconds";
                            description "Echo receive interval";
                        }

                        leaf multiplier {
                            type uint32 {
                                range "1..20";
                            }
                            description "Detection multiplier";
                        }

                        leaf receive-interval {
                            type uint32 {
                                range "10..100000";
                            }
                            units "milliseconds";
                            description "Receive interval";
                        }

                        leaf transmit-interval {
                            type uint32 {
                                range "10..100000";
                            }
                            units "milliseconds";
                            description "Transmit interval";
                        }

                        leaf type {
                            type enumeration {
                                enum cpm-np                         { value 1; }
                                enum fp                             { value 3; }
                            }
                            description "Local termination point for the BFD session";
                        }

                    } // list bfd-template

                    container seamless-bfd {
                        description "Enter the seamless-bfd context";

                        list reflector {
                            key "name";
                            description "Enter the reflector list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "S-BFD reflector name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the seamless BFD reflector";
                            }

                            leaf discriminator {
                                type uint32 {
                                    range "80000..82047|524288..526335";
                                }
                                description "Discriminator of the seamless BFD reflector";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf local-state {
                                type enumeration {
                                    enum admin-down                     { value 0; }
                                    enum up                             { value 3; }
                                }
                                description "Local state of the seamless BFD reflector";
                            }

                        } // list reflector

                    } // container seamless-bfd

                } // container bfd

                container bmp {
                    presence "Enable the bmp context";
                    description "Enable the bmp context";

                    leaf admin-state {
                        type types-sros:admin-state;
                        description "Administrative state of the BMP operation";
                    }

                    container collector {
                        presence "Enable the collector context";
                        description "Enable the collector context";

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the BMP collector";
                        }

                        container connection {
                            description "Enter the connection context";

                            container ipv4 {
                                description "Enter the ipv4 context";

                                leaf address {
                                    type types-sros:ipv4-unicast-address;
                                    description "IPv4 address";
                                }

                                leaf port {
                                    type types-sros:tcp-udp-port-non-zero;
                                    description "IPv4 TCP destination port number";
                                }

                            } // container ipv4

                            container ipv6 {
                                description "Enter the ipv6 context";

                                leaf address {
                                    type types-sros:ipv6-unicast-address;
                                    description "IPv6 address";
                                }

                                leaf port {
                                    type types-sros:tcp-udp-port-non-zero;
                                    description "IPv6 TCP destination port";
                                }

                            } // container ipv6

                        } // container connection

                    } // container collector

                    list station {
                        key "name";
                        description "Enter the station list instance";

                        leaf name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "BMP monitoring station name";
                        }

                        leaf description {
                            type types-sros:description;
                            description "Text description";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the BMP monitoring station";
                        }

                        leaf initiation-message {
                            type string {
                                length "1..255";
                            }
                            description "Free form initiation message sent to monitoring station";
                        }

                        leaf stats-report-interval {
                            type types-sros:time-duration {
                                range "15..65535";
                            }
                            units "seconds";
                            description "Frequency of reports sent to the BMP monitoring station";
                        }

                        leaf report-local-routes {
                            type boolean;
                            description "Allow local route reporting to BMP monitoring station";
                        }


                        container connection {
                            description "Enter the connection context";

                            leaf connect-retry {
                                type types-sros:time-duration {
                                    range "1..65535";
                                }
                                units "seconds";
                                description "Maximum time between connection attempts";
                            }

                            leaf local-address {
                                type types-sros:ip-unicast-address;
                                description "Local IP address to communicate with monitoring station";
                            }

                            leaf router-instance {
                                type types-services:service-name;
                                description "Router instance used to reach the BMP station";
                            }

                            container station-address {
                                description "Enter the station-address context";

                                leaf ip-address {
                                    type types-sros:ip-unicast-address;
                                    description "IP address of the remote BMP monitoring station";
                                }

                                leaf port {
                                    type types-sros:tcp-udp-port-non-zero;
                                    description "BMP monitoring station port";
                                }

                            } // container station-address

                            container tcp-keepalive {
                                description "Enter the tcp-keepalive context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the TCP keepalive";
                                }

                                leaf keep-idle {
                                    type types-sros:time-duration {
                                        range "1..100000";
                                    }
                                    units "seconds";
                                    description "Time until the first TCP keepalive probe is sent";
                                }

                                leaf keep-interval {
                                    type types-sros:time-duration {
                                        range "1..100000";
                                    }
                                    units "seconds";
                                    description "Time between two TCP keepalive probes";
                                }

                                leaf keep-count {
                                    type uint32 {
                                        range "3..100";
                                    }
                                    description "Keepalive threshold before connection is declared down";
                                }

                            } // container tcp-keepalive

                        } // container connection

                        container family {
                            description "Enter the family context";

                            leaf ipv4 {
                                type boolean;
                                description "Support IPv4 address family";
                            }

                            leaf ipv6 {
                                type boolean;
                                description "Support IPv6 address family";
                            }

                            leaf label-ipv4 {
                                type boolean;
                                description "Support labeled IPv4 address family";
                            }

                            leaf label-ipv6 {
                                type boolean;
                                description "Support labeled IPv6 address family";
                            }

                            leaf mcast-ipv4 {
                                type boolean;
                                description "Support IPv4 multicast address family";
                            }

                            leaf mcast-ipv6 {
                                type boolean;
                                description "Support IPv6 multicast address family";
                            }

                            leaf vpn-ipv4 {
                                type boolean;
                                description "Support VPN IPv4 address family";
                            }

                            leaf vpn-ipv6 {
                                type boolean;
                                description "Support VPN IPv6 address family";
                            }

                            leaf mcast-vpn-ipv4 {
                                type boolean;
                                description "Support IPv4 VPN multicast address family";
                            }

                            leaf mcast-vpn-ipv6 {
                                type boolean;
                                description "Support IPv6 VPN multicast address family";
                            }

                            leaf evpn {
                                type boolean;
                                description "Support EVPN address family";
                            }

                            leaf l2-vpn {
                                type boolean;
                                description "Support L2 VPN address family";
                            }

                            leaf sr-policy-ipv4 {
                                type boolean;
                                description "Support SR policy IPv4 address family";
                            }

                            leaf sr-policy-ipv6 {
                                type boolean;
                                description "Support SR policy IPv6 address family";
                            }

                        } // container family

                    } // list station

                } // container bmp

                container call-trace {
                    presence "Enable the call-trace context";
                    description "Enable the call-trace context";

                    leaf max-files-number {
                        type uint32 {
                            range "1..1024";
                        }
                        description "Maximum number of files call trace can create";
                    }

                    leaf primary-cf {
                        type enumeration {
                            enum cf1                            { value 1; }
                            enum cf2                            { value 2; }
                        }
                        description "Primary CF card as local storage location";
                    }

                    leaf buffering {
                        type boolean;
                        description "Buffer messages until the trace key is known";
                    }

                    list location {
                        key "location-type";
                        description "Enter the location list instance";

                        leaf location-type {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type enumeration {
                                    enum cf1                            { value 1; }
                                    enum cf2                            { value 2; }
                                }
                            }
                            description "Compact flash card to be used";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of compact flash for log storage";
                        }

                        leaf size-limit {
                            type union {
                                type uint32 {
                                    range "1..65536";
                                }
                                type enumeration {
                                    enum unlimited                      { value 0; }
                                }
                            }
                            description "Maximum cumulative size of call trace files on the card";
                        }

                    } // list location

                    list trace-profile {
                        key "name";
                        description "Enter the trace-profile list instance";

                        leaf name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "Call trace profile name";
                        }

                        leaf description {
                            type types-sros:description;
                            description "Text description";
                        }

                        leaf size-limit {
                            type uint32 {
                                range "1..1000";
                            }
                            units "megabytes";
                            description "Maximum data output for a single call trace operation";
                        }

                        leaf time-limit {
                            type types-sros:time-duration {
                                range "1..604800";
                            }
                            description "Maximum time for a single call trace job";
                        }

                        leaf events {
                            type enumeration {
                                enum public-only                    { value 2; }
                                enum all                            { value 3; }
                            }
                            description "Events to include in the captured trace";
                        }

                        container applications {
                            description "Enter the applications context";

                            leaf connectivity-management {
                                type boolean;
                                description "Trace messages used for connectivity protocols";
                            }

                            leaf gx {
                                type boolean;
                                description "Trace Diameter messages used for the Gx application";
                            }

                            leaf gy {
                                type boolean;
                                description "Trace Diameter messages used for the Gy application";
                            }

                            leaf nasreq {
                                type boolean;
                                description "Trace Diameter messages used for NASREQ application";
                            }

                            leaf radius-auth {
                                type boolean;
                                description "Trace RADIUS authentication messages and events";
                            }

                            leaf radius-acct {
                                type boolean;
                                description "Trace messages and events for RADIUS-based accounting";
                            }

                            leaf pfcp {
                                type boolean;
                                description "Trace PFCP messages";
                            }

                            leaf python {
                                type boolean;
                                description "Trace Python script execution";
                            }

                            leaf ludb {
                                type boolean;
                                description "Trace local user database lookups";
                            }

                            leaf msap {
                                type boolean;
                                description "Trace MSAP creation events";
                            }

                            leaf ppp-event {
                                type boolean;
                                description "Allow tracing for PPP state machine related events";
                            }

                        } // container applications

                        container output {
                            description "Enter the output context";

                            choice destination {
                                case local-storage {

                                    leaf local-storage {
                                        type empty;
                                        description "Destination for output";
                                    }

                                }
                                case debug {

                                    leaf debug {
                                        type empty;
                                        description "Enable output to the debug log";
                                    }

                                }
                                case live {

                                    container live {
                                        presence "Enable the live context";
                                        description "Enable the live context";

                                        leaf port {
                                            type types-nat:port-number;
                                            description "TCP IP port";
                                        }

                                        leaf router-instance {
                                            type types-sros:named-item-64 {
                                                pattern ".{1,32}" {
                                                    error-message "vRtrName needs to be extended to 64 to support this name";
                                                }
                                            }
                                            description "Router instance or VPRN service name";
                                        }

                                        choice live {
                                            case ip-address {

                                                leaf ip-address {
                                                    type types-sros:ip-address;
                                                    description "IP address of the live output destination server";
                                                }

                                            }
                                            case fqdn {

                                                leaf fqdn {
                                                    type string {
                                                        length "1..255";
                                                    }
                                                    description "Fully qualified domain name of live output destination";
                                                }

                                            }
                                        }
                                    } // container live

                                }
                            }
                        } // container output

                    } // list trace-profile

                } // container call-trace

                list card {
                    key "slot-number";
                    description "Enter the card list instance";

                    leaf slot-number {
                        type union {
                            type string {
                                length "1..64";
                                pattern "<.*>" {
                                    error-message "Config Groups Regex Pattern";
                                }
                            }
                            type types-card:iom-card-slot;
                        }
                        description "Slot number within the chassis";
                    }

                    leaf admin-state {
                        type types-sros:admin-state;
                        description "Administrative state of the card";
                    }

                    leaf card-type {
                        type types-card:sros-iom-type;
                        sros-ext:immutable;
                        description "Card type";
                    }

                    leaf fail-on-error {
                        type boolean;
                        description "Set operational state of the card to Failed upon error";
                    }

                    leaf reset-on-recoverable-error {
                        type boolean;
                        description "Reset card for fatal memory parity error on a Q-chip";
                    }

                    leaf level {
                        type types-card:sros-iom-level;
                        sros-ext:immutable;
                        description "License level of the card";
                    }

                    leaf power-save {
                        type boolean;
                        description "Enable low-power card mode";
                    }

                    leaf filter-profile {
                        type types-card:filter-profile;
                        description "Filter profile for the card";
                    }

                    leaf hash-seed-shift {
                        type uint32 {
                            range "1..16";
                        }
                        description "Number of bits to shift the hash seed result";
                    }

                    list upgrade {
                        key "upgrade-index";
                        description "Enter the upgrade list instance";

                        leaf upgrade-index {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type uint32 {
                                    range "1..6";
                                }
                            }
                            description "Order of the upgrade value";
                        }

                        leaf path {
                            type types-card:sros-iom-level-upgrade-path;
                            sros-ext:immutable;
                            description "Upgrade path of the target module for the slot";
                        }

                    } // list upgrade

                    list event {
                        key "type";
                        description "Enter the event list instance";

                        leaf type {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type enumeration {
                                    enum soft-error                     { value 1; }
                                }
                            }
                            description "Card event type to monitor";
                        }

                        leaf action {
                            type types-chassis:hw-event-action;
                            description "Action taken when an event is detected on the card";
                        }

                    } // list event

                    container virtual-scheduler-adjustment {
                        presence "Enable the virtual-scheduler-adjustment context";
                        description "Enable the virtual-scheduler-adjustment context";

                        leaf internal-scheduler-weight-mode {
                            type types-qos:internal-scheduler-weight-mode;
                            description "Internal scheduler weight mode";
                        }

                        leaf slow-queue-threshold-rate {
                            type uint32 {
                                range "0..1000000";
                            }
                            units "kilobps";
                            description "Slow queue threshold rate";
                        }

                        container interval {
                            description "Enter the interval context";

                            leaf scheduler-run-minimum {
                                type decimal64 {
                                    range "0.01..1000.00";
                                    fraction-digits 2;
                                }
                                units "percent";
                                description "Minimum time of the scheduler run";
                            }

                            leaf task-scheduling {
                                type decimal64 {
                                    range "0.01..1000.00";
                                    fraction-digits 2;
                                }
                                units "percent";
                                description "Task scheduling interval";
                            }

                            container rate-calculation-minimum {
                                description "Enter the rate-calculation-minimum context";

                                leaf fast-queue {
                                    type decimal64 {
                                        range "0.01..1000.00";
                                        fraction-digits 2;
                                    }
                                    units "percent";
                                    description "Minimum rate calculation time for fast queues";
                                }

                                leaf slow-queue {
                                    type decimal64 {
                                        range "0.01..1000.00";
                                        fraction-digits 2;
                                    }
                                    units "percent";
                                    description "Minimum rate calculation time for slow queues";
                                }

                            } // container rate-calculation-minimum

                        } // container interval

                        container workload-performance {
                            description "Enter the workload-performance context";

                            container manual {
                                description "Enter the manual context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the manual controls";
                                }

                                list control {
                                    key "parameter-name";
                                    description "Enter the control list instance";

                                    leaf parameter-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "Task name";
                                    }

                                    leaf percentage {
                                        type decimal64 {
                                            range "20.00..100.00";
                                            fraction-digits 2;
                                        }
                                        units "percent";
                                        description "Task CPU limit";
                                    }

                                } // list control

                            } // container manual

                        } // container workload-performance

                    } // container virtual-scheduler-adjustment

                    list mda {
                        key "mda-slot";
                        description "Enter the mda list instance";

                        leaf mda-slot {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type uint32;
                            }
                            description "MDA or XMA slot";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the MDA";
                        }

                        leaf timestamp-freq {
                            type uint32 {
                                range "19440|77760";
                            }
                            units "kilohertz";
                            description "DCR clocking mode timestamp frequency used on the MDA";
                        }

                        leaf fail-on-error {
                            type boolean;
                            description "Set operational state to Failed if an error is detected";
                        }

                        leaf mda-type {
                            type types-card:sros-mda-type;
                            sros-ext:immutable;
                            description "MDA type for the slot";
                        }

                        leaf power-priority-level {
                            type uint32 {
                                range "1..200";
                            }
                            description "Power priority level for the MDA";
                        }

                        leaf reset-on-recoverable-error {
                            type boolean;
                            description "Reset MDA for fatal memory parity error on a Q-chip";
                        }

                        leaf sync-e {
                            type enumeration {
                                enum true                           { value 1; }
                                enum false                          { value 2; }
                            }
                            description "Synchronous Ethernet capability";
                        }

                        leaf level {
                            type types-card:sros-mda-level;
                            sros-ext:immutable;
                            description "MDA card level";
                        }

                        leaf mac-mode {
                            type types-card:mda-mac-mode;
                            description "MDA2-e-XP or MDA2-s MAC mode";
                        }

                        container clock-mode {
                            status obsolete;
                            description "Enter the clock-mode context";

                            leaf mode {
                                status obsolete;
                                type enumeration {
                                    enum adaptive                       { value 1; }
                                    enum differential                   { value 2; }
                                }
                                description "Clock mode";
                            }

                            leaf timestamp-freq {
                                status obsolete;
                                type uint32 {
                                    range "19440|77760|103680";
                                }
                                description "Differential timestamp frequency";
                            }

                        } // container clock-mode

                        list upgrade {
                            key "upgrade-index";
                            description "Enter the upgrade list instance";

                            leaf upgrade-index {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type uint32 {
                                        range "1..6";
                                    }
                                }
                                description "Order of the upgrade instance";
                            }

                            leaf path {
                                type types-card:sros-mda-level-upgrade-path;
                                sros-ext:immutable;
                                description "Upgrade path of the MDA for the slot";
                            }

                        } // list upgrade

                        container access {
                            presence "Enable the access context";
                            description "Enable the access context";

                            container egress {
                                presence "Enable the egress context";
                                description "Enable the egress context";

                                list pool {
                                    status obsolete;
                                    key "name";
                                    description "Enter the pool list instance";

                                    leaf name {
                                        status obsolete;
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "MDA pool name";
                                    }

                                    leaf amber-alarm-threshold {
                                        status obsolete;
                                        type uint32 {
                                            range "1..1000";
                                        }
                                        units "percent";
                                        description "Amber alarm threshold allowed on oversubscription";
                                    }

                                    leaf red-alarm-threshold {
                                        status obsolete;
                                        type uint32 {
                                            range "1..1000";
                                        }
                                        units "percent";
                                        description "Red alarm threshold allowed on oversubscription";
                                    }

                                    leaf slope-policy {
                                        status obsolete;
                                        type types-sros:named-item;
                                        description "Slope policy";
                                    }

                                    container resv-cbs {
                                        status obsolete;
                                        description "Enter the resv-cbs context";

                                        leaf cbs {
                                            status obsolete;
                                            type int32 {
                                                range "0..100";
                                            }
                                            units "percent";
                                            description "Pool size reserved for CBS";
                                        }

                                        container amber-alarm-action {
                                            status obsolete;
                                            description "Enter the amber-alarm-action context";

                                            leaf step {
                                                status obsolete;
                                                type uint32 {
                                                    range "1..100";
                                                }
                                                units "percent";
                                                description "Step-size percentage for reserved CBS value of the pool";
                                            }

                                            leaf max {
                                                status obsolete;
                                                type uint32 {
                                                    range "1..100";
                                                }
                                                units "percent";
                                                description "Maximum reserved CBS size of the pool";
                                            }

                                        } // container amber-alarm-action

                                    } // container resv-cbs

                                } // list pool

                            } // container egress

                            container ingress {
                                presence "Enable the ingress context";
                                description "Enable the ingress context";

                                list pool {
                                    status obsolete;
                                    key "name";
                                    description "Enter the pool list instance";

                                    leaf name {
                                        status obsolete;
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "MDA pool name";
                                    }

                                    leaf amber-alarm-threshold {
                                        status obsolete;
                                        type uint32 {
                                            range "1..1000";
                                        }
                                        units "percent";
                                        description "Amber alarm threshold allowed on oversubscription";
                                    }

                                    leaf red-alarm-threshold {
                                        status obsolete;
                                        type uint32 {
                                            range "1..1000";
                                        }
                                        units "percent";
                                        description "Red alarm threshold allowed on oversubscription";
                                    }

                                    leaf slope-policy {
                                        status obsolete;
                                        type types-sros:named-item;
                                        description "Slope policy";
                                    }

                                    container resv-cbs {
                                        status obsolete;
                                        description "Enter the resv-cbs context";

                                        leaf cbs {
                                            status obsolete;
                                            type int32 {
                                                range "0..100";
                                            }
                                            units "percent";
                                            description "Pool size reserved for CBS";
                                        }

                                        container amber-alarm-action {
                                            status obsolete;
                                            description "Enter the amber-alarm-action context";

                                            leaf step {
                                                status obsolete;
                                                type uint32 {
                                                    range "1..100";
                                                }
                                                units "percent";
                                                description "Step-size percentage for reserved CBS size of the pool";
                                            }

                                            leaf max {
                                                status obsolete;
                                                type uint32 {
                                                    range "1..100";
                                                }
                                                units "percent";
                                                description "Maximum reserved CBS size of the pool";
                                            }

                                        } // container amber-alarm-action

                                    } // container resv-cbs

                                    container monitor-pool-depth {
                                        status obsolete;
                                        description "Enter the monitor-pool-depth context";

                                        leaf admin-state {
                                            status obsolete;
                                            type types-sros:admin-state;
                                            description "Administrative state of pool-depth monitoring";
                                        }

                                        container alarm-thresholds {
                                            status obsolete;
                                            description "Enter the alarm-thresholds context";

                                            leaf total-pool-in-use {
                                                status obsolete;
                                                type decimal64 {
                                                    range "0.00..100.00";
                                                    fraction-digits 2;
                                                }
                                                units "centipercent";
                                                description "Alarm threshold for usage of total buffer pool";
                                            }

                                            leaf shared-pool-in-use {
                                                status obsolete;
                                                type decimal64 {
                                                    range "0.00..100.00";
                                                    fraction-digits 2;
                                                }
                                                units "centipercent";
                                                description "Alarm threshold for shared of buffer pool usage";
                                            }

                                            leaf reserved-pool-in-use {
                                                status obsolete;
                                                type decimal64 {
                                                    range "0.00..100.00";
                                                    fraction-digits 2;
                                                }
                                                units "centipercent";
                                                description "Alarm threshold for reserved buffer pool usage";
                                            }

                                        } // container alarm-thresholds

                                    } // container monitor-pool-depth

                                } // list pool

                            } // container ingress

                        } // container access

                        container egress-xpl {
                            description "Enter the egress-xpl context";

                            leaf threshold {
                                type uint32 {
                                    range "1..1000000";
                                }
                                units "xpl errors";
                                description "Threshold value for XPL errors";
                            }

                            leaf window {
                                type uint32 {
                                    range "1..1440";
                                }
                                units "minutes";
                                description "Time interval to measure XPL error frequency";
                            }

                        } // container egress-xpl

                        list event {
                            key "type";
                            description "Enter the event list instance";

                            leaf type {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type enumeration {
                                        enum soft-error                     { value 1; }
                                        enum internal-frame-loss            { value 2; }
                                        enum memory-error                   { value 3; }
                                        enum datapath-link-error            { value 4; }
                                    }
                                }
                                description "MDA event type being monitored";
                            }

                            leaf action {
                                type types-chassis:hw-event-action;
                                description "Action when a specific hardware error event is raised";
                            }

                        } // list event

                        container ingress-xpl {
                            description "Enter the ingress-xpl context";

                            leaf threshold {
                                type uint32 {
                                    range "1..1000000";
                                }
                                units "xpl errors";
                                description "Threshold value for XPL errors";
                            }

                            leaf window {
                                type uint32 {
                                    range "1..1440";
                                }
                                units "minutes";
                                description "Time interval to measure XPL error frequency";
                            }

                        } // container ingress-xpl

                        container network {
                            presence "Enable the network context";
                            description "Enable the network context";

                            container egress {
                                presence "Enable the egress context";
                                description "Enable the egress context";

                                list pool {
                                    status obsolete;
                                    key "name";
                                    description "Enter the pool list instance";

                                    leaf name {
                                        status obsolete;
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "MDA pool name";
                                    }

                                    leaf amber-alarm-threshold {
                                        status obsolete;
                                        type uint32 {
                                            range "1..1000";
                                        }
                                        units "percent";
                                        description "Amber alarm threshold allowed on oversubscription";
                                    }

                                    leaf red-alarm-threshold {
                                        status obsolete;
                                        type uint32 {
                                            range "1..1000";
                                        }
                                        units "percent";
                                        description "Red alarm threshold allowed on oversubscription";
                                    }

                                    leaf slope-policy {
                                        status obsolete;
                                        type types-sros:named-item;
                                        description "Slope policy";
                                    }

                                    container resv-cbs {
                                        status obsolete;
                                        description "Enter the resv-cbs context";

                                        leaf cbs {
                                            status obsolete;
                                            type int32 {
                                                range "0..100";
                                            }
                                            units "percent";
                                            description "Pool size reserved for CBS";
                                        }

                                        container amber-alarm-action {
                                            status obsolete;
                                            description "Enter the amber-alarm-action context";

                                            leaf step {
                                                status obsolete;
                                                type uint32 {
                                                    range "1..100";
                                                }
                                                units "percent";
                                                description "Step-size percentage for reserved CBS value of the pool";
                                            }

                                            leaf max {
                                                status obsolete;
                                                type uint32 {
                                                    range "1..100";
                                                }
                                                units "percent";
                                                description "Maximum reserved CBS size of the pool";
                                            }

                                        } // container amber-alarm-action

                                    } // container resv-cbs

                                } // list pool

                            } // container egress

                            container ingress {
                                presence "Enable the ingress context";
                                description "Enable the ingress context";

                                leaf queue-policy {
                                    status obsolete;
                                    type types-sros:named-item;
                                    description "Network-queue policy";
                                }

                                list pool {
                                    status obsolete;
                                    key "name";
                                    description "Enter the pool list instance";

                                    leaf name {
                                        status obsolete;
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "MDA pool name";
                                    }

                                    leaf amber-alarm-threshold {
                                        status obsolete;
                                        type uint32 {
                                            range "1..1000";
                                        }
                                        units "percent";
                                        description "Amber alarm threshold allowed on oversubscription";
                                    }

                                    leaf red-alarm-threshold {
                                        status obsolete;
                                        type uint32 {
                                            range "1..1000";
                                        }
                                        units "percent";
                                        description "Red alarm threshold allowed on oversubscription";
                                    }

                                    leaf slope-policy {
                                        status obsolete;
                                        type types-sros:named-item;
                                        description "Slope policy";
                                    }

                                    container resv-cbs {
                                        status obsolete;
                                        description "Enter the resv-cbs context";

                                        leaf cbs {
                                            status obsolete;
                                            type int32 {
                                                range "0..100";
                                            }
                                            units "percent";
                                            description "Pool size reserved for CBS";
                                        }

                                        container amber-alarm-action {
                                            status obsolete;
                                            description "Enter the amber-alarm-action context";

                                            leaf step {
                                                status obsolete;
                                                type uint32 {
                                                    range "1..100";
                                                }
                                                units "percent";
                                                description "Step-size percentage for reserved CBS size of the pool";
                                            }

                                            leaf max {
                                                status obsolete;
                                                type uint32 {
                                                    range "1..100";
                                                }
                                                units "percent";
                                                description "Maximum reserved CBS size of the pool";
                                            }

                                        } // container amber-alarm-action

                                    } // container resv-cbs

                                    container monitor-pool-depth {
                                        status obsolete;
                                        description "Enter the monitor-pool-depth context";

                                        leaf admin-state {
                                            status obsolete;
                                            type types-sros:admin-state;
                                            description "Administrative state of pool-depth monitoring";
                                        }

                                        container alarm-thresholds {
                                            status obsolete;
                                            description "Enter the alarm-thresholds context";

                                            leaf total-pool-in-use {
                                                status obsolete;
                                                type decimal64 {
                                                    range "0.00..100.00";
                                                    fraction-digits 2;
                                                }
                                                units "centipercent";
                                                description "Alarm threshold for usage of total buffer pool";
                                            }

                                            leaf shared-pool-in-use {
                                                status obsolete;
                                                type decimal64 {
                                                    range "0.00..100.00";
                                                    fraction-digits 2;
                                                }
                                                units "centipercent";
                                                description "Alarm threshold for shared of buffer pool usage";
                                            }

                                            leaf reserved-pool-in-use {
                                                status obsolete;
                                                type decimal64 {
                                                    range "0.00..100.00";
                                                    fraction-digits 2;
                                                }
                                                units "centipercent";
                                                description "Alarm threshold for reserved buffer pool usage";
                                            }

                                        } // container alarm-thresholds

                                    } // container monitor-pool-depth

                                } // list pool

                            } // container ingress

                        } // container network

                        list flex {
                            key "flex-id";
                            description "Enter the flex list instance";

                            leaf flex-id {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type uint32 {
                                        range "1..24";
                                    }
                                }
                                description "FlexE group ID in the MDA slot within the IOM card";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the FlexE group";
                            }

                            leaf description {
                                type types-sros:long-description;
                                description "Text description";
                            }

                            leaf group-number {
                                type string {
                                    length "3..7";
                                }
                                description "FlexE group number used in the FlexE overhead";
                            }

                            container report-alarm {
                                description "Enter the report-alarm context";

                                leaf overhead-frame-not-locked {
                                    type boolean;
                                    description "Report no overhead frame lock";
                                }

                                leaf deskew-failed {
                                    type boolean;
                                    description "Report group members not deskewed";
                                }

                                leaf local-phy-fault {
                                    type boolean;
                                    description "Report local fault for PHY instances";
                                }

                                leaf remote-phy-fault {
                                    type boolean;
                                    description "Report remote PHY fault received";
                                }

                                leaf bad-group-number {
                                    type boolean;
                                    description "Report invalid group number received for PHY instances";
                                }

                                leaf bad-phy-number {
                                    type boolean;
                                    description "Report invalid PHY number received for PHY instances";
                                }

                                leaf bad-phy-instance-number {
                                    type boolean;
                                    description "Report invalid PHY instance number received";
                                }

                                leaf flex-e-map-mismatch {
                                    type boolean;
                                    description "Report invalid FlexE map received for PHY instances";
                                }

                                leaf client-calendar-error {
                                    type boolean;
                                    description "Report invalid calendar received for PHY instances";
                                }

                                leaf calendar-in-use-error {
                                    type boolean;
                                    description "Report wrong calendar in use received for PHY instances";
                                }

                            } // container report-alarm

                            list member {
                                key "port-id";
                                description "Enter the member list instance";

                                leaf port-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:port;
                                    }
                                    description "MDA port ID for the FlexE member";
                                }

                                leaf phy-number {
                                    type uint32 {
                                        range "1..62";
                                    }
                                    sros-ext:immutable;
                                    description "FlexE PHY number for the MDA FlexE member";
                                }

                                container report-alarm {
                                    description "Enter the report-alarm context";

                                    leaf los {
                                        type boolean;
                                        description "Report PHY loss of signal";
                                    }

                                    leaf high-ber {
                                        type boolean;
                                        description "Report high bit error rate (BER) received";
                                    }

                                    leaf am-not-locked {
                                        type boolean;
                                        description "Report unable to achieve alignment marker lock";
                                    }

                                    leaf deskew-failed {
                                        type boolean;
                                        description "Report unable to deskew the PHY";
                                    }

                                    leaf remote-phy-fault {
                                        type boolean;
                                        description "Report PHY has received remote PHY fault (RPF)";
                                    }

                                } // container report-alarm

                                container report-alarm-phy {
                                    description "Enter the report-alarm-phy context";

                                    leaf multiframe-not-locked {
                                        type boolean;
                                        description "Report multiframe not locked for PHY instances";
                                    }

                                    leaf bad-crc {
                                        type boolean;
                                        description "Report CRC error on multiframe for PHY instances";
                                    }

                                    leaf bad-group-number {
                                        type boolean;
                                        description "Report invalid group number for PHY instances";
                                    }

                                    leaf bad-phy-number {
                                        type boolean;
                                        description "Report invalid PHY number received on PHY instances";
                                    }

                                    leaf bad-phy-instance-number {
                                        type boolean;
                                        description "Report invalid PHY instance numbers received";
                                    }

                                    leaf flex-e-map-mismatch {
                                        type boolean;
                                        description "Report invalid FlexE map received for PHY instances";
                                    }

                                    leaf client-calendar-error {
                                        type boolean;
                                        description "Report invalid calendar received for PHY instances";
                                    }

                                    leaf calendar-in-use-error {
                                        type boolean;
                                        description "Report wrong calendar use for PHY instances";
                                    }

                                } // container report-alarm-phy

                            } // list member

                            list client {
                                key "client-index";
                                description "Add a list entry for client";

                                leaf client-index {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "1";
                                        }
                                    }
                                    description "FlexE group client ID within the FlexE group";
                                }

                            } // list client

                        } // list flex

                        container xconnect {
                            description "Enter the xconnect context";

                            list mac {
                                key "mac-id";
                                description "Enter the mac list instance";

                                leaf mac-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "1..12";
                                        }
                                    }
                                    description "MAC ID for the MDA cross-connect";
                                }

                                leaf description {
                                    type types-sros:very-long-description-or-empty;
                                    description "Text description";
                                }

                                list loopback {
                                    key "loopback-id";
                                    description "Enter the loopback list instance";

                                    leaf loopback-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..2";
                                            }
                                        }
                                        description "Loopback ID for the MDA cross-connect";
                                    }

                                    leaf bandwidth {
                                        type uint32 {
                                            range "10|25|40|100|400|800";
                                        }
                                        units "gigabps";
                                        sros-ext:immutable;
                                        description "Maximum bandwidth for a Layer 2 rate for MAC loopback";
                                    }

                                    leaf description {
                                        type types-sros:very-long-description-or-empty;
                                        description "Text description";
                                    }

                                } // list loopback

                            } // list mac

                        } // container xconnect

                    } // list mda

                    list xiom {
                        key "xiom-slot";
