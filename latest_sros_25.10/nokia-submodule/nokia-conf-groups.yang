                                        leaf p2mp-ipv6 {
                                            type boolean;
                                            description "Enable IPv6 P2MP FEC capability";
                                        }

                                        leaf prefix-ipv4 {
                                            type boolean;
                                            description "Enable IPv4 prefix FEC capability";
                                        }

                                        leaf prefix-ipv6 {
                                            type boolean;
                                            description "Enable IPv6 prefix FEC capability";
                                        }

