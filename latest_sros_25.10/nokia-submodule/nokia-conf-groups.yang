                                container ipv4 {
                                    presence "Enable the ipv4 context";
                                    description "Enable the ipv4 context";

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of the LDP interface";
                                    }

                                    leaf transport-address {
                                        type enumeration {
                                            enum interface                      { value 1; }
