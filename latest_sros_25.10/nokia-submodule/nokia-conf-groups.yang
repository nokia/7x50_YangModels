                                            container dst-ip-lsb {
                                                description "Enter the dst-ip-lsb context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the destination IP LSB match";
                                                }

                                            } // container dst-ip-lsb

                                            container dst-ip-msb {
                                                description "Enter the dst-ip-msb context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the destination IP MSB match";
                                                }

                                            } // container dst-ip-msb

                                            container dst-port {
                                                description "Enter the dst-port context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the destination port match";
                                                }

                                            } // container dst-port

                                            container flow-label {
                                                description "Enter the flow-label context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the flow label match";
                                                }

                                            } // container flow-label

                                            container icmp-code {
                                                description "Enter the icmp-code context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the ICMP code matching";
                                                }

                                            } // container icmp-code

                                            container icmp-type {
                                                description "Enter the icmp-type context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the ICMP type matching";
                                                }

                                            } // container icmp-type

                                            container packet-length {
                                                description "Enter the packet-length context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the packet-length match";
                                                }

                                            } // container packet-length

                                            container next-header {
                                                description "Enter the next-header context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of next-header match";
                                                }

                                            } // container next-header

                                            container src-ip-lsb {
                                                description "Enter the src-ip-lsb context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of source IP LSB match";
                                                }

                                            } // container src-ip-lsb

                                            container src-ip-msb {
                                                description "Enter the src-ip-msb context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the source IP MSB match";
                                                }

                                            } // container src-ip-msb

                                            container src-port {
                                                description "Enter the src-port context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the source port match";
                                                }

                                            } // container src-port

                                            container tcp-flags {
                                                description "Enter the tcp-flags context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the TCP flags match";
                                                }

                                            } // container tcp-flags

                                            container tcp-flags-ext {
                                                description "Enter the tcp-flags-ext context";

                                                leaf admin-state {
                                                    type types-sros:admin-state;
                                                    description "Administrative state of the extended TCP flags";
                                                }

                                            } // container tcp-flags-ext

                                        } // container match-criteria

                                    } // container ipv6-filter

                                } // container egress

                            } // container filter

                            container statistics {
                                description "Enter the statistics context";

                                container policer {
                                    description "Enter the policer context";

                                    leaf banks {
                                        type uint32 {
                                            range "0|1|2|4";
                                        }
                                        description "Number of policer banks";
                                    }

                                    leaf dedicated-fc-policers {
                                        type uint32 {
                                            range "0..10816";
                                        }
                                        description "Number of resources allocated to FC policer statistics";
                                    }

                                } // container policer

                                container filter {
                                    description "Enter the filter context";

                                    leaf ingress-banks {
                                        type uint32 {
                                            range "0..4";
                                        }
                                        description "Number of ingress banks";
                                    }

                                    leaf egress-banks {
                                        type uint32 {
                                            range "0..4";
                                        }
                                        description "Number of egress banks";
                                    }

                                } // container filter

                            } // container statistics

                            list pool {
                                key "pool-id";
                                description "Enter the pool list instance";

                                leaf pool-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "1..2";
                                        }
                                    }
                                    description "Pool identifier";
                                }

                                container lag-bundle {
                                    description "Enter the lag-bundle context";

                                    leaf reserved-member-count {
                                        type uint32 {
                                            range "2|4|8|16|32|64";
                                        }
                                        description "Member count reserved for LAG bundle";
                                    }

                                } // container lag-bundle

                            } // list pool

                            container fec {
                                description "Enter the fec context";

                                container system-wide {
                                    description "Enter the system-wide context";

                                    leaf unpaired {
                                        type uint32 {
                                            range "2..10240";
                                        }
                                        description "Number of system-wide unpaired FEC space";
                                    }

                                    leaf paired {
                                        type uint32 {
                                            range "0..8192";
                                        }
                                        description "Number of paired FECs available";
                                    }

                                } // container system-wide

                            } // container fec

                            container lpm {
                                status obsolete;
                                description "Enter the lpm context";

                                list scale-option {
                                    status obsolete;
                                    key "option";
                                    description "Enter the scale-option list instance";

                                    leaf option {
                                        status obsolete;
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..4";
                                            }
                                        }
                                        description "Unique LPM (FIB) scale option";
                                    }

                                    leaf admin-state {
                                        status obsolete;
                                        type types-sros:admin-state;
                                        description "Administrative state of the LPM (FIB) scale option";
                                    }

                                } // list scale-option

                            } // container lpm

                            container policer-and-statistics-override {
                                presence "Enable the policer-and-statistics-override context";
                                description "Enable the policer-and-statistics-override context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of policer and statistics override";
                                }

                                list bank {
                                    key "bank-name";
                                    description "Enter the bank list instance";

                                    leaf bank-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type enumeration {
                                                enum dual-mode-16k-bank-1           { value 1; }
                                                enum dual-mode-16k-bank-2           { value 2; }
                                                enum dual-mode-16k-bank-3           { value 3; }
                                                enum dual-mode-16k-bank-4           { value 4; }
                                                enum dual-mode-16k-bank-5           { value 5; }
                                                enum dual-mode-16k-bank-6           { value 6; }
                                            }
                                        }
                                        description "Bank name";
                                    }

                                    container application {
                                        description "Enter the application context";

                                        leaf group {
                                            type int32 {
                                                range "1..3";
                                            }
                                            description "Group associated to a bank";
                                        }

                                        leaf binding {
                                            type enumeration {
                                                enum policer                        { value 1; }
                                                enum statistics                     { value 2; }
                                            }
                                            description "Application to allocate bank resources";
                                        }

                                    } // container application

                                } // list bank

                                container application-group {
                                    description "Enter the application-group context";

                                    list group {
                                        key "group-id";
                                        description "Enter the group list instance";

                                        leaf group-id {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..3";
                                                }
                                            }
                                            description "Application group ID";
                                        }

                                        container policers {
                                            description "Enter the policers context";

                                            list application {
                                                key "application-id";
                                                description "Enter the application list instance";

                                                leaf application-id {
                                                    type union {
                                                        type string {
                                                            length "1..64";
                                                            pattern "<.*>" {
                                                                error-message "Config Groups Regex Pattern";
                                                            }
                                                        }
                                                        type enumeration {
                                                            enum per-fc-unicast-broadcast-unknown-multicast { value 1; }
                                                            enum per-fc-unicast-multipoint      { value 2; }
                                                            enum per-fc                         { value 3; }
                                                            enum per-2-fc-unicast-multipoint    { value 4; }
                                                            enum per-4-fc-unicast-multipoint    { value 5; }
                                                            enum per-2-fc                       { value 6; }
                                                            enum per-4-fc                       { value 7; }
                                                            enum aggregate-policers             { value 8; }
                                                            enum shared-policers                { value 9; }
                                                            enum filter-shared-policers         { value 11; }
                                                        }
                                                    }
                                                    description "FC policer type";
                                                }

                                                leaf scale {
                                                    type int32 {
                                                        range "0..96";
                                                    }
                                                    description "Number of resources to allocate for policers";
                                                }

                                            } // list application

                                        } // container policers

                                        container statistics {
                                            description "Enter the statistics context";

                                            list application {
                                                key "application-id";
                                                description "Enter the application list instance";

                                                leaf application-id {
                                                    type union {
                                                        type string {
                                                            length "1..64";
                                                            pattern "<.*>" {
                                                                error-message "Config Groups Regex Pattern";
                                                            }
                                                        }
                                                        type enumeration {
                                                            enum aggregate-policers             { value 8; }
                                                            enum shared-policers                { value 9; }
                                                            enum fc-policers                    { value 10; }
                                                            enum filter-shared-policers         { value 11; }
                                                        }
                                                    }
                                                    description "FC policer type";
                                                }

                                                leaf scale {
                                                    type int32 {
                                                        range "0..96";
                                                    }
                                                    description "Number of resources to allocate for policer statistics";
                                                }

                                            } // list application

                                        } // container statistics

                                    } // list group

                                } // container application-group

                            } // container policer-and-statistics-override

                            container bank-allocation {
                                presence "Enable the bank-allocation context";
                                description "Enable the bank-allocation context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of bank allocation";
                                }

                                list bank {
                                    key "bank-id";
                                    description "Enter the bank list instance";

                                    leaf bank-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..10";
                                            }
                                        }
                                        description "Bank ID";
                                    }

                                    leaf application {
                                        type types-system:bank-application-id;
                                        description "Application to assign to the bank";
                                    }

                                } // list bank

                                container application-resource-allocation {
                                    description "Enter the application-resource-allocation context";

                                } // container application-resource-allocation

                                container application-scales {
                                    description "Enter the application-scales context";

                                    container fc-policers {
                                        description "Enter the fc-policers context";

                                        leaf per-fc-unicast-broadcast-unknown-multicast {
                                            type uint32 {
                                                range "0..64";
                                            }
                                            description "Scale value for per-FC unicast and BUM policers";
                                        }

                                        leaf per-fc-unicast-multipoint {
                                            type uint32 {
                                                range "0..64";
                                            }
                                            description "Scale value for per-FC unicast-multipoint policers";
                                        }

                                        leaf per-fc {
                                            type uint32 {
                                                range "0..64";
                                            }
                                            description "Scale value for per-FC policers";
                                        }

                                    } // container fc-policers

                                    container fc-policers-high-scale {
                                        description "Enter the fc-policers-high-scale context";

                                        leaf per-2-fc-unicast-multipoint {
                                            type uint32 {
                                                range "0..64";
                                            }
                                            description "Scale value for per-2-FC unicast-multipoint policers";
                                        }

                                        leaf per-4-fc-unicast-multipoint {
                                            type uint32 {
                                                range "0..64";
                                            }
                                            description "Scale value for per-4-FC unicast-multipoint policers";
                                        }

                                        leaf per-2-fc {
                                            type uint32 {
                                                range "0..64";
                                            }
                                            description "Scale value for per-2-FC high-scale policers";
                                        }

                                        leaf per-4-fc {
                                            type uint32 {
                                                range "0..64";
                                            }
                                            description "Scale value for per-4-FC high-scale policers";
                                        }

                                    } // container fc-policers-high-scale

                                    container l1-policers {
                                        description "Enter the l1-policers context";

                                        leaf aggregate-policers {
                                            type uint32 {
                                                range "0..8";
                                            }
                                            description "Scale value for aggregate policers";
                                        }

                                        leaf shared-policers {
                                            type uint32 {
                                                range "0..32";
                                            }
                                            description "Scale value for shared policers";
                                        }

                                        leaf filter-shared-policers {
                                            type uint32 {
                                                range "0..32";
                                            }
                                            description "Scale value for filter rate-limiting shared policers";
                                        }

                                    } // container l1-policers

                                    container l1-policer-statistics {
                                        description "Enter the l1-policer-statistics context";

                                        leaf aggregate-policers {
                                            type uint32 {
                                                range "0..24";
                                            }
                                            description "Scale value for aggregate policers";
                                        }

                                        leaf filter-shared-policers {
                                            type uint32 {
                                                range "0..84";
                                            }
                                            description "Scale value for filter rate-limiting shared policers";
                                        }

                                    } // container l1-policer-statistics

                                } // container application-scales

                            } // container bank-allocation

                            container segment-routing-v6 {
                                description "Enter the segment-routing-v6 context";

                                container tunnel-termination {
                                    description "Enter the tunnel-termination context";

                                    leaf entries {
                                        type uint32 {
                                            range "256|1024|2048";
                                        }
                                        description "Maximum SRv6 tunnel termination TCAM entries";
                                    }

                                } // container tunnel-termination

                            } // container segment-routing-v6

                            container ecmp {
                                description "Enter the ecmp context";

                                container per-flow-hashing {
                                    description "Enter the per-flow-hashing context";

                                    leaf bgp-mpls-tunnel-bind {
                                        type boolean;
                                        description "Enable per-flow load balancing for autobind services";
                                    }

                                    leaf sdp-bind {
                                        type boolean;
                                        description "Enable per-flow load balancing for manual-bind services";
                                    }

                                } // container per-flow-hashing

                            } // container ecmp

                            container vlan-qos {
                                description "Enter the vlan-qos context";

                                container four-queue {
                                    description "Enter the four-queue context";

                                    leaf scale {
                                        type uint32 {
                                            range "0..4490";
                                        }
                                        description "Number of queue resources to allocate to VLAN QoS";
                                    }

                                    leaf statistics-capable {
                                        type uint32 {
                                            range "0..782";
                                        }
                                        description "Number of statistics resources to allocate to VLAN QoS";
                                    }

                                } // container four-queue

                                container virtual-flow {
                                    description "Enter the virtual-flow context";

                                    container four-queue {
                                        description "Enter the four-queue context";

                                        leaf scale {
                                            type uint32 {
                                                range "0..2227";
                                            }
                                            description "Number of resources to allocate to 4-queue VLAN QoS";
                                        }

                                    } // container four-queue

                                    container eight-queue {
                                        description "Enter the eight-queue context";

                                        leaf scale {
                                            type uint32 {
                                                range "0..1114";
                                            }
                                            description "Number of resources to allocate to 8-queue VLAN QoS";
                                        }

                                    } // container eight-queue

                                } // container virtual-flow

                            } // container vlan-qos

                            container load-balancing {
                                description "Enter the load-balancing context";

                                container ipv6 {
                                    description "Enter the ipv6 context";

                                    leaf non-symmetric-hashing {
                                        type boolean;
                                        description "Enable non-symmetric IPv6 load balancing";
                                    }

                                } // container ipv6

                            } // container load-balancing

                        } // container resource-allocation

                    } // container fp

                    list transmission-profile {
                        key "name";
                        description "Enter the transmission-profile list instance";

                        leaf name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "File transmission profile name";
                        }

                        leaf ipv4-source-address {
                            type types-sros:ipv4-unicast-address;
                            description "IPv4 source address used for the transport protocol";
                        }

                        leaf ipv6-source-address {
                            type types-sros:ipv6-address;
                            description "IPv6 source address used for the transport protocol";
                        }

                        leaf redirection {
                            type uint32 {
                                range "1..8";
                            }
                            description "Maximum level of redirection";
                        }

                        leaf retry {
                            type uint32 {
                                range "1..256";
                            }
                            description "Number of attempts to reconnecting to the server";
                        }

                        leaf router-instance {
                            type types-sros:router-instance-base-management-vprn-loose;
                            description "Router instance used by the transport protocol";
                        }

                        leaf timeout {
                            type uint32 {
                                range "1..3600";
                            }
                            units "seconds";
                            description "Timeout for a response from the server";
                        }

                        leaf http-version {
                            type types-system:http-version-type;
                            description "HTTP version";
                        }

                    } // list transmission-profile

                    container grpc {
                        presence "Enable the grpc context";
                        description "Enable the grpc context";

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the gRPC server";
                        }

                        leaf listening-port {
                            type types-sros:tcp-udp-port-non-zero {
                                range "1024..49151|57400";
                            }
                            description "Listening port for the gRPC server";
                        }

                        leaf delay-on-boot {
                            type uint16 {
                                range "1..3600";
                            }
                            units "seconds";
                            description "Delay for gRPC connections after system boot";
                        }

                        leaf max-msg-size {
                            type uint32 {
                                range "1..1024";
                            }
                            units "megabytes";
                            description "Maximum size of received message";
                        }

                        choice transport {
                            case tls-server-profile {

                                leaf tls-server-profile {
                                    type types-sros:named-item;
                                    description "Preferred TLS server profile";
                                }

                            }
                            case allow-unsecure-connection {

                                leaf allow-unsecure-connection {
                                    type empty;
                                    description "Allow connection without secured transport protocol";
                                }

                            }
                        }
                        container tcp-keepalive {
                            description "Enter the tcp-keepalive context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the TCP keepalive algorithm";
                            }

                            leaf idle-time {
                                type types-sros:time-duration {
                                    range "1..100000";
                                }
                                units "seconds";
                                description "Time until the first TCP keepalive probe is sent";
                            }

                            leaf interval {
                                type types-sros:time-duration {
                                    range "1..100000";
                                }
                                units "seconds";
                                description "Time between TCP keep-alive probes";
                            }

                            leaf retries {
                                type uint32 {
                                    range "3..100";
                                }
                                description "Number of probe retries before closing the connection";
                            }

                        } // container tcp-keepalive


                        container gnmi {
                            description "Enter the gnmi context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the gNMI service";
                            }

                            leaf proto-version {
                                type enumeration {
                                    enum latest {
                                        value 0;
                                        description "Latest supported version";
                                    }
                                    enum v070 {
                                        value 1;
                                        description "gNMI version 0.7.0";
                                    }
                                }
                                description "gnmi.proto version";
                            }

                            leaf auto-config-save {
                                type boolean;
                                description "Automatically save configuration as part of commit";
                            }

                        } // container gnmi

                        container gnoi {
                            description "Enter the gnoi context";

                            container cert-mgmt {
                                description "Enter the cert-mgmt context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of gNOI CertificateManagement";
                                }

                            } // container cert-mgmt

                            container file {
                                description "Enter the file context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the gNOI File service";
                                }

                            } // container file

                            container system {
                                description "Enter the system context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the gNOI System service";
                                }

                            } // container system

                        } // container gnoi


                        container md-cli {
                            description "Enter the md-cli context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the MD-CLI service";
                            }

                        } // container md-cli

                        container rib-api {
                            description "Enter the rib-api context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the RIB API service";
                            }

                            leaf purge-timeout {
                                type types-sros:time-duration {
                                    range "1..100000";
                                }
                                units "seconds";
                                description "Time until stale entries are purged";
                            }

                        } // container rib-api

                    } // container grpc

                    container grpc-tunnel {
                        presence "Enable the grpc-tunnel context";
                        description "Enable the grpc-tunnel context";

                        leaf delay-on-boot {
                            type uint16 {
                                range "1..3600";
                            }
                            units "seconds";
                            description "Delay for gRPC tunnels after system boot";
                        }

                        list destination-group {
                            key "name";
                            description "Enter the destination-group list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Destination group name";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            choice transport {
                                case tls-client-profile {

                                    leaf tls-client-profile {
                                        type types-sros:named-item;
                                        description "TLS client profile assigned to the destination group";
                                    }

                                }
                                case allow-unsecure-connection {

                                    leaf allow-unsecure-connection {
                                        type empty;
                                        description "Allow unsecured operation of gRPC connections";
                                    }

                                }
                            }
                            container tcp-keepalive {
                                description "Enter the tcp-keepalive context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the TCP keepalive algorithm";
                                }

                                leaf idle-time {
                                    type types-sros:time-duration {
                                        range "1..100000";
                                    }
                                    units "seconds";
                                    description "Time until the first TCP keepalive probe is sent";
                                }

                                leaf interval {
                                    type types-sros:time-duration {
                                        range "1..100000";
                                    }
                                    units "seconds";
                                    description "Time between TCP keep-alive probes";
                                }

                                leaf retries {
                                    type uint32 {
                                        range "3..100";
                                    }
                                    description "Number of probe retries before closing the connection";
                                }

                            } // container tcp-keepalive

                            list destination {
                                key "address port";
                                ordered-by user;
                                description "Enter the destination list instance";

                                leaf address {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type union {
                                            type types-sros:ip-address;
                                            type types-sros:fully-qualified-domain-name;
                                        }
                                    }
                                    description "Address of the destination within the destination group";
                                }

                                leaf port {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:tcp-udp-port-non-zero;
                                    }
                                    description "TCP port number for the destination";
                                }

                                leaf router-instance {
                                    type types-sros:named-item-64 {
                                        pattern ".{1,32}" {
                                            error-message "vRtrName needs to be extended to 64 to support this name";
                                        }
                                    }
                                    description "Router instance for the destination group";
                                }

                                leaf local-source-address {
                                    type types-sros:ip-address;
                                    description "Local IP address of packets sent from the source";
                                }

                                leaf originated-qos-marking {
                                    type types-qos:dscp-name;
                                    description "QoS marking used for gRPC tunnel packets";
                                }

                            } // list destination

                        } // list destination-group

                        list tunnel {
                            key "name";
                            description "Enter the tunnel list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Tunnel name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the tunnel";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf destination-group {
                                type types-sros:named-item;
                                description "Destination group used in the tunnel";
                            }

                            container target-name {
                                description "Enter the target-name context";

                                choice tunnel-identifier {
                                    case custom-string {

                                        leaf custom-string {
                                            type types-sros:named-item-64;
                                            description "Custom target name";
                                        }

                                    }
                                    case user-agent {

                                        leaf user-agent {
                                            type empty;
                                            description "Set the user agent as the target name";
                                        }

                                    }
                                    case node-name {

                                        leaf node-name {
                                            type empty;
                                            description "Set the node name as target name";
                                        }

                                    }
                                }
                            } // container target-name

                            list handler {
                                key "name";
                                description "Enter the handler list instance";

                                leaf name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Handler name";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the handler";
                                }

                                leaf port {
                                    type types-sros:tcp-udp-port-non-zero;
                                    description "TCP port number the handler listens to internally";
                                }

                                container target-type {
                                    description "Enter the target-type context";

                                    choice application {
                                        case custom-type {

                                            leaf custom-type {
                                                type string {
                                                    length "1..64";
                                                    pattern "[_0-9A-Z]+" {
                                                        error-message "must only contain uppercase letters, digits or underscores";
                                                    }
                                                }
                                                description "Custom string for target type";
                                            }

                                        }
                                        case grpc-server {

                                            leaf grpc-server {
                                                type empty;
                                                description "Target type set to GNMI_GNOI";
                                            }

                                        }
                                        case ssh-server {

                                            leaf ssh-server {
                                                type empty;
                                                description "Target type is SSH";
                                            }

                                        }
                                    }
                                } // container target-type

                            } // list handler

                        } // list tunnel

                    } // container grpc-tunnel

                    container management-interface {
                        presence "Enable the management-interface context";
                        description "Enable the management-interface context";

                        leaf configuration-mode {
                            type enumeration {
                                enum classic                        { value 1; }
                                enum model-driven                   { value 2; }
                                enum mixed                          { value 3; }
                            }
                            description "Management interfaces allowed to edit the configuration";
                        }

                        leaf schema-path {
                            type types-sros:url;
                            description "Schema path URL";
                        }

                        leaf commit-history {
                            type uint32 {
                                range "0..200";
                            }
                            description "Number of commit history IDs to store";
                        }

                        container commit-management {
                            presence "Enable the commit-management context";
                            description "Enable the commit-management context";

                            container python-scripts {
                                presence "Enable the python-scripts context";
                                description "Enable the python-scripts context";

                                leaf pre-commit-python-script {
                                    type types-sros:named-item;
                                    description "Python script to use for the pre-commit script";
                                }

                                leaf post-commit-python-script {
                                    type types-sros:named-item;
                                    description "Python script to use for the post-commit script";
                                }

                                leaf md-cli-trigger {
                                    type boolean;
                                    description "Trigger commit scripts from the MD-CLI";
                                }

                                leaf netconf-trigger {
                                    type boolean;
                                    description "Trigger commit scripts from NETCONF";
                                }

                                leaf gnmi-trigger {
                                    type boolean;
                                    description "Trigger commit scripts from gNMI";
                                }

                            } // container python-scripts

                        } // container commit-management

                        container cli {
                            presence "Enable the cli context";
                            description "Enable the cli context";

                            leaf-list cli-engine {
                                type types-system:cli-engine-type;
                                max-elements 2;
                                ordered-by user;
                                description "System-wide CLI engine access";
                            }

                            container classic-cli {
                                description "Enter the classic-cli context";

                                leaf allow-immediate {
                                    type boolean;
                                    description "Allow writable access in classic CLI configure branch";
                                }

                                container rollback {
                                    presence "Enable the rollback context";
                                    description "Enable the rollback context";

                                    leaf location {
                                        type types-sros:url;
                                        description "Path and filename prefix for rollback checkpoint files";
                                    }

                                    leaf local-checkpoints {
                                        type uint32 {
                                            range "1..50";
                                        }
                                        description "Maximum number of rollback files on local storage";
                                    }

                                    leaf remote-checkpoints {
                                        type uint32 {
                                            range "1..200";
                                        }
                                        description "Maximum rollback files saved at a remote location";
                                    }

                                    container rescue {
                                        description "Enter the rescue context";

                                        leaf location {
                                            type types-sros:url;
                                            description "Location of the rescue configuration file";
                                        }

                                    } // container rescue

                                } // container rollback

                            } // container classic-cli

                            container md-cli {
                                presence "Enable the md-cli context";
                                description "Enable the md-cli context";

                                leaf auto-config-save {
                                    type boolean;
                                    description "Automatically save configuration as part of commit";
                                }

                                leaf command-accounting-during-load {
                                    status obsolete;
                                    type boolean;
                                    description "Perform remote command accounting during a load or rollback operation";
                                }

                                container environment {
                                    description "Enter the environment context";

                                    leaf more {
                                        type boolean;
                                        description "Activate the pager when output is longer than a screen";
                                    }

                                    leaf time-display {
                                        type enumeration {
                                            enum local                          { value 1; }
                                            enum utc                            { value 2; }
                                        }
                                        description "Time zone to display time";
                                    }

                                    leaf time-format {
                                        type enumeration {
                                            enum iso-8601                       { value 1; }
                                            enum rfc-1123                       { value 2; }
                                            enum rfc-3339                       { value 3; }
                                        }
                                        description "Format to display the date and time";
                                    }

                                    container command-alias {
                                        description "Enter the command-alias context";

                                        list alias {
                                            key "alias-name";
                                            description "Enter the alias list instance";

                                            leaf alias-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type string {
                                                        length "1..64";
                                                        pattern "[_a-zA-Z0-9][-_a-zA-Z0-9]*" {
                                                            error-message "must only contain alpha-numeric characters, underscore or hyphen (not as the first character)";
                                                        }
                                                    }
                                                }
                                                description "Alias name";
                                            }

                                            leaf admin-state {
                                                type types-sros:admin-state;
                                                description "Administrative state of the alias";
                                            }

                                            leaf description {
                                                type types-sros:string-not-all-spaces {
                                                    length "1..110";
                                                }
                                                description "Alias description";
                                            }

                                            choice alias-expansion {
                                                case python {

                                                    leaf python-script {
                                                        type types-sros:named-item;
                                                        description "Python script to run when executing the alias";
                                                    }

                                                }
                                                case cli {

                                                    leaf cli-command {
                                                        type string {
                                                            length "1..255";
                                                        }
                                                        description "CLI command to run when executing the alias";
                                                    }

                                                }
                                            }
                                            list mount-point {
                                                key "path";
                                                description "Add a list entry for mount-point";

                                                leaf path {
                                                    type union {
                                                        type string {
                                                            length "1..64";
                                                            pattern "<.*>" {
                                                                error-message "Config Groups Regex Pattern";
                                                            }
                                                        }
                                                        type union {
                                                            type enumeration {
                                                                enum global                         { value 0; }
                                                            }
                                                            type string {
                                                                length "1..255";
                                                                pattern "/.*" {
                                                                    error-message "must start with forward slash";
                                                                }
                                                            }
                                                        }
                                                    }
                                                    description "Mount point where the alias is available";
                                                }

                                            } // list mount-point

                                        } // list alias

                                    } // container command-alias

                                    container command-completion {
                                        description "Enter the command-completion context";

                                        leaf enter {
                                            type boolean;
                                            description "Complete the command when the Enter key is pressed";
                                        }

                                        leaf space {
                                            type boolean;
                                            description "Complete the command when the Space key is pressed";
                                        }

                                        leaf tab {
                                            type boolean;
                                            description "Complete the command when the Tab key is pressed";
                                        }

                                    } // container command-completion

                                    container commit-options {
                                        description "Enter the commit-options context";

                                        leaf confirm {
                                            type boolean;
                                            description "Require confirmed commit when committing configuration";
                                        }

                                        leaf comment {
                                            type boolean;
                                            description "Require a commit comment when committing configuration";
                                        }

                                    } // container commit-options

                                    container console {
                                        description "Enter the console context";

                                        leaf length {
                                            type uint32 {
                                                range "24..512";
                                            }
                                            description "Number of lines displayed on the console";
                                        }

                                        leaf width {
                                            type uint32 {
                                                range "80..512";
                                            }
                                            description "Number of columns displayed on the console";
                                        }

                                    } // container console

                                    container history {
                                        description "Enter the history context";

                                        leaf recall {
                                            type boolean;
                                            description "Allow command history recall and search execution";
                                        }

                                        leaf size {
                                            type uint16 {
                                                range "0..1000";
                                            }
                                            description "Command history size";
                                        }

                                    } // container history

                                    container info-output {
                                        description "Enter the info-output context";

                                        container always-display {
                                            description "Enter the always-display context";

                                            leaf admin-state {
                                                type boolean;
                                                description "Always display admin-state elements";
                                            }

                                        } // container always-display

                                    } // container info-output

                                    container message-severity-level {
                                        description "Enter the message-severity-level context";

                                        leaf cli {
                                            type enumeration {
                                                enum warning                        { value 6; }
                                                enum info                           { value 7; }
                                            }
                                            description "Message severity threshold for CLI messages";
                                        }

                                    } // container message-severity-level

                                    container progress-indicator {
                                        description "Enter the progress-indicator context";

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the progress indicator";
                                        }

                                        leaf type {
                                            type enumeration {
                                                enum dots                           { value 1; }
                                            }
                                            description "Progress indicator output style";
                                        }

                                        leaf delay {
                                            type uint32 {
                                                range "0..10000";
                                            }
                                            units "milliseconds";
                                            description "Delay before the progress indicator is displayed";
                                        }

                                    } // container progress-indicator

                                    container prompt {
                                        description "Enter the prompt context";

                                        leaf context {
                                            type boolean;
                                            description "Show the current command context in the prompt";
                                        }

                                        leaf newline {
                                            type boolean;
                                            description "Add a new line before every prompt line";
                                        }

                                        leaf timestamp {
                                            type boolean;
                                            description "Show the timestamp before the first prompt line";
                                        }

                                        leaf uncommitted-changes-indicator {
                                            type boolean;
                                            description "Show an asterisk (*) when uncommitted changes exist";
                                        }

                                    } // container prompt

                                    container python {
                                        description "Enter the python context";

                                        leaf memory-reservation {
                                            type uint32 {
                                                range "1..500";
                                            }
                                            units "megabytes";
                                            description "Memory reserved per Python interpreter";
                                        }

                                        leaf minimum-available-memory {
                                            type uint32 {
                                                range "5..50";
                                            }
                                            units "percent";
                                            description "Minimum memory requirement to run a Python interpreter";
                                        }

                                        leaf timeout {
                                            type uint32 {
                                                range "30..86400";
                                            }
                                            units "seconds";
                                            description "Maximum run time before a Python application is stopped";
                                        }

                                    } // container python

                                } // container environment

                            } // container md-cli

                        } // container cli

                        container configuration-save {
                            presence "Enable the configuration-save context";
                            description "Enable the configuration-save context";

                            leaf configuration-backups {
                                type uint32 {
                                    range "1..200";
                                }
                                description "Maximum number of configuration versions maintained";
                            }

                            leaf incremental-saves {
                                type boolean;
                                description "Use incremental saved configuration files";
                            }

                        } // container configuration-save

                        container netconf {
                            presence "Enable the netconf context";
                            description "Enable the netconf context";

                            leaf admin-state {
                                status obsolete;
                                type types-sros:admin-state;
                                description "Administrative state of NETCONF";
                            }

                            leaf port {
                                status obsolete;
                                type uint32 {
                                    range "22|830";
                                }
                                description "Port on which NETCONF server listens for connections";
                            }

                            leaf delay-on-boot {
                                status obsolete;
                                type uint16 {
                                    range "1..3600";
                                }
                                units "seconds";
                                description "Delay for NETCONF connections after system boot";
                            }

                            leaf auto-config-save {
                                type boolean;
                                description "Automatically save configuration as part of commit";
                            }

                            container capabilities {
                                description "Enter the capabilities context";

                                leaf candidate {
                                    type boolean;
                                    description "Allow the NETCONF server to access candidate datastore";
                                }

                                leaf writable-running {
                                    status obsolete;
                                    type boolean;
                                    description "Allow NETCONF server to access the running datastore";
                                }

                            } // container capabilities

                            container listen {
                                description "Enter the listen context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of NETCONF server in listen mode";
                                }

                                leaf port {
                                    type uint32 {
                                        range "22|830|1024..49151";
                                    }
                                    description "Port on which NETCONF server listens for connections";
                                }

                                leaf delay-on-boot {
                                    type uint16 {
                                        range "1..3600";
                                    }
                                    units "seconds";
                                    description "Delay before NETCONF server is operational after boot";
                                }

                            } // container listen

                            container call-home {
                                description "Enter the call-home context";

                                list netconf-client {
                                    key "name";
                                    description "Enter the netconf-client list instance";

                                    leaf name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "Remote NETCONF client name";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of the NETCONF Call Home endpoint";
                                    }

                                    leaf remote-address {
                                        type types-sros:ip-unicast-without-local-address;
                                        description "IP address of the NETCONF client";
                                    }

                                    leaf remote-port {
                                        type types-sros:tcp-udp-port-non-zero;
                                        description "Port that the NETCONF client is listening on";
                                    }

                                    leaf router-instance {
                                        type types-sros:named-item-64 {
                                            pattern ".{1,32}" {
                                                error-message "vRtrName needs to be extended to 64 to support this name";
                                            }
                                        }
                                        description "Router instance or VPRN service name";
                                    }

                                    leaf transport {
                                        type types-system:netconf-transport;
                                        description "Transport type";
                                    }

                                    leaf connection-type {
                                        type enumeration {
                                            enum persistent {
                                                value 0;
                                                description "Enable persistent connection mode";
                                            }
                                        }
                                        description "Call Home connection type";
                                    }

                                    leaf delay-on-boot {
                                        type uint16 {
                                            range "1..3600";
                                        }
                                        units "seconds";
                                        description "Delay for Call Home connections after system boot";
                                    }

                                } // list netconf-client

                                container device-labels {
                                    presence "Enable the device-labels context";
                                    description "Enable the device-labels context";

                                    leaf device-label {
                                        type string {
                                            length "1..16";
                                            pattern "[_0-9a-zA-Z]+" {
                                                error-message "must only contain letters, digits or underscores";
                                            }
                                        }
                                        description "Device label";
                                    }

                                    leaf advertise-system-name {
                                        type boolean;
                                        description "Advertise the system name";
                                    }

                                    leaf advertise-software-version {
                                        type boolean;
                                        description "Advertise the software version";
                                    }

                                    leaf advertise-operating-system {
                                        type boolean;
                                        description "Advertise the network operating system";
                                    }

                                } // container device-labels

                            } // container call-home

                        } // container netconf

                        container operations {
                            presence "Enable the operations context";
                            description "Enable the operations context";

                            container global-timeouts {
                                description "Enter the global-timeouts context";

                                leaf asynchronous-execution {
                                    type types-operation:operation-timeout;
                                    description "Timeout for asynchronous operation execution";
                                }

                                leaf asynchronous-retention {
                                    type types-operation:operation-timeout;
                                    description "Timeout for asynchronous operation data retention";
                                }

                                leaf synchronous-execution {
                                    type types-operation:operation-timeout;
                                    description "Timeout for synchronous operation execution";
                                }

                            } // container global-timeouts

                        } // container operations

                        container remote-management {
                            presence "Enable the remote-management context";
                            description "Enable the remote-management context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of remote management registration";
                            }

                            leaf delay-on-boot {
                                type uint16 {
                                    range "1..3600";
                                }
                                units "seconds";
                                description "Delay for remote management after system boot";
                            }

                            leaf connection-timeout {
                                type uint32 {
                                    range "1..3600";
                                }
                                units "seconds";
                                description "Time without a response before manager declared down";
                            }

                            leaf hello-interval {
                                type types-sros:time-duration {
                                    range "10..216000";
                                }
                                units "seconds";
                                description "Time between hello messages from SR OS node to manager";
                            }

                            leaf router-instance {
                                type types-sros:named-item-64 {
                                    pattern ".{1,32}" {
                                        error-message "vRtrName needs to be extended to 64 to support this name";
                                    }
                                }
                                description "Router name or VPRN service name";
                            }

                            leaf device-label {
                                type types-sros:named-item-64;
                                description "Device label supplied to the remote manager";
                            }

                            leaf device-name {
                                type types-sros:named-item-64;
                                description "Device name supplied to the remote manager";
                            }

                            leaf source-address {
                                type types-sros:ip-address;
                                description "Source IP address for connection to the manager";
                            }

                            leaf source-port {
                                type types-system:remote-mgmt-registration-port;
                                description "Source TCP port number to connection to the manager";
                            }

                            choice transport {
                                case client-tls-profile {

                                    leaf client-tls-profile {
                                        type types-sros:named-item;
                                        description "TLS client profile name";
                                    }

                                }
                                case allow-unsecure-connection {

                                    leaf allow-unsecure-connection {
                                        type empty;
                                        description "Allow connection without secured transport protocol";
                                    }

                                }
                            }
                            list manager {
                                key "manager-name";
                                description "Enter the manager list instance";

                                leaf manager-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item-64;
                                    }
                                    description "Remote management manager name";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of remote management registration";
                                }

                                leaf connection-timeout {
                                    type uint32 {
                                        range "1..3600";
                                    }
                                    units "seconds";
                                    description "Time without response before manager is declared down";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf manager-address {
                                    type union {
                                        type types-sros:ip-address;
                                        type types-sros:fully-qualified-domain-name;
                                    }
                                    description "Destination IP address of the manager";
                                }

                                leaf manager-port {
                                    type types-sros:tcp-udp-port-non-zero;
                                    description "Destination TCP port for gRPC connections to manager";
                                }

                                leaf router-instance {
                                    type types-sros:named-item-64 {
                                        pattern ".{1,32}" {
                                            error-message "vRtrName needs to be extended to 64 to support this name";
                                        }
                                    }
                                    description "Reference to a router or VPRN service name";
                                }

                                leaf device-label {
                                    type types-sros:named-item-64;
                                    description "Device label supplied to the remote manager";
                                }

                                leaf device-name {
                                    type types-sros:named-item-64;
                                    description "Device name supplied to the remote manager";
                                }

                                leaf source-address {
                                    type types-sros:ip-address;
                                    description "Source IP address for connection to the manager";
                                }

                                leaf source-port {
                                    type types-system:remote-mgmt-registration-port;
                                    description "Source TCP destination port number";
                                }

                                choice transport {
                                    case client-tls-profile {

                                        leaf client-tls-profile {
                                            type types-sros:named-item;
                                            description "TLS client profile name assigned to the remote manager";
                                        }

                                    }
                                    case allow-unsecure-connection {

                                        leaf allow-unsecure-connection {
                                            type empty;
                                            description "Allow connection without secured transport protocol";
                                        }

                                    }
                                }
                            } // list manager

                        } // container remote-management

                        container yang-modules {
                            presence "Enable the yang-modules context";
                            description "Enable the yang-modules context";

                            leaf base-r13-modules {
                                status obsolete;
                                type boolean;
                                description "Support Base-R13 YANG models";
                            }

                            leaf nokia-modules {
                                status obsolete;
                                type boolean;
                                description "Support Nokia YANG models";
                            }

                            leaf nokia-submodules {
                                type boolean;
                                description "Support submodule-based packaging of Nokia YANG models";
                            }

                            leaf openconfig-modules {
                                type boolean;
                                description "Support access to OpenConfig YANG models";
                            }

                            leaf nokia-combined-modules {
                                type boolean;
                                description "Support access to combined Nokia YANG models";
                            }

                            leaf shared-model-management {
                                type boolean;
                                description "Allow multiple models to configure the same elements";
                            }

                            container nmda {
                                description "Enter the nmda context";

                                leaf nmda-support {
                                    type boolean;
                                    description "Advertise NMDA support over NETCONF";
                                }

                            } // container nmda

                        } // container yang-modules

                        container snmp {
                            presence "Enable the snmp context";
                            description "Enable the snmp context";

                            leaf engine-id {
                                type types-system:engine-id-as-string;
                                description "SNMP engine ID that identifies the SNMPv3 node";
                            }

                            leaf transport {
                                type enumeration {
                                    enum udp {
                                        value 1;
                                        description "UDP only";
                                    }
                                    enum tcp {
                                        value 2;
                                        description "TCP only";
                                    }
                                    enum both {
                                        value 3;
                                        description "TCP and UDP";
                                    }
                                }
                                description "Transport protocol used by the SNMP agent";
                            }

                            leaf general-port {
                                type types-sros:tcp-udp-port;
                                description "Port number used to send general SNMP messages";
                            }

                            leaf max-bulk-duration {
                                type uint32 {
                                    range "100..5000";
                                }
                                units "milliseconds";
                                description "Maximum process duration before responses are returned";
                            }

                            leaf packet-size {
                                type int32 {
                                    range "484..9216";
                                }
                                description "Maximum SNMP packet size generated by the node";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the SNMP agent";
                            }

                            container streaming {
                                presence "Enable the streaming context";
                                description "Enable the streaming context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of SNMP streaming";
                                }

                            } // container streaming

                        } // container snmp

                    } // container management-interface

                    container thresholds {
                        description "Enter the thresholds context";

                        list cflash-cap-alarm-percent {
                            key "cflash-id";
                            description "Enter the cflash-cap-alarm-percent list instance";

                            leaf cflash-id {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:thresholds-cflash-url;
                                }
                                description "cflash device name monitored for capacity";
                            }

                            leaf rising-threshold {
                                type int32 {
                                    range "0..100";
                                }
                                units "percent";
                                description "Rising threshold for the sampled statistic";
                            }

                            leaf falling-threshold {
                                type int32 {
                                    range "0..100";
                                }
                                units "percent";
                                description "Falling threshold for the sampled statistic";
                            }

                            leaf interval {
                                type int32 {
                                    range "1..2147483647";
                                }
                                description "Polling period over which data is sampled and compared";
                            }

                            leaf rmon-event-type {
                                type types-system:threshold-event-type;
                                description "Notification type specifying action when event occurs";
                            }

                            leaf startup-alarm {
                                type types-system:threshold-startup-alarm;
                                description "Alarm type when the alarm is first created";
                            }

                        } // list cflash-cap-alarm-percent

                        list cflash-cap-warn-percent {
                            key "cflash-id";
                            description "Enter the cflash-cap-warn-percent list instance";

                            leaf cflash-id {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:thresholds-cflash-url;
                                }
                                description "cflash device name monitored for capacity";
                            }

                            leaf rising-threshold {
                                type int32 {
                                    range "0..100";
                                }
                                units "percent";
                                description "Rising threshold for the sampled statistic";
                            }

                            leaf falling-threshold {
                                type int32 {
                                    range "0..100";
                                }
                                units "percent";
                                description "Falling threshold for the sampled statistic";
                            }

                            leaf interval {
                                type int32 {
                                    range "1..2147483647";
                                }
                                description "Polling period over which data is sampled and compared";
                            }

                            leaf rmon-event-type {
                                type types-system:threshold-event-type;
                                description "Notification type specifying action when event occurs";
                            }

                            leaf startup-alarm {
                                type types-system:threshold-startup-alarm;
                                description "Alarm type when the alarm is first created";
                            }

                        } // list cflash-cap-warn-percent

                        container kb-memory-use-alarm {
                            presence "Enable the kb-memory-use-alarm context";
                            description "Enable the kb-memory-use-alarm context";

                            leaf rising-threshold {
                                type int64 {
                                    range "-2147483648..2147483647";
                                }
                                description "Rising threshold for the sampled statistic";
                            }

                            leaf falling-threshold {
                                type int64 {
                                    range "-2147483648..2147483647";
                                }
                                description "Falling threshold for the sampled statistic";
                            }

                            leaf interval {
                                type int32 {
                                    range "1..2147483647";
                                }
                                description "Polling period over which data is sampled and compared";
                            }

                            leaf rmon-event-type {
                                type types-system:threshold-event-type;
                                description "Notification type specifying action when event occurs";
                            }

                            leaf startup-alarm {
                                type types-system:threshold-startup-alarm;
                                description "Alarm type when the alarm is first created";
                            }

                        } // container kb-memory-use-alarm

                        container kb-memory-use-warn {
                            presence "Enable the kb-memory-use-warn context";
                            description "Enable the kb-memory-use-warn context";

                            leaf rising-threshold {
                                type int64 {
                                    range "-2147483648..2147483647";
                                }
                                description "Rising threshold for the sampled statistic";
                            }

                            leaf falling-threshold {
                                type int64 {
                                    range "-2147483648..2147483647";
                                }
                                description "Falling threshold for the sampled statistic";
                            }

                            leaf interval {
                                type int32 {
                                    range "1..2147483647";
                                }
                                description "Polling period over which data is sampled and compared";
                            }

                            leaf rmon-event-type {
                                type types-system:threshold-event-type;
                                description "Notification type specifying action when event occurs";
                            }

                            leaf startup-alarm {
                                type types-system:threshold-startup-alarm;
                                description "Alarm type when the alarm is first created";
                            }

                        } // container kb-memory-use-warn

                        container rmon {
                            description "Enter the rmon context";

                            list alarm {
                                key "rmon-alarm-id";
                                description "Enter the alarm list instance";

                                leaf rmon-alarm-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "0..65400";
                                        }
                                    }
                                    description "RMON alarm identifier";
                                }

                                leaf variable-oid {
                                    type string {
                                        length "1..255";
                                    }
                                    description "Object identifier to sample the specific variable";
                                }

                                leaf interval {
                                    type int32 {
                                        range "1..2147483647";
                                    }
                                    units "seconds";
                                    description "Polling period over which data is sampled and compared";
                                }

                                leaf sample-type {
                                    type types-system:threshold-sample;
                                    description "Sampling type for value comparison with thresholds";
                                }

                                leaf startup-alarm {
                                    type types-system:threshold-startup-alarm;
                                    description "TCA type eligible to be raised on the test's first poll";
                                }

                                leaf rising-event {
                                    type uint32 {
                                        range "0..65400";
                                    }
                                    description "RMON event ID for rising threshold crossing event";
                                }

                                leaf falling-event {
                                    type uint32 {
                                        range "0..65400";
                                    }
                                    description "RMON event ID for falling threshold crossing event";
                                }

                                leaf rising-threshold {
                                    type int64 {
                                        range "-2147483648..2147483647";
                                    }
                                    description "Threshold for the rising sampled statistic";
                                }

                                leaf falling-threshold {
                                    type int64 {
                                        range "-2147483648..2147483647";
                                    }
                                    description "Threshold for the falling sampled statistic";
                                }

                                leaf owner {
                                    type string {
                                        length "1..80";
                                    }
                                    description "Owner that created this entry and uses the resources";
                                }

                            } // list alarm

                            list event {
                                key "rmon-event-id";
                                description "Enter the event list instance";

                                leaf rmon-event-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "1..65400";
                                        }
                                    }
                                    description "Index ID for an entry in the event table";
                                }

                                leaf event-type {
                                    type types-system:threshold-rmon-event-type;
                                    description "Notification action to be taken when the event occurs";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf owner {
                                    type string {
                                        length "1..80";
                                    }
                                    description "Owner that created this entry and uses the resources";
                                }

                            } // list event

                            list hc-alarm {
                                key "rmon-hc-alarm-id";
                                description "Enter the hc-alarm list instance";

                                leaf rmon-hc-alarm-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "1..65400";
                                        }
                                    }
                                    description "RMON high capacity alarm identifier";
                                }

                                leaf variable-oid {
                                    type string {
                                        length "1..255";
                                    }
                                    sros-ext:immutable;
                                    description "Object identifier to sample the specific variable";
                                }

                                leaf interval {
                                    type uint32 {
                                        range "1..2147483647";
                                    }
                                    units "seconds";
                                    sros-ext:immutable;
                                    description "Polling period over which data is sampled and compared";
                                }

                                leaf sample-type {
                                    type types-system:threshold-sample;
                                    sros-ext:immutable;
                                    description "Sampling type for value comparison with thresholds";
                                }

                                leaf startup-alarm {
                                    type types-system:threshold-startup-alarm;
                                    sros-ext:immutable;
                                    description "TCA type eligible to be raised on the test's first poll";
                                }

                                leaf rising-event {
                                    type uint32 {
                                        range "1..65400";
                                    }
                                    sros-ext:immutable;
                                    description "RMON event ID for rising threshold crossing event";
                                }

                                leaf rising-threshold {
                                    type int64 {
                                        range "-9223372036854775806..9223372036854775807";
                                    }
                                    sros-ext:immutable;
                                    description "Threshold for the rising sampled statistic";
                                }

                                leaf falling-event {
                                    type uint32 {
                                        range "1..65400";
                                    }
                                    sros-ext:immutable;
                                    description "RMON event ID for falling threshold crossing event";
                                }

                                leaf falling-threshold {
                                    type int64 {
                                        range "-9223372036854775806..9223372036854775807";
                                    }
                                    sros-ext:immutable;
                                    description "Threshold for the falling sampled statistic";
                                }

                                leaf owner {
                                    type types-sros:string-not-all-spaces {
                                        length "1..127";
                                    }
                                    sros-ext:immutable;
                                    description "Owner that created this entry and uses the resources";
                                }

                            } // list hc-alarm

                        } // container rmon

                    } // container thresholds

                    container ip {
                        presence "Enable the ip context";
                        description "Enable the ip context";

                        leaf allow-qinq-network-interface {
                            type boolean;
                            description "Allow QinQ encapsulation for network interfaces";
                        }

                        leaf enforce-unique-if-index {
                            type boolean;
                            description "Force creation of globally unique IP interface indexes";
                        }

                        leaf mpls-tunnel-mode {
                            type types-sros:mpls-tunnel-mode;
                            description "MPLS tunnel mode";
                        }

                        leaf forward-6in4 {
                            type boolean;
                            description "Allow forwarding of IPv6 over IPv4 to system IP address";
                        }

                        leaf forward-ip-over-gre {
                            type boolean;
                            description "Allow forwarding of IP over GRE to system IP address";
                        }

                        leaf ipv6-eh {
                            type enumeration {
                                enum max                            { value 1; }
                                enum limited                        { value 2; }
                            }
                            description "Number of IPv6 extension headers parsed in line cards";
                        }

                        leaf allow-cpu-fragmentation {
                            type boolean;
                            description "Enable IP fragmentation for packets exceeding IP MTU";
                        }

                        leaf allow-icmp-redirect {
                            type boolean;
                            description "Enable generation of ICMP redirect messages";
                        }

                        leaf buffer-unresolved-packets {
                            type boolean;
                            description "Buffer unresolved packets during ARP";
                        }

                        leaf urpf-check-ignore-default {
                            type boolean;
                            description "Ignore default route when performing a uRPF check";
                        }

                        container mpls {
                            description "Enter the mpls context";

                            leaf label-stack-statistics-count {
                                type uint32 {
                                    range "1..2";
                                }
                                description "Collect traffic statistics on labels of the MPLS stack";
                            }

                        } // container mpls

                    } // container ip

                    container lacp {
                        presence "Enable the lacp context";
                        description "Enable the lacp context";

                        leaf system-priority {
                            type uint32 {
                                range "1..65535";
                            }
                            description "LACP system priority on aggregated Ethernet interfaces";
                        }

                    } // container lacp

                    container lldp {
                        presence "Enable the lldp context";
                        description "Enable the lldp context";

                        leaf tx-credit-max {
                            type int32 {
                                range "1..100";
                            }
                            description "Maximum consecutive LLDPDUs that can be transmitted";
                        }

                        leaf message-fast-tx {
                            type int32 {
                                range "1..3600";
                            }
                            units "seconds";
                            description "Interval at which LLDP frames are transmitted";
                        }

                        leaf message-fast-tx-init {
                            type int32 {
                                range "1..8";
                            }
                            description "PDUs to transmit during the fast transmission period";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of LLDP";
                        }

                        leaf tx-interval {
                            type int32 {
                                range "5..32768";
                            }
                            units "seconds";
                            description "LLDP transmit interval";
                        }

                        leaf tx-hold-multiplier {
                            type int32 {
                                range "2..10";
                            }
                            description "Transmit interval multiplier";
                        }

                        leaf reinit-delay {
                            type int32 {
                                range "1..10";
                            }
                            units "seconds";
                            description "Time required before re-initializing LLDP on a port";
                        }

                        leaf notification-interval {
                            type int32 {
                                range "5..3600";
                            }
                            units "seconds";
                            description "Minimum interval between change notifications";
                        }

                    } // container lldp

                    container l2tp {
                        presence "Enable the l2tp context";
                        description "Enable the l2tp context";

                        container non-multi-chassis-tunnel-id-range {
                            description "Enter the non-multi-chassis-tunnel-id-range context";

                            leaf start {
                                type types-l2tp:loc-tunnel-id-or-zero;
                                description "Lower bound of the range";
                            }

                            leaf end {
                                type types-l2tp:loc-tunnel-id-or-zero;
                                description "Upper bound of the range";
                            }

                        } // container non-multi-chassis-tunnel-id-range

                    } // container l2tp

                    list power-management {
                        key "power-zone";
                        description "Enter the power-management list instance";

                        leaf power-zone {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type uint32 {
                                    range "1..2";
                                }
                            }
                            description "Power zone";
                        }

                        leaf mode {
                            type enumeration {
                                enum none                           { value 0; }
                                enum basic                          { value 1; }
                                enum advanced                       { value 2; }
                            }
                            description "Power capacity mode algorithm";
                        }

                        leaf power-safety-alert {
                            type uint32 {
                                range "0..120000";
                            }
                            units "watts";
                            description "Power capacity to trigger a safety alert event";
                        }

                        leaf power-safety-level {
                            type yang:gauge32 {
                                range "0..100";
                            }
                            units "percent";
                            description "Minimum threshold to power off devices";
                        }

                        container power-save {
                            description "Enter the power-save context";

                            container low-power-fabric {
                                description "Enter the low-power-fabric context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of low-power switch fabric mode";
                                }

                            } // container low-power-fabric


                        } // container power-save

                    } // list power-management

                    container dhcp6 {
                        presence "Enable the dhcp6 context";
                        description "Enable the dhcp6 context";

                        leaf-list adv-noaddrs-global {
                            type enumeration {
                                enum esm-relay                      { value 1; }
                                enum server                         { value 2; }
                            }
                            max-elements 2;
                            description "Applications to send NoAddrsAvail in Advertise messages";
                        }

                    } // container dhcp6

                    list software-repository {
                        key "repository-name";
                        description "Enter the software-repository list instance";

                        leaf repository-name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "Software repository name";
                        }

                        leaf description {
                            type types-sros:description;
                            description "Text description";
                        }

                        leaf primary-location {
                            type string {
                                length "1..180";
                            }
                            description "Primary location for files in the software repository";
                        }

                        leaf secondary-location {
                            type string {
                                length "1..180";
                            }
                            description "Secondary location for files in the software repository";
                        }

                        leaf tertiary-location {
                            type string {
                                length "1..180";
                            }
                            description "Tertiary location for files in the software repository";
                        }

                    } // list software-repository

                    container resource {
                        status obsolete;
                        description "Enter the resource context";

                        list ecmp-profile {
                            status obsolete;
                            key "profile-id";
                            description "Enter the ecmp-profile list instance";

                            leaf profile-id {
                                status obsolete;
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type uint32 {
                                        range "1..2";
                                    }
                                }
                                description "ECMP profile identifier";
                            }

                            leaf type {
                                status obsolete;
                                type enumeration {
                                    enum mpls                           { value 1; }
                                    enum ip                             { value 2; }
                                }
                                sros-ext:immutable;
                                description "ECMP bundle type for the profile";
                            }

                            leaf links {
                                status obsolete;
                                type uint32 {
                                    range "1..16";
                                }
                                description "Maximum number of links per group for the ECMP bundle";
                            }

                            leaf groups {
                                status obsolete;
                                type uint32 {
                                    range "1..2048";
                                }
                                description "Maximum number of groups allowed by the profile";
                            }

                        } // list ecmp-profile

                    } // container resource

                    container switch-fabric {
                        presence "Enable the switch-fabric context";
                        description "Enable the switch-fabric context";

                        leaf sfm-loss-threshold {
                            type uint32 {
                                range "1..7";
                            }
                            description "Number of SFMs that can fail before SFM overload state";
                        }

                        container failure-recovery {
                            description "Enter the failure-recovery context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the failure recovery process";
                            }

                        } // container failure-recovery

                    } // container switch-fabric

                    list usb {
                        key "usb-cflash";
                        description "Enter the usb list instance";

                        leaf usb-cflash {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type enumeration {
                                    enum cf2                            { value 2; }
                                }
                            }
                            description "Specifies the compact flash ID";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the USB port";
                        }

                    } // list usb


                    container fan-control {
                        presence "Enable the fan-control context";
                        description "Enable the fan-control context";

                        leaf increase-min-speed {
                            type boolean;
                            description "Increase minimum speed of router fans";
                        }

                        leaf min-speed {
                            type enumeration {
                                enum 65                             { value 65; }
                                enum 90                             { value 90; }
                            }
                            description "Minimum fan speed for the system as a percentage";
                        }

                        leaf cooling-profile {
                            type enumeration {
                                enum default                        { value 1; }
                                enum aggressive                     { value 2; }
                            }
                            description "Cooling profile used to determine fan speeds";
                        }

                        leaf qsfp-temp-monitor {
                            type boolean;
                            description "Monitor dynamically the QSFP cage temperatures";
                        }

                    } // container fan-control

                    container bluetooth {
                        presence "Enable the bluetooth context";
                        description "Enable the bluetooth context";

                        leaf passkey {
                            type string {
                                length "6";
                                pattern "[0-9]+" {
                                    error-message "passkey can only contain digits";
                                }
                            }
                            description "Bluetooth passkey";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the Bluetooth module";
                        }

                        leaf advertising-timeout {
                            type uint32 {
                                range "30..3600";
                            }
                            units "seconds";
                            description "Bluetooth advertising timeout";
                        }

                        leaf power {
                            status obsolete;
                            type enumeration {
                                enum manual                         { value 1; }
                                enum automatic                      { value 2; }
                            }
                            description "Bluetooth module power state";
                        }

                        leaf power-mode {
                            type enumeration {
                                enum manual                         { value 1; }
                                enum automatic                      { value 2; }
                            }
                            description "Bluetooth module power mode";
                        }

                        leaf pairing-button {
                            type boolean;
                            description "Enable the pairing button";
                        }

                        list device {
                            key "mac-address";
                            description "Enter the device list instance";

                            leaf mac-address {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type yang:mac-address;
                                }
                                description "Bluetooth client device MAC address";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                        } // list device

                        list module {
                            key "cpm-slot";
                            description "Enter the module list instance";

                            leaf cpm-slot {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-card:cpm-card-slot;
                                }
                                description "CPM slot on which the module resides";
                            }

                            leaf provisioned-identifier {
                                type types-sros:display-string {
                                    length "1..32";
                                    pattern ".*\\S.*" {
                                        error-message "provisioned-identifier must not be all spaces";
                                    }
                                }
                                description "Bluetooth module ID";
                            }

                        } // list module

                    } // container bluetooth

                    container central-frequency-clock {
                        presence "Enable the central-frequency-clock context";
                        description "Enable the central-frequency-clock context";

                        leaf ql-minimum {
                            type types-system:ref-ssm-quality-level-override;
                            description "Minimum signal QL for system timing module";
                        }

                        leaf ql-selection {
                            type boolean;
                            description "Consider QL in system and BITS output timing";
                        }

                        leaf revert {
                            type boolean;
                            description "Revert to higher-priority reference source";
                        }

                        leaf wait-to-restore {
                            type uint32 {
                                range "1..12";
                            }
                            units "minutes";
                            description "Time to revalidate a previously failed input reference";
                        }

                        container ref-order {
                            description "Enter the ref-order context";

                            leaf first {
                                type types-system:sets-ref-source;
                                description "First preferred timing reference source";
                            }

                            leaf second {
                                type types-system:sets-ref-source;
                                description "Second preferred timing reference source";
                            }

                            leaf third {
                                type types-system:sets-ref-source;
                                description "Third preferred timing reference source";
                            }

                            leaf fourth {
                                type types-system:sets-ref-source;
                                description "Fourth preferred timing reference source";
                            }

                            leaf fifth {
                                type types-system:sets-ref-source;
                                description "Fifth preferred timing reference source";
                            }

                            leaf sixth {
                                type types-system:sets-ref-source;
                                description "Sixth preferred timing reference source";
                            }

                        } // container ref-order

                        container bits {
                            description "Enter the bits context";

                            leaf interface-type {
                                type types-system:bits-if-type;
                                description "Interface type of the BITS timing reference";
                            }

                            leaf ql-override {
                                type types-system:ssm-quality-level-override;
                                description "Quality level override of a timing reference";
                            }

                            leaf ssm-bit {
                                type uint32 {
                                    range "4..8";
                                }
                                description "Sa bit to convey SSM information";
                            }

                            container input {
                                description "Enter the input context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the BITS input timing reference";
                                }

                            } // container input

                            container output {
                                description "Enter the output context";

                                leaf line-length {
                                    type enumeration {
                                        enum length-not-applicable          { value 0; }
                                        enum 110                            { value 1; }
                                        enum 220                            { value 2; }
                                        enum 330                            { value 3; }
                                        enum 440                            { value 4; }
                                        enum 550                            { value 5; }
                                        enum 660                            { value 6; }
                                    }
                                    description "Line length for the BITS output timing reference";
                                }

                                leaf ql-minimum {
                                    type types-system:ref-ssm-quality-level-override;
                                    description "Minimum signal quality level for BITSout port";
                                }

                                leaf source {
                                    type types-system:bits-out-source;
                                    description "Source of the BITS output timing reference";
                                }

                                leaf squelch {
                                    type boolean;
                                    description "Squelch the signal of the BITS output timing reference";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of BITS output timing reference";
                                }

                            } // container output

                        } // container bits

                        container ptp {
                            description "Enter the ptp context";

                            leaf ql-override {
                                type types-system:ssm-quality-level-override;
                                description "Quality level override of a timing reference";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the PTP timing reference";
                            }

                        } // container ptp

                        container ref1 {
                            description "Enter the ref1 context";

                            leaf ql-override {
                                type types-system:ref-ssm-quality-level-override;
                                description "Quality level override of a timing reference";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the first timing reference";
                            }

                            leaf source-port {
                                type types-sros:port;
                                description "Source port for the first timing reference";
                            }

                        } // container ref1

                        container ref2 {
                            description "Enter the ref2 context";

                            leaf ql-override {
                                type types-system:ref-ssm-quality-level-override;
                                description "Quality level override of a timing reference";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the second timing reference";
                            }

                            leaf source-port {
                                type types-sros:port;
                                description "Source port for the second timing reference";
                            }

                        } // container ref2

                        container synce {
                            description "Enter the synce context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the SyncE timing reference";
                            }

                            leaf ql-override {
                                type types-system:ref-ssm-quality-level-override;
                                description "Quality level override of a timing reference";
                            }

                        } // container synce

                        container gnss {
                            description "Enter the gnss context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the GNSS timing reference";
                            }

                            leaf ql-override {
                                type types-system:gnss-ssm-quality-level-override;
                                description "Quality level override for a timing reference";
                            }

                        } // container gnss

                    } // container central-frequency-clock

                    container cron {
                        presence "Enable the cron context";
                        description "Enable the cron context";

                        list schedule {
                            key "schedule-name owner";
                            description "Enter the schedule list instance";

                            leaf schedule-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Schedule name";
                            }

                            leaf owner {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Schedule owner";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the CRON schedule";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf count {
                                type uint32 {
                                    range "1..65535";
                                }
                                description "Number of times to repeat a periodic schedule run";
                            }

                            leaf interval {
                                type uint32 {
                                    range "30..42949672";
                                }
                                units "seconds";
                                description "Time between each periodic schedule run";
                            }

                            leaf type {
                                type enumeration {
                                    enum periodic                       { value 1; }
                                    enum calendar                       { value 2; }
                                    enum oneshot                        { value 3; }
                                }
                                description "Schedule type";
                            }

                            leaf-list day-of-month {
                                type int32 {
                                    range "-31..-1|1..31";
                                }
                                max-elements 62;
                                description "Days in a month when a schedule runs";
                            }

                            leaf-list hour {
                                type uint32 {
                                    range "0..23";
                                }
                                max-elements 24;
                                description "Hours within a day when the schedule runs";
                            }

                            leaf-list minute {
                                type uint32 {
                                    range "0..59";
                                }
                                max-elements 60;
                                description "Minutes in an hour when the schedule runs";
                            }

                            leaf-list month {
                                type union {
                                    type enumeration {
                                        enum january                        { value 1; }
                                        enum february                       { value 2; }
                                        enum march                          { value 3; }
                                        enum april                          { value 4; }
                                        enum may                            { value 5; }
                                        enum june                           { value 6; }
                                        enum july                           { value 7; }
                                        enum august                         { value 8; }
                                        enum september                      { value 9; }
                                        enum october                        { value 10; }
                                        enum november                       { value 11; }
                                        enum december                       { value 12; }
                                    }
                                    type uint32 {
                                        range "1..12";
                                    }
                                }
                                max-elements 12;
                                description "Months when the schedule runs";
                            }

                            leaf-list weekday {
                                type union {
                                    type enumeration {
                                        enum sunday                         { value 1; }
                                        enum monday                         { value 2; }
                                        enum tuesday                        { value 3; }
                                        enum wednesday                      { value 4; }
                                        enum thursday                       { value 5; }
                                        enum friday                         { value 6; }
                                        enum saturday                       { value 7; }
                                    }
                                    type uint32 {
                                        range "1..7";
                                    }
                                }
                                max-elements 7;
                                description "Weekdays when the schedule runs";
                            }

                            container script-policy {
                                description "Enter the script-policy context";

                                leaf name {
                                    type types-sros:named-item;
                                    description "CLI script policy name";
                                }

                                leaf owner {
                                    type types-sros:named-item;
                                    description "Script policy owner";
                                }

                            } // container script-policy

                            container end-time {
                                description "Enter the end-time context";

                                choice date-or-dayname-time {
                                    case date-and-time {

                                        leaf date-and-time {
                                            type yang:date-and-time;
                                            description "Date and time to stop triggering the schedule";
                                        }

                                    }
                                    case dayname-time {

                                        leaf day {
                                            type enumeration {
                                                enum sunday                         { value 0; }
                                                enum monday                         { value 1; }
                                                enum tuesday                        { value 2; }
                                                enum wednesday                      { value 3; }
                                                enum thursday                       { value 4; }
                                                enum friday                         { value 5; }
                                                enum saturday                       { value 6; }
                                            }
                                            description "Day to stop triggering the schedule";
                                        }

                                        leaf time {
                                            type types-system:hours-minutes-twenty-four;
                                            description "Time to stop triggering the schedule";
                                        }

                                    }
                                }
                            } // container end-time

                        } // list schedule

                    } // container cron

                    container login-control {
                        presence "Enable the login-control context";
                        description "Enable the login-control context";

                        leaf exponential-backoff {
                            type boolean;
                            description "Enable exponential-backoff of the login prompt";
                        }

                        leaf idle-timeout {
                            type union {
                                type enumeration {
                                    enum none                           { value 9999; }
                                }
                                type int64 {
                                    range "1..1440";
                                }
                            }
                            units "minutes";
                            description "Idle timeout for console, FTP, Telnet, and SSH sessions";
                        }

                        leaf login-banner {
                            type boolean;
                            description "Display the SR OS login banner";
                        }

                        container login-scripts {
                            description "Enter the login-scripts context";

                            leaf global-script {
                                type types-sros:string-not-all-spaces {
                                    length "1..180";
                                }
                                description "URL of the global CLI login script";
                            }

                            container per-user-script {
                                description "Enter the per-user-script context";

                                leaf user-directory {
                                    type types-sros:string-not-all-spaces {
                                        length "1..180";
                                    }
                                    description "Directory name of user-defined login script";
                                }

                                leaf file-name {
                                    type types-sros:filename;
                                    description "File name of the per-user login script";
                                }

                            } // container per-user-script

                        } // container login-scripts

                        container motd {
                            description "Enter the motd context";

                            choice motd {
                                case url {

                                    leaf url {
                                        type types-sros:string-not-all-spaces {
                                            length "1..180";
                                        }
                                        description "Location of the message of the day";
                                    }

                                }
                                case text {

                                    leaf text {
                                        type types-sros:string-not-all-spaces {
                                            length "1..900";
                                        }
                                        description "Message of the day displayed after a succesfull login";
                                    }

                                }
                            }
                        } // container motd

                        container pre-login-message {
                            description "Enter the pre-login-message context";

                            leaf message {
                                type types-sros:string-not-all-spaces {
                                    length "1..900";
                                }
                                description "Pre-login message displayed before the login prompt";
                            }

                            leaf name {
                                type boolean;
                                description "Display the system name after the pre-login message";
                            }

                        } // container pre-login-message

                        container ftp {
                            description "Enter the ftp context";

                            leaf inbound-max-sessions {
                                type uint32 {
                                    range "0..5";
                                }
                                description "Maximum number of concurrent inbound FTP sessions";
                            }

                        } // container ftp

                        container ssh {
                            description "Enter the ssh context";

                            leaf graceful-shutdown {
                                type boolean;
                                description "Allow graceful shutdown of SSH sessions";
                            }

                            leaf max-channels-per-connection {
                                type uint32 {
                                    range "1..50";
                                }
                                description "Maximum number of channels per SSH connection";
                            }

                            leaf inbound-max-sessions {
                                type uint32 {
                                    range "0..50";
                                }
                                description "Maximum number of concurrent inbound sessions";
                            }

                            leaf outbound-max-sessions {
                                type uint32 {
                                    range "0..15";
                                }
                                description "Maximum number of concurrent outbound sessions";
                            }

                            leaf ttl-security {
                                type uint32 {
                                    range "1..255";
                                }
                                description "Minimum TTL value for incoming packets";
                            }

                        } // container ssh

                        container telnet {
                            description "Enter the telnet context";

                            leaf graceful-shutdown {
                                type boolean;
                                description "Allow graceful shutdown of Telnet sessions";
                            }

                            leaf inbound-max-sessions {
                                type uint32 {
                                    range "0..50";
                                }
                                description "Maximum number of concurrent inbound sessions";
                            }

                            leaf outbound-max-sessions {
                                type uint32 {
                                    range "0..15";
                                }
                                description "Maximum number of concurrent outbound sessions";
                            }

                            leaf ttl-security {
                                type uint32 {
                                    range "1..255";
                                }
                                description "Minimum TTL value for incoming packets";
                            }

                        } // container telnet

                    } // container login-control

                    container network-element-discovery {
                        presence "Enable the network-element-discovery context";
                        description "Enable the network-element-discovery context";

                        leaf generate-traps {
                            type boolean;
                            description "Generate NE discovery traps";
                        }

                        list profile {
                            key "name";
                            description "Enter the profile list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Profile name";
                            }

                            leaf neid {
                                type string {
                                    length "7..8";
                                }
                                description "Network element ID of the advertised node";
                            }

                            leaf platform-type {
                                type types-sros:named-item-255;
                                description "Platform name and chassis type to be advertised";
                            }

                            leaf vendor-id {
                                type types-sros:named-item-255;
                                description "Vendor ID to be advertised";
                            }

                            leaf system-mac {
                                type types-sros:mac-unicast-address-no-zero;
                                description "MAC address of the advertised node";
                            }

                            container neip {
                                presence "Enable the neip context";
                                description "Enable the neip context";

                                leaf ipv4 {
                                    type types-sros:ipv4-unicast-address;
                                    description "NEIP IPv4 address";
                                }

                                leaf ipv6 {
                                    type types-sros:ipv6-address;
                                    description "NEIP IPv6 address";
                                }

                                container auto-generate {
                                    description "Enter the auto-generate context";

                                    container ipv4 {
                                        presence "Enable the ipv4 context";
                                        description "Enable the ipv4 context";

                                        leaf vendor-id-value {
                                            type uint32 {
                                                range "1..255";
                                            }
                                            description "Most significant byte if the NE IPv4 address";
                                        }

                                    } // container ipv4

                                    container ipv6 {
                                        presence "Enable the ipv6 context";
                                        description "Enable the ipv6 context";

                                        leaf vendor-id-value {
                                            type uint32 {
                                                range "1..255";
                                            }
                                            description "Most significant byte of the NE IPv6 address";
                                        }

                                    } // container ipv6

                                } // container auto-generate

                            } // container neip

                        } // list profile

                    } // container network-element-discovery

                    container persistence {
                        presence "Enable the persistence context";
                        description "Enable the persistence context";

                        container ancp {
                            presence "Enable the ancp context";
                            description "Enable the ancp context";

                            leaf location {
                                type types-system:cpm-flash-id;
                                description "CPM flash card where the information is stored";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                        } // container ancp

                        container application-assurance {
                            presence "Enable the application-assurance context";
                            description "Enable the application-assurance context";

                            leaf location {
                                type types-system:cpm-flash-id;
                                description "CPM flash card where the information is stored";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                        } // container application-assurance

                        container dhcp-server {
                            presence "Enable the dhcp-server context";
                            description "Enable the dhcp-server context";

                            leaf location {
                                type types-system:cpm-flash-id;
                                description "CPM flash card where the information is stored";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                        } // container dhcp-server

                        container nat-port-forwarding {
                            presence "Enable the nat-port-forwarding context";
                            description "Enable the nat-port-forwarding context";

                            leaf location {
                                type types-system:cpm-flash-id;
                                description "CPM flash card where the information is stored";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                        } // container nat-port-forwarding

                        container python-policy-cache {
                            presence "Enable the python-policy-cache context";
                            description "Enable the python-policy-cache context";

                            leaf location {
                                type types-system:cpm-flash-id;
                                description "CPM flash card where the information is stored";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                        } // container python-policy-cache

                        container subscriber-mgmt {
                            presence "Enable the subscriber-mgmt context";
                            description "Enable the subscriber-mgmt context";

                            leaf location {
                                type types-system:cpm-flash-id;
                                description "CPM flash card where the information is stored";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                        } // container subscriber-mgmt

                        container options {
                            presence "Enable the options context";
                            description "Enable the options context";

                            leaf dhcp-leasetime-threshold {
                                type types-sros:time-duration {
                                    range "1..631152000";
                                }
                                description "DHCP lease time limit to be eligible for persistence";
                            }

                        } // container options

                    } // container persistence

                    container ptp {
                        presence "Enable the ptp context";
                        description "Enable the ptp context";

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of PTP";
                        }

                        leaf announce-receipt-timeout {
                            type uint32 {
                                range "2..10";
                            }
                            description "Expired intervals count before timeout event declared";
                        }

                        leaf clock-type {
                            type types-ptp:clock-type;
                            sros-ext:immutable;
                            description "Clock type";
                        }

                        leaf domain {
                            type types-ptp:domain;
                            description "PTP domain";
                        }

                        leaf profile {
                            type types-ptp:profile;
                            sros-ext:immutable;
                            description "PTP profile";
                        }

                        leaf local-priority {
                            type types-ptp:priority {
                                range "1..255";
                            }
                            description "PTP clock local priority";
                        }

                        leaf log-announce-interval {
                            type types-ptp:log-interval {
                                range "-3..4";
                            }
                            description "Announce message interval in log form";
                        }

                        leaf network-type {
                            type enumeration {
                                enum sonet                          { value 1; }
                                enum sdh                            { value 2; }
                            }
                            description "PTP network type";
                        }

                        leaf priority1 {
                            type types-ptp:priority;
                            description "Priority1 of the local clock";
                        }

                        leaf priority2 {
                            type types-ptp:priority;
                            description "Priority2 of the local clock";
                        }

                        leaf tx-while-sync-uncertain {
                            type boolean;
                            description "Send Announce messages while clock is unsynchronized";
                        }

                        leaf time-inaccuracy {
                            type uint32 {
                                range "0..10000000";
                            }
                            units "nanoseconds";
                            description "Time inaccuracy value override";
                        }

                        leaf initial-time-inaccuracy {
                            type uint32 {
                                range "0..10000000";
                            }
                            units "nanoseconds";
                            description "Total time inaccuracy from grandmaster to local clock";
                        }

                        leaf tx-path-trace {
                            type boolean;
                            description "Include PATH TRACE TLV in Announce messages";
                        }

                        leaf max-steps-removed {
                            type uint32 {
                                range "1..255";
                            }
                            description "Threshold for steps removed in Announce messages";
                        }

                        leaf within-holdover-spec-timer {
                            type uint32 {
                                range "0..3600";
                            }
                            units "seconds";
                            description "Duration for local clock to specify the holdover state";
                        }

                        container ptsf {
                            description "Enter the ptsf context";

                            container monitor-ptsf-unusable {
                                description "Enter the monitor-ptsf-unusable context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of PTSF unusable monitoring";
                                }

                            } // container monitor-ptsf-unusable

                        } // container ptsf

                        list port {
                            key "port-id";
                            description "Enter the port list instance";

                            leaf port-id {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:port;
                                }
                                description "Ethernet PTP port ID";
                            }

                            leaf address {
                                type yang:mac-address;
                                description "Destination MAC address of the transmitted PTP messages";
                            }

                            leaf local-priority {
                                type types-ptp:priority {
                                    range "1..255";
                                }
                                description "PTP port local priority";
                            }

                            leaf log-delay-interval {
                                type types-ptp:log-interval {
                                    range "-6..0";
                                }
                                description "Minimum interval for Delay_Req messages in log form";
                            }

                            leaf log-sync-interval {
                                type types-ptp:log-interval {
                                    range "-6..0";
                                }
                                description "Interval for transmission of Sync messages in log form";
                            }

                            leaf master-only {
                                type boolean;
                                description "Restrict the local port to master state";
                            }

                            leaf alternate-profile {
                                type types-sros:named-item-64;
                                description "Alternate profile for the PTP port";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the PTP port";
                            }

                            leaf monitor-receiver {
                                type boolean;
                                description "Enable the PTP port as a monitor-receiver";
                            }

                            leaf monitor-sender {
                                type boolean;
                                description "Enable the PTP port as a monitor-sender";
                            }

                            leaf not-master {
                                type boolean;
                                description "Block PTP port from entering the timeTransmitter state";
                            }

                        } // list port

                        list router {
                            key "router-instance";
                            description "Enter the router list instance";

                            leaf router-instance {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item-64 {
                                        pattern ".{1,32}" {
                                            error-message "vRtrName needs to be extended to 64 to support this name";
                                        }
                                    }
                                }
                                description "Router name or VPRN service name";
                            }

                            leaf peer-limit {
                                type int32 {
                                    range "0..1600";
                                }
                                description "Number of discovered peers allowed for routing instance";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of PTP on the router instance";
                            }

                            list peer {
                                key "ip-address";
                                description "Enter the peer list instance";

                                leaf ip-address {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ip-address;
                                    }
                                    description "IP address of the remote PTP peer";
                                }

                                leaf local-priority {
                                    type types-ptp:priority {
                                        range "1..255";
                                    }
                                    description "PTP peer local priority";
                                }

                                leaf log-sync-interval {
                                    type types-ptp:log-interval {
                                        range "-6..0";
                                    }
                                    description "PTP peer interval for Sync messages in log form";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the PTP peer";
                                }

                                leaf monitor-receiver {
                                    type boolean;
                                    description "Enable the PTP peer as a monitor-receiver";
                                }

                                leaf not-master {
                                    type boolean;
                                    description "Block PTP port from entering the timeTransmitter state";
                                }

                            } // list peer

                        } // list router

                        list alternate-profile {
                            key "name";
                            description "Enter the alternate-profile list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item-64;
                                }
                                description "Alternate profile name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the alternate PTP profile";
                            }

                            leaf profile {
                                type enumeration {
                                    enum g8265dot1-2010 {
                                        value 1;
                                        description "ITU-T G.8265.1 specification";
                                    }
                                    enum ieee1588-2008 {
                                        value 2;
                                        description "2008 version of IEEE 1588 standard";
                                    }
                                    enum g8275dot1-2014 {
                                        value 3;
                                        description "2014 version of ITU-T G.8275.1 specification";
                                    }
                                    enum g8275dot2-2016 {
                                        value 4;
                                        description "2016 version of ITU-T G.8275.2 specification";
                                    }
                                    enum iec-61850-9-3-2016 {
                                        value 5;
                                        description "2016 version of IEC/IEEE 61850-9-3 standard";
                                    }
                                    enum c37dot238-2017 {
                                        value 6;
                                        description "2017 version of C37.238 specification";
                                    }
                                }
                                description "Standard based profile used within an alternate profile";
                            }

                            leaf domain {
                                type types-ptp:domain;
                                description "Alternate profile PTP domain number";
                            }

                            leaf log-announce-interval {
                                type types-ptp:log-interval {
                                    range "-3..4";
                                }
                                description "PTP announce message interval in log form";
                            }

                        } // list alternate-profile

                    } // container ptp

                    container script-control {
                        presence "Enable the script-control context";
                        description "Enable the script-control context";

                        list script {
                            key "script-name owner";
                            description "Enter the script list instance";

                            leaf script-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Script name";
                            }

                            leaf owner {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Script owner";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the script";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf location {
                                type types-sros:string-not-all-spaces {
                                    length "1..255";
                                }
                                description "Script location";
                            }

                        } // list script

                        list script-policy {
                            key "policy-name owner";
                            description "Enter the script-policy list instance";

                            leaf policy-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Script policy name";
                            }

                            leaf owner {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Script policy owner";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the script policy";
                            }

                            leaf expire-time {
                                type union {
                                    type uint32 {
                                        range "0..21474836";
                                    }
                                    type enumeration {
                                        enum forever                        { value 2147483647; }
                                    }
                                }
                                units "seconds";
                                description "Maximum amount of time to keep a run history status";
                            }

                            leaf max-completed {
                                type uint32 {
                                    range "1..1500";
                                }
                                description "Maximum number of script history status entries kept";
                            }

                            leaf results {
                                type types-sros:string-not-all-spaces {
                                    length "1..255";
                                }
                                description "Location to receive CLI output of a script run";
                            }

                            leaf lock-override {
                                type boolean;
                                description "Allow EHS/CRON script to break database explicit lock";
                            }

                            choice script-type {
                                case scriptcontrol {

                                    leaf lifetime {
                                        type union {
                                            type uint32 {
                                                range "0..21474836";
                                            }
                                            type enumeration {
                                                enum forever                        { value 2147483647; }
                                            }
                                        }
                                        units "seconds";
                                        description "Maximum amount of time the script may run";
                                    }

                                    container script {
                                        description "Enter the script context";

                                        leaf name {
                                            type types-sros:named-item;
                                            description "Script name";
                                        }

                                        leaf owner {
                                            type types-sros:named-item;
                                            description "Script owner";
                                        }

                                    } // container script

                                }
                                case python3script {

                                    leaf python-lifetime {
                                        type uint32 {
                                            range "30..86400";
                                        }
                                        units "seconds";
                                        description "Maximum time the Python application can run";
                                    }

                                    container python-script {
                                        description "Enter the python-script context";

                                        leaf name {
                                            type types-sros:named-item;
                                            description "Python application name";
                                        }

                                    } // container python-script

                                }
                            }
                        } // list script-policy

                    } // container script-control

                    container security {
                        presence "Enable the security context";
                        description "Enable the security context";

                        leaf telnet-server {
                            type boolean;
                            description "Enable Telnet servers running on the system";
                        }

                        leaf telnet6-server {
                            type boolean;
                            description "Enable Telnet IPv6 servers running on the system";
                        }

                        leaf ftp-server {
                            type boolean;
                            description "Enable FTP servers running on the system";
                        }

                        leaf per-peer-queuing {
                            type boolean;
                            description "Allow CPM hardware queuing per peer";
                        }

                        leaf console-login {
                            type boolean;
                            description "Enable logins on the serial console port of the CPM";
                        }

                        container telnet {
                            presence "Enable the telnet context";
                            description "Enable the telnet context";

                            leaf listening-port {
                                type types-sros:tcp-udp-port-non-zero {
                                    range "23|1024..49151";
                                }
                                description "TCP port for Telnet connections for VPRN or base routing";
                            }

                        } // container telnet

                        container vprn-network-exceptions {
                            presence "Enable the vprn-network-exceptions context";
                            description "Enable the vprn-network-exceptions context";

                            leaf count {
                                type uint32 {
                                    range "10..1000";
                                }
                                description "Limit of exception messages received";
                            }

                            leaf window {
                                type uint32 {
                                    range "1..60";
                                }
                                units "seconds";
                                description "Time interval to measure exception messages";
                            }

                        } // container vprn-network-exceptions

                        container cpu-protection {
                            presence "Enable the cpu-protection context";
                            description "Enable the cpu-protection context";

                            leaf link-specific-rate {
                                type types-security:cpm-packet-rate-limit;
                                units "packets per second";
                                description "Packet arrival rate limit for link level protocols";
                            }

                            container port-overall-rate {
                                description "Enter the port-overall-rate context";

                                leaf pir {
                                    type types-security:cpm-packet-rate-limit;
                                    units "packets per second";
                                    description "Per-port packet arrival rate limit";
                                }

                                leaf action-low-priority {
                                    type boolean;
                                    description "Mark packets that exceed the rate as low-priority";
                                }

                            } // container port-overall-rate

                            container protocol-protection {
                                presence "Enable the protocol-protection context";
                                description "Enable the protocol-protection context";

                                leaf allow-sham-links {
                                    type boolean;
                                    description "Allow OSPF sham link traffic";
                                }

                                leaf block-pim-tunneled {
                                    type boolean;
                                    description "Block extraction and processing of PIM packets";
                                }

                            } // container protocol-protection

                            container ip-src-monitoring {
                                description "Enter the ip-src-monitoring context";

                                container included-protocols {
                                    description "Enter the included-protocols context";

                                    leaf dhcp {
                                        type boolean;
                                        description "Include extracted DHCP packets for IP source monitoring";
                                    }

                                    leaf gtp {
                                        type boolean;
                                        description "Include extracted GTP packets for IP source monitoring";
                                    }

                                    leaf icmp {
                                        type boolean;
                                        description "Include extracted ICMP packets for IP source monitoring";
                                    }

                                    leaf igmp {
                                        type boolean;
                                        description "Include extracted IGMP packets for IP source monitoring";
                                    }

                                } // container included-protocols

                            } // container ip-src-monitoring

                            list policy {
                                key "policy-id";
                                description "Enter the policy list instance";

                                leaf policy-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-services:cpm-prot-policy-id;
                                    }
                                    description "Policy ID";
                                }

                                leaf alarm {
                                    type boolean;
                                    description "Generate an event when the rate is exceeded";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf overall-rate {
                                    type types-security:cpm-policy-packet-rate-limit;
                                    units "packets per second";
                                    description "Packet arrival rate limit for all packets";
                                }

                                leaf per-source-rate {
                                    type types-security:cpm-policy-packet-rate-limit;
                                    units "packets per second";
                                    description "Per-source packet arrival rate limit";
                                }

                                container out-profile-rate {
                                    description "Enter the out-profile-rate context";

                                    leaf pir {
                                        type types-security:cpm-policy-packet-rate-limit;
                                        units "packets per second";
                                        description "Packet arrival rate limit";
                                    }

                                    leaf log-events {
                                        type boolean;
                                        description "Generate a log event when the packet rate is exceeded";
                                    }

                                } // container out-profile-rate

                                container per-source-parameters {
                                    description "Enter the per-source-parameters context";

                                    container ip-src-monitoring {
                                        description "Enter the ip-src-monitoring context";

                                        leaf limit-dhcp-ci-addr-zero {
                                            type boolean;
                                            description "Apply rate limiting to packets with client IP address 0";
                                        }

                                    } // container ip-src-monitoring

                                } // container per-source-parameters

                                container eth-cfm {
                                    description "Enter the eth-cfm context";

                                    list entry {
                                        key "id";
                                        description "Enter the entry list instance";

                                        leaf id {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..100";
                                                }
                                            }
                                            description "Entry ID";
                                        }

                                        leaf pir {
                                            type union {
                                                type int32 {
                                                    range "0..65534";
                                                }
                                                type enumeration {
                                                    enum max                            { value -1; }
                                                }
                                            }
                                            units "packets per second";
                                            description "Packet arrival rate limit";
                                        }

                                        list level {
                                            key "start end";
                                            description "Add a list entry for level";

                                            leaf start {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "0..7";
                                                    }
                                                }
                                                description "Lower bound of the level range";
                                            }

                                            leaf end {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "0..7";
                                                    }
                                                }
                                                description "Upper bound of the level range";
                                            }

                                        } // list level

                                        list opcode {
                                            key "start end";
                                            description "Add a list entry for opcode";

                                            leaf start {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "0..255";
                                                    }
                                                }
                                                description "Lower bound of the OpCode range";
                                            }

                                            leaf end {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "0..255";
                                                    }
                                                }
                                                description "Upper bound of the OpCode range";
                                            }

                                        } // list opcode

                                    } // list entry

                                } // container eth-cfm

                            } // list policy

                        } // container cpu-protection

                        container dist-cpu-protection {
                            presence "Enable the dist-cpu-protection context";
                            description "Enable the dist-cpu-protection context";

                            list policy {
                                key "policy-name";
                                description "Enter the policy list instance";

                                leaf policy-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Policy name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf type {
                                    type types-system:dcpu-policy-type;
                                    sros-ext:immutable;
                                    description "Policy type";
                                }

                                list protocol {
                                    key "protocol-name";
                                    description "Enter the protocol list instance";

                                    leaf protocol-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-system:dist-cpu-protocol-id;
                                        }
                                        description "Protocol name";
                                    }

                                    container enforcement {
                                        description "Enter the enforcement context";

                                        choice type {
                                            case static {

                                                container static {
                                                    description "Enter the static context";

                                                    leaf policer-name {
                                                        type types-sros:named-item;
                                                        description "Static policer enforced by the protocol";
                                                    }

                                                } // container static

                                            }
                                            case dynamic {

                                                container dynamic {
                                                    description "Enter the dynamic context";

                                                    leaf mon-policer-name {
                                                        type types-sros:named-item;
                                                        description "Dynamic enforcement policer for the protocol";
                                                    }

                                                } // container dynamic

                                            }
                                            case dynamic-local-mon-bypass {

                                                leaf dynamic-local-mon-bypass {
                                                    type empty;
                                                    description "Do not include packets in the local monitoring function";
                                                }

                                            }
                                            case shared {

                                                container shared {
                                                    description "Enter the shared context";

                                                    leaf shared-policer-name {
                                                        type types-sros:named-item;
                                                        description "Shared enforcement policer name";
                                                    }

                                                } // container shared

                                            }
                                        }
                                    } // container enforcement

                                    container dynamic-parameters {
                                        description "Enter the dynamic-parameters context";

                                        leaf detection-time {
                                            type uint32 {
                                                range "1..128000";
                                            }
                                            units "seconds";
                                            description "Minimum time the dynamic policer remains allocated";
                                        }

                                        leaf log-events {
                                            type enumeration {
                                                enum false                          { value 0; }
                                                enum true                           { value 1; }
                                                enum verbose                        { value 2; }
                                            }
                                            description "Control of log events creation for status and activity";
                                        }

                                        container exceed-action {
                                            description "Enter the exceed-action context";

                                            leaf action {
                                                type types-system:dcp-exceed-action;
                                                description "Action taken on control packets when rates are exceeded";
                                            }

                                            leaf hold-down {
                                                type union {
                                                    type enumeration {
                                                        enum indefinite                     { value -1; }
                                                        enum none                           { value 0; }
                                                    }
                                                    type uint32 {
                                                        range "1..10080";
                                                    }
                                                }
                                                units "seconds";
                                                description "Hold down behavior";
                                            }

                                        } // container exceed-action

                                        container rate {
                                            description "Enter the rate context";

                                            choice type {
                                                case kbps {

                                                    container kbps {
                                                        description "Enter the kbps context";

                                                        leaf limit {
                                                            type union {
                                                                type enumeration {
                                                                    enum max                            { value -1; }
                                                                }
                                                                type uint32 {
                                                                    range "1..20000000";
                                                                }
                                                            }
                                                            units "kilobps";
                                                            description "Rate limit";
                                                        }

                                                        leaf mbs {
                                                            type int32 {
                                                                range "0..4194304";
                                                            }
                                                            units "bytes";
                                                            description "Tolerance for the rate";
                                                        }

                                                    } // container kbps

                                                }
                                                case packets {

                                                    container packets {
                                                        description "Enter the packets context";

                                                        leaf limit {
                                                            type union {
                                                                type enumeration {
                                                                    enum max                            { value -1; }
                                                                }
                                                                type uint32 {
                                                                    range "0..8000";
                                                                }
                                                            }
                                                            units "packets per interval";
                                                            description "Packets per interval limit";
                                                        }

                                                        leaf within {
                                                            type uint32 {
                                                                range "1..32767";
                                                            }
                                                            units "seconds";
                                                            description "Measurement interval for packets rate";
                                                        }

                                                        leaf initial-delay {
                                                            type uint32 {
                                                                range "0..255";
                                                            }
                                                            units "packets";
                                                            description "Additional packets allowed in an initial burst";
                                                        }

                                                    } // container packets

                                                }
                                            }
                                        } // container rate

                                    } // container dynamic-parameters

                                } // list protocol

                                list local-monitoring-policer {
                                    key "policer-name";
                                    description "Enter the local-monitoring-policer list instance";

                                    leaf policer-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "Local monitoring policer name";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf exceed-action {
                                        type types-system:dcp-exceed-action;
                                        description "Action taken when policer rates are exceeded";
                                    }

                                    leaf log-events {
                                        type enumeration {
                                            enum false                          { value 0; }
                                            enum true                           { value 1; }
                                            enum verbose                        { value 2; }
                                        }
                                        description "Control of log events creation for status and activity";
                                    }

                                    container rate {
                                        description "Enter the rate context";

                                        choice type {
                                            case kbps {

                                                container kbps {
                                                    description "Enter the kbps context";

                                                    leaf limit {
                                                        type union {
                                                            type enumeration {
                                                                enum max                            { value -1; }
                                                            }
                                                            type uint32 {
                                                                range "1..20000000";
                                                            }
                                                        }
                                                        units "kilobps";
                                                        description "Rate limit";
                                                    }

                                                    leaf mbs {
                                                        type int32 {
                                                            range "0..4194304";
                                                        }
                                                        units "bytes";
                                                        description "Tolerance for the rate";
                                                    }

                                                } // container kbps

                                            }
                                            case packets {

                                                container packets {
                                                    description "Enter the packets context";

                                                    leaf limit {
                                                        type union {
                                                            type enumeration {
                                                                enum max                            { value -1; }
                                                            }
                                                            type uint32 {
                                                                range "0..8000";
                                                            }
                                                        }
                                                        units "packets per interval";
                                                        description "Packets per interval limit";
                                                    }

                                                    leaf within {
                                                        type uint32 {
                                                            range "1..32767";
                                                        }
                                                        units "seconds";
                                                        description "Measurement interval for packets rate";
                                                    }

                                                    leaf initial-delay {
                                                        type uint32 {
                                                            range "0..255";
                                                        }
                                                        units "packets";
                                                        description "Additional packets allowed in an initial burst";
                                                    }

                                                } // container packets

                                            }
                                        }
                                    } // container rate

                                } // list local-monitoring-policer

                                list static-policer {
                                    key "policer-name";
                                    description "Enter the static-policer list instance";

                                    leaf policer-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "Static policer name";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf detection-time {
                                        type uint32 {
                                            range "1..128000";
                                        }
                                        units "seconds";
                                        description "Minimum time the dynamic policer remains allocated";
                                    }

                                    leaf log-events {
                                        type enumeration {
                                            enum false                          { value 0; }
                                            enum true                           { value 1; }
                                            enum verbose                        { value 2; }
                                        }
                                        description "Control of log events creation for status and activity";
                                    }

                                    container exceed-action {
                                        description "Enter the exceed-action context";

                                        leaf action {
                                            type types-system:dcp-exceed-action;
                                            description "Action taken on control packets when rates are exceeded";
                                        }

                                        leaf hold-down {
                                            type union {
                                                type enumeration {
                                                    enum indefinite                     { value -1; }
                                                    enum none                           { value 0; }
                                                }
                                                type uint32 {
                                                    range "1..10080";
                                                }
                                            }
                                            units "seconds";
                                            description "Hold down behavior";
                                        }

                                    } // container exceed-action

                                    container rate {
                                        description "Enter the rate context";

                                        choice type {
                                            case kbps {

                                                container kbps {
                                                    description "Enter the kbps context";

                                                    leaf limit {
                                                        type union {
                                                            type enumeration {
                                                                enum max                            { value -1; }
                                                            }
                                                            type uint32 {
                                                                range "1..20000000";
                                                            }
                                                        }
                                                        units "kilobps";
                                                        description "Rate limit";
                                                    }

                                                    leaf mbs {
                                                        type int32 {
                                                            range "0..4194304";
                                                        }
                                                        units "bytes";
                                                        description "Tolerance for the rate";
                                                    }

                                                } // container kbps

                                            }
                                            case packets {

                                                container packets {
                                                    description "Enter the packets context";

                                                    leaf limit {
                                                        type union {
                                                            type enumeration {
                                                                enum max                            { value -1; }
                                                            }
                                                            type uint32 {
                                                                range "0..8000";
                                                            }
                                                        }
                                                        units "packets per interval";
                                                        description "Packets per interval limit";
                                                    }

                                                    leaf within {
                                                        type uint32 {
                                                            range "1..32767";
                                                        }
                                                        units "seconds";
                                                        description "Measurement interval for packets rate";
                                                    }

                                                    leaf initial-delay {
                                                        type uint32 {
                                                            range "0..255";
                                                        }
                                                        units "packets";
                                                        description "Additional packets allowed in an initial burst";
                                                    }

                                                } // container packets

                                            }
                                        }
                                    } // container rate

                                } // list static-policer

                            } // list policy

                        } // container dist-cpu-protection

                        container dot1x {
                            presence "Enable the dot1x context";
                            description "Enable the dot1x context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of 802.1x network access control";
                            }

                            list radius-policy {
                                key "policy-name";
                                description "Enter the radius-policy list instance";

                                leaf policy-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "RADIUS server policy name for 802.1X authentication";
                                }

                                leaf source-address {
                                    type types-sros:ipv4-unicast-address;
                                    description "Source address of the RADIUS packet";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the server for authentication";
                                }

                                leaf retry {
                                    type uint32 {
                                        range "1..10";
                                    }
                                    description "Number of RADIUS requests toward the same RADIUS server";
                                }

                                leaf timeout {
                                    type uint32 {
                                        range "1..90";
                                    }
                                    units "seconds";
                                    description "Time to wait for a response from the RADIUS server";
                                }

                                list server {
                                    key "server-index";
                                    description "Enter the server list instance";

                                    leaf server-index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..5";
                                            }
                                        }
                                        description "RADIUS server index";
                                    }

                                    leaf address {
                                        type types-sros:ipv4-unicast-address;
                                        description "IP address of the RADIUS dot1x server";
                                    }

                                    leaf secret {
                                        type types-sros:encrypted-leaf {
                                            length "1..54";
                                        }
                                        description "Secret key associated with the RADIUS server";
                                    }

                                    leaf authentication-port {
                                        type types-sros:tcp-udp-port-non-zero;
                                        description "UDP port to contact RADIUS server for authentication";
                                    }

                                    leaf accounting-port {
                                        type types-sros:tcp-udp-port-non-zero;
                                        description "UDP port to contact the RADIUS server for accounting";
                                    }

                                    leaf type {
                                        type enumeration {
                                            enum authorization                  { value 0; }
                                            enum accounting                     { value 1; }
                                            enum combined                       { value 2; }
                                        }
                                        description "RADIUS server type";
                                    }

                                } // list server

                            } // list radius-policy

                        } // container dot1x

                        container keychains {
                            description "Enter the keychains context";

                            list keychain {
                                key "keychain-name";
                                description "Enter the keychain list instance";

                                leaf keychain-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Keychain name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the keychain";
                                }

                                container tcp-option-number {
                                    description "Enter the tcp-option-number context";

                                    leaf receive {
                                        type enumeration {
                                            enum option-253                     { value 1; }
                                            enum option-254                     { value 2; }
                                            enum both                           { value 3; }
                                            enum tcp-ao                         { value 4; }
                                        }
                                        description "TCP option accepted in received TCP packets";
                                    }

                                    leaf send {
                                        type enumeration {
                                            enum option-253                     { value 1; }
                                            enum option-254                     { value 2; }
                                            enum tcp-ao                         { value 4; }
                                        }
                                        description "TCP option accepted in sent TCP packets";
                                    }

                                } // container tcp-option-number

                                container bidirectional {
                                    description "Enter the bidirectional context";

                                    list entry {
                                        key "keychain-entry-index";
                                        description "Enter the entry list instance";

                                        leaf keychain-entry-index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "0..63|255";
                                                }
                                            }
                                            description "Keychain ID";
                                        }

                                        leaf authentication-key {
                                            type types-sros:encrypted-leaf {
                                                length "1..54";
                                            }
                                            sros-ext:immutable;
                                            description "Authentication key used by the encryption algorithm";
                                        }

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the keychain entry";
                                        }

                                        leaf begin-time {
                                            type yang:date-and-time;
                                            description "Calendar date and time to start using the key";
                                        }

                                        leaf algorithm {
                                            type types-security:keychain-algo;
                                            sros-ext:immutable;
                                            description "Encryption algorithm used by the keychain key";
                                        }

                                        leaf option {
                                            type enumeration {
                                                enum none                           { value 0; }
                                                enum basic                          { value 1; }
                                                enum isis-enhanced                  { value 2; }
                                            }
                                            description "Keychain key option";
                                        }

                                        leaf tolerance {
                                            type union {
                                                type types-sros:time-duration {
                                                    range "0..4294967294";
                                                }
                                                type enumeration {
                                                    enum infinite                       { value -1; }
                                                }
                                            }
                                            description "Time eligible receive key overlaps with active send key";
                                        }

                                    } // list entry

                                } // container bidirectional

                                container receive {
                                    description "Enter the receive context";

                                    list entry {
                                        key "keychain-entry-index";
                                        description "Enter the entry list instance";

                                        leaf keychain-entry-index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "0..63|255";
                                                }
                                            }
                                            description "Keychain ID";
                                        }

                                        leaf authentication-key {
                                            type types-sros:encrypted-leaf {
                                                length "1..54";
                                            }
                                            sros-ext:immutable;
                                            description "Authentication key used by the encryption algorithm";
                                        }

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the keychain entry";
                                        }

                                        leaf begin-time {
                                            type yang:date-and-time;
                                            description "Calendar date and time to start using the key";
                                        }

                                        leaf algorithm {
                                            type types-security:keychain-algo;
                                            sros-ext:immutable;
                                            description "Encryption algorithm used by the keychain key";
                                        }

                                        leaf end-time {
                                            type yang:date-and-time;
                                            description "Calendar date and time when system stops using the key";
                                        }

                                        leaf tolerance {
                                            type union {
                                                type types-sros:time-duration {
                                                    range "0..4294967294";
                                                }
                                                type enumeration {
                                                    enum infinite                       { value -1; }
                                                }
                                            }
                                            description "Time eligible receive key overlaps with active send key";
                                        }

                                    } // list entry

                                } // container receive

                                container send {
                                    description "Enter the send context";

                                    list entry {
                                        key "keychain-entry-index";
                                        description "Enter the entry list instance";

                                        leaf keychain-entry-index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "0..63|255";
                                                }
                                            }
                                            description "Keychain ID";
                                        }

                                        leaf authentication-key {
                                            type types-sros:encrypted-leaf {
                                                length "1..54";
                                            }
                                            sros-ext:immutable;
                                            description "Authentication key used by the encryption algorithm";
                                        }

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the keychain entry";
                                        }

                                        leaf begin-time {
                                            type yang:date-and-time;
                                            description "Calendar date and time to start using the key";
                                        }

                                        leaf algorithm {
                                            type types-security:keychain-algo;
                                            sros-ext:immutable;
                                            description "Encryption algorithm used by the keychain key";
                                        }

                                    } // list entry

                                } // container send

                                container macsec {
                                    description "Enter the macsec context";

                                    list entry {
                                        key "keychain-entry-index";
                                        description "Enter the entry list instance";

                                        leaf keychain-entry-index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "0..63";
                                                }
                                            }
                                            description "Keychain ID";
                                        }

                                        leaf cak {
                                            type types-sros:encrypted-leaf-hex-without-prefix {
                                                length "1..71";
                                            }
                                            sros-ext:immutable;
                                            description "CAK used by the encryption algorithm";
                                        }

                                        leaf cak-name {
                                            type types-security:cak-name;
                                            sros-ext:immutable;
                                            description "CAK name";
                                        }

                                        leaf algorithm {
                                            type enumeration {
                                                enum aes-128-cmac-128 {
                                                    value 1;
                                                    description "Algorithm based on AES-CMAC and key size of 128 bits";
                                                }
                                                enum aes-256-cmac-256 {
                                                    value 2;
                                                    description "Algorithm based on AES-CMAC and key size of 256 bits";
                                                }
                                            }
                                            sros-ext:immutable;
                                            description "Encryption algorithm used by the keychain key";
                                        }

                                        leaf tolerance {
                                            type union {
                                                type types-sros:time-duration {
                                                    range "20..4294967294";
                                                }
                                                type enumeration {
                                                    enum infinite                       { value -1; }
                                                }
                                            }
                                            description "Time a receive key should overlap with active send key";
                                        }

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the keychain entry";
                                        }

                                        leaf begin-time {
                                            type yang:date-and-time;
                                            description "Calendar date and time to start using the key";
                                        }

                                    } // list entry

                                } // container macsec

                            } // list keychain

                        } // container keychains

                        container source-address {
                            description "Enter the source-address context";

                            list ipv4 {
                                key "application";
                                description "Enter the ipv4 list instance";

                                leaf application {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type enumeration {
                                            enum telnet {
                                                value 1;
                                                description "Telnet packets";
                                            }
                                            enum ftp {
                                                value 2;
                                                description "FTP packets";
                                            }
                                            enum ssh {
                                                value 3;
                                                description "SSH packets";
                                            }
                                            enum radius {
                                                value 4;
                                                description "RADIUS packets";
                                            }
                                            enum tacplus {
                                                value 5;
                                                description "TACACS+ packets";
                                            }
                                            enum snmptrap {
                                                value 6;
                                                description "SNMP trap packets";
                                            }
                                            enum syslog {
                                                value 7;
                                                description "Syslog packets";
                                            }
                                            enum ping {
                                                value 8;
                                                description "ICMP Echo Reply messages";
                                            }
                                            enum traceroute {
                                                value 9;
                                                description "Traceroute reply messages";
                                            }
                                            enum dns {
                                                value 10;
                                                description "DNS packets";
                                            }
                                            enum sntp {
                                                value 11;
                                                description "SNTP packets";
                                            }
                                            enum ntp {
                                                value 12;
                                                description "NTP packets";
                                            }
                                            enum cflowd {
                                                value 13;
                                                description "Cflowd packets";
                                            }
                                            enum ptp {
                                                value 23;
                                                description "PTP packets";
                                            }
                                            enum mcreporter {
                                                value 24;
                                                description "IGMP Host Report messages";
                                            }
                                            enum sflow {
                                                value 27;
                                                description "Sflow packets";
                                            }
                                            enum icmp-error {
                                                value 29;
                                                description "ICMP error messages";
                                            }
                                            enum ldap {
                                                value 31;
                                                description "LDAP packets";
                                            }
                                        }
                                    }
                                    description "Application that sets the source IPv4 address";
                                }

                                choice source {
                                    case interface-name {

                                        leaf interface-name {
                                            type types-sros:interface-name;
                                            sros-ext:immutable;
                                            description "IP interface name";
                                        }

                                    }
                                    case address {

                                        leaf address {
                                            type types-sros:ipv4-address;
                                            sros-ext:immutable;
                                            description "IPv4 source address for the application";
                                        }

                                    }
                                }
                            } // list ipv4

                            list ipv6 {
                                key "application";
                                description "Enter the ipv6 list instance";

                                leaf application {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type enumeration {
                                            enum telnet {
                                                value 14;
                                                description "Telnet packets";
                                            }
                                            enum ftp {
                                                value 15;
                                                description "FTP packets";
                                            }
                                            enum radius {
                                                value 16;
                                                description "RADIUS packets";
                                            }
                                            enum tacplus {
                                                value 17;
                                                description "TACACS+ packets";
                                            }
                                            enum snmptrap {
                                                value 18;
                                                description "SNMP trap packets";
                                            }
                                            enum syslog {
                                                value 19;
                                                description "Syslog packets";
                                            }
                                            enum ping {
                                                value 20;
                                                description "ICMPv6 Echo Reply messages";
                                            }
                                            enum traceroute {
                                                value 21;
                                                description "Traceroute reply messages";
                                            }
                                            enum dns {
                                                value 22;
                                                description "DNS packets";
                                            }
                                            enum cflowd {
                                                value 25;
                                                description "Cflowd packets";
                                            }
                                            enum ntp {
                                                value 26;
                                                description "NTP packets";
                                            }
                                            enum sflow {
                                                value 28;
                                                description "Sflow packets";
                                            }
                                            enum icmp6-error {
                                                value 30;
                                                description "ICMPv6 error messages";
                                            }
                                            enum ldap {
                                                value 32;
                                                description "LDAP packets";
                                            }
                                            enum ssh {
                                                value 33;
                                                description "SSH packets";
                                            }
                                            enum ptp {
                                                value 34;
                                                description "PTP packets";
                                            }
                                        }
                                    }
                                    description "Application that sets the source IPv6 address";
                                }

                                leaf address {
                                    type types-sros:ipv6-address;
                                    sros-ext:immutable;
                                    description "IPv6 source address for the application";
                                }

                            } // list ipv6

                        } // container source-address

                        container system-passwords {
                            presence "Enable the system-passwords context";
                            description "Enable the system-passwords context";

                            leaf admin-password {
                                type types-sros:hashed-leaf {
                                    length "3..136";
                                }
                                description "Administrative password for the enable command";
                            }

                        } // container system-passwords

                        container tech-support {
                            presence "Enable the tech-support context";
                            description "Enable the tech-support context";

                            leaf ts-location {
                                type types-sros:ts-url-string;
                                description "Default file path for generated tech-support files";
                            }

                        } // container tech-support

                        container hash-control {
                            presence "Enable the hash-control context";
                            description "Enable the hash-control context";

                            container management-interface {
                                description "Enter the management-interface context";

                                container classic-cli {
                                    description "Enter the classic-cli context";

                                    leaf read-algorithm {
                                        type enumeration {
                                            enum all-hash                       { value 0; }
                                            enum hash                           { value 1; }
                                            enum hash2                          { value 2; }
                                            enum custom                         { value 3; }
                                        }
                                        description "Input encryption algorithm for configuration secrets";
                                    }

                                    leaf write-algorithm {
                                        type enumeration {
                                            enum cleartext                      { value 0; }
                                            enum hash                           { value 1; }
                                            enum hash2                          { value 2; }
                                            enum custom                         { value 3; }
                                        }
                                        description "Output encryption algorithm for configuration secrets";
                                    }

                                } // container classic-cli

                                container md-cli {
                                    description "Enter the md-cli context";

                                    leaf hash-algorithm {
                                        type enumeration {
                                            enum cleartext                      { value 0; }
                                            enum hash                           { value 1; }
                                            enum hash2                          { value 2; }
                                            enum custom                         { value 3; }
                                        }
                                        description "Encryption algorithm for configuration secrets";
                                    }

                                } // container md-cli

                                container netconf {
                                    description "Enter the netconf context";

                                    leaf hash-algorithm {
                                        type enumeration {
                                            enum cleartext                      { value 0; }
                                            enum hash                           { value 1; }
                                            enum hash2                          { value 2; }
                                            enum custom                         { value 3; }
                                        }
                                        description "Encryption algorithm for configuration secrets";
                                    }

                                } // container netconf

                                container grpc {
                                    description "Enter the grpc context";

                                    leaf hash-algorithm {
                                        type enumeration {
                                            enum cleartext                      { value 0; }
                                            enum hash                           { value 1; }
                                            enum hash2                          { value 2; }
                                            enum custom                         { value 3; }
                                        }
                                        description "Encryption algorithm for configuration secrets";
                                    }

                                } // container grpc

                            } // container management-interface

                        } // container hash-control

                        container management {
                            presence "Enable the management context";
                            description "Enable the management context";

                            leaf allow-telnet {
                                type boolean;
                                description "Allow access to the IPv4 Telnet server";
                            }

                            leaf allow-telnet6 {
                                type boolean;
                                description "Allow access to the Telnet IPv6 server";
                            }

                            leaf allow-ftp {
                                type boolean;
                                description "Allow access to the FTP server";
                            }

                            leaf allow-ssh {
                                type boolean;
                                description "Allow access to the SSH server";
                            }

                            leaf allow-netconf {
                                type boolean;
                                description "Allow access to the NETCONF server";
                            }

                            leaf allow-grpc {
                                type boolean;
                                description "Allow access to the gRPC server";
                            }

                        } // container management

                        container aaa {
                            presence "Enable the aaa context";
                            description "Enable the aaa context";

                            leaf health-check {
                                type union {
                                    type int32 {
                                        range "6..1500";
                                    }
                                    type enumeration {
                                        enum none                           { value 0; }
                                    }
                                }
                                units "seconds";
                                description "Polling interval of LDAP, RADIUS, and TACACS+ servers";
                            }

                            container remote-servers {
                                presence "Enable the remote-servers context";
                                description "Enable the remote-servers context";

                                container radius {
                                    presence "Enable the radius context";
                                    description "Enable the radius context";

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of the authentication server";
                                    }

                                    leaf accounting {
                                        type boolean;
                                        description "Enable RADIUS command accounting";
                                    }

                                    leaf accounting-port {
                                        type uint32 {
                                            range "1..65535";
                                        }
                                        description "Port number on RADIUS server for accounting requests";
                                    }

                                    leaf authorization {
                                        type boolean;
                                        description "Enable RADIUS authorization";
                                    }

                                    leaf interactive-authentication {
                                        type boolean;
                                        description "Enable RADIUS interactive authentication";
                                    }

                                    leaf server-retry {
                                        type uint32 {
                                            range "1..10";
                                        }
                                        description "Number of attempts to retry contacting RADIUS server";
                                    }

                                    leaf server-timeout {
                                        type uint32 {
                                            range "1..90";
                                        }
                                        units "seconds";
                                        description "Time to wait for a response from the RADIUS server";
                                    }

                                    leaf port {
                                        type uint32 {
                                            range "1..65535";
                                        }
                                        description "UDP port number on which to contact RADIUS server";
                                    }

                                    leaf use-default-template {
                                        type boolean;
                                        description "Apply the RADIUS default user template to RADIUS user";
                                    }

                                    leaf access-algorithm {
                                        type enumeration {
                                            enum direct                         { value 1; }
                                            enum round-robin                    { value 2; }
                                        }
                                        description "Algorithm used to access the set of RADIUS servers";
                                    }

                                    leaf route-preference {
                                        type types-security:aaa-route-preference;
                                        description "Route preference to reach the AAA server";
                                    }

                                    list server {
                                        key "index";
                                        description "Enter the server list instance";

                                        leaf index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..5";
                                                }
                                            }
                                            description "RADIUS server ID";
                                        }

                                        leaf address {
                                            type types-sros:ip-unicast-address;
                                            description "IP address of the RADIUS server";
                                        }

                                        leaf authenticator {
                                            type enumeration {
                                                enum md5                            { value 1; }
                                                enum sm3                            { value 2; }
                                            }
                                            description "Authenticator hash algorithm for the RADIUS server";
                                        }

                                        leaf secret {
                                            type types-sros:encrypted-leaf {
                                                length "1..115";
                                            }
                                            description "Secret key to access the RADIUS server";
                                        }

                                        leaf tls-client-profile {
                                            type types-sros:named-item;
                                            description "TLS client profile for the RADIUS server";
                                        }

                                    } // list server

                                } // container radius

                                container ldap {
                                    presence "Enable the ldap context";
                                    description "Enable the ldap context";

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of the LDAP operation protocol";
                                    }

                                    leaf public-key-authentication {
                                        type boolean;
                                        description "Allow SSH public key authentication from LDAP server";
                                    }

                                    leaf server-retry {
                                        type uint32 {
                                            range "1..10";
                                        }
                                        description "Number of attempts to retry contacting the LDAP server";
                                    }

                                    leaf server-timeout {
                                        type types-sros:time-duration {
                                            range "1..90";
                                        }
                                        units "seconds";
                                        description "Timeout for a response from the LDAP server";
                                    }

                                    leaf use-default-template {
                                        type boolean;
                                        description "Apply the default template to LDAP";
                                    }

                                    leaf route-preference {
                                        type types-security:aaa-route-preference;
                                        description "Route preference to reach the AAA server";
                                    }

                                    list server {
                                        key "index";
                                        description "Enter the server list instance";

                                        leaf index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..5";
                                                }
                                            }
                                            description "LDAP server ID";
                                        }

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the LDAP server";
                                        }

                                        leaf server-name {
                                            type types-sros:named-item;
                                            description "LDAP server name";
                                        }

                                        leaf tls-profile {
                                            type types-sros:named-item;
                                            description "TLS client profile used to encrypt the LDAP connection";
                                        }

                                        list address {
                                            key "ip-address";
                                            description "Enter the address list instance";

                                            leaf ip-address {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:ip-unicast-address;
                                                }
                                                description "LDAP server address";
                                            }

                                            leaf port {
                                                type int32 {
                                                    range "1..65535";
                                                }
                                                description "Port number on which to contact the LDAP server";
                                            }

                                        } // list address

                                        container bind-authentication {
                                            description "Enter the bind-authentication context";

                                            leaf root-dn {
                                                type types-sros:string-not-all-spaces {
                                                    length "1..512";
                                                }
                                                description "Root domain used for authentication with LDAP server";
                                            }

                                            leaf password {
                                                type types-sros:encrypted-leaf {
                                                    length "1..199";
                                                }
                                                description "Password used for authentication with the LDAP server";
                                            }

                                        } // container bind-authentication

                                        container search {
                                            description "Enter the search context";

                                            leaf base-dn {
                                                type types-sros:string-not-all-spaces {
                                                    length "1..512";
                                                }
                                                description "LDAP server search base domain name";
                                            }

                                        } // container search

                                    } // list server

                                } // container ldap

                                container tacplus {
                                    presence "Enable the tacplus context";
                                    description "Enable the tacplus context";

                                    leaf interactive-authentication {
                                        type boolean;
                                        description "Allows TACACS+ interactive authentication";
                                    }

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of the TACACS+ protocol";
                                    }

                                    leaf server-timeout {
                                        type types-sros:time-duration {
                                            range "1..90";
                                        }
                                        units "seconds";
                                        description "Time to wait for a response from the TACACS+ server";
                                    }

                                    leaf server-retry-timeout {
                                        type union {
                                            type types-sros:time-duration {
                                                range "1..300";
                                            }
                                            type enumeration {
                                                enum none {
                                                    value 0;
                                                    description "Disable retry timeout and send requests immediately";
                                                }
                                            }
                                        }
                                        units "seconds";
                                        description "Time before retrying requests when health checks are disabled";
                                    }

                                    leaf use-default-template {
                                        type boolean;
                                        description "Apply TACACS+ default user-template to TACACS+ user";
                                    }

                                    leaf ignore-unknown-mandatory-vsas {
                                        type boolean;
                                        description "Ignore unknown mandatory VSAs and fail authentication";
                                    }

                                    leaf route-preference {
                                        type types-security:aaa-route-preference;
                                        description "Route preference to reach the AAA server";
                                    }

                                    container accounting {
                                        presence "Enable the accounting context";
                                        description "Enable the accounting context";

                                        leaf record-type {
                                            type enumeration {
                                                enum start-stop                     { value 1; }
                                                enum stop-only                      { value 2; }
                                            }
                                            description "Type of accounting record packet sent to TACACS+ server";
                                        }

                                    } // container accounting

                                    container authorization {
                                        presence "Enable the authorization context";
                                        description "Enable the authorization context";

                                        leaf use-priv-lvl {
                                            type boolean;
                                            description "Allow privilege level mapping";
                                        }

                                        container request-format {
                                            description "Enter the request-format context";

                                            leaf-list access-operation-cmd {
                                                type enumeration {
                                                    enum delete                         { value 1; }
                                                }
                                                max-elements 1;
                                                description "Access operations sent in authorization requests";
                                            }

                                        } // container request-format

                                    } // container authorization

                                    container admin-control {
                                        description "Enter the admin-control context";

                                        leaf tacplus-map-to-priv-lvl {
                                            type int32 {
                                                range "0..15";
                                            }
                                            description "Interactive authentication from node to TACACS+ server";
                                        }

                                    } // container admin-control

                                    container priv-lvl-map {
                                        presence "Enable the priv-lvl-map context";
                                        description "Enable the priv-lvl-map context";

                                        list priv-lvl {
                                            key "level";
                                            description "Enter the priv-lvl list instance";

                                            leaf level {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "0..15";
                                                    }
                                                }
                                                description "Privilege level for the mapping";
                                            }

                                            leaf user-profile-name {
                                                type types-sros:named-item {
                                                    pattern "[^ ]*" {
                                                        error-message "The name cannot contain spaces.";
                                                    }
                                                }
                                                description "User profile for the mapping";
                                            }

                                        } // list priv-lvl

                                    } // container priv-lvl-map

                                    container service-request {
                                        description "Enter the service-request context";

                                        leaf nokia-grpc-rpc-authorization {
                                            type boolean;
                                            description "Request nokia-grpc-rpc-authorization service VSAs";
                                        }

                                        leaf nokia-netconf-base-op-authorization {
                                            type boolean;
                                            description "Request nokia-netconf-base-op-authorization service VSAs";
                                        }

                                        leaf nokia-user {
                                            type boolean;
                                            description "Request nokia-user service VSAs";
                                        }

                                        leaf nokia-user-profile {
                                            type boolean;
                                            description "Request nokia-user-profile service VSAs";
                                        }

                                    } // container service-request

                                    list server {
                                        key "index";
                                        description "Enter the server list instance";

                                        leaf index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..5";
                                                }
                                            }
                                            description "TACACS+ server ID";
                                        }

                                        leaf address {
                                            type types-sros:ip-unicast-address;
                                            description "IP address of the TACACS+ server";
                                        }

                                        leaf port {
                                            type types-qos:tcp-udp-match-port;
                                            description "TCP port ID on which to contact TACACS+ server";
                                        }

                                        leaf secret {
                                            type types-sros:encrypted-leaf {
                                                length "1..199";
                                            }
                                            description "Secret key to access the TACACS+ server";
                                        }

                                    } // list server

                                } // container tacplus

                                container vprn-server {
                                    presence "Enable the vprn-server context";
                                    description "Enable the vprn-server context";

                                    leaf inband {
                                        type types-services:service-name;
                                        description "VPRN service used for AAA by in-band sessions";
                                    }

                                    leaf outband {
                                        type types-services:service-name;
                                        description "VPRN service used for AAA by out-of-band sessions";
                                    }

                                    leaf vprn {
                                        type types-services:service-name;
                                        description "VPRN used for AAA in VPRNs without a AAA server";
                                    }

                                } // container vprn-server

                            } // container remote-servers

                            container local-profiles {
                                presence "Enable the local-profiles context";
                                description "Enable the local-profiles context";

                                list profile {
                                    key "user-profile-name";
                                    description "Enter the profile list instance";

                                    leaf user-profile-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item {
                                                pattern "[^ ]*" {
                                                    error-message "The name cannot contain spaces.";
                                                }
                                            }
                                        }
                                        description "User profile name";
                                    }

                                    leaf cli-session-group {
                                        type types-sros:named-item {
                                            pattern "[^ ]*" {
                                                error-message "The name cannot contain spaces.";
                                            }
                                        }
                                        description "CLI session group to which the profile belongs";
                                    }

                                    leaf combined-max-sessions {
                                        type types-system:session-limit;
                                        description "Maximum number of concurrent SSH and Telnet sessions";
                                    }

                                    leaf ssh-max-sessions {
                                        type types-system:session-limit;
                                        description "Maximum number of concurrent SSH sessions";
                                    }

                                    leaf telnet-max-sessions {
                                        type types-system:session-limit;
                                        description "Maximum number of concurrent Telnet sessions";
                                    }

                                    leaf li {
                                        type boolean;
                                        description "Allow lawful intercept profile ID";
                                    }

                                    leaf default-action {
                                        type enumeration {
                                            enum deny-all {
                                                value 1;
                                                description "Deny access to all commands";
                                            }
                                            enum permit-all {
                                                value 2;
                                                description "Allow access to all commands";
                                            }
                                            enum none {
                                                value 3;
                                                description "No action; evaluate the next profile";
                                            }
                                            enum read-only-all {
                                                value 4;
                                                description "Allow read-only access to all commands";
                                            }
                                        }
                                        description "Action for non-matching entry";
                                    }

                                    list entry {
                                        key "entry-id";
                                        description "Enter the entry list instance";

                                        leaf entry-id {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..9999";
                                                }
                                            }
                                            description "User profile entry ID";
                                        }

                                        leaf description {
                                            type types-sros:description;
                                            description "Text description";
                                        }

                                        leaf match {
                                            type types-sros:display-string;
                                            description "Command to match the entry";
                                        }

                                        leaf action {
                                            type enumeration {
                                                enum deny {
                                                    value 1;
                                                    description "Keyword";
                                                }
                                                enum permit {
                                                    value 2;
                                                    description "Keyword";
                                                }
                                                enum none {
                                                    value 3;
                                                    description "No action; evaluate the next entry";
                                                }
                                                enum read-only {
                                                    value 4;
                                                    description "Keyword";
                                                }
                                            }
                                            description "Action when a command matches the entry";
                                        }

                                    } // list entry

                                    container grpc {
                                        description "Enter the grpc context";

                                        container rpc-authorization {
                                            description "Enter the rpc-authorization context";

                                            leaf gnmi-capabilities {
                                                type types-system:permit-deny;
                                                description "gNMI Capabilities RPC authorization";
                                            }

                                            leaf gnmi-get {
                                                type types-system:permit-deny;
                                                description "gNMI Get RPC authorization";
                                            }

                                            leaf gnmi-set {
                                                type types-system:permit-deny;
                                                description "gNMI Set RPC authorization";
                                            }

                                            leaf gnmi-subscribe {
                                                type types-system:permit-deny;
                                                description "gNMI Subscribe RPC authorization";
                                            }

                                            leaf gnoi-cert-mgmt-rotate {
                                                type types-system:permit-deny;
                                                description "gNOI Rotate RPC authorization";
                                            }

                                            leaf gnoi-cert-mgmt-install {
                                                type types-system:permit-deny;
                                                description "gNOI Install RPC authorization";
                                            }

                                            leaf gnoi-cert-mgmt-getcert {
                                                type types-system:permit-deny;
                                                description "gNOI GetCertificates RPC authorization";
                                            }

                                            leaf gnoi-cert-mgmt-revoke {
                                                type types-system:permit-deny;
                                                description "gNOI RevokeCertificates RPC authorization";
                                            }

                                            leaf gnoi-cert-mgmt-cangenerate {
                                                type types-system:permit-deny;
                                                description "gNOI CanGenerateCSR RPC authorization";
                                            }

                                            leaf gnoi-file-get {
                                                type types-system:permit-deny;
                                                description "gNOI File Get RPC authorization";
                                            }

                                            leaf gnoi-file-transfertoremote {
                                                type types-system:permit-deny;
                                                description "gNOI File TransferToRemote RPC authorization";
                                            }

                                            leaf gnoi-file-put {
                                                type types-system:permit-deny;
                                                description "gNOI File Put RPC authorization";
                                            }

                                            leaf gnoi-file-stat {
                                                type types-system:permit-deny;
                                                description "gNOI File Stat RPC authorization";
                                            }

                                            leaf gnoi-file-remove {
                                                type types-system:permit-deny;
                                                description "gNOI File Remove RPC authorization";
                                            }

                                            leaf gnoi-system-ping {
                                                type types-system:permit-deny;
                                                description "gNOI System Ping RPC authorization";
                                            }

                                            leaf gnoi-system-traceroute {
                                                type types-system:permit-deny;
                                                description "gNOI System Traceroute RPC authorization";
                                            }

                                            leaf gnoi-system-time {
                                                type types-system:permit-deny;
                                                description "gNOI System Time RPC authorization";
                                            }

                                            leaf gnoi-system-setpackage {
                                                type types-system:permit-deny;
                                                description "gNOI System SetPackage RPC authorization";
                                            }

                                            leaf gnoi-system-switchcontrolprocessor {
                                                type types-system:permit-deny;
                                                description "gNOI System SwitchControlProcessor RPC authorization";
                                            }

                                            leaf gnoi-system-reboot {
                                                type types-system:permit-deny;
                                                description "gNOI System Reboot RPC authorization";
                                            }

                                            leaf gnoi-system-rebootstatus {
                                                type types-system:permit-deny;
                                                description "gNOI System RebootStatus RPC authorization";
                                            }

                                            leaf gnoi-system-cancelreboot {
                                                type types-system:permit-deny;
                                                description "gNOI System CancelReboot RPC authorization";
                                            }

                                            leaf md-cli-session {
                                                type types-system:permit-deny;
                                                description "gNOI MdCli Session RPC authorization";
                                            }

                                            leaf rib-api-getversion {
                                                type types-system:permit-deny;
                                                description "RibApi GetVersion RPC authorization";
                                            }

                                            leaf rib-api-modify {
                                                type types-system:permit-deny;
                                                description "RibApi Modify RPC authorization";
                                            }

                                        } // container rpc-authorization

                                    } // container grpc

                                    container netconf {
                                        description "Enter the netconf context";

                                        container base-op-authorization {
                                            description "Enter the base-op-authorization context";

                                            leaf action {
                                                type boolean;
                                                description "Allow the NETCONF <action> RPC";
                                            }

                                            leaf cancel-commit {
                                                type boolean;
                                                description "Allow the NETCONF <cancel-commit> RPC";
                                            }

                                            leaf close-session {
                                                type boolean;
                                                description "Allow the NETCONF <close-session> RPC";
                                            }

                                            leaf commit {
                                                type boolean;
                                                description "Allow the NETCONF <commit> RPC";
                                            }

                                            leaf copy-config {
                                                type boolean;
                                                description "Allow the NETCONF <copy-config> RPC";
                                            }

                                            leaf create-subscription {
                                                type boolean;
                                                description "Allow the NETCONF <create-subscription> RPC";
                                            }

                                            leaf delete-config {
                                                type boolean;
                                                description "Allow the NETCONF <delete-config> RPC";
                                            }

                                            leaf discard-changes {
                                                type boolean;
                                                description "Allow the NETCONF <discard-changes> RPC";
                                            }

                                            leaf edit-config {
                                                type boolean;
                                                description "Allow the NETCONF <edit-config> RPC";
                                            }

                                            leaf get {
                                                type boolean;
                                                description "Allow the NETCONF <get> RPC";
                                            }

                                            leaf get-config {
                                                type boolean;
                                                description "Allow the NETCONF <get-config> RPC";
                                            }

                                            leaf get-data {
                                                type boolean;
                                                description "Allow the NETCONF <get-data> RPC";
                                            }

                                            leaf get-schema {
                                                type boolean;
                                                description "Allow the NETCONF <get-schema> RPC";
                                            }

                                            leaf kill-session {
                                                type boolean;
                                                description "Allow the NETCONF <kill-session> RPC";
                                            }

                                            leaf lock {
                                                type boolean;
                                                description "Allow the NETCONF <lock> and <unlock> RPCs";
                                            }

                                            leaf validate {
                                                type boolean;
                                                description "Allow the NETCONF <validate> RPC";
                                            }

                                        } // container base-op-authorization

                                    } // container netconf

                                } // list profile

                            } // container local-profiles

                            list user-template {
                                key "user-template-name";
                                description "Enter the user-template list instance";

                                leaf user-template-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type enumeration {
                                            enum ldap-default {
                                                value 0;
                                                description "Default LDAP user template";
                                            }
                                            enum radius-default {
                                                value 1;
                                                description "Default RADIUS user template";
                                            }
                                            enum tacplus-default {
                                                value 2;
                                                description "Default TACACS+ user template";
                                            }
                                        }
                                    }
                                    description "Default user template applied to the remote user";
                                }

                                leaf home-directory {
                                    type types-sros:cflash-without-slot-url;
                                    description "User local home directory based on the template";
                                }

                                leaf profile {
                                    type types-sros:named-item {
                                        pattern "[^ ]*" {
                                            error-message "The profile name cannot contain spaces.";
                                        }
                                    }
                                    description "User profile based on the template";
                                }

                                leaf restricted-to-home {
                                    type boolean;
                                    description "Restrict file access to the home directory of the user";
                                }

                                leaf save-when-restricted {
                                    type boolean;
                                    description "Save configurations when the user is restricted to home";
                                }

                                container access {
                                    description "Enter the access context";

                                    leaf ftp {
                                        type boolean;
                                        description "Allow FTP access";
                                    }

                                    leaf console {
                                        type boolean;
                                        description "Allow Bluetooth, console port CLI, SCP/SFTP, SSH CLI, and Telnet CLI access";
                                    }

                                    leaf grpc {
                                        type boolean;
                                        description "Allow gRPC access";
                                    }

                                    leaf netconf {
                                        type boolean;
                                        description "Allow NETCONF access";
                                    }

                                    leaf li {
                                        type boolean;
                                        description "Allow access to Lawful Intercept (LI) commands";
                                    }

                                    leaf scp-sftp {
                                        type boolean;
                                        description "Allow SCP/SFTP access";
                                    }

                                    leaf console-port-cli {
                                        type boolean;
                                        description "Allow console port CLI access";
                                    }

                                    leaf ssh-cli {
                                        type boolean;
                                        description "Allow SSH CLI access";
                                    }

                                    leaf telnet-cli {
                                        type boolean;
                                        description "Allow Telnet CLI access";
                                    }

                                    leaf bluetooth {
                                        type boolean;
                                        description "Allow Bluetooth access";
                                    }

                                } // container access

                                container console {
                                    description "Enter the console context";

                                    leaf login-exec {
                                        type types-sros:string-not-all-spaces {
                                            length "1..200";
                                        }
                                        description "File to execute when the user logs in";
                                    }

                                } // container console

                            } // list user-template

                            list cli-session-group {
                                key "cli-session-group-name";
                                description "Enter the cli-session-group list instance";

                                leaf cli-session-group-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item {
                                            pattern "[^ ]*" {
                                                error-message "The name cannot contain spaces.";
                                            }
                                        }
                                    }
                                    description "CLI session group name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf combined-max-sessions {
                                    type types-system:session-limit;
                                    description "Maximum number of concurrent SSH and Telnet sessions";
                                }

                                leaf ssh-max-sessions {
                                    type types-system:session-limit;
                                    description "Maximum number of concurrent SSH sessions";
                                }

                                leaf telnet-max-sessions {
                                    type types-system:session-limit;
                                    description "Maximum number of concurrent Telnet sessions";
                                }

                            } // list cli-session-group

                            container management-interface {
                                presence "Enable the management-interface context";
                                description "Enable the management-interface context";

                                container grpc {
                                    description "Enter the grpc context";

                                    container tls-authentication {
                                        description "Enter the tls-authentication context";

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of mTLS authentication";
                                        }

                                        leaf default-user {
                                            type types-sros:named-item;
                                            description "Local user to display with mTLS authentication";
                                        }

                                    } // container tls-authentication

                                } // container grpc

                                container output-authorization {
                                    description "Enter the output-authorization context";

                                    leaf md-interfaces {
                                        type boolean;
                                        description "Authorize output in model-driven interfaces";
                                    }

                                    leaf telemetry-data {
                                        type boolean;
                                        description "Authorize dial-in telemetry output";
                                    }

                                    leaf telemetry-default-user {
                                        type types-sros:named-item;
                                        description "Local user for dial-out telemetry output authorization";
                                    }

                                } // container output-authorization

                                container md-cli {
                                    description "Enter the md-cli context";

                                    leaf command-accounting-during-load {
                                        type boolean;
                                        description "Perform file command accounting for load or rollback";
                                    }

                                } // container md-cli

                            } // container management-interface

                        } // container aaa

                        container cli-script {
                            presence "Enable the cli-script context";
                            description "Enable the cli-script context";

                            container authorization {
                                description "Enter the authorization context";

                                container cron {
                                    description "Enter the cron context";

                                    leaf cli-user {
                                        type types-sros:named-item;
                                        description "User profile name for CLI command script authorization";
                                    }

                                } // container cron

                                container event-handler {
                                    description "Enter the event-handler context";

                                    leaf cli-user {
                                        type types-sros:named-item;
                                        description "User profile name for CLI command script authorization";
                                    }

                                } // container event-handler

                            } // container authorization

                        } // container cli-script

                        container cpm-filter {
                            presence "Enable the cpm-filter context";
                            description "Enable the cpm-filter context";

                            leaf default-action {
                                type enumeration {
                                    enum drop                           { value 1; }
                                    enum accept                         { value 2; }
                                }
                                description "Action for packets that do not match any filter entries";
                            }

                            container ip-filter {
                                description "Enter the ip-filter context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the CPM filter";
                                }

                                list entry {
                                    key "entry-id";
                                    description "Enter the entry list instance";

                                    leaf entry-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..131072";
                                            }
                                        }
                                        description "Filter entry ID";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf log {
                                        type types-filter:filter-log-id;
                                        description "Log ID where matching packets are entered";
                                    }

                                    container match {
                                        description "Enter the match context";

                                        leaf router-instance {
                                            type types-sros:named-item-64;
                                            description "Router instance as the match criteria";
                                        }

                                        leaf protocol {
                                            type types-sros:match-ip-protocol;
                                            description "IP protocol as the match criterion";
                                        }

                                        leaf dscp {
                                            type types-qos:dscp-name;
                                            description "DSCP used as the match criterion on the packet";
                                        }

                                        leaf fragment {
                                            type enumeration {
                                                enum false                          { value 2; }
                                                enum true                           { value 3; }
                                            }
                                            description "Match criterion based on presence of fragmented packets";
                                        }

                                        leaf multiple-option {
                                            type boolean;
                                            description "Match on packets containing multiple option fields";
                                        }

                                        leaf option-present {
                                            type boolean;
                                            description "Match on packets with option field present";
                                        }

                                        choice port-selector {
                                            case src-dst-port {

                                                container src-port {
                                                    description "Enter the src-port context";

                                                    choice port {
                                                        case eq {

                                                            leaf eq {
                                                                type uint16 {
                                                                    range "0..65535";
                                                                }
                                                                description "Port number as the match criterion";
                                                            }

                                                            leaf mask {
                                                                type uint16 {
                                                                    range "1..65535";
                                                                }
                                                                description "Port mask as the match criterion";
                                                            }

                                                        }
                                                        case range {

                                                            container range {
                                                                presence "Enable the range context";
                                                                description "Enable the range context";

                                                                leaf start {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Lower bound of the port number to match";
                                                                }

                                                                leaf end {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Upper bound of the port number to match";
                                                                }

                                                            } // container range

                                                        }
                                                        case port-list {

                                                            leaf port-list {
                                                                type types-sros:named-item;
                                                                description "Port list as the match criterion";
                                                            }

                                                        }
                                                    }
                                                } // container src-port

                                                container dst-port {
                                                    description "Enter the dst-port context";

                                                    choice port {
                                                        case eq {

                                                            leaf eq {
                                                                type uint16 {
                                                                    range "0..65535";
                                                                }
                                                                description "Port number as the match criterion";
                                                            }

                                                            leaf mask {
                                                                type uint16 {
                                                                    range "1..65535";
                                                                }
                                                                description "Port mask as the match criterion";
                                                            }

                                                        }
                                                        case range {

                                                            container range {
                                                                presence "Enable the range context";
                                                                description "Enable the range context";

                                                                leaf start {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Lower bound of the port number to match";
                                                                }

                                                                leaf end {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Upper bound of the port number to match";
                                                                }

                                                            } // container range

                                                        }
                                                        case port-list {

                                                            leaf port-list {
                                                                type types-sros:named-item;
                                                                description "Port list as the match criterion";
                                                            }

                                                        }
                                                    }
                                                } // container dst-port

                                            }
                                            case port {

                                                container port {
                                                    description "Enter the port context";

                                                    choice port {
                                                        case eq {

                                                            leaf eq {
                                                                type uint16 {
                                                                    range "0..65535";
                                                                }
                                                                description "Port number as the match criterion";
                                                            }

                                                            leaf mask {
                                                                type uint16 {
                                                                    range "1..65535";
                                                                }
                                                                description "Port mask as the match criterion";
                                                            }

                                                        }
                                                        case range {

                                                            container range {
                                                                presence "Enable the range context";
                                                                description "Enable the range context";

                                                                leaf start {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Lower bound of the port number to match";
                                                                }

                                                                leaf end {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Upper bound of the port number to match";
                                                                }

                                                            } // container range

                                                        }
                                                        case port-list {

                                                            leaf port-list {
                                                                type types-sros:named-item;
                                                                description "Port list as the match criterion";
                                                            }

                                                        }
                                                    }
                                                } // container port

                                            }
                                        }
                                        container ip-option {
                                            presence "Enable the ip-option context";
                                            description "Enable the ip-option context";

                                            leaf type {
                                                type types-filter:filter-match-ip-option;
                                                description "Specific IP option to match";
                                            }

                                            leaf mask {
                                                type types-filter:filter-match-ip-option {
                                                    range "1..255";
                                                }
                                                description "Range of option numbers for the mask match criterion";
                                            }

                                        } // container ip-option

                                        container src-ip {
                                            description "Enter the src-ip context";

                                            choice match-address-choice {
                                                case address-and-prefix-or-mask {

                                                    leaf address {
                                                        type union {
                                                            type types-sros:ipv4-prefix-with-host-bits;
                                                            type types-sros:ipv4-address;
                                                        }
                                                        description "IPv4 address used as the match criterion";
                                                    }

                                                    leaf mask {
                                                        type types-sros:ipv4-address;
                                                        description "IPv4 address mask used as the match criterion";
                                                    }

                                                }
                                                case ip-prefix-list {

                                                    leaf ip-prefix-list {
                                                        type types-sros:named-item;
                                                        description "IPv4 address prefix list used as match criterion";
                                                    }

                                                }
                                            }
                                        } // container src-ip

                                        container dst-ip {
                                            description "Enter the dst-ip context";

                                            choice match-address-choice {
                                                case address-and-prefix-or-mask {

                                                    leaf address {
                                                        type union {
                                                            type types-sros:ipv4-prefix-with-host-bits;
                                                            type types-sros:ipv4-address;
                                                        }
                                                        description "IPv4 address used as the match criterion";
                                                    }

                                                    leaf mask {
                                                        type types-sros:ipv4-address;
                                                        description "IPv4 address mask used as the match criterion";
                                                    }

                                                }
                                                case ip-prefix-list {

                                                    leaf ip-prefix-list {
                                                        type types-sros:named-item;
                                                        description "IPv4 address prefix list used as match criterion";
                                                    }

                                                }
                                            }
                                        } // container dst-ip

                                        container icmp {
                                            description "Enter the icmp context";

                                            choice icmp-code {
                                                case code {

                                                    leaf code {
                                                        type types-filter:ipv4-match-icmp-codes;
                                                        description "ICMP code to match";
                                                    }

                                                }
                                            }
                                            choice icmp-type {
                                                case type {

                                                    leaf type {
                                                        type types-filter:ipv4-match-icmp-types;
                                                        description "ICMP type to match";
                                                    }

                                                }
                                            }
                                        } // container icmp

                                        container tcp-flags {
                                            description "Enter the tcp-flags context";

                                            leaf ack {
                                                type boolean;
                                                description "ACK bit in TCP header control bits as match criterion";
                                            }

                                            leaf syn {
                                                type boolean;
                                                description "SYN bit in TCP header control bits as match criterion";
                                            }

                                        } // container tcp-flags

                                    } // container match

                                    container action {
                                        description "Enter the action context";

                                        choice action-choice {
                                            case case-drop {

                                                leaf drop {
                                                    type empty;
                                                    description "Drop matching packets";
                                                }

                                            }
                                            case case-accept {

                                                leaf accept {
                                                    type empty;
                                                    description "Forward matching packets";
                                                }

                                            }
                                            case case-default {

                                                leaf default {
                                                    type empty;
                                                    description "Use default action for matching packets";
                                                }

                                            }
                                            case case-queue {

                                                leaf queue {
                                                    type uint32 {
                                                        range "33..2000";
                                                    }
                                                    description "Forward matching packets to the CPM hardware queue";
                                                }

                                            }
                                        }
                                    } // container action

                                } // list entry

                            } // container ip-filter

                            container ipv6-filter {
                                description "Enter the ipv6-filter context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the CPM filter";
                                }

                                list entry {
                                    key "entry-id";
                                    description "Enter the entry list instance";

                                    leaf entry-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..131072";
                                            }
                                        }
                                        description "Filter entry ID";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf log {
                                        type types-filter:filter-log-id;
                                        description "Log ID where matching packets are entered";
                                    }

                                    container match {
                                        description "Enter the match context";

                                        leaf router-instance {
                                            type types-sros:named-item-64;
                                            description "Router instance as the match criteria";
                                        }

                                        leaf next-header {
                                            type types-sros:match-ip-protocol;
                                            description "IP protocol to match";
                                        }

                                        leaf dscp {
                                            type types-qos:dscp-name;
                                            description "DSCP used as the match criterion on the packet";
                                        }

                                        leaf flow-label {
                                            type types-filter:filter-match-flow-label;
                                            description "Flow label in the IPv6 header as the match criterion";
                                        }

                                        leaf fragment {
                                            type enumeration {
                                                enum false                          { value 2; }
                                                enum true                           { value 3; }
                                            }
                                            description "Match criterion based on presence of fragmented packets";
                                        }

                                        choice port-selector {
                                            case src-dst-port {

                                                container src-port {
                                                    description "Enter the src-port context";

                                                    choice port {
                                                        case eq {

                                                            leaf eq {
                                                                type uint16 {
                                                                    range "0..65535";
                                                                }
                                                                description "Port number as the match criterion";
                                                            }

                                                            leaf mask {
                                                                type uint16 {
                                                                    range "1..65535";
                                                                }
                                                                description "Port mask as the match criterion";
                                                            }

                                                        }
                                                        case range {

                                                            container range {
                                                                presence "Enable the range context";
                                                                description "Enable the range context";

                                                                leaf start {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Lower bound of the port number to match";
                                                                }

                                                                leaf end {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Upper bound of the port number to match";
                                                                }

                                                            } // container range

                                                        }
                                                        case port-list {

                                                            leaf port-list {
                                                                type types-sros:named-item;
                                                                description "Port list as the match criterion";
                                                            }

                                                        }
                                                    }
                                                } // container src-port

                                                container dst-port {
                                                    description "Enter the dst-port context";

                                                    choice port {
                                                        case eq {

                                                            leaf eq {
                                                                type uint16 {
                                                                    range "0..65535";
                                                                }
                                                                description "Port number as the match criterion";
                                                            }

                                                            leaf mask {
                                                                type uint16 {
                                                                    range "1..65535";
                                                                }
                                                                description "Port mask as the match criterion";
                                                            }

                                                        }
                                                        case range {

                                                            container range {
                                                                presence "Enable the range context";
                                                                description "Enable the range context";

                                                                leaf start {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Lower bound of the port number to match";
                                                                }

                                                                leaf end {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Upper bound of the port number to match";
                                                                }

                                                            } // container range

                                                        }
                                                        case port-list {

                                                            leaf port-list {
                                                                type types-sros:named-item;
                                                                description "Port list as the match criterion";
                                                            }

                                                        }
                                                    }
                                                } // container dst-port

                                            }
                                            case port {

                                                container port {
                                                    description "Enter the port context";

                                                    choice port {
                                                        case eq {

                                                            leaf eq {
                                                                type uint16 {
                                                                    range "0..65535";
                                                                }
                                                                description "Port number as the match criterion";
                                                            }

                                                            leaf mask {
                                                                type uint16 {
                                                                    range "1..65535";
                                                                }
                                                                description "Port mask as the match criterion";
                                                            }

                                                        }
                                                        case range {

                                                            container range {
                                                                presence "Enable the range context";
                                                                description "Enable the range context";

                                                                leaf start {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Lower bound of the port number to match";
                                                                }

                                                                leaf end {
                                                                    type uint16 {
                                                                        range "0..65535";
                                                                    }
                                                                    description "Upper bound of the port number to match";
                                                                }

                                                            } // container range

                                                        }
                                                        case port-list {

                                                            leaf port-list {
                                                                type types-sros:named-item;
                                                                description "Port list as the match criterion";
                                                            }

                                                        }
                                                    }
                                                } // container port

                                            }
                                        }
                                        container src-ip {
                                            description "Enter the src-ip context";

                                            choice match-address-choice {
                                                case address-and-prefix-or-mask {

                                                    leaf address {
                                                        type union {
                                                            type types-sros:ipv6-prefix-with-host-bits;
                                                            type types-sros:ipv6-address;
                                                        }
                                                        description "IPv6 address used as the match criterion";
                                                    }

                                                    leaf mask {
                                                        type types-sros:ipv6-address;
                                                        description "IPv6 address mask used as the match criterion";
                                                    }

                                                }
                                                case ipv6-prefix-list {

                                                    leaf ipv6-prefix-list {
                                                        type types-sros:named-item;
                                                        description "IPv6 address prefix list used as match criterion";
                                                    }

                                                }
                                            }
                                        } // container src-ip

                                        container dst-ip {
                                            description "Enter the dst-ip context";

                                            choice match-address-choice {
                                                case address-and-prefix-or-mask {

                                                    leaf address {
                                                        type union {
                                                            type types-sros:ipv6-prefix-with-host-bits;
                                                            type types-sros:ipv6-address;
                                                        }
                                                        description "IPv6 address used as the match criterion";
                                                    }

                                                    leaf mask {
                                                        type types-sros:ipv6-address;
                                                        description "IPv6 address mask used as the match criterion";
                                                    }

                                                }
                                                case ipv6-prefix-list {

                                                    leaf ipv6-prefix-list {
                                                        type types-sros:named-item;
                                                        description "IPv6 address prefix list used as match criterion";
                                                    }

                                                }
                                            }
                                        } // container dst-ip

                                        container extension-header {
                                            description "Enter the extension-header context";

                                            leaf hop-by-hop {
                                                type boolean;
                                                description "Match on existence of Hop-By-Hop Options Header";
                                            }

                                        } // container extension-header

                                        container icmp {
                                            description "Enter the icmp context";

                                            choice icmp-code {
                                                case code {

                                                    leaf code {
                                                        type types-filter:ipv6-match-icmp-codes;
                                                        description "ICMP code as the match criterion";
                                                    }

                                                }
                                            }
                                            choice icmp-type {
                                                case type {

                                                    leaf type {
                                                        type types-filter:ipv6-match-icmp-types;
                                                        description "ICMP type as the match criterion";
                                                    }

                                                }
                                            }
                                        } // container icmp

                                        container tcp-flags {
                                            description "Enter the tcp-flags context";

                                            leaf ack {
                                                type boolean;
                                                description "ACK bit in TCP header control bits as match criterion";
                                            }

                                            leaf syn {
                                                type boolean;
                                                description "SYN bit in TCP header control bits as match criterion";
                                            }

                                        } // container tcp-flags

                                    } // container match

                                    container action {
                                        description "Enter the action context";

                                        choice action-choice {
                                            case case-drop {

                                                leaf drop {
                                                    type empty;
                                                    description "Drop matching packets";
                                                }

                                            }
                                            case case-accept {

                                                leaf accept {
                                                    type empty;
                                                    description "Forward matching packets";
                                                }

                                            }
                                            case case-default {

                                                leaf default {
                                                    type empty;
                                                    description "Use default action for matching packets";
                                                }

                                            }
                                            case case-queue {

                                                leaf queue {
                                                    type uint32 {
                                                        range "33..2000";
                                                    }
                                                    description "Forward matching packets to the CPM hardware queue";
                                                }

                                            }
                                        }
                                    } // container action

                                } // list entry

                            } // container ipv6-filter

                            container mac-filter {
                                description "Enter the mac-filter context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the CPM filter";
                                }

                                list entry {
                                    key "entry-id";
                                    description "Enter the entry list instance";

                                    leaf entry-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..131072";
                                            }
                                        }
                                        description "Filter entry ID";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf log {
                                        type types-filter:filter-log-id;
                                        description "Log ID where matching packets are entered";
                                    }

                                    container match {
                                        description "Enter the match context";

                                        leaf service {
                                            type types-services:service-name;
                                            description "Service ID used as the match condition";
                                        }

                                        leaf frame-type {
                                            type enumeration {
                                                enum 802dot2-llc                    { value 1; }
                                                enum ethernet-ii                    { value 3; }
                                            }
                                            description "MAC frame type as the match criterion";
                                        }

                                        leaf etype {
                                            type types-services:etype-value;
                                            description "Ethernet type as the match criterion";
                                        }

                                        container src-mac {
                                            presence "Enable the src-mac context";
                                            description "Enable the src-mac context";

                                            leaf address {
                                                type yang:mac-address;
                                                description "MAC address used as the match criterion";
                                            }

                                            leaf mask {
                                                type yang:mac-address;
                                                description "MAC address mask as the match criterion";
                                            }

                                        } // container src-mac

                                        container dst-mac {
                                            presence "Enable the dst-mac context";
                                            description "Enable the dst-mac context";

                                            leaf address {
                                                type yang:mac-address;
                                                description "MAC address used as the match criterion";
                                            }

                                            leaf mask {
                                                type yang:mac-address;
                                                description "MAC address mask as the match criterion";
                                            }

                                        } // container dst-mac

                                        container llc-ssap {
                                            presence "Enable the llc-ssap context";
                                            description "Enable the llc-ssap context";

                                            leaf ssap {
                                                type types-qos:service-access-point;
                                                description "8-bit SSAP as the match criterion";
                                            }

                                            leaf mask {
                                                type types-qos:service-access-point {
                                                    range "1..255";
                                                }
                                                description "Mask for SSAP value as the match criterion";
                                            }

                                        } // container llc-ssap

                                        container llc-dsap {
                                            presence "Enable the llc-dsap context";
                                            description "Enable the llc-dsap context";

                                            leaf dsap {
                                                type types-qos:service-access-point;
                                                description "8-bit DSAP as the match criterion";
                                            }

                                            leaf mask {
                                                type types-qos:service-access-point {
                                                    range "1..255";
                                                }
                                                description "Mask for DSAP value as the match criterion";
                                            }

                                        } // container llc-dsap

                                        container cfm-opcode {
                                            description "Enter the cfm-opcode context";

                                            choice cfm-opcode {
                                                case eq {

                                                    leaf eq {
                                                        type uint32 {
                                                            range "0..255";
                                                        }
                                                        description "Equal to comparison operator for the CFM opcode";
                                                    }

                                                }
                                                case lt {

                                                    leaf lt {
                                                        type uint32 {
                                                            range "1..255";
                                                        }
                                                        description "Less than comparison operator for the CFM opcode";
                                                    }

                                                }
                                                case gt {

                                                    leaf gt {
                                                        type uint32 {
                                                            range "0..254";
                                                        }
                                                        description "Greater than comparison operator for the CFM opcode";
                                                    }

                                                }
                                                case range {

                                                    container range {
                                                        presence "Enable the range context";
                                                        description "Enable the range context";

                                                        leaf start {
                                                            type uint32 {
                                                                range "0..254";
                                                            }
                                                            description "Lower bound of the OpCode range to match";
                                                        }

                                                        leaf end {
                                                            type uint32 {
                                                                range "1..255";
                                                            }
                                                            description "Upper bound of the Opcode range to match";
                                                        }

                                                    } // container range

                                                }
                                            }
                                        } // container cfm-opcode

                                    } // container match

                                    container action {
                                        description "Enter the action context";

                                        choice action-choice {
                                            case case-drop {

                                                leaf drop {
                                                    type empty;
                                                    description "Drop matching packets";
                                                }

                                            }
                                            case case-accept {

                                                leaf accept {
                                                    type empty;
                                                    description "Forward matching packets";
                                                }

                                            }
                                            case case-default {

                                                leaf default {
                                                    type empty;
                                                    description "Use default action for matching packets";
                                                }

                                            }
                                            case case-queue {

                                                leaf queue {
                                                    type uint32 {
                                                        range "33..2000";
                                                    }
                                                    description "Forward matching packets to the CPM hardware queue";
                                                }

                                            }
                                        }
                                    } // container action

                                } // list entry

                            } // container mac-filter

                        } // container cpm-filter

                        container cpm-queue {
                            presence "Enable the cpm-queue context";
                            description "Enable the cpm-queue context";

                            list queue {
                                key "queue-id";
                                description "Enter the queue list instance";

                                leaf queue-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "33..2000";
                                        }
                                    }
                                    description "CPM queue ID";
                                }

                                leaf cbs {
                                    type types-security:burst-size;
                                    units "kilobps";
                                    description "Buffer size that can be drawn from queue buffer pool";
                                }

                                leaf mbs {
                                    type types-security:burst-size;
                                    units "kilobps";
                                    description "Maximum queue depth to which the queue can grow";
                                }

                                container rate {
                                    description "Enter the rate context";

                                    leaf pir {
                                        type types-system:pir-rate;
                                        units "kilobps";
                                        description "Peak Information Rate for the queue";
                                    }

                                    leaf cir {
                                        type types-system:cir-rate;
                                        units "kilobps";
                                        description "Amount of bandwidth committed to the queue";
                                    }

                                } // container rate

                            } // list queue

                        } // container cpm-queue

                        container management-access-filter {
                            presence "Enable the management-access-filter context";
                            description "Enable the management-access-filter context";

                            container ip-filter {
                                presence "Enable the ip-filter context";
                                description "Enable the ip-filter context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of management-access filters";
                                }

                                leaf default-action {
                                    type types-filter:maf-action;
                                    description "Default action for the management access filter";
                                }

                                list entry {
                                    key "entry-id";
                                    description "Enter the entry list instance";

                                    leaf entry-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..9999";
                                            }
                                        }
                                        description "Entry ID to identify the match criteria and the action";
                                    }

                                    leaf action {
                                        type types-filter:maf-action;
                                        description "Action associated with the management access filter";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf log-events {
                                        type boolean;
                                        description "Enable match logging";
                                    }

                                    container match {
                                        description "Enter the match context";

                                        leaf router-instance {
                                            type types-services:service-name;
                                            description "Router instance as the match criterion";
                                        }

                                        leaf protocol {
                                            type types-sros:match-ip-protocol;
                                            description "IP protocol as the match criterion";
                                        }

                                        container src-ip {
                                            description "Enter the src-ip context";

                                            choice src-ip {
                                                case address {

                                                    leaf address {
                                                        type union {
                                                            type types-sros:ipv4-prefix;
                                                            type types-sros:ipv4-address;
                                                        }
                                                        description "IP address or IP prefix as the match criterion";
                                                    }

                                                    leaf mask {
                                                        type types-sros:ipv4-address;
                                                        description "IP address mask as the match criterion";
                                                    }

                                                }
                                                case ip-prefix-list {

                                                    leaf ip-prefix-list {
                                                        type types-sros:named-item;
                                                        description "IP prefix list as the match criterion";
                                                    }

                                                }
                                            }
                                        } // container src-ip

                                        container mgmt-port {
                                            description "Enter the mgmt-port context";

                                            choice mgmt-port {
                                                case port-id {

                                                    leaf port-id {
                                                        type types-sros:port;
                                                        description "Port ID as the match criterion";
                                                    }

                                                }
                                                case cpm {

                                                    leaf cpm {
                                                        type empty;
                                                        description "Match any traffic received on any Ethernet port";
                                                    }

                                                }
                                                case lag-id {

                                                    leaf lag-id {
                                                        status obsolete;
                                                        type types-sros:lag-interface;
                                                        description "LAG ID for the source interface";
                                                    }

                                                    leaf lag {
                                                        type types-sros:lag-interface;
                                                        description "LAG ID as the match criterion";
                                                    }

                                                }
                                            }
                                        } // container mgmt-port

                                        container dst-port {
                                            presence "Enable the dst-port context";
                                            description "Enable the dst-port context";

                                            leaf port {
                                                type uint16 {
                                                    range "1..65535";
                                                }
                                                description "TCP or UDP port number as the match criterion";
                                            }

                                            leaf mask {
                                                type uint16 {
                                                    range "1..65535";
                                                }
                                                description "IP address mask as the match criterion";
                                            }

                                        } // container dst-port

                                        container src-port {
                                            presence "Enable the src-port context";
                                            description "Enable the src-port context";

                                            leaf port {
                                                type uint16 {
                                                    range "1..65535";
                                                }
                                                description "TCP or UDP port number as the match criterion";
                                            }

                                            leaf mask {
                                                type uint16 {
                                                    range "1..65535";
                                                }
                                                description "IP address mask as the match criterion";
                                            }

                                        } // container src-port

                                    } // container match

                                } // list entry

                            } // container ip-filter

                            container ipv6-filter {
                                presence "Enable the ipv6-filter context";
                                description "Enable the ipv6-filter context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of management-access filters";
                                }

                                leaf default-action {
                                    type types-filter:maf-action;
                                    description "Default action for the management access filter";
                                }

                                list entry {
                                    key "entry-id";
                                    description "Enter the entry list instance";

                                    leaf entry-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..9999";
                                            }
                                        }
                                        description "Entry ID to identify the match criteria and the action";
                                    }

                                    leaf action {
                                        type types-filter:maf-action;
                                        description "Action associated with the management access filter";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf log-events {
                                        type boolean;
                                        description "Enable match logging";
                                    }

                                    container match {
                                        description "Enter the match context";

                                        leaf router-instance {
                                            type types-services:service-name;
                                            description "Router instance as the match criterion";
                                        }

                                        leaf next-header {
                                            type types-sros:match-ip-protocol;
                                            description "IP protocol to match";
                                        }

                                        leaf flow-label {
                                            type types-filter:filter-match-flow-label;
                                            description "Flow identifier used to discriminate traffic flows";
                                        }

                                        container src-ip {
                                            description "Enter the src-ip context";

                                            choice src-ip {
                                                case address {

                                                    leaf address {
                                                        type union {
                                                            type types-sros:ipv6-prefix;
                                                            type types-sros:ipv6-address;
                                                        }
                                                        description "IPv6 address or IPv6 prefix to match";
                                                    }

                                                    leaf mask {
                                                        type types-sros:ipv6-address;
                                                        description "IP address mask as the match criterion";
                                                    }

                                                }
                                                case ipv6-prefix-list {

                                                    leaf ipv6-prefix-list {
                                                        type types-sros:named-item;
                                                        description "IPv6 prefix list as the match criterion";
                                                    }

                                                }
                                            }
                                        } // container src-ip

                                        container mgmt-port {
                                            description "Enter the mgmt-port context";

                                            choice mgmt-port {
                                                case port-id {

                                                    leaf port-id {
                                                        type types-sros:port;
                                                        description "Port ID as the match criterion";
                                                    }

                                                }
                                                case cpm {

                                                    leaf cpm {
                                                        type empty;
                                                        description "Match any traffic received on any Ethernet port";
                                                    }

                                                }
                                                case lag-id {

                                                    leaf lag-id {
                                                        status obsolete;
                                                        type types-sros:lag-interface;
                                                        description "LAG ID for the source interface";
                                                    }

                                                    leaf lag {
                                                        type types-sros:lag-interface;
                                                        description "LAG ID as the match criterion";
                                                    }

                                                }
                                            }
                                        } // container mgmt-port

                                        container dst-port {
                                            presence "Enable the dst-port context";
                                            description "Enable the dst-port context";

                                            leaf port {
                                                type uint16 {
                                                    range "1..65535";
                                                }
                                                description "TCP or UDP port number as the match criterion";
                                            }

                                            leaf mask {
                                                type uint16 {
                                                    range "1..65535";
                                                }
                                                description "IP address mask as the match criterion";
                                            }

                                        } // container dst-port

                                        container src-port {
                                            presence "Enable the src-port context";
                                            description "Enable the src-port context";

                                            leaf port {
                                                type uint16 {
                                                    range "1..65535";
                                                }
                                                description "TCP or UDP port number as the match criterion";
                                            }

                                            leaf mask {
                                                type uint16 {
                                                    range "1..65535";
                                                }
                                                description "IP address mask as the match criterion";
                                            }

                                        } // container src-port

                                    } // container match

                                } // list entry

                            } // container ipv6-filter

                            container mac-filter {
                                presence "Enable the mac-filter context";
                                description "Enable the mac-filter context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of management access MAC filter";
                                }

                                leaf default-action {
                                    type types-filter:maf-mac-action;
                                    description "Default action for the management access filter";
                                }

                                list entry {
                                    key "entry-id";
                                    description "Enter the entry list instance";

                                    leaf entry-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..9999";
                                            }
                                        }
                                        description "Entry ID to identify the match criteria and the action";
                                    }

                                    leaf action {
                                        type types-filter:maf-mac-action;
                                        description "Action associated with the management access filter";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    leaf log-events {
                                        type boolean;
                                        description "Enable match logging";
                                    }

                                    container match {
                                        description "Enter the match context";

                                        leaf service {
                                            type types-services:service-name;
                                            description "Service ID used as the match condition";
                                        }

                                        leaf frame-type {
                                            type enumeration {
                                                enum 802dot3                        { value 0; }
                                                enum 802dot2-llc                    { value 1; }
                                                enum 802dot2-snap                   { value 2; }
                                                enum ethernet-ii                    { value 3; }
                                                enum 802dot1-ag                     { value 4; }
                                            }
                                            description "MAC frame type as the match criterion";
                                        }

                                        leaf etype {
                                            type types-services:etype-value;
                                            description "Ethernet type II Ethertype value as the match criterion";
                                        }

                                        leaf snap-pid {
                                            type int32 {
                                                range "0..65535";
                                            }
                                            description "IEEE 802.3 LLC SNAP Ethernet Frame PID as the match";
                                        }

                                        leaf snap-oui {
                                            type enumeration {
                                                enum zero                           { value 2; }
                                                enum non-zero                       { value 3; }
                                            }
                                            description "IEEE 802.3 LLC SNAP Ethernet Frame OUI value for match";
                                        }

                                        container src-mac {
                                            presence "Enable the src-mac context";
                                            description "Enable the src-mac context";

                                            leaf address {
                                                type yang:mac-address;
                                                description "MAC address used as the match criterion";
                                            }

                                            leaf mask {
                                                type yang:mac-address;
                                                description "MAC address mask as the match criterion";
                                            }

                                        } // container src-mac

                                        container dst-mac {
                                            presence "Enable the dst-mac context";
                                            description "Enable the dst-mac context";

                                            leaf address {
                                                type yang:mac-address;
                                                description "MAC address used as the match criterion";
                                            }

                                            leaf mask {
                                                type yang:mac-address;
                                                description "MAC address mask as the match criterion";
                                            }

                                        } // container dst-mac

                                        container dot1p {
                                            presence "Enable the dot1p context";
                                            description "Enable the dot1p context";

                                            leaf priority {
                                                type int32 {
                                                    range "0..7";
                                                }
                                                description "IEEE 802.1p value as the match criterion";
                                            }

                                            leaf mask {
                                                type int32 {
                                                    range "1..7";
                                                }
                                                description "3-bit mask as the match criterion";
                                            }

                                        } // container dot1p

                                        container llc-ssap {
                                            presence "Enable the llc-ssap context";
                                            description "Enable the llc-ssap context";

                                            leaf ssap {
                                                type int32 {
                                                    range "0..255";
                                                }
                                                description "8-bit SSAP as the match criterion";
                                            }

                                            leaf mask {
                                                type int32 {
                                                    range "1..255";
                                                }
                                                description "Mask for SSAP value as the match criterion";
                                            }

                                        } // container llc-ssap

                                        container llc-dsap {
                                            presence "Enable the llc-dsap context";
                                            description "Enable the llc-dsap context";

                                            leaf dsap {
                                                type int32 {
                                                    range "0..255";
                                                }
                                                description "8-bit DSAP as the match criterion";
                                            }

                                            leaf mask {
                                                type int32 {
                                                    range "1..255";
                                                }
                                                description "Mask for DSAP value as the match criterion";
                                            }

                                        } // container llc-dsap

                                        container cfm-opcode {
                                            description "Enter the cfm-opcode context";

                                            choice match-cfm-opcode {
                                                case operator-eq {

                                                    leaf eq {
                                                        type uint32 {
                                                            range "0..255";
                                                        }
                                                        description "Equal to comparison operator for the CFM opcode";
                                                    }

                                                }
                                                case operator-lt {

                                                    leaf lt {
                                                        type uint32 {
                                                            range "1..255";
                                                        }
                                                        description "Less than comparison operator for the CFM opcode";
                                                    }

                                                }
                                                case operator-gt {

                                                    leaf gt {
                                                        type uint32 {
                                                            range "0..254";
                                                        }
                                                        description "Greater than comparison operator for the CFM opcode";
                                                    }

                                                }
                                                case opcode-range {

                                                    container range {
                                                        presence "Enable the range context";
                                                        description "Enable the range context";

                                                        leaf start {
                                                            type uint32 {
                                                                range "0..254";
                                                            }
                                                            description "Lower bound of the range for the OpCode to match";
                                                        }

                                                        leaf end {
                                                            type uint32 {
                                                                range "1..255";
                                                            }
                                                            description "Upper bound of the range for the OpCode to match";
                                                        }

                                                    } // container range

                                                }
                                            }
                                        } // container cfm-opcode

                                    } // container match

                                } // list entry

                            } // container mac-filter

                        } // container management-access-filter

                        container pki {
                            presence "Enable the pki context";
                            description "Enable the pki context";

                            leaf certificate-display-format {
                                type enumeration {
                                    enum ascii                          { value 1; }
                                    enum utf8                           { value 2; }
                                }
                                description "Display format for Certificates and CRLs";
                            }

                            leaf dynamic-ca {
                                type boolean;
                                description "Enable the dynamic sub-CA support for IPsec";
                            }

                            leaf imported-format {
                                type enumeration {
                                    enum any                            { value 1; }
                                    enum secure                         { value 2; }
                                }
                                description "The supported encrypted file formats";
                            }

                            leaf maximum-cert-chain-depth {
                                type uint32 {
                                    range "1..7";
                                }
                                description "Maximum depth of certificate chain verification";
                            }

                            container certificate-expiration-warning {
                                description "Enter the certificate-expiration-warning context";

                                leaf hours {
                                    type int32 {
                                        range "0..8760";
                                    }
                                    units "hours";
                                    description "Time before system generates certificate warning trap";
                                }

                                leaf repeat-hours {
                                    type int32 {
                                        range "0..8760";
                                    }
                                    units "hours";
                                    description "Time system repeats certificate expiration warning trap";
                                }

                            } // container certificate-expiration-warning

                            container crl-expiration-warning {
                                description "Enter the crl-expiration-warning context";

                                leaf hours {
                                    type int32 {
                                        range "0..8760";
                                    }
                                    units "hours";
                                    description "Time before system generates CRL expiration warning trap";
                                }

                                leaf repeat-hours {
                                    type int32 {
                                        range "0..8760";
                                    }
                                    units "hours";
                                    description "Time system repeats CRL expiration warning trap";
                                }

                            } // container crl-expiration-warning

                            list ca-profile {
                                key "ca-profile-name";
                                description "Enter the ca-profile list instance";

                                leaf ca-profile-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "CA profile name";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the CA profile";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf cert-file {
                                    type types-security:pki-file-name;
                                    description "Certificate file name";
                                }

                                leaf crl-file {
                                    type types-security:pki-file-name;
                                    description "Certificate Revocation List (CRL) file name";
                                }

                                leaf revocation-check {
                                    type enumeration {
                                        enum crl                            { value 1; }
                                        enum crl-optional                   { value 2; }
                                    }
                                    description "Revocation method to check status of CA certificates";
                                }

                                container ocsp {
                                    description "Enter the ocsp context";

                                    leaf responder-url {
                                        type union {
                                            type types-sros:http-optional-url-loose;
                                        }
                                        description "HTTP URL of the OCSP responder for the CA";
                                    }

                                    leaf service-name {
                                        type types-services:service-name;
                                        description "Administrative service name";
                                    }

                                    leaf transmission-profile {
                                        type types-sros:named-item;
                                        description "Transmission profile for the OCSP";
                                    }

                                } // container ocsp

                                container cmpv2 {
                                    description "Enter the cmpv2 context";

                                    leaf always-set-sender-for-ir {
                                        type boolean;
                                        description "Set subject name in CMPv2 header for all IR messages";
                                    }

                                    leaf same-recipient-nonce-for-poll-request {
                                        type boolean;
                                        description "Use same recipNonce as last CMPv2 response";
                                    }

                                    leaf signing-cert-subject {
                                        type string {
                                            length "1..256";
                                        }
                                        description "Subject DN attributes to identify signing certificate";
                                    }

                                    choice response-signing {
                                        case response-signing-use-extracert {

                                            leaf response-signing-use-extracert {
                                                type empty;
                                                description "Use extraCerts certificate to verify response signature";
                                            }

                                        }
                                        case response-signing-cert {

                                            leaf response-signing-cert {
                                                type types-security:pki-file-name;
                                                description "File name of the certificate to verify CMPv2 responses";
                                            }

                                        }
                                    }
                                    choice recipient {
                                        case use-ca-subject {

                                            leaf use-ca-subject {
                                                type empty;
                                                description "Use subject DN in CA certificate as CMPv2 request recipient";
                                            }

                                        }
                                        case recipient-subject {

                                            leaf recipient-subject {
                                                type string {
                                                    length "1..256";
                                                }
                                                description "DN attributes for recipient subject of CMPv2 requests";
                                            }

                                        }
                                    }
                                    container accept-unprotected-message {
                                        description "Enter the accept-unprotected-message context";

                                        leaf error-message {
                                            type boolean;
                                            description "Accept unprotected error messages";
                                        }

                                        leaf pkiconf-message {
                                            type boolean;
                                            description "Accept unprotected PKI confirmation messages";
                                        }

                                    } // container accept-unprotected-message

                                    container http {
                                        description "Enter the http context";

                                        leaf response-timeout {
                                            type uint32 {
                                                range "1..3600";
                                            }
                                            units "seconds";
                                            description "HTTP response timeout";
                                        }

                                        leaf version {
                                            type types-system:http-version-type;
                                            description "HTTP version for CMPv2 messages";
                                        }

                                    } // container http

                                    container url {
                                        description "Enter the url context";

                                        leaf url-string {
                                            type union {
                                                type types-sros:http-optional-url-loose;
                                            }
                                            description "URL for CMPv2";
                                        }

                                        choice transport {
                                            case service {

                                                leaf service-name {
                                                    type types-services:service-name;
                                                    description "Administrative service name";
                                                }

                                            }
                                            case transmission {

                                                leaf transmission-profile {
                                                    type types-sros:named-item;
                                                    description "Transmission profile for CMPv2";
                                                }

                                            }
                                        }
                                    } // container url

                                    container key-list {
                                        description "Enter the key-list context";

                                        list key {
                                            key "reference-number";
                                            description "Enter the key list instance";

                                            leaf reference-number {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:display-string {
                                                        length "1..64";
                                                        pattern ".*\\S.*" {
                                                            error-message "Reference number must not be all spaces";
                                                        }
                                                    }
                                                }
                                                description "Unique identifier for the CA initial authentication key";
                                            }

                                            leaf password {
                                                type types-sros:encrypted-leaf {
                                                    length "1..115";
                                                }
                                                description "Shared secret for this CA initial authentication key";
                                            }

                                        } // list key

                                    } // container key-list

                                } // container cmpv2

                                container auto-crl-update {
                                    presence "Enable the auto-crl-update context";
                                    description "Enable the auto-crl-update context";

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of the automatic CRL update";
                                    }

                                    leaf periodic-update-interval {
                                        type types-sros:time-duration {
                                            range "3600..31622400";
                                        }
                                        units "seconds";
                                        description "Interval between two consecutive CRL updates";
                                    }

                                    leaf pre-update-time {
                                        type types-sros:time-duration {
                                            range "0..31622400";
                                        }
                                        units "seconds";
                                        description "Time prior to the next update time of the current CRL";
                                    }

                                    leaf retry-interval {
                                        type types-sros:time-duration {
                                            range "0..31622400";
                                        }
                                        units "seconds";
                                        description "Interval before retrying to update CRL";
                                    }

                                    leaf schedule-type {
                                        type enumeration {
                                            enum next-update-based              { value 1; }
                                            enum periodic                       { value 2; }
                                        }
                                        description "Time scheduler type for an automated CRL update";
                                    }

                                    container crl-urls {
                                        description "Enter the crl-urls context";

                                        list url-entry {
                                            key "entry-id";
                                            description "Enter the url-entry list instance";

                                            leaf entry-id {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "1..8";
                                                    }
                                                }
                                                description "URL on this system";
                                            }

                                            leaf transmission-profile {
                                                type types-sros:named-item;
                                                description "File transmission profile to update CRL";
                                            }

                                            leaf url {
                                                type union {
                                                    type types-sros:http-url-path-loose;
                                                }
                                                description "Location of updated CRL";
                                            }

                                        } // list url-entry

                                    } // container crl-urls

                                } // container auto-crl-update

                            } // list ca-profile

                            list common-name-list {
                                key "cn-list-name";
                                description "Enter the common-name-list list instance";

                                leaf cn-list-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "CN list name";
                                }

                                list common-name {
                                    key "cn-index";
                                    description "Enter the common-name list instance";

                                    leaf cn-index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..128";
                                            }
                                        }
                                        description "Common name index";
                                    }

                                    leaf cn-type {
                                        type enumeration {
                                            enum ip-address                     { value 1; }
                                            enum domain-name                    { value 2; }
                                        }
                                        description "Common name type";
                                    }

                                    leaf cn-value {
                                        type types-sros:regular-expression-not-all-spaces;
                                        description "Common name value";
                                    }

                                } // list common-name

                            } // list common-name-list



                            list est-profile {
                                key "name";
                                description "Enter the est-profile list instance";

                                leaf name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Enrollment over Secured Transport profile name";
                                }

                                leaf transmission-profile {
                                    type types-sros:named-item;
                                    description "Transmission profile name for EST";
                                }

                                leaf client-tls-profile {
                                    type types-sros:named-item;
                                    description "TLS client profile assigned to applications";
                                }

                                leaf check-id-kp-cmcra-only {
                                    type boolean;
                                    description "Check id-kp-cmcra in the EST certificate";
                                }

                                container server {
                                    description "Enter the server context";

                                    leaf port {
                                        type types-sros:tcp-udp-port-non-zero;
                                        description "Port number of the EST server";
                                    }

                                    choice address {
                                        case ipv4 {

                                            leaf ipv4 {
                                                type types-sros:ipv4-unicast-address;
                                                description "IPv4 address of the EST server";
                                            }

                                        }
                                        case ipv6 {

                                            leaf ipv6 {
                                                type types-sros:ip-address;
                                                description "IPv6 address of the EST server";
                                            }

                                        }
                                        case fqdn {

                                            leaf fqdn {
                                                type types-sros:fully-qualified-domain-name;
                                                description "Fully Qualified Domain Name (FQDN) of the EST server";
                                            }

                                        }
                                    }
                                } // container server

                                container http-authentication {
                                    description "Enter the http-authentication context";

                                    leaf username {
                                        type string {
                                            length "1..32";
                                        }
                                        description "Username for the EST authentication";
                                    }

                                    leaf password {
                                        type types-sros:encrypted-leaf {
                                            length "1..115";
                                        }
                                        description "Password for EST authentication";
                                    }

                                } // container http-authentication

                            } // list est-profile

                            list certificate-update-profile {
                                key "name";
                                description "Enter the certificate-update-profile list instance";

                                leaf name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Certificate update profile name";
                                }

                                leaf hash-algorithm {
                                    type types-security:hash-algorithm;
                                    description "Hash algorithm for a certificate request";
                                }

                                leaf retry-interval {
                                    type uint32 {
                                        range "60..36000";
                                    }
                                    units "seconds";
                                    description "Retry interval after a failed update";
                                }

                                choice protocol {
                                    case cmpv2 {

                                        container cmpv2 {
                                            description "Enter the cmpv2 context";

                                            leaf ca-profile {
                                                type types-sros:named-item;
                                                description "CA profile name";
                                            }

                                        } // container cmpv2

                                    }
                                    case est {

                                        container est {
                                            description "Enter the est context";

                                            leaf est-profile {
                                                type types-sros:named-item;
                                                description "EST profile name";
                                            }

                                        } // container est

                                    }
                                }
                                choice key-generation {
                                    case same-as-existing-key {

                                        leaf same-as-existing-key {
                                            type empty;
                                            description "Generate the new key to same type and key length";
                                        }

                                    }
                                    case rsa {

                                        container rsa {
                                            description "Enter the rsa context";

                                            leaf key-size {
                                                type uint32 {
                                                    range "512..8192";
                                                }
                                                description "Length of the generated RSA key";
                                            }

                                        } // container rsa

                                    }
                                    case dsa {

                                        container dsa {
                                            description "Enter the dsa context";

                                            leaf key-size {
                                                type uint32 {
                                                    range "512..8192";
                                                }
                                                description "Length of the generated DSA key";
                                            }

                                        } // container dsa

                                    }
                                    case ecdsa {

                                        container ecdsa {
                                            description "Enter the ecdsa context";

                                            leaf curve {
                                                type types-security:ecdsa-curve;
                                                description "Elliptic curve to be used in ECDSA key generation";
                                            }

                                        } // container ecdsa

                                    }
                                }
                                choice schedule {
                                    case before-expiry {

                                        leaf before-expiry {
                                            type uint32 {
                                                range "3600..157680000";
                                            }
                                            units "seconds";
                                            description "Time scheduler updates before certificate expiry";
                                        }

                                    }
                                    case after-issue {

                                        leaf after-issue {
                                            type uint32 {
                                                range "864000..157680000";
                                            }
                                            units "seconds";
                                            description "Time for scheduler updates after certificate issuance";
                                        }

                                    }
                                }
                            } // list certificate-update-profile

                            list certificate-auto-update {
                                key "certificate-file-name";
                                description "Enter the certificate-auto-update list instance";

                                leaf certificate-file-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-security:pki-file-name;
                                    }
                                    description "Certificate file name";
                                }

                                leaf key-file-name {
                                    type types-security:pki-file-name;
                                    description "Imported key filename";
                                }

                                leaf profile {
                                    type types-sros:named-item;
                                    description "Certificate update profile name";
                                }

                            } // list certificate-auto-update

                        } // container pki

                        container python-script {
                            presence "Enable the python-script context";
                            description "Enable the python-script context";

                            container authorization {
                                description "Enter the authorization context";

                                container cron {
                                    description "Enter the cron context";

                                    leaf cli-user {
                                        type types-sros:named-item;
                                        description "User profile name when executing a Python application";
                                    }

                                } // container cron

                                container event-handler {
                                    description "Enter the event-handler context";

                                    leaf cli-user {
                                        type types-sros:named-item;
                                        description "User profile name when executing a Python application";
                                    }

                                } // container event-handler

                                container subscriber-mgmt {
                                    description "Enter the subscriber-mgmt context";

                                    leaf cli-user {
                                        type types-sros:named-item;
                                        description "User profile name when executing a Python application";
                                    }

                                } // container subscriber-mgmt

                            } // container authorization

                        } // container python-script

                        container snmp {
                            presence "Enable the snmp context";
                            description "Enable the snmp context";

                            list access {
                                key "group context security-model security-level";
                                description "Enter the access list instance";

                                leaf group {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Group name";
                                }

                                leaf context {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item-or-empty;
                                    }
                                    description "String to match context name for access rights";
                                }

                                leaf security-model {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type enumeration {
                                            enum snmpv1                         { value 1; }
                                            enum snmpv2c                        { value 2; }
                                            enum usm                            { value 3; }
                                        }
                                    }
                                    description "Security model";
                                }

                                leaf security-level {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type enumeration {
                                            enum no-auth-no-privacy             { value 1; }
                                            enum auth-no-privacy                { value 2; }
                                            enum privacy                        { value 3; }
                                        }
                                    }
                                    description "Minimum security level required to gain access rights";
                                }

                                leaf prefix-match {
                                    type enumeration {
                                        enum exact                          { value 1; }
                                        enum prefix                         { value 2; }
                                    }
                                    description "Match type for the context";
                                }

                                leaf read {
                                    type types-sros:named-item;
                                    description "SNMP view for read access";
                                }

                                leaf write {
                                    type types-sros:named-item;
                                    description "SNMP view for write access";
                                }

                                leaf notify {
                                    type types-sros:named-item;
                                    description "SNMP view for notification access";
                                }

                            } // list access

                            list community {
                                key "community-string";
                                description "Enter the community list instance";

                                leaf community-string {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:encrypted-leaf {
                                            length "1..114";
                                        }
                                    }
                                    description "SNMPv1 or SNMPv2c community string";
                                }

                                leaf access-permissions {
                                    type enumeration {
                                        enum r                              { value 1; }
                                        enum rw                             { value 2; }
                                        enum rwa                            { value 3; }
                                        enum mgmt                           { value 4; }
                                        enum vpls-mgmt                      { value 5; }
                                    }
                                    description "Access permissions for objects in the MIB";
                                }

                                leaf version {
                                    type enumeration {
                                        enum v1                             { value 1; }
                                        enum v2c                            { value 2; }
                                        enum both                           { value 3; }
                                    }
                                    description "SNMP version";
                                }

                                leaf source-access-list {
                                    type types-sros:string-not-all-spaces {
                                        length "1..32";
                                        pattern "[A-Za-z].*" {
                                            error-message "List name must begin with a letter";
                                        }
                                    }
                                    description "Source access list to validate received SNMP requests";
                                }

                            } // list community

                            list usm-community {
                                key "community-string";
                                description "Enter the usm-community list instance";

                                leaf community-string {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:encrypted-leaf {
                                            length "1..114";
                                        }
                                    }
                                    description "Community string associated with SNMPv3 access group";
                                }

                                leaf group {
                                    type types-sros:named-item;
                                    description "Group to manage access rights of the community string";
                                }

                                leaf source-access-list {
                                    type types-sros:string-not-all-spaces {
                                        length "1..32";
                                        pattern "[A-Za-z].*" {
                                            error-message "List name must begin with a letter";
                                        }
                                    }
                                    description "Source access list to validate received SNMP requests";
                                }

                            } // list usm-community

                            container attempts {
                                presence "Enable the attempts context";
                                description "Enable the attempts context";

                                leaf count {
                                    type uint16 {
                                        range "1..64";
                                    }
                                    description "Unsuccessful attempts allowed within time period";
                                }

                                leaf time {
                                    type uint16 {
                                        range "0..60";
                                    }
                                    units "minutes";
                                    description "Time before host lockout after unsuccessful attempts";
                                }

                                leaf lockout {
                                    type uint16 {
                                        range "0..1440";
                                    }
                                    units "minutes";
                                    description "Lockout period during which the host cannot log in";
                                }

                            } // container attempts

                            list source-access-list {
                                key "list-name";
                                description "Enter the source-access-list list instance";

                                leaf list-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:string-not-all-spaces {
                                            length "1..32";
                                            pattern "[A-Za-z].*" {
                                                error-message "List name must begin with a letter";
                                            }
                                        }
                                    }
                                    description "Source access list name";
                                }

                                list source-host {
                                    key "host-name";
                                    description "Enter the source-host list instance";

                                    leaf host-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item;
                                        }
                                        description "Source host entry name";
                                    }

                                    leaf address {
                                        type types-sros:ip-unicast-address;
                                        description "Source IP address entry used to validate SNMP requests";
                                    }

                                } // list source-host

                            } // list source-access-list

                            list view {
                                key "view-name subtree";
                                description "Enter the view list instance";

                                leaf view-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "View name";
                                }

                                leaf subtree {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type string {
                                            length "1..256";
                                        }
                                    }
                                    description "Object Identifier (OID) value";
                                }

                                leaf mask {
                                    type string {
                                        length "1..16";
                                        pattern "(0X|0x)?(([A-Fa-f0-9]){2})+" {
                                            error-message "Hex value must be even number of characters.";
                                        }
                                    }
                                    description "Mask value as binary value, or hex value";
                                }

                                leaf type {
                                    type enumeration {
                                        enum included                       { value 1; }
                                        enum excluded                       { value 2; }
                                    }
                                    description "Type of SNMP security view mask";
                                }

                            } // list view

                        } // container snmp

                        container ssh {
                            presence "Enable the ssh context";
                            description "Enable the ssh context";

                            leaf preserve-key {
                                type boolean;
                                description "Preserve keys and restore on system or server restart";
                            }

                            leaf server-admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the SSH server";
                            }

                            leaf version {
                                status obsolete;
                                type enumeration {
                                    enum 1                              { value 1; }
                                    enum 2                              { value 2; }
                                    enum 1-2                            { value 3; }
                                }
                                description "SSH protocol version supported by the SSH server";
                            }

                            leaf permit-empty-passwords {
                                type boolean;
                                description "Permit users with empty password strings to log in";
                            }

                            leaf listening-port {
                                type types-sros:tcp-udp-port-non-zero {
                                    range "22|1024..49151";
                                }
                                description "TCP port for SSH connections for VPRN or base routing";
                            }

                            container server-cipher-list-v1 {
                                status obsolete;
                                presence "Enable the server-cipher-list-v1 context";
                                description "Enable the server-cipher-list-v1 context";

                                list cipher {
                                    status obsolete;
                                    key "index";
                                    description "Enter the cipher list instance";

                                    leaf index {
                                        status obsolete;
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type int32 {
                                                range "1..255";
                                            }
                                        }
                                        description "Cipher index in the list";
                                    }

                                    leaf name {
                                        status obsolete;
                                        type enumeration {
                                            enum des                            { value 2; }
                                            enum 3des                           { value 3; }
                                            enum blowfish                       { value 6; }
                                        }
                                        description "Algorithm for performing encryption or decryption";
                                    }

                                } // list cipher

                            } // container server-cipher-list-v1

                            container server-cipher-list-v2 {
                                presence "Enable the server-cipher-list-v2 context";
                                description "Enable the server-cipher-list-v2 context";

                                list cipher {
                                    key "index";
                                    description "Enter the cipher list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type int32 {
                                                range "1..255";
                                            }
                                        }
                                        description "Cipher index in the list";
                                    }

                                    leaf name {
                                        type enumeration {
                                            enum 3des-cbc                       { value 32; }
                                            enum aes128-cbc                     { value 36; }
                                            enum aes192-cbc                     { value 37; }
                                            enum aes256-cbc                     { value 38; }
                                            enum aes128-ctr                     { value 40; }
                                            enum aes192-ctr                     { value 41; }
                                            enum aes256-ctr                     { value 42; }
                                            enum blowfish-cbc                   { status obsolete; }
                                            enum cast128-cbc                    { status obsolete; }
                                            enum arcfour                        { status obsolete; }
                                            enum rijndael-cbc                   { status obsolete; }
                                        }
                                        description "Algorithm for performing encryption or decryption";
                                    }

                                } // list cipher

                            } // container server-cipher-list-v2

                            container client-cipher-list-v1 {
                                status obsolete;
                                presence "Enable the client-cipher-list-v1 context";
                                description "Enable the client-cipher-list-v1 context";

                                list cipher {
                                    status obsolete;
                                    key "index";
                                    description "Enter the cipher list instance";

                                    leaf index {
                                        status obsolete;
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type int32 {
                                                range "1..255";
                                            }
                                        }
                                        description "Cipher index in the list";
                                    }

                                    leaf name {
                                        status obsolete;
                                        type enumeration {
                                            enum des                            { value 2; }
                                            enum 3des                           { value 3; }
                                            enum blowfish                       { value 6; }
                                        }
                                        description "Algorithm for performing encryption or decryption";
                                    }

                                } // list cipher

                            } // container client-cipher-list-v1

                            container client-cipher-list-v2 {
                                presence "Enable the client-cipher-list-v2 context";
                                description "Enable the client-cipher-list-v2 context";

                                list cipher {
                                    key "index";
                                    description "Enter the cipher list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type int32 {
                                                range "1..255";
                                            }
                                        }
                                        description "Cipher index in the list";
                                    }

                                    leaf name {
                                        type enumeration {
                                            enum 3des-cbc                       { value 32; }
                                            enum aes128-cbc                     { value 36; }
                                            enum aes192-cbc                     { value 37; }
                                            enum aes256-cbc                     { value 38; }
                                            enum aes128-ctr                     { value 40; }
                                            enum aes192-ctr                     { value 41; }
                                            enum aes256-ctr                     { value 42; }
                                            enum blowfish-cbc                   { status obsolete; }
                                            enum cast128-cbc                    { status obsolete; }
                                            enum arcfour                        { status obsolete; }
                                            enum rijndael-cbc                   { status obsolete; }
                                        }
                                        description "Algorithm for performing encryption or decryption";
                                    }

                                } // list cipher

                            } // container client-cipher-list-v2

                            container server-mac-list-v2 {
                                description "Enter the server-mac-list-v2 context";

                                list mac {
                                    key "index";
                                    description "Enter the mac list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..255";
                                            }
                                        }
                                        description "MAC algorithm index";
                                    }

                                    leaf name {
                                        type enumeration {
                                            enum hmac-sha2-512                  { value 1; }
                                            enum hmac-sha2-256                  { value 2; }
                                            enum hmac-sha1                      { value 3; }
                                            enum hmac-sha1-96                   { value 4; }
                                            enum hmac-md5                       { value 5; }
                                            enum hmac-md5-96                    { value 8; }
                                            enum hmac-ripemd160                 { status obsolete; }
                                            enum hmac-ripemd160-openssh-com     { status obsolete; }
                                        }
                                        description "Algorithm for calculating message authentication code";
                                    }

                                } // list mac

                            } // container server-mac-list-v2

                            container client-mac-list-v2 {
                                description "Enter the client-mac-list-v2 context";

                                list mac {
