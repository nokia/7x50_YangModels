                                leaf check-zero {
                                    type boolean;
                                    description "Enable checking of mandatory zero fields";
                                }

                                leaf message-size {
                                    type types-ripng:message-size;
                                    description "Maximum number of routes in the message";
                                }

                                leaf metric-in {
                                    type types-ripng:metric;
                                    description "Metric added to routes received from the neighbor";
                                }

                                leaf metric-out {
                                    type types-ripng:metric;
                                    description "Metric added to routes exported into RIPng";
                                }

                                leaf preference {
                                    type types-ripng:preference;
                                    description "Route preference";
                                }

                                leaf receive {
                                    type types-ripng:receive;
                                    description "Accepted version on received packets";
                                }

                                leaf split-horizon {
                                    type boolean;
                                    description "Enable split horizon and poison reverse";
                                }

                                leaf send {
                                    type enumeration {
                                        enum none                           { value 1; }
                                        enum ripng                          { value 5; }
                                        enum unicast                        { value 6; }
                                    }
                                    description "RIPng version and method used to send RIPng updates";
                                }

                                container timers {
                                    presence "Enable the timers context";
                                    description "Enable the timers context";

                                    leaf update {
                                        type types-ripng:timer-update;
                                        description "Timer that controls the frequency of updates";
                                    }

                                    leaf timeout {
                                        type types-ripng:timer-timeout;
                                        description "RIP timeout timer";
                                    }

                                    leaf flush {
                                        type types-ripng:timer-flush;
                                        description "RIP flush timer";
                                    }

                                } // container timers

                                list unicast-address {
                                    key "address";
                                    description "Add a list entry for unicast-address";

                                    leaf address {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:ipv6-unicast-address;
                                        }
                                        description "Unicast address for the neighbor";
                                    }

                                } // list unicast-address

                            } // list neighbor

                        } // list group

                    } // container ripng

                    container rsvp {
                        presence "Enable the rsvp context";
                        description "Enable the rsvp context";

                        leaf authentication-over-bypass {
                            type boolean;
                            description "Enable MD5 authentication over bypass LSP of PLR and MP";
                        }

                        leaf entropy-label-capability {
                            type boolean;
                            description "Allow receiving and processing of the entropy label and ELI on incoming packets of RSVP LSPs";
                        }

                        leaf graceful-shutdown {
                            type boolean;
                            description "Initiate a graceful shutdown of all RSVP interfaces on the node";
                        }

                        leaf implicit-null-label {
                            type boolean;
                            description "Signal the implicit null option for all RSVP LSPs";
                        }

                        leaf keep-multiplier {
                            type uint32 {
                                range "1..255";
                            }
                            description "Value for the keep-multiplier to declare a reservation or neighbor as down";
                        }

                        leaf include-node-id-in-rro {
                            type boolean;
                            description "Include the node-id sub-object in the RRO (Record Route Object) on the RSVP instance";
                        }

                        leaf p2mp-merge-point-abort-timer {
                            type uint32 {
                                range "1..65535";
                            }
                            units "seconds";
                            description "Merge pointer timer for abort timer";
                        }

                        leaf p2p-merge-point-abort-timer {
                            type uint32 {
                                range "1..65535";
                            }
                            units "seconds";
                            description "Merge pointer timer for P2P paths";
                        }

                        leaf preemption-timer {
                            type uint32 {
                                range "0..1800";
                            }
                            units "seconds";
                            description "Preemption timer for the MPLS instance";
                        }

                        leaf rapid-retransmit-time {
                            type uint32 {
                                range "1..100";
                            }
                            units "deciseconds";
                            description "Rapid retransmission interval to reliably deliver RSVP messages";
                        }

                        leaf rapid-retry-limit {
                            type uint32 {
                                range "1..6";
                            }
                            description "Rapid retry limit to reliably deliver RSVP messages";
                        }

                        leaf refresh-reduction-over-bypass {
                            type boolean;
                            description "Enable refresh reduction capabilities over tunnels";
                        }

                        leaf refresh-time {
                            type uint32 {
                                range "1..65535";
                            }
                            units "seconds";
                            description "Interval between refresh messages";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of RSVP";
                        }

                        leaf-list te-down-threshold {
                            type types-rsvp:rsvp-te-threshold-level;
                            max-elements 16;
                            ordered-by user;
                            description "Value for the te-down-threshold";
                        }

                        leaf-list te-up-threshold {
                            type types-rsvp:rsvp-te-threshold-level;
                            max-elements 16;
                            ordered-by user;
                            description "Value for the te-up-threshold";
                        }

                        container graceful-restart {
                            description "Enter the graceful-restart context";

                            leaf max-recovery {
                                type uint32 {
                                    range "1..1800";
                                }
                                units "seconds";
                                description "Maximum recovery interval";
                            }

                            leaf max-restart {
                                type uint32 {
                                    range "1..300";
                                }
                                units "seconds";
                                description "Maximum restart interval";
                            }

                        } // container graceful-restart

                        container msg-pacing {
                            presence "Enable the msg-pacing context";
                            description "Enable the msg-pacing context";

                            leaf max-burst {
                                type uint32 {
                                    range "100..1000";
                                }
                                description "Maximum RSVP messages that are sent over a specified period when message pacing is enabled";
                            }

                            leaf period {
                                type uint32 {
                                    range "100..1000";
                                }
                                units "milliseconds";
                                description "Time for RSVP message pacing";
                            }

                        } // container msg-pacing

                        container te-threshold-update {
                            presence "Enable the te-threshold-update context";
                            description "Enable the te-threshold-update context";

                            leaf on-cac-failure {
                                type boolean;
                                description "CAC (Call Admission Control) failure-triggered IGP update";
                            }

                            leaf update-timer {
                                type uint32 {
                                    range "1..300";
                                }
                                units "seconds";
                                description "Timer-based IGP updates";
                            }

                        } // container te-threshold-update

                        container dbw-accounting {
                            presence "Enable the dbw-accounting context";
                            description "Enable the dbw-accounting context";

                            leaf dbw-multiplier {
                                type uint32 {
                                    range "0..1000";
                                }
                                units "percent";
                                description "Dark Bandwidth multiplier";
                            }

                            leaf sample-interval {
                                type uint32 {
                                    range "10..600";
                                }
                                units "seconds";
                                description "Dark Bandwidth sample interval";
                            }

                            leaf sample-multiplier {
                                type uint32 {
                                    range "1..10";
                                }
                                description "Dark Bandwidth sample multiplier";
                            }

                            container up-threshold {
                                description "Enter the up-threshold context";

                                leaf percent {
                                    type types-sros:percent;
                                    description "Minimum difference in percent between dark bandwidth and sampled data rate, to trigger IGP-TE update";
                                }

                                leaf bw {
                                    type int32 {
                                        range "0..1000000";
                                    }
                                    units "megabps";
                                    description "Minimum difference in MRLB or MRB to trigger an update";
                                }

                            } // container up-threshold

                            container down-threshold {
                                description "Enter the down-threshold context";

                                leaf percent {
                                    type types-sros:percent;
                                    description "Minimum difference in percent between dark bandwidth and sampled data rate, to trigger IGP-TE update";
                                }

                                leaf bw {
                                    type int32 {
                                        range "0..1000000";
                                    }
                                    units "megabps";
                                    description "Minimum difference in MRLB or MRB to trigger an update";
                                }

                            } // container down-threshold

                        } // container dbw-accounting

                        container diffserv-te {
                            presence "Enable the diffserv-te context";
                            description "Enable the diffserv-te context";

                            leaf admission-control-model {
                                type enumeration {
                                    enum mam                            { value 1; }
                                    enum rdm                            { value 2; }
                                }
                                description "Parameters for the DiffServ TE node";
                            }

                            container class-type-bw {
                                description "Enter the class-type-bw context";

                                leaf ct0 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "RSVP interface bandwidth percentage for class type 0";
                                }

                                leaf ct1 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "RSVP interface bandwidth percentage for class type 1";
                                }

                                leaf ct2 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "RSVP interface bandwidth percentage for class type 2";
                                }

                                leaf ct3 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "RSVP interface bandwidth percentage for class type 3";
                                }

                                leaf ct4 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "RSVP interface bandwidth percentage for class type 4";
                                }

                                leaf ct5 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "RSVP interface bandwidth percentage for class type 5";
                                }

                                leaf ct6 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "RSVP interface bandwidth percentage for class type 6";
                                }

                                leaf ct7 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "RSVP interface bandwidth percentage for class type 7";
                                }

                            } // container class-type-bw

                            list fc {
                                key "fc-name";
                                description "Enter the fc list instance";

                                leaf fc-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:fc-name;
                                    }
                                    description "Forwarding class for this mapping";
                                }

                                leaf class-type {
                                    type types-mpls:class-type;
                                    description "Diff-Serv Class Type (CT) for an LSP";
                                }

                            } // list fc

                            list te-class {
                                key "te-class-number";
                                description "Enter the te-class list instance";

                                leaf te-class-number {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "0..7";
                                        }
                                    }
                                    description "TE class number";
                                }

                                leaf class-type {
                                    type types-mpls:class-type;
                                    sros-ext:immutable;
                                    description "Class type (CT) associated with the TE class";
                                }

                                leaf priority {
                                    type types-mpls:priority;
                                    sros-ext:immutable;
                                    description "TE class priority";
                                }

                            } // list te-class

                        } // container diffserv-te

                        list interface {
                            key "interface-name";
                            description "Enter the interface list instance";

                            leaf interface-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:interface-name;
                                }
                                description "Index for router RSVP interface";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of RSVP on the IP interface";
                            }

                            leaf authentication-keychain {
                                type types-sros:named-item;
                                description "TCP authentication keychain for the session";
                            }

                            leaf authentication-key {
                                type types-sros:encrypted-leaf {
                                    length "1..51";
                                }
                                description "Authentication or hash key string";
                            }

                            leaf bfd-liveness {
                                type boolean;
                                description "Enable BFD";
                            }

                            leaf graceful-restart-helper-mode {
                                type boolean;
                                description "Enable Graceful Restart helper for the RSVP interface";
                            }

                            leaf graceful-shutdown {
                                type boolean;
                                description "Initiate a graceful shutdown of RSVP interface";
                            }

                            leaf hello-interval {
                                type uint32 {
                                    range "0..60";
                                }
                                units "seconds";
                                description "Time between RSVP Hello messages";
                            }

                            leaf subscription {
                                type uint32 {
                                    range "0..1000";
                                }
                                description "Percentage of the link bandwidth to use for reservation";
                            }

                            leaf dbw-multiplier {
                                type int32 {
                                    range "0..1000";
                                }
                                units "percent";
                                description "Dark bandwidth multiplier";
                            }

                            leaf implicit-null-label {
                                type boolean;
                                description "Signal the implicit null label value for all LSPs";
                            }

                            container class-type-bw {
                                presence "Enable the class-type-bw context";
                                description "Enable the class-type-bw context";

                                leaf ct0 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "Percentage of link bandwidth for class type (CT) 0";
                                }

                                leaf ct1 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "Percentage of link bandwidth for class type (CT) 1";
                                }

                                leaf ct2 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "Percentage of link bandwidth for class type (CT) 2";
                                }

                                leaf ct3 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "Percentage of link bandwidth for class type (CT) 3";
                                }

                                leaf ct4 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "Percentage of link bandwidth for class type (CT) 4";
                                }

                                leaf ct5 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "Percentage of link bandwidth for class type (CT) 5";
                                }

                                leaf ct6 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "Percentage of link bandwidth for class type (CT) 6";
                                }

                                leaf ct7 {
                                    type int32 {
                                        range "0..100";
                                    }
                                    description "Percentage of link bandwidth for class type (CT) 7";
                                }

                            } // container class-type-bw

                            container refresh-reduction {
                                presence "Enable the refresh-reduction context";
                                description "Enable the refresh-reduction context";

                                leaf reliable-delivery {
                                    type boolean;
                                    description "Reliable delivery of RSVP messages over the RSVP interface";
                                }

                            } // container refresh-reduction

                            container dbw-up-threshold {
                                presence "Enable the dbw-up-threshold context";
                                description "Enable the dbw-up-threshold context";

                                leaf percent {
                                    type int32 {
                                        range "0..100";
                                    }
                                    units "percent";
                                    description "Minimum difference in percent between dark bandwidth and sampled data rate, to trigger IGP-TE update";
                                }

                                leaf bw {
                                    type int32 {
                                        range "0..1000000";
                                    }
                                    units "megabps";
                                    description "Minimum difference in MRLB or MRB to trigger an update";
                                }

                            } // container dbw-up-threshold

                            container dbw-down-threshold {
                                presence "Enable the dbw-down-threshold context";
                                description "Enable the dbw-down-threshold context";

                                leaf percent {
                                    type int32 {
                                        range "0..100";
                                    }
                                    units "percent";
                                    description "Minimum difference in percent between dark bandwidth and sampled data rate, to trigger IGP-TE update";
                                }

                                leaf bw {
                                    type int32 {
                                        range "0..1000000";
                                    }
                                    units "megabps";
                                    description "Minimum difference in MRLB or MRB to trigger an update";
                                }

                            } // container dbw-down-threshold

                            container te-down-threshold {
                                presence "Enable the te-down-threshold context";
                                description "Enable the te-down-threshold context";

                                leaf-list value {
                                    type types-rsvp:rsvp-te-threshold-level;
                                    max-elements 16;
                                    ordered-by user;
                                    description "Threshold level per interface";
                                }

                            } // container te-down-threshold

                            container te-up-threshold {
                                presence "Enable the te-up-threshold context";
                                description "Enable the te-up-threshold context";

                                leaf-list value {
                                    type types-rsvp:rsvp-te-threshold-level;
                                    max-elements 16;
                                    ordered-by user;
                                    description "Threshold level per interface";
                                }

                            } // container te-up-threshold

                        } // list interface

                    } // container rsvp

                    container segment-routing {
                        presence "Enable the segment-routing context";
                        description "Enable the segment-routing context";

                        list maintenance-policy {
                            key "policy-name";
                            description "Enter the maintenance-policy list instance";

                            leaf policy-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Maintenance policy name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the maintenance policy";
                            }

                            leaf bfd-liveness {
                                type boolean;
                                description "Enable seamless BFD for segment lists of candidate path";
                            }

                            leaf bfd-template {
                                type types-sros:named-item;
                                description "BFD template to be used by seamless BFD";
                            }

                            leaf mode {
                                type enumeration {
                                    enum none                           { value 0; }
                                    enum ecmp-protected                 { value 1; }
                                    enum linear                         { value 2; }
                                }
                                description "Protection mode for SR policy candidate paths";
                            }

                            leaf threshold {
                                type uint32 {
                                    range "1..32";
                                }
                                description "Minimum number of up S-BFD sessions for up path status";
                            }

                            leaf hold-down-timer {
                                type uint32 {
                                    range "0..5000";
                                }
                                units "deciseconds";
                                description "Hold down timer for SR policy candidate paths";
                            }

                            leaf revert-timer {
                                type uint32 {
                                    range "0..4320";
                                }
                                units "minutes";
                                description "Revert timer for SR policy candidate paths";
                            }

                            leaf return-path-label {
                                type uint32 {
                                    range "32..1048575";
                                }
                                description "S-BFD return-path label";
                            }

                        } // list maintenance-policy

                        container sr-mpls {
                            presence "Enable the sr-mpls context";
                            description "Enable the sr-mpls context";

                            list prefix-sids {
                                key "interface-name";
                                description "Enter the prefix-sids list instance";

                                leaf interface-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:interface-name;
                                    }
                                    description "Loopback interface name that owns prefix to advertise";
                                }

                                leaf node-sid {
                                    type boolean;
                                    description "Assign a node SID to the prefix referencing the router";
                                }

                                container ipv4-sid {
                                    presence "Enable the ipv4-sid context";
                                    description "Enable the ipv4-sid context";

                                    choice type {
                                        case label {

                                            leaf label {
                                                type int64 {
                                                    range "32..1048575";
                                                }
                                                description "Label value for the node SID";
                                            }

                                        }
                                        case index {

                                            leaf index {
                                                type int64 {
                                                    range "0..4294967295";
                                                }
                                                description "Node SID index for the interface";
                                            }

                                        }
                                    }
                                } // container ipv4-sid

                                container ipv6-sid {
                                    presence "Enable the ipv6-sid context";
                                    description "Enable the ipv6-sid context";

                                    choice type {
                                        case label {

                                            leaf label {
                                                type int64 {
                                                    range "32..1048575";
                                                }
                                                description "Label value for the node SID";
                                            }

                                        }
                                        case index {

                                            leaf index {
                                                type int64 {
                                                    range "0..4294967295";
                                                }
                                                description "Node SID index for the interface";
                                            }

                                        }
                                    }
                                } // container ipv6-sid

                                list flex-algo {
                                    key "flex-algo-id";
                                    description "Enter the flex-algo list instance";

                                    leaf flex-algo-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "128..255";
                                            }
                                        }
                                        description "Flexible algorithm ID";
                                    }

                                    container ipv4-sid {
                                        presence "Enable the ipv4-sid context";
                                        description "Enable the ipv4-sid context";

                                        choice type {
                                            case label {

                                                leaf label {
                                                    type int64 {
                                                        range "32..1048575";
                                                    }
                                                    description "Label value for the node SID";
                                                }

                                            }
                                            case index {

                                                leaf index {
                                                    type int64 {
                                                        range "0..4294967295";
                                                    }
                                                    description "Node SID index for the interface";
                                                }

                                            }
                                        }
                                    } // container ipv4-sid

                                    container ipv6-sid {
                                        presence "Enable the ipv6-sid context";
                                        description "Enable the ipv6-sid context";

                                        choice type {
                                            case label {

                                                leaf label {
                                                    type int64 {
                                                        range "32..1048575";
                                                    }
                                                    description "Label value for the node SID";
                                                }

                                            }
                                            case index {

                                                leaf index {
                                                    type int64 {
                                                        range "0..4294967295";
                                                    }
                                                    description "Node SID index for the interface";
                                                }

                                            }
                                        }
                                    } // container ipv6-sid

                                } // list flex-algo

                            } // list prefix-sids

                        } // container sr-mpls

                        container sr-policies {
                            presence "Enable the sr-policies context";
                            description "Enable the sr-policies context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of segment routing policies";
                            }

                            leaf reserved-label-block {
                                type types-sros:named-item-64;
                                description "Reserved local block for segment routing policies";
                            }

                            leaf ecmp {
                                type uint32 {
                                    range "1..16";
                                }
                                description "Maximum number of segment lists per candidate path";
                            }

                            container ingress-statistics {
                                presence "Enable the ingress-statistics context";
                                description "Enable the ingress-statistics context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the traffic statistics";
                                }

                            } // container ingress-statistics

                            container egress-statistics {
                                presence "Enable the egress-statistics context";
                                description "Enable the egress-statistics context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the traffic statistics";
                                }

                                leaf collect-stats {
                                    type boolean;
                                    description "Collect accounting and statistical data";
                                }

                                leaf accounting-policy {
                                    type types-log:log-policy-id;
                                    description "Accounting policy ID";
                                }

                            } // container egress-statistics

                            list static-policy {
                                key "name";
                                description "Enter the static-policy list instance";

                                leaf name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item-64;
                                    }
                                    description "Name of the static SR policy";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of segment routing static policy";
                                }

                                leaf color {
                                    type int64 {
                                        range "0..4294967295";
                                    }
                                    description "Color value for static policy";
                                }

                                leaf endpoint {
                                    type types-sros:ip-address;
                                    description "Destination of the source-routed path";
                                }

                                leaf preference {
                                    type uint32;
                                    description "Preference value of this static policy";
                                }

                                leaf head-end {
                                    type union {
                                        type types-sros:ip-address;
                                        type enumeration {
                                            enum local                          { value 1; }
                                        }
                                    }
                                    description "Head-end address for this static policy";
                                }

                                leaf binding-sid {
                                    type types-sros:mpls-label-or-zero;
                                    description "Binding Segment ID for SR policy to upstream routers";
                                }

                                leaf distinguisher {
                                    type uint32 {
                                        range "1..max";
                                    }
                                    description "Unique value for a policy";
                                }

                                leaf maintenance-policy {
                                    type types-sros:named-item;
                                    description "Policy name";
                                }

                                leaf prefer-transport-frr {
                                    type boolean;
                                    description "Enable transport FRR preference";
                                }

                                leaf type {
                                    type enumeration {
                                        enum sr-mpls                        { value 1; }
                                        enum srv6                           { value 2; }
                                    }
                                    description "Static policy type";
                                }

                                container segment-routing-v6 {
                                    presence "Enable the segment-routing-v6 context";
                                    description "Enable the segment-routing-v6 context";

                                    leaf return-path-bfd-sid {
                                        type types-sros:ipv6-address;
                                        description "BFD controlled return path for SRv6";
                                    }

                                    list binding-sid {
                                        key "index";
                                        description "Enter the binding-sid list instance";

                                        leaf index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1";
                                                }
                                            }
                                            description "Binding SID index";
                                        }

                                        choice binding-sid-type {
                                            case remote-binding-sid {

                                                leaf ip-address {
                                                    type types-sros:ipv6-address;
                                                    description "Remote SRv6 binding SID";
                                                }

                                            }
                                            case local-binding-sid {

                                                container locator {
                                                    presence "Enable the locator context";
                                                    description "Enable the locator context";

                                                    leaf locator-name {
                                                        type types-sros:named-item-64 {
                                                            pattern "[^@]*" {
                                                                error-message "locator name cannot contain @";
                                                            }
                                                        }
                                                        description "Name of the locator of the local SRv6 regular binding SID";
                                                    }

                                                    leaf function {
                                                        type enumeration {
                                                            enum end-b6-encaps-red              { value 1; }
                                                        }
                                                        description "Behavior of the local SRv6 regular binding SID";
                                                    }

                                                    leaf function-value {
                                                        type uint32 {
                                                            range "1..1048575";
                                                        }
                                                        description "Value of the local SRv6 regular binding SID";
                                                    }

                                                } // container locator

                                                container micro-segment-locator {
                                                    presence "Enable the micro-segment-locator context";
                                                    description "Enable the micro-segment-locator context";

                                                    leaf locator-name {
                                                        type types-sros:named-item-64 {
                                                            pattern "[^@]*" {
                                                                error-message "locator name cannot contain @";
                                                            }
                                                        }
                                                        description "Name of the locator of the local SRv6 microbinding SID";
                                                    }

                                                    leaf function {
                                                        type enumeration {
                                                            enum end-b6-encaps-red-next-csid    { value 1; }
                                                        }
                                                        description "Behavior of the local SRv6 microbinding SID";
                                                    }

                                                    leaf function-value {
                                                        type uint32 {
                                                            range "1..65535";
                                                        }
                                                        description "Value of the local SRv6 microbinding SID";
                                                    }

                                                } // container micro-segment-locator

                                            }
                                        }
                                    } // list binding-sid

                                } // container segment-routing-v6

                                list segment-list {
                                    key "seg-list-index";
                                    description "Enter the segment-list list instance";

                                    leaf seg-list-index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..32";
                                            }
                                        }
                                        description "Index for identifying a specific segment list";
                                    }

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of segment list for static policy";
                                    }

                                    leaf weight {
                                        type uint32;
                                        description "Weight of the segment list";
                                    }

                                    list segment {
                                        key "segment-index";
                                        description "Enter the segment list instance";

                                        leaf segment-index {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..24";
                                                }
                                            }
                                            description "Index for identifying a segment in a segment list";
                                        }

                                        leaf mpls-label {
                                            type uint32 {
                                                range "0..1048575";
                                            }
                                            description "Value for the MPLS label";
                                        }

                                        leaf srv6-sid {
                                            type types-sros:ipv6-address;
                                            description "Segment ID for segment routing IPv6";
                                        }

                                        container behavior-and-structure {
                                            presence "Enable the behavior-and-structure context";
                                            description "Enable the behavior-and-structure context";

                                            leaf behavior {
                                                type enumeration {
                                                    enum end-next-csid                  { value 43; }
                                                    enum end-x-next-csid                { value 52; }
                                                    enum end-t-next-csid                { value 85; }
                                                    enum end-b6-encaps-next-csid        { value 93; }
                                                    enum end-b6-encaps-red-next-csid    { value 94; }
                                                }
                                                description "Behavior of the SRv6 uSID";
                                            }

                                            leaf block-length {
                                                type uint8 {
                                                    range "8|16|24|32|40|48|56|64";
                                                }
                                                description "Locator block length of the SRv6 uSID";
                                            }

                                            leaf node-length {
                                                type uint8 {
                                                    range "0|16";
                                                }
                                                description "Length of the node part of the SRv6 uSID";
                                            }

                                            leaf function-length {
                                                type uint8 {
                                                    range "0|16";
                                                }
                                                description "Function length of the SRv6 uSID";
                                            }

                                        } // container behavior-and-structure

                                    } // list segment

                                } // list segment-list

                            } // list static-policy

                        } // container sr-policies

                        container segment-routing-v6 {
                            presence "Enable the segment-routing-v6 context";
                            description "Enable the segment-routing-v6 context";

                            leaf-list origination-fpe {
                                type uint32 {
                                    range "1..64";
                                }
                                max-elements 1;
                                description "List of the SRv6 origination FPEs";
                            }

                            leaf source-address {
                                type types-sros:ipv6-unicast-address;
                                description "Source address used in the SRv6 packet";
                            }

                            list locator {
                                key "locator-name";
                                description "Enter the locator list instance";

                                leaf locator-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item-64 {
                                            pattern "[^@]*" {
                                                error-message "locator name cannot contain @";
                                            }
                                        }
                                    }
                                    description "SRv6 locator name";
                                }

                                leaf block-length {
                                    type types-sros:prefix-length {
                                        range "0..96";
                                    }
                                    description "SRv6 locator block address length";
                                }

                                leaf function-length {
                                    type types-sros:prefix-length {
                                        range "16|20..96";
                                    }
                                    description "Function length";
                                }

                                leaf-list termination-fpe {
                                    type uint32 {
                                        range "1..64";
                                    }
                                    max-elements 1;
                                    description "List of the SRv6 termination FPE";
                                }

                                leaf label-block {
                                    type types-sros:named-item-64;
                                    description "Reserved label block name for service termination";
                                }

                                leaf argument-length {
                                    type uint8 {
                                        range "0|16";
                                    }
                                    description "SRv6 locator argument length";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the locator";
                                }

                                leaf algorithm {
                                    type uint32 {
                                        range "128..255";
                                    }
                                    description "IGP flexible algorithm ID";
                                }

                                container prefix {
                                    description "Enter the prefix context";

                                    leaf ip-prefix {
                                        type types-sros:ipv6-unicast-prefix;
                                        description "SRv6 locator prefix";
                                    }

                                } // container prefix

                                container static-function {
                                    description "Enter the static-function context";

                                    leaf max-entries {
                                        type uint32 {
                                            range "1..1048575";
                                        }
                                        description "Maximum number of static SID functions";
                                    }

                                    leaf label-block {
                                        type types-sros:named-item-64;
                                        description "Label block for the service SIDs of the SRv6 locator";
                                    }

                                } // container static-function

                            } // list locator

                            container micro-segment {
                                presence "Enable the micro-segment context";
                                description "Enable the micro-segment context";

                                leaf block-length {
                                    type uint8 {
                                        range "8|16|24|32|40|48|56|64";
                                    }
                                    description "Micro-SID block length";
                                }

                                leaf global-sid-entries {
                                    type uint8 {
                                        range "4..60";
                                    }
                                    description "Maximum number of micro-segment locators network wide";
                                }

                                leaf sid-length {
                                    type uint8 {
                                        range "16";
                                    }
                                    description "Micro-SID length";
                                }

                                leaf argument-length {
                                    type uint8 {
                                        range "0|16";
                                    }
                                    description "Micro-segment argument length";
                                }

                                list block {
                                    key "block-name";
                                    description "Enter the block list instance";

                                    leaf block-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item-64 {
                                                pattern "[^@]*" {
                                                    error-message "Block name cannot contain @";
                                                }
                                            }
                                        }
                                        description "Micro-SID block name";
                                    }

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of micro-SID block";
                                    }

                                    leaf-list termination-fpe {
                                        type uint32 {
                                            range "1..64";
                                        }
                                        max-elements 1;
                                        description "FPE ID for SRv6 termination";
                                    }

                                    leaf label-block {
                                        type types-sros:named-item-64;
                                        description "Reserved label block";
                                    }

                                    container prefix {
                                        description "Enter the prefix context";

                                        leaf ip-prefix {
                                            type types-sros:ipv6-unicast-prefix;
                                            description "SRv6 locator prefix";
                                        }

                                    } // container prefix

                                    container static-function {
                                        description "Enter the static-function context";

                                        leaf max-entries {
                                            type uint32 {
                                                range "1..1048575";
                                            }
                                            description "Maximum number of static SID functions";
                                        }

                                    } // container static-function

                                } // list block

                            } // container micro-segment

                            list micro-segment-locator {
                                key "locator-name";
                                description "Enter the micro-segment-locator list instance";

                                leaf locator-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item-64 {
                                            pattern "[^@]*" {
                                                error-message "locator name cannot contain @";
                                            }
                                        }
                                    }
                                    description "SRv6 locator name";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the locator";
                                }

                                leaf algorithm {
                                    type uint32 {
                                        range "128..255";
                                    }
                                    description "IGP flexible algorithm ID";
                                }

                                leaf block {
                                    type types-sros:named-item-64 {
                                        pattern "[^@]*" {
                                            error-message "Block name cannot contain @";
                                        }
                                    }
                                    description "Pre-defined micro-SID block";
                                }

                                container un {
                                    description "Enter the un context";

                                    leaf srh-mode {
                                        type types-sr-mpls:srh-mode;
                                        description "Segment Routing Header (SRH) mode";
                                    }

                                    leaf value {
                                        type uint32 {
                                            range "1..1048575";
                                        }
                                        description "SRv6 function value";
                                    }

                                } // container un

                            } // list micro-segment-locator

                            container base-routing-instance {
                                presence "Enable the base-routing-instance context";
                                description "Enable the base-routing-instance context";

                                list locator {
                                    key "locator-name";
                                    description "Enter the locator list instance";

                                    leaf locator-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item-64 {
                                                pattern "[^@]*" {
                                                    error-message "locator name cannot contain @";
                                                }
                                            }
                                        }
                                        description "SRv6 locator name";
                                    }

                                    container function {
                                        description "Enter the function context";

                                        list end {
                                            key "value";
                                            description "Enter the end list instance";

                                            leaf value {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "1..1048575";
                                                    }
                                                }
                                                description "SRv6 SID function value";
                                            }

                                            leaf srh-mode {
                                                type types-sr-mpls:srh-mode;
                                                description "Segment Routing Header (SRH) mode";
                                            }

                                        } // list end

                                        list end-x {
                                            key "value";
                                            description "Enter the end-x list instance";

                                            leaf value {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "1..1048575";
                                                    }
                                                }
                                                description "SRv6 SID function value";
                                            }

                                            leaf srh-mode {
                                                type types-sr-mpls:srh-mode;
                                                description "Segment Routing Header (SRH) mode";
                                            }

                                            leaf protection {
                                                type enumeration {
                                                    enum unprotected                    { value 0; }
                                                    enum protected                      { value 1; }
                                                }
                                                description "Adjacency protection type for the SID function";
                                            }

                                            leaf interface-name {
                                                type types-sros:interface-name;
                                                description "Interface name";
                                            }

                                        } // list end-x

                                        list end-x-auto-allocate {
                                            key "srh-mode protection";
                                            description "Add a list entry for end-x-auto-allocate";

                                            leaf srh-mode {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sr-mpls:srh-mode;
                                                }
                                                description "Segment Routing Header (SRH) mode";
                                            }

                                            leaf protection {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type enumeration {
                                                        enum unprotected                    { value 0; }
                                                        enum protected                      { value 1; }
                                                    }
                                                }
                                                description "Adjacency protection for automatic SID function";
                                            }

                                        } // list end-x-auto-allocate

                                        container end-dt4 {
                                            presence "Enable the end-dt4 context";
                                            description "Enable the end-dt4 context";

                                            leaf value {
                                                type uint32 {
                                                    range "1..1048575";
                                                }
                                                description "SRv6 function value";
                                            }

                                        } // container end-dt4

                                        container end-dt6 {
                                            presence "Enable the end-dt6 context";
                                            description "Enable the end-dt6 context";

                                            leaf value {
                                                type uint32 {
                                                    range "1..1048575";
                                                }
                                                description "SRv6 function value";
                                            }

                                        } // container end-dt6

                                        container end-dt46 {
                                            presence "Enable the end-dt46 context";
                                            description "Enable the end-dt46 context";

                                            leaf value {
                                                type uint32 {
                                                    range "1..1048575";
                                                }
                                                description "SRv6 function value";
                                            }

                                        } // container end-dt46

                                    } // container function

                                } // list locator

                                list micro-segment-locator {
                                    key "locator-name";
                                    description "Enter the micro-segment-locator list instance";

                                    leaf locator-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:named-item-64 {
                                                pattern "[^@]*" {
                                                    error-message "locator name cannot contain @";
                                                }
                                            }
                                        }
                                        description "SRv6 micro-segment locator name";
                                    }

                                    container function {
                                        description "Enter the function context";

                                        list ua {
                                            key "value";
                                            description "Enter the ua list instance";

                                            leaf value {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type uint32 {
                                                        range "1..1048575";
                                                    }
                                                }
                                                description "SRv6 SID function value";
                                            }

                                            leaf srh-mode {
                                                type types-sr-mpls:srh-mode;
                                                description "Segment Routing Header (SRH) mode";
                                            }

                                            leaf protection {
                                                type enumeration {
                                                    enum unprotected                    { value 0; }
                                                    enum protected                      { value 1; }
                                                }
                                                description "Adjacency protection type for the SID function";
                                            }

                                            leaf interface-name {
                                                type types-sros:interface-name;
                                                description "Interface name";
                                            }

                                        } // list ua

                                        list ua-auto-allocate {
                                            key "srh-mode protection";
                                            description "Add a list entry for ua-auto-allocate";

                                            leaf srh-mode {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sr-mpls:srh-mode;
                                                }
                                                description "Segment Routing Header (SRH) mode";
                                            }

                                            leaf protection {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type enumeration {
                                                        enum unprotected                    { value 0; }
                                                        enum protected                      { value 1; }
                                                    }
                                                }
                                                description "Adjacency protection for automatic SID function";
                                            }

                                        } // list ua-auto-allocate

                                        container udt4 {
                                            presence "Enable the udt4 context";
                                            description "Enable the udt4 context";

                                            leaf value {
                                                type uint32 {
                                                    range "1..1048575";
                                                }
                                                description "SRv6 function value";
                                            }

                                        } // container udt4

                                        container udt6 {
                                            presence "Enable the udt6 context";
                                            description "Enable the udt6 context";

                                            leaf value {
                                                type uint32 {
                                                    range "1..1048575";
                                                }
                                                description "SRv6 function value";
                                            }

                                        } // container udt6

                                        container udt46 {
                                            presence "Enable the udt46 context";
                                            description "Enable the udt46 context";

                                            leaf value {
                                                type uint32 {
                                                    range "1..1048575";
                                                }
                                                description "SRv6 function value";
                                            }

                                        } // container udt46

                                    } // container function

                                } // list micro-segment-locator

                            } // container base-routing-instance

                        } // container segment-routing-v6

                    } // container segment-routing

                    container static-routes {
                        presence "Enable the static-routes context";
                        description "Enable the static-routes context";

                        container hold-down {
                            presence "Enable the hold-down context";
                            description "Enable the hold-down context";

                            leaf initial {
                                type uint32 {
                                    range "1..65535";
                                }
                                description "Value for the initial hold-down time";
                            }

                            leaf multiplier {
                                type uint32 {
                                    range "1..10";
                                }
                                description "Multiplier of the previous hold-down time";
                            }

                            leaf max-value {
                                type uint32 {
                                    range "1..65535";
                                }
                                description "Maximum value of the hold-down time";
                            }

                        } // container hold-down

                        list route {
                            key "ip-prefix route-type";
                            description "Enter the route list instance";

                            leaf ip-prefix {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:ip-prefix;
                                }
                                description "IP prefix and prefix length for the static routes";
                            }

                            leaf route-type {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-router:unicast-multicast;
                                }
                                description "Static route type";
                            }

                            leaf-list community {
                                type types-sros:community;
                                max-elements 12;
                                ordered-by user;
                                description "Community ID associated with the static route";
                            }

                            leaf tag {
                                type uint32 {
                                    range "1..max";
                                }
                                description "Static route tag";
                            }

                            leaf backup-tag {
                                type uint32 {
                                    range "1..max";
                                }
                                description "Static route backup tag";
                            }

                            container leak-destination {
                                description "Enter the leak-destination context";

                                list router-instance {
                                    key "service-name";
                                    description "Add a list entry for router-instance";

                                    leaf service-name {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-services:service-name;
                                        }
                                        description "VPRN service name";
                                    }

                                } // list router-instance

                            } // container leak-destination

                            container blackhole {
                                presence "Enable the blackhole context";
                                description "Enable the blackhole context";

                                leaf description {
                                    type types-sros:description-allow-all-white-spaces;
                                    description "Text description";
                                }

                                leaf metric {
                                    type uint32 {
                                        range "0..65535";
                                    }
                                    description "Static route metric";
                                }

                                leaf preference {
                                    type uint32 {
                                        range "1..255";
                                    }
                                    description "Priority of static route over different route sources";
                                }

                                leaf tag {
                                    type uint32 {
                                        range "1..max";
                                    }
                                    description "Static route tag";
                                }

                                leaf community {
                                    type types-sros:community;
                                    description "Community ID associated with the static route";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the static route operation";
                                }

                                leaf dynamic-bgp {
                                    type boolean;
                                    description "Derive static route next hop from BGP next hop value";
                                }

                                leaf generate-icmp {
                                    type boolean;
                                    description "Send ICMP unreachable messages when received packets match a static route with black-hole next-hop";
                                }

                                container prefix-list {
                                    description "Enter the prefix-list context";

                                    leaf name {
                                        type types-sros:named-item-64;
                                        description "Prefix list name";
                                    }

                                    leaf flag {
                                        type enumeration {
                                            enum any                            { value 0; }
                                            enum all                            { value 1; }
                                            enum none                           { value 2; }
                                        }
                                        description "Static route match condition from prefix list";
                                    }

                                } // container prefix-list

                            } // container blackhole


                            list indirect {
                                key "ip-address";
                                description "Enter the indirect list instance";

                                leaf ip-address {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ip-address;
                                    }
                                    description "Next-hop IP address used to reach the destination";
                                }

                                leaf description {
                                    type types-sros:description-allow-all-white-spaces;
                                    description "Text description";
                                }

                                leaf metric {
                                    type uint32 {
                                        range "0..65535";
                                    }
                                    description "Static route metric";
                                }

                                leaf preference {
                                    type uint32 {
                                        range "1..255";
                                    }
                                    description "Priority of static route over different route sources";
                                }

                                leaf tag {
                                    type uint32 {
                                        range "1..max";
                                    }
                                    description "Static route tag";
                                }

                                leaf community {
                                    type types-sros:community;
                                    description "Community ID associated with the static route";
                                }

                                leaf destination-class {
                                    type types-sros:class-index;
                                    description "Destination class for this static route";
                                }

                                leaf source-class {
                                    type types-sros:class-index;
                                    description "Source class for the static route";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the static route operation";
                                }

                                container qos {
                                    description "Enter the qos context";

                                    leaf forwarding-class {
                                        type types-sros:fc-name;
                                        description "Forwarding class associated with the static route";
                                    }

                                    leaf priority {
                                        type types-sros:priority;
                                        description "Static route priority";
                                    }

                                } // container qos

                                container prefix-list {
                                    description "Enter the prefix-list context";

                                    leaf name {
                                        type types-sros:named-item-64;
                                        description "Prefix list name";
                                    }

                                    leaf flag {
                                        type enumeration {
                                            enum any                            { value 0; }
                                            enum all                            { value 1; }
                                            enum none                           { value 2; }
                                        }
                                        description "Static route match condition from prefix list";
                                    }

                                } // container prefix-list

                                list cpe-check {
                                    key "address";
                                    description "Enter the cpe-check list instance";

                                    leaf address {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:ip-address;
                                        }
                                        description "IP address of the target CPE device";
                                    }

                                    leaf drop-count {
                                        type uint32 {
                                            range "1..255";
                                        }
                                        description "Consecutive ping replies missed before CPE deemed down";
                                    }

                                    leaf interval {
                                        type uint32 {
                                            range "1..255";
                                        }
                                        units "seconds";
                                        description "Interval between ICMP pings to target CPE IP address";
                                    }

                                    leaf log {
                                        type boolean;
                                        description "Log CPE connectivity checks transitions";
                                    }

                                    leaf padding-size {
                                        type uint32 {
                                            range "0..16384";
                                        }
                                        units "bytes";
                                        description "Padding size for CPE connectivity checks";
                                    }

                                } // list cpe-check

                                container tunnel-next-hop {
                                    description "Enter the tunnel-next-hop context";

                                    leaf disallow-igp {
                                        type boolean;
                                        description "Do not resolve indirect static routes using IGP next-hops in RTM if no tunnel next-hops found in TTM";
                                    }

                                    leaf resolution {
                                        type enumeration {
                                            enum none                           { value 0; }
                                            enum filter                         { value 1; }
                                            enum any                            { value 2; }
                                        }
                                        description "Tunnel next hop resolution to resolve indirect static route";
                                    }

                                    leaf flex-algo {
                                        type types-router:flex-algo-id;
                                        description "Flexible Algorithm ID";
                                    }

                                    container resolution-filter {
                                        description "Enter the resolution-filter context";

                                        leaf ldp {
                                            type boolean;
                                            description "Use LDP Route Forwarding Equivalence Class (FEC) tunneling for next-hop resolution";
                                        }

                                        leaf sr-isis {
                                            type boolean;
                                            description "Use the SR ISIS tunneling mechanism to resolve next hop for the static route";
                                        }

                                        leaf sr-ospf {
                                            type boolean;
                                            description "Use SR OSPF tunneling for next-hop resolution";
                                        }

                                        leaf sr-ospf3 {
                                            type boolean;
                                            description "Use SR OSPFv3 tunneling mechanism to resolve next-hop";
                                        }

                                        leaf rib-api {
                                            type boolean;
                                            description "Set RIB API type for use with tunnel next-hop";
                                        }

                                        leaf mpls-fwd-policy {
                                            type boolean;
                                            description "Use MPLS forwarding policy for tunnel-next-hop";
                                        }

                                        container rsvp-te {
                                            presence "Enable the rsvp-te context";
                                            description "Enable the rsvp-te context";

                                            list lsp {
                                                key "lsp-name";
                                                description "Add a list entry for lsp";

                                                leaf lsp-name {
                                                    type union {
                                                        type string {
                                                            length "1..64";
                                                            pattern "<.*>" {
                                                                error-message "Config Groups Regex Pattern";
                                                            }
                                                        }
                                                        type types-sros:named-item-64;
                                                    }
                                                    description "Labeled Switch Path name";
                                                }

                                            } // list lsp

                                        } // container rsvp-te

                                        container sr-te {
                                            presence "Enable the sr-te context";
                                            description "Enable the sr-te context";

                                            list lsp {
                                                key "lsp-name";
                                                description "Add a list entry for lsp";

                                                leaf lsp-name {
                                                    type union {
                                                        type string {
                                                            length "1..64";
                                                            pattern "<.*>" {
                                                                error-message "Config Groups Regex Pattern";
                                                            }
                                                        }
                                                        type types-sros:named-item-64;
                                                    }
                                                    description "Labeled Switch Path name";
                                                }

                                            } // list lsp

                                        } // container sr-te

                                    } // container resolution-filter

                                } // container tunnel-next-hop

                            } // list indirect

                            list interface {
                                key "interface-name";
                                description "Enter the interface list instance";

                                leaf interface-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:interface-name;
                                    }
                                    description "Router interface name";
                                }

                                leaf description {
                                    type types-sros:description-allow-all-white-spaces;
                                    description "Text description";
                                }

                                leaf metric {
                                    type uint32 {
                                        range "0..65535";
                                    }
                                    description "Static route metric";
                                }

                                leaf preference {
                                    type uint32 {
                                        range "1..255";
                                    }
                                    description "Priority of static route over different route sources";
                                }

                                leaf tag {
                                    type uint32 {
                                        range "1..max";
                                    }
                                    description "Static route tag";
                                }

                                leaf community {
                                    type types-sros:community;
                                    description "Community ID associated with the static route";
                                }

                                leaf destination-class {
                                    type types-sros:class-index;
                                    description "Destination class for this static route";
                                }

                                leaf source-class {
                                    type types-sros:class-index;
                                    description "Source class for the static route";
                                }

                                leaf load-balancing-weight {
                                    type uint32 {
                                        range "1..max";
                                    }
                                    description "Load-balancing weight for all of the ECMP next hops";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the static route operation";
                                }

                                container qos {
                                    description "Enter the qos context";

                                    leaf forwarding-class {
                                        type types-sros:fc-name;
                                        description "Forwarding class associated with the static route";
                                    }

                                    leaf priority {
                                        type types-sros:priority;
                                        description "Static route priority";
                                    }

                                } // container qos

                                container prefix-list {
                                    description "Enter the prefix-list context";

                                    leaf name {
                                        type types-sros:named-item-64;
                                        description "Prefix list name";
                                    }

                                    leaf flag {
                                        type enumeration {
                                            enum any                            { value 0; }
                                            enum all                            { value 1; }
                                            enum none                           { value 2; }
                                        }
                                        description "Static route match condition from prefix list";
                                    }

                                } // container prefix-list

                                list cpe-check {
                                    key "address";
                                    description "Enter the cpe-check list instance";

                                    leaf address {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type types-sros:ip-address;
                                        }
                                        description "IP address of the target CPE device";
                                    }

                                    leaf drop-count {
                                        type uint32 {
                                            range "1..255";
                                        }
                                        description "Consecutive ping replies missed before CPE deemed down";
                                    }

                                    leaf interval {
                                        type uint32 {
                                            range "1..255";
                                        }
                                        units "seconds";
                                        description "Interval between ICMP pings to target CPE IP address";
                                    }

                                    leaf log {
                                        type boolean;
                                        description "Log CPE connectivity checks transitions";
                                    }

                                    leaf padding-size {
                                        type uint32 {
                                            range "0..16384";
                                        }
                                        units "bytes";
                                        description "Padding size for CPE connectivity checks";
                                    }

                                } // list cpe-check

                            } // list interface

                            list ipsec-tunnel {
                                key "ipsec-tunnel-name";
                                description "Enter the ipsec-tunnel list instance";

                                leaf ipsec-tunnel-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "IPsec tunnel name";
                                }

                                leaf description {
                                    type types-sros:description-allow-all-white-spaces;
                                    description "Text description";
                                }

                                leaf metric {
                                    type uint32 {
                                        range "0..65535";
                                    }
                                    description "Static route metric";
                                }

                                leaf preference {
                                    type uint32 {
                                        range "1..255";
                                    }
                                    description "Priority of static route over different route sources";
                                }

                                leaf tag {
                                    type uint32 {
                                        range "1..max";
                                    }
                                    description "Static route tag";
                                }

                                leaf community {
                                    type types-sros:community;
                                    description "Community ID associated with the static route";
                                }

                                leaf destination-class {
                                    type types-sros:class-index;
                                    description "Destination class for this static route";
                                }

                                leaf source-class {
                                    type types-sros:class-index;
                                    description "Source class for the static route";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the static route operation";
                                }

                                container qos {
                                    description "Enter the qos context";

                                    leaf forwarding-class {
                                        type types-sros:fc-name;
                                        description "Forwarding class associated with the static route";
                                    }

                                    leaf priority {
                                        type types-sros:priority;
                                        description "Static route priority";
                                    }

                                } // container qos

                            } // list ipsec-tunnel

                            list next-hop {
                                key "ip-address";
                                description "Enter the next-hop list instance";

                                leaf ip-address {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ip-address-with-zone;
                                    }
                                    description "IP address of the directly-connected next hop";
                                }

                                leaf description {
                                    type types-sros:description-allow-all-white-spaces;
                                    description "Text description";
                                }

                                leaf metric {
                                    type uint32 {
                                        range "0..65535";
                                    }
                                    description "Static route metric";
                                }

                                leaf preference {
                                    type uint32 {
                                        range "1..255";
                                    }
                                    description "Priority of static route over different route sources";
                                }

                                leaf tag {
                                    type uint32 {
                                        range "1..max";
                                    }
                                    description "Static route tag";
                                }

                                leaf community {
                                    type types-sros:community;
                                    description "Community ID associated with the static route";
                                }

                                leaf destination-class {
                                    type types-sros:class-index;
                                    description "Destination class for this static route";
                                }

                                leaf source-class {
                                    type types-sros:class-index;
                                    description "Source class for the static route";
                                }

                                leaf bfd-liveness {
                                    type boolean;
                                    description "Use Bidirectional Forwarding Detection on this static route";
                                }

                                leaf validate-next-hop {
                                    type boolean;
                                    description "Track the state of the next hop in the IPv4 ARP Cache or the IPv6 Neighbor Cache";
                                }

                                leaf load-balancing-weight {
                                    type uint32 {
                                        range "1..max";
                                    }
                                    description "Load-balancing weight for all of the ECMP next hops";
                                }

                                leaf ldp-sync {
                                    type boolean;
                                    description "Use LDP synchronization feature for a static route";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the static route operation";
                                }

                                container qos {
                                    description "Enter the qos context";

                                    leaf forwarding-class {
                                        type types-sros:fc-name;
                                        description "Forwarding class associated with the static route";
                                    }

                                    leaf priority {
                                        type types-sros:priority;
                                        description "Static route priority";
                                    }

                                } // container qos

                                container prefix-list {
                                    description "Enter the prefix-list context";

                                    leaf name {
                                        type types-sros:named-item-64;
                                        description "Prefix list name";
                                    }

                                    leaf flag {
                                        type enumeration {
                                            enum any                            { value 0; }
                                            enum all                            { value 1; }
                                            enum none                           { value 2; }
                                        }
                                        description "Static route match condition from prefix list";
                                    }

