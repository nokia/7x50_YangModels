                                type string {
                                    length "2";
                                    pattern "x[1-2]" {
                                        error-message "Invalid xiom-slot.";
                                    }
                                }
                            }
                            description "XIOM slot ID";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
