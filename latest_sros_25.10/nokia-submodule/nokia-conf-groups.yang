                            } // list flow-setup-rate

                        } // container policer

                        container protocol-handlers {
                            description "Enter the protocol-handlers context";

                            container udp {
                                description "Enter the udp context";

                                leaf flow-inactivity-timeout {
                                    type uint32 {
                                        range "1..600";
                                    }
                                    units "seconds";
                                    description "Inactivity timeout for UDP flows";
                                }

                            } // container udp

                            container tcp {
                                description "Enter the tcp context";

                                leaf dynamic-block {
                                    type boolean;
                                    description "Block the tracked source upon a TCP flow discard";
                                }

                                leaf flow-inactivity-timeout {
                                    type uint32 {
                                        range "1..3600";
                                    }
                                    units "seconds";
                                    description "Inactivity timeout for TCP flows";
                                }

                                leaf flow-protected-object-reset {
                                    type enumeration {
                                        enum none {
                                            value 0;
                                            description "Do not send any RSTs";
                                        }
                                        enum authenticated-sources {
                                            value 1;
                                            description "Send an RST for TCP-authenticated tracked sources only";
                                        }
                                        enum all-sources {
                                            value 2;
                                            description "RST for any tracked-source.";
                                        }
                                    }
                                    description "Whether to send a TCP RST to the PO if flow ends early";
                                }

                                leaf flow-start-guard-time {
                                    type uint32 {
                                        range "1..120";
                                    }
                                    units "seconds";
                                    description "Maximum time to receive payload after a TCP handshake";
                                }

                            } // container tcp

                            container other {
                                description "Enter the other context";

                                leaf flow-inactivity-timeout {
                                    type uint32 {
                                        range "1..600";
                                    }
                                    units "seconds";
                                    description "Inactivity timeout for non-TCP and non-UDP flows";
                                }

                            } // container other

                            list dns-validate {
                                key "name";
                                description "Enter the dns-validate list instance";

                                leaf name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "DNS packet validator instance name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf dynamic-block {
                                    type boolean;
                                    description "Block the tracked source upon a DNS validator discard";
                                }

                                leaf message-size-limit {
                                    type uint32 {
                                        range "1..10000";
                                    }
                                    description "Maximum size of the DNS message";
                                }

                                leaf request-rate-policer {
                                    type types-sros:named-item;
                                    description "PO event-rate policer used for DNS requests";
                                }

                                leaf source-request-rate-policer {
                                    type types-sros:named-item;
                                    description "Source event-rate policer used for DNS requests";
                                }

                                container dns-redirect-target {
                                    description "Enter the dns-redirect-target context";

                                    leaf ipv4-server-a {
                                        type types-sros:ip-address;
                                        description "IPv4 address of a DNS server at the PO";
                                    }

                                    leaf ipv4-server-b {
                                        type types-sros:ip-address;
                                        description "IPv4 address of a secondary DNS server at the PO";
                                    }

                                    leaf ipv6-server-a {
                                        type types-sros:ip-address;
                                        description "IPv6 address of a DNS server at the PO";
                                    }

                                    leaf ipv6-server-b {
                                        type types-sros:ip-address;
                                        description "IPv6 address of a secondary DNS server at the PO";
                                    }

                                } // container dns-redirect-target

                                container dns-filter {
                                    presence "Enable the dns-filter context";
                                    description "Enable the dns-filter context";

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of the DNS filter";
                                    }

                                    container default-action {
                                        description "Enter the default-action context";

                                        leaf drop {
                                            type boolean;
                                            description "Drop traffic not matching any DNS filter entries";
                                        }

                                    } // container default-action

                                    list entry {
                                        key "id";
                                        description "Enter the entry list instance";

                                        leaf id {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type uint32 {
                                                    range "1..16";
                                                }
                                            }
                                            description "Unique ID for the DNS filter entry";
                                        }

                                        leaf description {
                                            type types-sros:description;
                                            description "Text description";
                                        }

                                        container action {
                                            description "Enter the action context";

                                            leaf drop {
                                                type boolean;
                                                description "Drop traffic matching the DNS filter entry";
                                            }

                                            leaf request-rate-policer {
                                                type types-sros:named-item;
                                                description "PO-granularity event-rate policer for DNS requests";
                                            }

                                            leaf source-request-rate-policer {
                                                type types-sros:named-item;
                                                description "Source-granularity event-rate policer for DNS requests";
                                            }

                                            container query-name-entropy-range {
                                                presence "Enable the query-name-entropy-range context";
                                                description "Enable the query-name-entropy-range context";

                                                leaf minimum {
                                                    type decimal64 {
                                                        range "0.00..9.99";
                                                        fraction-digits 2;
                                                    }
                                                    description "Minimum entropy of the DNS query name";
                                                }

                                                leaf maximum {
                                                    type decimal64 {
                                                        range "0.01..10.00";
                                                        fraction-digits 2;
                                                    }
                                                    description "Maximum entropy of the DNS query name";
                                                }

                                            } // container query-name-entropy-range

                                        } // container action

                                        container match {
                                            description "Enter the match context";

                                            container query-type {
                                                description "Enter the query-type context";

                                                list record {
                                                    key "record-type";
                                                    description "Add a list entry for record";

                                                    leaf record-type {
                                                        type union {
                                                            type string {
                                                                length "1..64";
                                                                pattern "<.*>" {
                                                                    error-message "Config Groups Regex Pattern";
                                                                }
                                                            }
                                                            type types-dms:dns-record-type;
                                                        }
                                                        description "DNS record type";
                                                    }

                                                } // list record

                                            } // container query-type

                                            container query-name {
                                                description "Enter the query-name context";

                                                list dns-list {
                                                    key "list-name";
                                                    description "Add a list entry for dns-list";

                                                    leaf list-name {
                                                        type union {
                                                            type string {
                                                                length "1..64";
                                                                pattern "<.*>" {
                                                                    error-message "Config Groups Regex Pattern";
                                                                }
                                                            }
                                                            type types-sros:named-item;
                                                        }
                                                        description "DNS domain list name";
                                                    }

                                                } // list dns-list

                                                list expression {
                                                    key "expression-string";
                                                    description "Add a list entry for expression";

                                                    leaf expression-string {
                                                        type union {
                                                            type string {
                                                                length "1..64";
                                                                pattern "<.*>" {
                                                                    error-message "Config Groups Regex Pattern";
                                                                }
                                                            }
                                                            type string {
                                                                length "1..80";
                                                            }
                                                        }
                                                        description "DNS domain expression";
                                                    }

                                                } // list expression

                                            } // container query-name

                                        } // container match

                                    } // list entry

                                } // container dns-filter

                                container query-name-entropy-range {
                                    presence "Enable the query-name-entropy-range context";
                                    description "Enable the query-name-entropy-range context";

                                    leaf minimum {
                                        type decimal64 {
                                            range "0.00..9.99";
                                            fraction-digits 2;
                                        }
                                        description "Minimum entropy of the DNS query name";
                                    }

                                    leaf maximum {
                                        type decimal64 {
                                            range "0.01..10.00";
                                            fraction-digits 2;
                                        }
                                        description "Maximum entropy of the DNS query name";
                                    }

                                } // container query-name-entropy-range

                            } // list dns-validate

                            list dns-tracker {
                                key "dns-tracker-name";
                                description "Enter the dns-tracker list instance";

                                leaf dns-tracker-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "DNS tracker name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf dynamic-block {
                                    type boolean;
                                    description "Block the tracked source upon DNS tracker discard";
                                }

                                leaf inactivity-timeout {
                                    type uint32 {
                                        range "1..3600";
                                    }
                                    units "seconds";
                                    description "Inactivity timeout for DNS over TCP flows";
                                }

                                leaf start-guard-time {
                                    type uint32 {
                                        range "1..120";
                                    }
                                    units "seconds";
                                    description "Maximum time to receive DNS request after TCP handshake";
                                }

                                leaf payload-validate {
                                    type types-sros:named-item;
                                    description "DNS over TCP/UDP packet validator to analyze payload";
                                }

                            } // list dns-tracker


                            list http-tracker {
                                key "http-tracker-name";
                                description "Enter the http-tracker list instance";

                                leaf http-tracker-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "HTTP flow tracker instance name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf dynamic-block {
                                    type boolean;
                                    description "Block the tracked source upon an HTTP tracker discard";
                                }

                                leaf inactivity-timeout {
                                    type uint32 {
                                        range "1..3600";
                                    }
                                    units "seconds";
                                    description "Inactivity timeout for HTTP flows";
                                }

                                leaf start-guard-time {
                                    type uint32 {
                                        range "1..120";
                                    }
                                    units "seconds";
                                    description "Max time to receive HTTP request after TCP handshake";
                                }

                                leaf request-guard-time {
                                    type uint32 {
                                        range "1..120";
                                    }
                                    units "seconds";
                                    description "Maximum time to complete an HTTP request";
                                }

                                leaf request-rate-policer {
                                    type types-sros:named-item;
                                    description "PO event-rate policer used for HTTP requests";
                                }

                                leaf source-request-rate-policer {
                                    type types-sros:named-item;
                                    description "Source event-rate policer used for HTTP requests";
                                }

                            } // list http-tracker

                            list icmp-validate {
                                key "name";
                                description "Enter the icmp-validate list instance";

                                leaf name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "ICMP packet validator instance name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf dynamic-block {
                                    type boolean;
                                    description "Block the tracked source upon ICMP validator discard";
                                }

                                leaf echo-rate-policer {
                                    type types-sros:named-item;
                                    description "PO event-rate policer used for ICMP echo messages";
                                }

                                leaf track-source {
                                    type boolean;
                                    description "Valid ICMP can optionally trigger tracked-source state to be kept.";
                                }

                                leaf source-echo-rate-policer {
                                    type types-sros:named-item;
                                    description "Source event-rate policer used for ICMP echo messages";
                                }

                            } // list icmp-validate

                            list quic-tracker {
                                key "quic-tracker-name";
                                description "Enter the quic-tracker list instance";

                                leaf quic-tracker-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "QUIC flow tracker instance name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf dynamic-block {
                                    type boolean;
                                    description "Block the tracked source upon QUIC tracker discard";
                                }

                                leaf fragment-limit {
                                    type uint32 {
                                        range "1..31";
                                    }
                                    description "Maximum number of QUIC message fragments in handshake";
                                }

                                leaf application-data-guard-time {
                                    type uint32 {
                                        range "1..120";
                                    }
                                    units "seconds";
                                    description "Maximum time to send data after flow initialization";
                                }

                                leaf inactivity-timeout {
                                    type uint32 {
                                        range "1..3600";
                                    }
                                    units "seconds";
                                    description "Inactivity timeout for QUIC flows";
                                }

                                leaf concurrent-handshake-limit {
                                    type types-sros:named-item;
                                    description "PO-level event-count policer to limit QUIC sessions";
                                }

                                leaf source-concurrent-handshake-limit {
                                    type types-sros:named-item;
                                    description "Source-level policer to limit number of QUIC sessions";
                                }

                            } // list quic-tracker

                            list sip-tracker {
                                key "sip-tracker-name";
                                description "Enter the sip-tracker list instance";

                                leaf sip-tracker-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "SIP flow tracker instance name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf dynamic-block {
                                    type boolean;
                                    description "Block the tracked source upon SIP tracker discard";
                                }

                                leaf request-rate-policer {
                                    type types-sros:named-item;
                                    description "PO-level event-rate policer to use for SIP requests";
                                }

                                leaf source-request-rate-policer {
                                    type types-sros:named-item;
                                    description "Source-level event-rate policer to use for SIP requests";
                                }

                                container udp {
                                    description "Enter the udp context";

                                    leaf inactivity-timeout {
                                        type uint32 {
                                            range "1..3600";
                                        }
                                        units "seconds";
                                        description "Inactivity timeout for SIP over UDP flows";
                                    }

                                } // container udp


                            } // list sip-tracker

                            list tls-tracker {
                                key "tls-tracker-name";
                                description "Enter the tls-tracker list instance";

                                leaf tls-tracker-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "TLS flow tracker instance name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf dynamic-block {
                                    type boolean;
                                    description "Block the tracked source upon TLS tracker discard";
                                }

                                leaf inactivity-timeout {
                                    type uint32 {
                                        range "1..3600";
                                    }
                                    units "seconds";
                                    description "Inactivity timeout for TLS flows";
                                }

                                leaf client-cipher-limit {
                                    type uint32 {
                                        range "1..255";
                                    }
                                    description "Maximum number of cipher suites in the client Hello";
                                }

                                leaf client-extension-limit {
                                    type uint32 {
                                        range "1..31";
                                    }
                                    description "Maximum number of TLS extensions in the client Hello";
                                }

                                leaf concurrent-handshake-limit {
                                    type types-sros:named-item;
                                    description "PO-level event-count policer to limit TLS sessions";
                                }

                                leaf source-concurrent-handshake-limit {
                                    type types-sros:named-item;
                                    description "Source-level event-count policer to limit TLS sessions";
                                }

                                leaf start-guard-time {
                                    type uint32 {
                                        range "1..120";
                                    }
                                    units "seconds";
                                    description "Max time to receive client Hello after TCP handshake";
                                }

                                leaf handshake-guard-time {
                                    type uint32 {
                                        range "1..120";
                                    }
                                    units "seconds";
                                    description "Maximum time to complete the TLS security handshake";
                                }

                                leaf application-data-guard-time {
                                    type uint32 {
                                        range "1..120";
                                    }
                                    units "seconds";
                                    description "Maximum time to send data after the TLS handshake";
                                }

                                leaf tls-client-filter {
                                    type types-sros:named-item;
                                    description "TLS client filter used to filter TLS client Hellos";
                                }

                            } // list tls-tracker

                            list tls-client-filter {
                                key "tls-client-filter-name";
                                description "Enter the tls-client-filter list instance";

                                leaf tls-client-filter-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "TLS client filter name";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the TLS client filter";
                                }

                                container default-action {
                                    description "Enter the default-action context";

                                    leaf drop {
                                        type boolean;
                                        description "Drop traffic not matching any TLS client filter entries";
                                    }

                                } // container default-action

                                list entry {
                                    key "id";
                                    description "Enter the entry list instance";

                                    leaf id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..8";
                                            }
                                        }
                                        description "TLS client filter entry ID";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    container action {
                                        description "Enter the action context";

                                        leaf drop {
                                            type boolean;
                                            description "Drop traffic matching the TLS client filter entry";
                                        }

                                    } // container action

                                    container match {
                                        description "Enter the match context";

                                        list tls-fingerprint-list {
                                            key "list-name";
                                            description "Add a list entry for tls-fingerprint-list";

                                            leaf list-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:named-item;
                                                }
                                                description "TLS fingerprint list name";
                                            }

                                        } // list tls-fingerprint-list

                                    } // container match

                                } // list entry

                            } // list tls-client-filter

                        } // container protocol-handlers

                        container mitigation-rules {
                            description "Enter the mitigation-rules context";

                            list entry {
                                key "id";
                                description "Enter the entry list instance";

                                leaf id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "1..65535";
                                        }
                                    }
                                    description "Mitigation-rule entry ID";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the PO mitigation-rule entry";
                                }

                                leaf monitor {
                                    type boolean;
                                    description "Track discards that would have occurred, but did not";
                                }

                                container action {
                                    description "Enter the action context";

                                    leaf drop {
                                        type boolean;
                                        description "Drop traffic that matches the mitigation-rule entry";
                                    }

                                    leaf flow-count-policer {
                                        type types-sros:named-item;
                                        description "PO-level flow-count policer to apply to traffic";
                                    }

                                    leaf flow-setup-rate-policer {
                                        type types-sros:named-item;
                                        description "PO-level flow setup-rate policer to apply to traffic";
                                    }

                                    leaf source-flow-count-policer {
                                        type types-sros:named-item;
                                        description "Source flow-count policer to apply to traffic";
                                    }

                                    leaf source-flow-setup-rate-policer {
                                        type types-sros:named-item;
                                        description "Source flow-setup-rate policer to apply to traffic";
                                    }

                                    leaf dns-client-authentication {
                                        type enumeration {
                                            enum none {
                                                value 0;
                                                description "No DNS authentication";
                                            }
                                            enum active-ns-redirect {
                                                value 1;
                                                description "Actively challenge using custom NS redirect";
                                            }
                                            enum active-force-tcp {
                                                value 2;
                                                description "Actively challenge by forcing to use TCP";
                                            }
                                            enum active-cookie-ns-redirect {
                                                value 3;
                                                description "Actively challenge with NS redirect and cookie exchange";
                                            }
                                        }
                                        description "DNS client authentication for DNS requests";
                                    }

                                    leaf http-client-authentication {
                                        type enumeration {
                                            enum none {
                                                value 0;
                                                description "No HTTP authentication";
                                            }
                                            enum active-302-redirect {
                                                value 1;
                                                description "Actively challenge the HTTP client using a 302 redirect";
                                            }
                                        }
                                        description "HTTP client authentication for HTTP flows";
                                    }

                                    leaf quic-client-authentication {
                                        type enumeration {
                                            enum none {
                                                value 0;
                                                description "No QUIC authentication";
                                            }
                                            enum active-challenge {
                                                value 1;
                                                description "Actively challenge the session with a SynAck cookie";
                                            }
                                        }
                                        description "QUIC client authentication for QUIC flows";
                                    }

                                    leaf tcp-client-authentication {
                                        type enumeration {
                                            enum none {
                                                value 0;
                                                description "No TCP authentication";
                                            }
                                            enum active-challenge {
                                                value 1;
                                                description "Actively challenge session with a SynAck cookie";
                                            }
                                            enum active-invalid-ack {
                                                value 2;
                                                description "Actively interrupt session with an out of sequence Ack";
                                            }
                                            enum active-invalid-syn-ack {
                                                value 3;
                                                description "Actively interrupt session with a SynAck invalid AckNum";
                                            }
                                        }
                                        description "TCP client authentication for TCP flows";
                                    }

                                    container protocol-tracker {
                                        description "Enter the protocol-tracker context";

                                        choice tracker {
                                            case any {

                                                leaf any {
                                                    type empty;
                                                    description "Track matching traffic as a stateful flow";
                                                }

                                            }
                                            case dns {

                                                leaf dns {
                                                    type types-sros:named-item;
                                                    description "Flow tracker to analyze matching DNS over TCP traffic";
                                                }

                                            }
                                            case http {

                                                leaf http {
                                                    type types-sros:named-item;
                                                    description "Flow tracker used to analyze matching HTTP traffic";
                                                }

                                            }
                                            case quic {

                                                leaf quic {
                                                    type types-sros:named-item;
                                                    description "Flow tracker used to analyze matching QUIC traffic";
                                                }

                                            }
                                            case sip {

                                                leaf sip {
                                                    type types-sros:named-item;
                                                    description "Flow tracker used to analyze matching SIP traffic";
                                                }

                                            }
                                            case tls {

                                                leaf tls {
                                                    type types-sros:named-item;
                                                    description "Flow tracker used to analyze matching TLS traffic";
                                                }

                                            }
                                        }
                                    } // container protocol-tracker

                                    container protocol-validate {
                                        description "Enter the protocol-validate context";

                                        choice validate {
                                            case dns {

                                                leaf dns {
                                                    type types-sros:named-item;
                                                    description "DNS protocol packet validator used to analyze traffic";
                                                }

                                            }
                                            case icmp {

                                                leaf icmp {
                                                    type types-sros:named-item;
                                                    description "ICMP protocol packet validator used to analyze traffic";
                                                }

                                            }
                                        }
                                    } // container protocol-validate

                                } // container action

                                container match {
                                    description "Enter the match context";

                                    container dst-ip {
                                        description "Enter the dst-ip context";

                                        leaf operator {
                                            type types-dms:match-operator;
                                            description "Match condition for the IP address";
                                        }

                                        choice value {
                                            case prefix {

                                                leaf prefix {
                                                    type types-sros:ip-prefix;
                                                    description "IP prefix to match against the IP address";
                                                }

                                            }
                                            case prefix-list {

                                                leaf prefix-list {
                                                    type types-sros:named-item;
                                                    description "IP prefix list to match to the IP address";
                                                }

                                            }
                                        }
                                    } // container dst-ip

                                    container dst-port {
                                        description "Enter the dst-port context";

                                        leaf operator {
                                            type types-dms:match-operator;
                                            description "Match condition for the port";
                                        }

                                        choice value {
                                            case port-number {

                                                leaf port-number {
                                                    type types-sros:tcp-udp-port;
                                                    description "TCP or UDP port number";
                                                }

                                            }
                                            case port-range {

                                                leaf range-start {
                                                    type int32 {
                                                        range "0..65534";
                                                    }
                                                    description "Lower bound of the port range";
                                                }

                                                leaf range-end {
                                                    type int32 {
                                                        range "1..65535";
                                                    }
                                                    description "Upper bound of the port range";
                                                }

                                            }
                                            case port-list {

                                                leaf port-list {
                                                    type types-sros:named-item;
                                                    description "Port list to match against the port";
                                                }

                                            }
                                        }
                                    } // container dst-port

                                    container ip-protocol {
                                        description "Enter the ip-protocol context";

                                        leaf operator {
                                            type types-dms:match-operator;
                                            description "Match condition for the IP protocol";
                                        }

                                        leaf value {
                                            type types-sros:match-ip-protocol;
                                            description "IP protocol to match to the protocol used by traffic";
                                        }

                                    } // container ip-protocol

                                    container src-ip {
                                        description "Enter the src-ip context";

                                        leaf operator {
                                            type types-dms:match-operator;
                                            description "Match condition for the source IP address";
                                        }

                                        choice value {
                                            case prefix {

                                                leaf prefix {
                                                    type types-sros:ip-prefix;
                                                    description "IP prefix to match against the source IP address";
                                                }

                                            }
                                            case prefix-list {

                                                leaf prefix-list {
                                                    type types-sros:named-item;
                                                    description "IP prefix list to match against the source IP address";
                                                }

                                            }
                                            case genome-list {

                                                leaf genome-list {
                                                    type types-dms:genome-list;
                                                    description "Genome list to match against the source IP address";
                                                }

                                            }
                                            case genome-list-set {

                                                leaf genome-list-set {
                                                    type types-sros:named-item;
                                                    description "Genome-list set to match against the source IP address";
                                                }

                                            }
                                        }
                                    } // container src-ip

                                    container src-port {
                                        description "Enter the src-port context";

                                        leaf operator {
                                            type types-dms:match-operator;
                                            description "Match condition for the port";
                                        }

                                        choice value {
                                            case port-number {

                                                leaf port-number {
                                                    type types-sros:tcp-udp-port;
                                                    description "TCP or UDP port number";
                                                }

                                            }
                                            case port-range {

                                                leaf range-start {
                                                    type int32 {
                                                        range "0..65534";
                                                    }
                                                    description "Lower bound of the port range";
                                                }

                                                leaf range-end {
                                                    type int32 {
                                                        range "1..65535";
                                                    }
                                                    description "Upper bound of the port range";
                                                }

                                            }
                                            case port-list {

                                                leaf port-list {
                                                    type types-sros:named-item;
                                                    description "Port list to match against the port";
                                                }

                                            }
                                        }
                                    } // container src-port

                                } // container match

                            } // list entry


                        } // container mitigation-rules

                        container pre-filter {
                            description "Enter the pre-filter context";

                            list genome-list {
                                key "id";
                                description "Enter the genome-list list instance";

                                leaf id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-dms:genome-list;
                                    }
                                    description "Genome list ID";
                                }

                                leaf action {
                                    type types-dms:pre-filter-action;
                                    description "Action to take on traffic matching Genome list source";
                                }

                                leaf monitor {
                                    type boolean;
                                    description "Use monitor mode to track genome-list packet actions";
                                }

                            } // list genome-list

                        } // container pre-filter

                    } // list protected-object

                } // container defender-mitigation-system


                list esa {
                    key "esa-id";
                    description "Enter the esa list instance";

                    leaf esa-id {
                        type union {
                            type string {
                                length "1..64";
                                pattern "<.*>" {
                                    error-message "Config Groups Regex Pattern";
                                }
                            }
                            type types-esa:esa-id;
                        }
                        description "ESA ID";
                    }

                    leaf admin-state {
                        type types-sros:admin-state;
                        description "Administrative state of the ESA";
                    }

                    leaf description {
                        type types-sros:description;
                        description "Text description";
                    }

                    list host-port {
                        key "host-port";
                        description "Enter the host-port list instance";

                        leaf host-port {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:port;
                            }
                            description "Ethernet port associated with the ESA";
                        }

                        container crc-monitor {
                            description "Enter the crc-monitor context";

                            leaf window-size {
                                type uint32 {
                                    range "10..60";
                                }
                                units "seconds";
                                description "Window size of the monitor";
                            }

                            container signal-degrade {
                                description "Enter the signal-degrade context";

                                leaf threshold {
                                    type uint32 {
                                        range "1..9";
                                    }
                                    description "SD threshold";
                                }

                                leaf multiplier {
                                    type uint32;
                                    description "SD multiplier";
                                }

                            } // container signal-degrade

                            container signal-failure {
                                description "Enter the signal-failure context";

                                leaf threshold {
                                    type uint32 {
                                        range "1..9";
                                    }
                                    description "SF threshold";
                                }

                                leaf multiplier {
                                    type uint32;
                                    description "SF multiplier";
                                }

                            } // container signal-failure

                        } // container crc-monitor

                    } // list host-port

                    list vm {
                        key "vm-id";
                        description "Enter the vm list instance";

                        leaf vm-id {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-esa:vm-id;
                            }
                            description "VM ID";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the ESA-VM instance";
                        }

                        leaf description {
                            type types-sros:description;
                            description "Text description";
                        }

                        leaf host-port {
                            type types-sros:port;
                            sros-ext:immutable;
                            description "Ethernet port associated with the ESA-VM instance";
                        }

                        leaf vm-type {
                            type enumeration {
                                enum aa                             { value 1; }
                                enum bb                             { value 2; }
                                enum tunnel                         { value 3; }
                                enum video                          { value 4; }
                                enum dms                            { value 5; }
                            }
                            sros-ext:immutable;
                            description "ESA-VM type";
                        }

                        leaf cores {
                            type uint32 {
                                range "0..128";
                            }
                            description "Number of CPU physical cores allocated to the ESA-VM";
                        }

                        leaf memory {
                            type uint32 {
                                range "0..256";
                            }
                            units "gigabytes";
                            description "Amount of memory allocated to the ESA-VM";
                        }

                    } // list vm

                } // list esa

                container eth-cfm {
                    presence "Enable the eth-cfm context";
                    description "Enable the eth-cfm context";

                    container default-domain {
                        presence "Enable the default-domain context";
                        description "Enable the default-domain context";

                        list bridge-identifier {
                            key "bridge-name vlan";
                            description "Enter the bridge-identifier list instance";

                            leaf bridge-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-services:service-name;
                                }
                                description "Bridge name in the default domain table";
                            }

                            leaf vlan {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-eth-cfm:vlan-id-or-none;
                                }
                                description "VLAN ID for the default domain";
                            }

                            leaf id-permission {
                                type enumeration {
                                    enum none                           { value 1; }
                                    enum chassis                        { value 2; }
                                    enum defer                          { value 5; }
                                }
                                description "Strategy for the inclusion of Sender ID TLV information";
                            }

                            leaf mip-ltr-priority {
                                type union {
                                    type types-eth-cfm:frame-priority;
                                    type enumeration {
                                        enum defer                          { value -1; }
                                    }
                                }
                                description "Priority of the Linktrace Response";
                            }

                            container mhf-creation {
                                description "Enter the mhf-creation context";

                                leaf mhf-type {
                                    type types-eth-cfm:mhf-creation-type;
                                    description "MIP creation mode";
                                }

                                leaf level {
                                    type types-eth-cfm:mhf-creation-level-type;
                                    description "Requested level of the MIP";
                                }

                            } // container mhf-creation

                        } // list bridge-identifier

                    } // container default-domain

                    list domain {
                        key "md-admin-name";
                        description "Enter the domain list instance";

                        leaf md-admin-name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-eth-cfm:admin-name;
                            }
                            description "Maintenance Domain (MD) name";
                        }

                        leaf level {
                            type types-eth-cfm:mp-level;
                            sros-ext:immutable;
                            description "Maintenance Domain Level (MD Level)";
                        }

                        leaf md-index {
                            type uint32 {
                                range "1..max";
                            }
                            sros-ext:immutable;
                            description "The index of the Maintenance Domain (MD)";
                        }

                        choice md-name {
                            case dns {

                                leaf dns {
                                    type string {
                                        length "1..43";
                                    }
                                    sros-ext:immutable;
                                    description "Domain name like text string derived from a DNS name";
                                }

                            }
                            case mac {

                                leaf mac {
                                    type string {
                                        length "13..23";
                                        pattern "[0-9a-fA-F]{1,2}(:[0-9a-fA-F]{1,2}){5}-[0-9]{1,5}";
                                    }
                                    sros-ext:immutable;
                                    description "Maintenance domain MAC name";
                                }

                            }
                            case name {

                                leaf name {
                                    type string {
                                        length "1..43";
                                    }
                                    sros-ext:immutable;
                                    description "Maintenance Domain name";
                                }

                            }
                            case format {

                                leaf format {
                                    type enumeration {
                                        enum none                           { value 0; }
                                    }
                                    sros-ext:immutable;
                                    description "Maintenance domain name format type";
                                }

                            }
                        }
                        list association {
                            key "ma-admin-name";
                            description "Enter the association list instance";

                            leaf ma-admin-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-eth-cfm:admin-name;
                                }
                                description "Domain association name";
                            }

                            leaf ma-index {
                                type uint32 {
                                    range "1..max";
                                }
                                sros-ext:immutable;
                                description "Maintenance Association (MA) table index";
                            }

                            leaf ccm-interval {
                                type types-eth-cfm:ccm-interval-type;
                                description "CCM transmission interval for all MEPs in association";
                            }

                            leaf auto-mep-discovery {
                                type boolean;
                                description "Allow remote MEP automatic discovery";
                            }

                            leaf facility-id-permission {
                                type types-eth-cfm:facility-id-permission-type;
                                description "Sender ID TLV information for facility base MEPs";
                            }

                            choice ma-name {
                                description
                                    "The Maintenance Domain Association name

                                     It is the part of the Maintenance Association Identifier
                                     which is unique within the Maintenance Domain Name and is
                                     appended to the Maintenance Domain Name to form the
                                     Maintenance Association Identifier (MAID).";
                                case icc-based {

                                    leaf icc-based {
                                        type string {
                                            length "8..13";
                                        }
                                        sros-ext:immutable;
                                        description "Maintenance Association name in ICC-based format";
                                    }

                                }
                                case integer {

                                    leaf integer {
                                        type uint32 {
                                            range "0..65535";
                                        }
                                        sros-ext:immutable;
                                        description "Maintenance Association name in integer format";
                                    }

                                }
                                case string {

                                    leaf string {
                                        type string {
                                            length "1..45";
                                        }
                                        sros-ext:immutable;
                                        description "Maintenance Association name in raw ASCII string format";
                                    }

                                }
                                case vid {

                                    leaf vid {
                                        type uint32 {
                                            range "0..4094";
                                        }
                                        sros-ext:immutable;
                                        description "Primary VLAN ID for the Maintenance Association name";
                                    }

                                }
                                case vpn-id {

                                    leaf vpn-id {
                                        type string {
                                            length "0..15";
                                            pattern "[0-9A-F]{6}(:[0-9A-F]{8})";
                                        }
                                        sros-ext:immutable;
                                        description "VPN ID for the Maintenance Association name";
                                    }

                                }
                            }
                            container ccm-hold-time {
                                description "Enter the ccm-hold-time context";

                                leaf down {
                                    type uint32 {
                                        range "1..1000";
                                    }
                                    units "centiseconds";
                                    description "Additional time before a MEP declares a fault, in CCM timeout conditions";
                                }

                            } // container ccm-hold-time

                            list bridge-identifier {
                                key "bridge-name";
                                description "Enter the bridge-identifier list instance";

                                leaf bridge-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-services:service-name;
                                    }
                                    description "Bridge name that links to the service";
                                }

                                leaf vlan {
                                    type int32 {
                                        range "1..4094";
                                    }
                                    description "VLAN ID for the default domain index";
                                }

                                leaf mhf-creation {
                                    type types-eth-cfm:tmnx-mhf-creation-type;
                                    description "MIP method of creation";
                                }

                                leaf id-permission {
                                    type types-eth-cfm:facility-id-permission-type;
                                    description "Strategy for the inclusion of Sender ID TLV information";
                                }

                                leaf mip-ltr-priority {
                                    type types-eth-cfm:frame-priority;
                                    description "Priority of the Linktrace Response Message (ETH-LTR) from a MIP";
                                }

                            } // list bridge-identifier

                            list remote-mep {
                                key "mep-id";
                                description "Enter the remote-mep list instance";

                                leaf mep-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-eth-cfm:mep-id-type;
                                    }
                                    description "Remote MEP ID";
                                }

                                leaf remote-mac {
                                    type types-sros:mac-unicast-address-no-zero;
                                    description "Remote MAC Address for transmitting CFM packets to remote MEPs";
                                }

                            } // list remote-mep

                        } // list association

                    } // list domain

                } // container eth-cfm

                list eth-ring {
                    key "ring-index";
                    description "Enter the eth-ring list instance";

                    leaf ring-index {
                        type union {
                            type string {
                                length "1..64";
                                pattern "<.*>" {
                                    error-message "Config Groups Regex Pattern";
                                }
                            }
                            type uint32 {
                                range "1..128";
                            }
                        }
                        description "Ring ID";
                    }

                    leaf admin-state {
                        type types-sros:admin-state;
                        description "Administrative state of the Ethernet ring";
                    }

                    leaf description {
                        type types-sros:description-or-empty;
                        description "Text description";
                    }

                    leaf compatible-version {
                        type uint32 {
                            range "1..2";
                        }
                        description "Compatibility version for the Ethernet ring";
                    }

                    leaf guard-time {
                        type uint32 {
                            range "1..20";
                        }
                        units "deciseconds";
                        description "Ethernet ring guard time";
                    }

                    leaf node-id {
                        type yang:mac-address;
                        description "MAC address of the RPL link";
                    }

                    leaf raps-dst-mac-lsb {
                        type enumeration {
                            enum default {
                                value 1;
                                description "Message destination MAC LSB equals 0x01";
                            }
                            enum ring-id {
                                value 2;
                                description "Message destination MAC LSB equals ring ID";
                            }
                        }
                        description "Value used in the R-APS destination MAC last octet";
                    }

                    leaf revert-time {
                        type uint32 {
                            range "0|60..720";
                        }
                        units "seconds";
                        description "Revert time for the Ethernet ring";
                    }

                    leaf rpl-node {
                        type enumeration {
                            enum owner                          { value 1; }
                            enum neighbor                       { value 2; }
                        }
                        description "Ring Protection Link (RPL) type for the Ethernet ring";
                    }

                    container ccm-hold-time {
                        description "Enter the ccm-hold-time context";

                        leaf down {
                            type uint32 {
                                range "1..5000";
                            }
                            units "centiseconds";
                            description "Hold timer for down event dampening";
                        }

                        leaf up {
                            type uint32 {
                                range "0..5000";
                            }
                            units "deciseconds";
                            description "Hold timer for recovery reporting";
                        }

                    } // container ccm-hold-time

                    container sub-ring {
                        description "Enter the sub-ring context";

                        leaf type {
                            type enumeration {
                                enum virtual-link                   { value 1; }
                                enum non-virtual-link               { value 2; }
                            }
                            description "Sub-ring type";
                        }

                        container interconnect {
                            description "Enter the interconnect context";

                            leaf propagate-topology-change {
                                type boolean;
                                description "Propagate topology changes";
                            }

                            choice interconnect-choice {
                                case vpls {

                                    leaf vpls {
                                        type empty;
                                        description "Connect sub-ring to VPLS ID that contains sub-ring SAP";
                                    }

                                }
                                case ring {

                                    leaf ring-id {
                                        type uint32 {
                                            range "1..128";
                                        }
                                        description "Ring instance of the connection ring for the sub-ring";
                                    }

                                }
                            }
                        } // container interconnect

                    } // container sub-ring

                    list path {
                        key "path-index";
                        description "Enter the path list instance";

                        leaf path-index {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type string {
                                    length "1";
                                    pattern "[a|b]" {
                                        error-message "only characters a and b are allowed";
                                    }
                                }
                            }
                            description "Path ID";
                        }

                        leaf port-and-raps-tag {
                            type types-sros:port-and-encap;
                            sros-ext:immutable;
                            description "Port ID and Ring APS tag ID";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the Ethernet ring path";
                        }

                        leaf description {
                            type types-sros:description-or-empty;
                            description "Text description";
                        }

                        leaf rpl-end {
                            type boolean;
                            description "Enable path as a Ring Protection Link (RPL) end";
                        }

                        container eth-cfm {
                            description "Enter the eth-cfm context";

                            list mep {
                                key "md-admin-name ma-admin-name mep-id";
                                description "Enter the mep list instance";

                                leaf md-admin-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-eth-cfm:admin-name;
                                    }
                                    description "Maintenance Domain (MD) name";
                                }

                                leaf ma-admin-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-eth-cfm:admin-name;
                                    }
                                    description "Maintenance Association (MA) name";
                                }

                                leaf mep-id {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-eth-cfm:mep-id-type;
                                    }
                                    description "Maintenance Endpoint (MEP) ID";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the MEP";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                                leaf mac-address {
                                    type types-sros:mac-unicast-address-no-zero;
                                    description "MAC address of the MEP";
                                }

                                leaf install-mep {
                                    type boolean;
                                    description "Install MEP in the forwarding plane";
                                }

                                leaf low-priority-defect {
                                    type types-eth-cfm:lowest-alarm-priority;
                                    description "Lowest priority defect allowed to generate fault alarm";
                                }

                                leaf ccm {
                                    type boolean;
                                    description "Generate CCM messages";
                                }

                                leaf ccm-ltm-priority {
                                    type types-eth-cfm:frame-priority;
                                    description "Priority of CCM and LTM messages transmitted by the MEP";
                                }

                                leaf ccm-padding-size {
                                    type uint32 {
                                        range "3..1500";
                                    }
                                    description "Number of octets of padding to insert in CCM packets";
                                }

                                leaf one-way-delay-threshold {
                                    type uint32 {
                                        range "0..600";
                                    }
                                    units "seconds";
                                    description "Threshold time limit for the one-way delay test";
                                }

                                leaf control-mep {
                                    type boolean;
                                    description "Enable Ethernet ring control on the MEP";
                                }

                                container alarm-notification {
                                    description "Enter the alarm-notification context";

                                    leaf fng-alarm-time {
                                        type int32 {
                                            range "250|500|1000";
                                        }
                                        units "centiseconds";
                                        description "Time that must expire before an FNG alarm is raised";
                                    }

                                    leaf fng-reset-time {
                                        type int32 {
                                            range "250|500|1000";
                                        }
                                        units "centiseconds";
                                        description "Time that must expire before an FNG alarm is reset";
                                    }

                                } // container alarm-notification

                                container eth-test {
                                    presence "Enable the eth-test context";
                                    description "Enable the eth-test context";

                                    leaf bit-error-threshold {
                                        type uint32 {
                                            range "0..11840";
                                        }
                                        units "bit errors";
                                        description "Lowest priority defect allowed to generate fault alarm";
                                    }

                                    container test-pattern {
                                        description "Enter the test-pattern context";

                                        leaf pattern {
                                            type enumeration {
                                                enum all-zeros                      { value 0; }
                                                enum all-ones                       { value 1; }
                                            }
                                            description "Test pattern for Ethernet Test frames";
                                        }

                                        leaf crc-tlv {
                                            type boolean;
                                            description "Generate a CRC checksum";
                                        }

                                    } // container test-pattern

                                } // container eth-test

                                container grace {
                                    description "Enter the grace context";

                                    container eth-ed {
                                        description "Enter the eth-ed context";

                                        leaf max-rx-defect-window {
                                            type uint32 {
                                                range "1..86400";
                                            }
                                            units "seconds";
                                            description "Maximum received ETH-ED expected defect window duration";
                                        }

                                        leaf priority {
                                            type int32 {
                                                range "0..7";
                                            }
                                            description "Transmission priority for ETH-ED PDUs";
                                        }

                                        leaf rx-eth-ed {
                                            type boolean;
                                            description "Receive and process ETH-ED ITU-T Y.1731 PDUs on the MEP";
                                        }

                                        leaf tx-eth-ed {
                                            type boolean;
                                            description "Transmit ETH-ED PDUs from the MEP";
                                        }

                                    } // container eth-ed

                                    container eth-vsm-grace {
                                        description "Enter the eth-vsm-grace context";

                                        leaf rx-eth-vsm-grace {
                                            type boolean;
                                            description "Receive and process Nokia ETH-CFM Grace PDU on the MEP";
                                        }

                                        leaf tx-eth-vsm-grace {
                                            type boolean;
                                            description "Transmit ETH-ED PDUs from the MEP";
                                        }

                                    } // container eth-vsm-grace

                                } // container grace

                            } // list mep

                        } // container eth-cfm

                    } // list path

                } // list eth-ring


                container filter {
                    presence "Enable the filter context";
                    description "Enable the filter context";

                    list redirect-policy {
                        key "redirect-policy-name";
                        description "Enter the redirect-policy list instance";

                        leaf redirect-policy-name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "Redirect policy name";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the redirect policy";
                        }

                        leaf description {
                            type types-sros:description;
                            description "Text description";
                        }

                        leaf router-instance {
                            type types-services:service-name;
                            description "Routing context to use for route lookup";
                        }

                        leaf sticky-dest {
                            type types-filter:filter-sticky-dest;
                            units "seconds";
                            description "Time required by system before applying the current best destination as active destination";
                        }

                        leaf notify-dest-change {
                            type boolean;
                            description "Send notifications when the active destination changes";
                        }

                        list destination {
                            key "destination-address";
                            description "Enter the destination list instance";

                            leaf destination-address {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:ip-unicast-address;
                                }
                                description "IP address and type of destination";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the destination";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf priority {
                                type uint32 {
                                    range "1..255";
                                }
                                description "Priority for this destination";
                            }

                            container ping-test {
                                presence "Enable the ping-test context";
                                description "Enable the ping-test context";

                                leaf source-address {
                                    type types-sros:ip-address;
                                    description "Source address to use in the IP packet of the ping test";
                                }

                                leaf interval {
                                    type uint32 {
                                        range "1..60";
                                    }
                                    units "seconds";
                                    description "Time between consecutive requests which are sent to the far end host";
                                }

                                leaf timeout {
                                    type uint32 {
                                        range "1..60";
                                    }
                                    units "seconds";
                                    description "Time required to receive a response from the far end host";
                                }

                                leaf drop-count {
                                    type uint32 {
                                        range "1..60";
                                    }
                                    description "Number of consecutive requests that fail before destination is declared unreachable";
                                }

                                leaf hold-down {
                                    type uint32 {
                                        range "0..86400";
                                    }
                                    units "seconds";
                                    description "Time for the system to be held down if this test has marked it unreachable";
                                }

                            } // container ping-test

                            container unicast-rt-test {
                                presence "Enable the unicast-rt-test context";
                                description "Enable the unicast-rt-test context";

                            } // container unicast-rt-test

                        } // list destination

                    } // list redirect-policy

                    list redirect-policy-binding {
                        key "binding-name";
                        description "Enter the redirect-policy-binding list instance";

                        leaf binding-name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "Binding name";
                        }

                        leaf binding-operator {
                            type types-filter:filter-binding-operator;
                            description "Logical operator used to obtain the master test result";
                        }

                        list redirect-policy {
                            key "redirect-policy-name";
                            description "Enter the redirect-policy list instance";

                            leaf redirect-policy-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Redirect policy name";
                            }

                            list destination {
                                key "destination-address";
                                description "Add a list entry for destination";

                                leaf destination-address {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ip-unicast-address;
                                    }
                                    description "IP address of redirect policy destination to binding";
                                }

                            } // list destination

                        } // list redirect-policy

                    } // list redirect-policy-binding

                    list log {
                        key "log-id";
                        description "Enter the log list instance";

                        leaf log-id {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-filter:filter-log-id;
                            }
                            description "Filter log identifier";
                        }

                        leaf description {
                            type types-sros:description-or-empty;
                            description "Text description";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of filter logging";
                        }

                        container destination {
                            description "Enter the destination context";

                            choice destination {
                                case memory {

                                    container memory {
                                        description "Enter the memory context";

                                        leaf max-entries {
                                            type uint32 {
                                                range "1..50000";
                                            }
                                            description "Maximum number of memory entries that the log can store";
                                        }

                                        leaf stop-on-full {
                                            type boolean;
                                            description "Stop logging when maximum number of memory entries is reached or wrap-around is used";
                                        }

                                    } // container memory

                                }
                                case syslog {

                                    container syslog {
                                        description "Enter the syslog context";

                                        leaf syslog-id {
                                            status obsolete;
                                            type types-log:log-syslog-name;
                                            description "ID of the Syslog server definition for filter logs";
                                        }

                                        leaf name {
                                            type types-log:log-syslog-name;
                                            description "Syslog server definition ID";
                                        }

                                        container summary {
                                            description "Enter the summary context";

                                            leaf admin-state {
                                                type types-sros:admin-state;
                                                description "Administrative state of filter log summarization";
                                            }

                                            leaf summary-crit {
                                                type types-filter:filter-log-summary-criterion;
                                                description "Summary for filter log entries";
                                            }

                                        } // container summary

                                    } // container syslog

                                }
                            }
                        } // container destination

                    } // list log

                    container match-list {
                        presence "Enable the match-list context";
                        description "Enable the match-list context";

                        list protocol-list {
                            key "protocol-list-name";
                            description "Enter the protocol-list list instance";

                            leaf protocol-list-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
