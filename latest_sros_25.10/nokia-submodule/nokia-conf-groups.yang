                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Name of the packet length list";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            list packet-length {
                                key "value";
                                description "Add a list entry for packet-length";

                                leaf value {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type int32 {
                                            range "0..65535";
                                        }
                                    }
                                    description "Packet length";
                                }

                            } // list packet-length

                            list range {
                                key "start end";
                                description "Add a list entry for range";

                                leaf start {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
