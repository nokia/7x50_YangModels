                                    }

                                    leaf interval {
                                        type uint32 {
                                            range "1..255";
                                        }
                                        units "seconds";
                                        description "Interval between ICMP pings to target CPE IP address";
                                    }

                                    leaf log {
                                        type boolean;
                                        description "Log CPE connectivity checks transitions";
                                    }

                                    leaf padding-size {
                                        type uint32 {
                                            range "0..16384";
                                        }
                                        units "bytes";
                                        description "Padding size for CPE connectivity checks";
                                    }

                                } // list cpe-check

                            } // list next-hop

                        } // list route

                    } // container static-routes

                    container twamp-light {
                        presence "Enable the twamp-light context";
                        description "Enable the twamp-light context";

                        container reflector {
                            presence "Enable the reflector context";
                            description "Enable the reflector context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the TWAMP Light reflector";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf udp-port {
                                type types-sros:tcp-udp-port-non-zero {
                                    range "862|64364..64373";
                                }
                                description "UDP port on which the specified TWAMP-Light reflector listens for TWAMP PDUs";
                            }

                            leaf allow-ipv6-udp-checksum-zero {
                                type boolean;
                                description "Process IPv6 packets with a zero UDP checksum";
                            }

                            leaf type {
                                type enumeration {
                                    enum stamp                          { value 1; }
                                    enum twamp-light                    { value 2; }
                                }
                                description "Processing behavior type for the reflector";
                            }

                            leaf lag-ip-measurement {
                                type boolean;
                                description "Process the TWAMP Light packet micro-session fields";
                            }

                            list prefix {
                                key "ip-prefix";
                                description "Enter the prefix list instance";

                                leaf ip-prefix {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ip-prefix;
                                    }
                                    description "Source prefix for the TWAMP-Light reflector";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                            } // list prefix

                        } // container reflector

                    } // container twamp-light

                    container wpp {
                        presence "Enable the wpp context";
                        description "Enable the wpp context";

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of WPP";
                        }

                        list portal {
                            key "name";
                            description "Enter the portal list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Web portal name";
                            }

                            leaf address {
                                type types-sros:ip-unicast-without-local-address;
                                sros-ext:immutable;
                                description "WPP portal address";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the WPP portal server";
                            }

                            leaf secret {
                                type types-sros:encrypted-leaf {
                                    length "1..115";
                                }
                                description "Message authentication between portal and BRAS by applying the secret used by WPPv2";
                            }

                            leaf version {
                                type uint32 {
                                    range "1|2";
                                }
                                description "Protocol version to be expected by the WPP portal";
                            }

                            leaf retry-interval {
                                type uint32 {
                                    range "10..2000";
                                }
                                units "milliseconds";
                                description "Time between two consecutive retransmissions";
                            }

                            leaf ntf-logout-retry-count {
                                type uint32 {
                                    range "0..5";
                                }
                                description "Number of retransmissions of an NTF_LOGOUT message";
                            }

                            leaf ack-auth-retry-count {
                                type uint32 {
                                    range "0..5";
                                }
                                description "Number of retransmissions of an ACK_OUT message";
                            }

                            leaf port-format {
                                type enumeration {
                                    enum standard                       { value 1; }
                                    enum vendor-specific                { value 2; }
                                }
                                description "Format of the port in the ACK_INO message";
                            }

                        } // list portal

                    } // container wpp

                } // list router

