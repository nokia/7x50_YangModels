                                    description "Enter the kex list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..255";
                                            }
                                        }
                                        description "SSHv2 KEX algorithm index";
                                    }

                                    leaf name {
                                        type enumeration {
                                            enum diffie-hellman-group1-sha1     { value 1; }
                                            enum diffie-hellman-group14-sha1    { value 2; }
                                            enum diffie-hellman-group-exchange-sha1 { value 3; }
                                            enum diffie-hellman-group14-sha256  { value 4; }
                                            enum diffie-hellman-group16-sha512  { value 5; }
                                            enum ecdh-sha2-nistp256             { value 6; }
                                            enum ecdh-sha2-nistp384             { value 7; }
                                            enum ecdh-sha2-nistp521             { value 8; }
                                        }
                                        description "KEX algorithm for computing a shared secret key";
                                    }

                                } // list kex

                            } // container client-kex-list-v2

                            container server-host-key-list-v2 {
                                description "Enter the server-host-key-list-v2 context";

                                list host-key {
                                    key "index";
                                    description "Enter the host-key list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..255";
                                            }
                                        }
                                        description "SSHv2 host key algorithm index";
                                    }

                                    leaf name {
                                        type enumeration {
                                            enum ssh-rsa                        { value 2; }
                                            enum rsa-sha2-256                   { value 3; }
                                            enum rsa-sha2-512                   { value 4; }
                                            enum ecdsa-sha2-nistp256            { value 5; }
                                            enum ecdsa-sha2-nistp384            { value 6; }
                                            enum ecdsa-sha2-nistp521            { value 7; }
                                            enum ssh-ed25519                    { value 8; }
                                            enum ssh-dss                        { status obsolete; }
                                        }
                                        description "Host key algorithm for computing a signature";
                                    }

                                } // list host-key

                            } // container server-host-key-list-v2

                            container client-host-key-list-v2 {
                                description "Enter the client-host-key-list-v2 context";

                                list host-key {
                                    key "index";
                                    description "Enter the host-key list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..255";
                                            }
                                        }
                                        description "SSHv2 host key algorithm index";
                                    }

                                    leaf name {
                                        type enumeration {
                                            enum ssh-rsa                        { value 2; }
                                            enum rsa-sha2-256                   { value 3; }
                                            enum rsa-sha2-512                   { value 4; }
                                            enum ecdsa-sha2-nistp256            { value 5; }
                                            enum ecdsa-sha2-nistp384            { value 6; }
                                            enum ecdsa-sha2-nistp521            { value 7; }
                                            enum ssh-ed25519                    { value 8; }
                                            enum ssh-dss                        { status obsolete; }
                                        }
                                        description "Host key algorithm for computing a signature";
                                    }

                                } // list host-key

                            } // container client-host-key-list-v2

                            container authentication-method {
                                description "Enter the authentication-method context";

                                container client {
                                    description "Enter the client context";

                                    leaf public-key-only {
                                        type boolean;
                                        description "Accept only public-key authentication for SSH session";
                                    }

                                } // container client

                                container server {
                                    description "Enter the server context";

                                    leaf public-key-only {
                                        type boolean;
                                        description "Accept only public-key authentication for SSH session";
                                    }

                                } // container server

                            } // container authentication-method

                        } // container ssh

                        container tls {
                            presence "Enable the tls context";
                            description "Enable the tls context";

                            list cert-profile {
                                key "cert-profile-name";
                                description "Enter the cert-profile list instance";

                                leaf cert-profile-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "TLS certificate profile name";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the certificate profile";
                                }

                                list entry {
                                    key "entry-id";
                                    description "Enter the entry list instance";

                                    leaf entry-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type int32 {
                                                range "1..8";
                                            }
                                        }
                                        description "Certificate profile ID";
                                    }

                                    leaf certificate-file {
                                        type types-sros:string-not-all-spaces {
                                            length "1..95";
                                            pattern "[^:\\\\/]+";
                                        }
                                        description "Certificate file name";
                                    }

                                    leaf key-file {
                                        type types-sros:string-not-all-spaces {
                                            length "1..95";
                                            pattern "[^:\\\\/]+";
                                        }
                                        description "Key file name";
                                    }

                                    container send-chain {
                                        description "Enter the send-chain context";

                                        list ca-profile {
                                            key "ca-profile-name";
                                            description "Add a list entry for ca-profile";

                                            leaf ca-profile-name {
                                                type union {
                                                    type string {
                                                        length "1..64";
                                                        pattern "<.*>" {
                                                            error-message "Config Groups Regex Pattern";
                                                        }
                                                    }
                                                    type types-sros:named-item;
                                                }
                                                description "CA profile name";
                                            }

                                        } // list ca-profile

                                    } // container send-chain

                                } // list entry

                            } // list cert-profile

                            list client-cipher-list {
                                key "client-cipher-list-name";
                                description "Enter the client-cipher-list list instance";

                                leaf client-cipher-list-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
