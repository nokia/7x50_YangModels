                        } // container bgp-evpn

                        container bgp-ipvpn {
                            description "Enter the bgp-ipvpn context";

                            container mpls {
                                description "Enter the mpls context";

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of BGP-IPVPN MPLS";
                                }

