                                    }

                                    leaf neighbor {
                                        type types-sros:regular-expression-not-all-spaces;
                                        sros-ext:immutable;
                                        description "Regular expression to match against the base router BGP instance neighbor configuration";
                                    }

                                    leaf router-instance {
                                        type types-services:service-name;
                                        sros-ext:immutable;
                                        description "Target routing instance";
                                    }

                                } // list bgp-peers

                                list interfaces {
                                    key "criterion-index";
                                    description "Enter the interfaces list instance";

                                    leaf criterion-index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..255";
                                            }
                                        }
                                        description "Index defining interfaces for prefix autogeneration";
                                    }

                                    leaf interface {
                                        type types-sros:regular-expression-not-all-spaces;
                                        sros-ext:immutable;
                                        description "Regular expression defining a match string";
                                    }

                                    leaf router-instance {
                                        type types-services:service-name;
                                        sros-ext:immutable;
                                        description "Routing instance as part of apply-path interfaces";
                                    }

                                } // list interfaces


                            } // container apply-path

                            list prefix {
                                key "ipv6-prefix";
                                description "Add a list entry for prefix";

                                leaf ipv6-prefix {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ipv6-prefix;
                                    }
                                    description "IPv6 prefix to be added to the prefix list";
                                }

                            } // list prefix

                            list prefix-exclude {
                                key "ipv6-prefix";
                                description "Add a list entry for prefix-exclude";

                                leaf ipv6-prefix {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ipv6-prefix;
                                    }
                                    description "IPv6 prefix to be added to the prefix list";
                                }

                            } // list prefix-exclude

                        } // list ipv6-prefix-list

                        list port-list {
                            key "port-list-name";
                            description "Enter the port-list list instance";

                            leaf port-list-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Port list name";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            list port {
                                key "value";
                                description "Add a list entry for port";

                                leaf value {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type int32 {
                                            range "0..65535";
                                        }
                                    }
                                    description "Port value";
                                }

                            } // list port

                            list range {
                                key "start end";
                                description "Add a list entry for range";

                                leaf start {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type int32 {
                                            range "0..65534";
                                        }
                                    }
                                    description "Lower bound of the port list range";
                                }

                                leaf end {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type int32 {
                                            range "1..65535";
                                        }
                                    }
                                    description "Upper bound of the port list range";
                                }

                            } // list range

                        } // list port-list

                        list ip-packet-length-list {
                            key "packet-length-list-name";
                            description "Enter the ip-packet-length-list list instance";

                            leaf packet-length-list-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
