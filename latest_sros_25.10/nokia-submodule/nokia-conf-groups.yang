                                    }

                                    leaf format-32bit {
                                        type boolean;
                                        description "Use IPv4 address of local LSR-ID interface as LSR-ID of the LDP LSR";
                                    }

                                } // container local-lsr-id

                                container hello {
                                    presence "Enable the hello context";
                                    description "Enable the hello context";

