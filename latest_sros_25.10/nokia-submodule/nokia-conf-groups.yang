                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "IP prefix list name";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            container apply-path {
                                description "Enter the apply-path context";

                                list bgp-peers {
                                    key "criterion-index";
                                    description "Enter the bgp-peers list instance";

                                    leaf criterion-index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..255";
                                            }
                                        }
                                        description "Index defining BGP peers for prefix autogeneration";
                                    }

                                    leaf group {
                                        type types-sros:regular-expression-not-all-spaces;
                                        sros-ext:immutable;
                                        description "Regular expression to match against the base router BGP instance group configuration";
                                    }

                                    leaf neighbor {
                                        type types-sros:regular-expression-not-all-spaces;
                                        sros-ext:immutable;
                                        description "Regular expression to match against the base router BGP instance neighbor configuration";
                                    }

                                    leaf router-instance {
                                        type types-services:service-name;
                                        sros-ext:immutable;
                                        description "Target routing instance";
                                    }

                                } // list bgp-peers

                                list interfaces {
                                    key "criterion-index";
                                    description "Enter the interfaces list instance";

                                    leaf criterion-index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..255";
                                            }
                                        }
                                        description "Index defining interfaces for prefix autogeneration";
                                    }

                                    leaf interface {
                                        type types-sros:regular-expression-not-all-spaces;
                                        sros-ext:immutable;
                                        description "Regular expression defining a match string";
                                    }

                                    leaf router-instance {
                                        type types-services:service-name;
                                        sros-ext:immutable;
                                        description "Routing instance as part of apply-path interfaces";
                                    }

                                } // list interfaces



                            } // container apply-path

                            list prefix {
                                key "ip-prefix";
                                description "Add a list entry for prefix";

                                leaf ip-prefix {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ipv4-prefix;
                                    }
                                    description "IPv4 prefix to be added to the prefix list";
                                }

                            } // list prefix

                            list prefix-exclude {
                                key "ip-prefix";
                                description "Add a list entry for prefix-exclude";

                                leaf ip-prefix {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ipv4-prefix;
                                    }
                                    description "IPv4 prefix to be added to the prefix list";
                                }

                            } // list prefix-exclude

