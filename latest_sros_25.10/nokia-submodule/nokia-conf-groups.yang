                                container gateway-ip {
                                    description "Enter the gateway-ip context";

                                    leaf advertise {
                                        type boolean;
                                        description "Enable the advertisement of GW-IP in IP prefix routes";
                                    }

                                    leaf resolve {
                                        type boolean;
                                        description "Enable the resolution of GW-IP in IP prefix routes";
                                    }

                                } // container gateway-ip

