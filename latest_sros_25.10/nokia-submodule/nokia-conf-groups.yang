                                            type uint32 {
                                                range "1..32";
                                            }
                                            description "Queue ID";
                                        }

                                    }
                                    case all {

                                        leaf all {
                                            type empty;
                                            description "Apply significant change to counters for all queues";
                                        }

                                    }
                                }
                                container e-counters {
