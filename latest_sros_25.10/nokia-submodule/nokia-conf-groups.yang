                                leaf orr-location {
                                    type uint32 {
                                        range "1..255";
                                    }
                                    description "Optimal route reflection location for the cluster";
                                }

                                leaf allow-local-fallback {
                                    type boolean;
                                    description "Allow fallback to RR topology";
                                }

                            } // container cluster

