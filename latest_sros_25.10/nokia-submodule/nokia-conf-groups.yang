                                            }
                                        }
                                        type int32 {
                                            range "0..65534";
                                        }
                                    }
                                    description "Lower bound of the packet length range";
                                }

                                leaf end {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type int32 {
                                            range "1..65535";
                                        }
                                    }
                                    description "Upper bound of the packet length range";
                                }

                            } // list range

                        } // list ip-packet-length-list

                        list ipv6-packet-length-list {
                            key "packet-length-list-name";
                            description "Enter the ipv6-packet-length-list list instance";

                            leaf packet-length-list-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Name of the packet length list";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            list packet-length {
                                key "value";
                                description "Add a list entry for packet-length";

                                leaf value {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type int32 {
                                            range "40..65575";
                                        }
                                    }
                                    description "Packet length";
                                }

                            } // list packet-length

                            list range {
                                key "start end";
                                description "Add a list entry for range";

                                leaf start {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
