                                } // container hello

                                container keepalive {
                                    description "Enter the keepalive context";

                                    leaf timeout {
                                        type uint32 {
                                            range "3..65535";
                                        }
                                        units "seconds";
                                        description "Timeout value for keepalive";
                                    }

                                    leaf factor {
                                        type uint32 {
                                            range "1..255";
                                        }
                                        description "Value for the keep-alive factor";
                                    }

                                } // container keepalive

                            } // container ipv6

                            list interface {
                                key "ip-int-name";
                                description "Enter the interface list instance";

                                leaf ip-int-name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
