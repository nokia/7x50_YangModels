                            container ingress {
                                description "Enter the ingress context";

                                leaf-list queue {
                                    type int8 {
                                        range "1..32";
                                    }
                                    max-elements 32;
                                    description "Ingress queues used in this category";
                                }

                                leaf-list policer {
                                    type int8 {
                                        range "1..63";
                                    }
                                    max-elements 63;
                                    description "Ingress policers used in this category";
                                }

                            } // container ingress

