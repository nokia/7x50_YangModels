submodule nokia-conf-groups {

    yang-version "1.1";

    belongs-to nokia-conf { prefix "conf"; }

    import ietf-inet-types                { prefix "inet"; }
    import ietf-yang-types                { prefix "yang"; }
    import nokia-sros-yang-extensions     { prefix "sros-ext"; }
    import nokia-types-application-assurance { prefix "types-aa"; }
    import nokia-types-bgp                { prefix "types-bgp"; }
    import nokia-types-card               { prefix "types-card"; }
    import nokia-types-cflowd             { prefix "types-cflowd"; }
    import nokia-types-chassis            { prefix "types-chassis"; }
    import nokia-types-dhcp               { prefix "types-dhcp"; }
    import nokia-types-diameter           { prefix "types-diam"; }
    import nokia-types-dms                { prefix "types-dms"; }
    import nokia-types-esa                { prefix "types-esa"; }
    import nokia-types-eth-cfm            { prefix "types-eth-cfm"; }
    import nokia-types-filter             { prefix "types-filter"; }
    import nokia-types-igmp               { prefix "types-igmp"; }
    import nokia-types-igp                { prefix "types-igp"; }
    import nokia-types-ipsec              { prefix "types-ipsec"; }
    import nokia-types-isa                { prefix "types-isa"; }
    import nokia-types-isis               { prefix "types-isis"; }
    import nokia-types-l2tp               { prefix "types-l2tp"; }
    import nokia-types-ldp                { prefix "types-ldp"; }
    import nokia-types-lldp               { prefix "types-lldp"; }
    import nokia-types-log                { prefix "types-log"; }
    import nokia-types-mcast-cac          { prefix "types-mcast-cac"; }
    import nokia-types-mcast-mgmt         { prefix "types-mcast-mgmt"; }
    import nokia-types-mcr                { prefix "types-mcr"; }
    import nokia-types-mpls               { prefix "types-mpls"; }
    import nokia-types-nat                { prefix "types-nat"; }
    import nokia-types-oam                { prefix "types-oam"; }
    import nokia-types-operation          { prefix "types-operation"; }
    import nokia-types-ospf               { prefix "types-ospf"; }
    import nokia-types-policy             { prefix "types-policy"; }
    import nokia-types-port               { prefix "types-port"; }
    import nokia-types-ppp                { prefix "types-ppp"; }
    import nokia-types-ptp                { prefix "types-ptp"; }
    import nokia-types-qos                { prefix "types-qos"; }
    import nokia-types-radius             { prefix "types-radius"; }
    import nokia-types-redundancy         { prefix "types-redundancy"; }
    import nokia-types-rip                { prefix "types-rip"; }
    import nokia-types-ripng              { prefix "types-ripng"; }
    import nokia-types-router             { prefix "types-router"; }
    import nokia-types-rsvp               { prefix "types-rsvp"; }
    import nokia-types-security           { prefix "types-security"; }
    import nokia-types-services           { prefix "types-services"; }
    import nokia-types-sfm                { prefix "types-sfm"; }
    import nokia-types-sr-mpls            { prefix "types-sr-mpls"; }
    import nokia-types-sros               { prefix "types-sros"; }
    import nokia-types-subscriber-mgmt    { prefix "types-submgt"; }
    import nokia-types-system             { prefix "types-system"; }
    import nokia-types-vrrp               { prefix "types-vrrp"; }
    import nokia-types-wlangw             { prefix "types-wlangw"; }

    sros-ext:sros-major-release "rel25";
    organization "Nokia";
    contact
        "Nokia SR OS Support
         Web: <http://www.nokia.com>";
    description
        "Nokia YANG Data model to configure Configuration groups on SR OS based routers.

         Copyright 2016 Nokia. All rights reserved. Reproduction of this document
         is authorized on the condition that the foregoing copyright notice is included.

         This nokia-conf-groups YANG module embodies Nokia's proprietary
         intellectual property. Nokia retains all title and ownership in the
         specification, including any revisions.

         Nokia grants all interested parties a non-exclusive license to use
         and distribute an unmodified copy of this specification in connection with
         management of Nokia products, and without fee, provided this
         copyright notice and license appear on all copies.

         This specification is supplied `as is', and Nokia makes no warranty,
         either express or implied, as to the use, operation, condition, or performance
         of the specification.";
    revision "2026-08-12";

    grouping conf-groups {
        container groups {
            description "Enter the groups context";

            list group {
                key "name";
                max-elements 64;
                description "Enter the group list instance";

                leaf name {
                    type types-sros:named-item-64;
                    description "The name of this configuration group.";
                }

                container aaa {
                    presence "Enable the aaa context";
                    description "Enable the aaa context";

                    container radius {
                        description "Enter the radius context";

                        leaf coa-port {
                            type inet:port-number {
                                range "1647|1700|1812|3799";
                            }
                            description "RADIUS listening port for CoA and Disconnect messages";
                        }

                        list acct-on-off-group {
                            key "name";
                            description "Enter the acct-on-off-group list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Group name for accounting on/off";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                        } // list acct-on-off-group

                        list server-policy {
                            key "name";
                            description "Enter the server-policy list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "RADIUS server policy name";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf python-policy {
                                type types-sros:named-item;
                                description "Python policy for RADIUS packets to/from RADIUS servers";
                            }

                            container servers {
                                description "Enter the servers context";

                                leaf timeout {
                                    type types-sros:time-duration {
                                        range "1..340";
                                    }
                                    units "seconds";
                                    description "Time until the next retry to the RADIUS server";
                                }

                                leaf retry-count {
                                    type uint32 {
                                        range "1..256";
                                    }
                                    description "Number of retries for contacting the RADIUS server";
                                }

                                leaf hold-down-time {
                                    type types-sros:time-duration {
                                        range "30..86400";
                                    }
                                    units "seconds";
                                    description "Hold time before reusing a RADIUS server that was down";
                                }

                                leaf router-instance {
                                    type types-sros:named-item-64 {
                                        pattern ".{1,32}" {
                                            error-message "vRtrName needs to be extended to 64 to support this name";
                                        }
                                    }
                                    description "RADIUS routing instance";
                                }

                                leaf source-address {
                                    type types-sros:ipv4-address;
                                    description "Source address of RADIUS messages";
                                }

                                leaf ipv6-source-address {
                                    type types-sros:ipv6-address;
                                    description "Source address for IPv6 RADIUS datagrams";
                                }

                                leaf access-algorithm {
                                    type types-radius:server-selection-algo;
                                    description "Algorithm to select a RADIUS server from the pool";
                                }

                                leaf stickiness {
                                    type boolean;
                                    description "Allow stickiness in a multi-server application";
                                }

                                list server {
                                    key "server-index";
                                    description "Enter the server list instance";

                                    leaf server-index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..16";
                                            }
                                        }
                                        description "RADIUS server index";
                                    }

                                    leaf server-name {
                                        type types-sros:named-item;
                                        description "RADIUS server name";
                                    }

                                } // list server

                                container buffering {
                                    description "Enter the buffering context";

                                    container acct-start {
                                        presence "Enable the acct-start context";
                                        description "Enable the acct-start context";

                                        leaf min {
                                            type types-sros:time-duration {
                                                range "1..3600";
                                            }
                                            units "seconds";
                                            description "Minimum time between accounting message resend attempts";
                                        }

                                        leaf max {
                                            type types-sros:time-duration {
                                                range "1..3600";
                                            }
                                            units "seconds";
                                            description "Maximum time between accounting message resend attempts";
                                        }

                                        leaf lifetime {
                                            type types-sros:time-duration {
                                                range "1..25";
                                            }
                                            units "hours";
                                            description "Time accounting message can be in retransmission buffer";
                                        }

                                    } // container acct-start

                                    container acct-interim {
                                        presence "Enable the acct-interim context";
                                        description "Enable the acct-interim context";

                                        leaf min {
                                            type types-sros:time-duration {
                                                range "1..3600";
                                            }
                                            units "seconds";
                                            description "Minimum time between accounting message resend attempts";
                                        }

                                        leaf max {
                                            type types-sros:time-duration {
                                                range "1..3600";
                                            }
                                            units "seconds";
                                            description "Maximum time between accounting message resend attempts";
                                        }

                                        leaf lifetime {
                                            type types-sros:time-duration {
                                                range "1..25";
                                            }
                                            units "hours";
                                            description "Time accounting message can be in retransmission buffer";
                                        }

                                    } // container acct-interim

                                    container acct-stop {
                                        presence "Enable the acct-stop context";
                                        description "Enable the acct-stop context";

                                        leaf min {
                                            type types-sros:time-duration {
                                                range "1..3600";
                                            }
                                            units "seconds";
                                            description "Minimum time between accounting message resend attempts";
                                        }

                                        leaf max {
                                            type types-sros:time-duration {
                                                range "1..3600";
                                            }
                                            units "seconds";
                                            description "Maximum time between accounting message resend attempts";
                                        }

                                        leaf lifetime {
                                            type types-sros:time-duration {
                                                range "1..25";
                                            }
                                            units "hours";
                                            description "Time accounting message can be in retransmission buffer";
                                        }

                                    } // container acct-stop

                                } // container buffering

                                container health-check {
                                    description "Enter the health-check context";

                                    leaf down-timeout {
                                        type types-sros:time-duration {
                                            range "1..340";
                                        }
                                        units "seconds";
                                        description "Wait time before declaring RADIUS server out-of-service";
                                    }

                                    container test-account {
                                        description "Enter the test-account context";

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the health check";
                                        }

                                        leaf interval {
                                            type types-sros:time-duration {
                                                range "1..60";
                                            }
                                            units "seconds";
                                            description "Time for test account to check health of RADIUS servers";
                                        }

                                        leaf user-name {
                                            type types-sros:display-string {
                                                length "1..64";
                                            }
                                            description "Username to send access requests to probe RADIUS server";
                                        }

                                        leaf password {
                                            type types-sros:encrypted-leaf {
                                                length "1..115";
                                            }
                                            description "Test account password for RADIUS server health check";
                                        }

                                    } // container test-account

                                } // container health-check

                            } // container servers

                            container acct-on-off {
                                presence "Enable the acct-on-off context";
                                description "Enable the acct-on-off context";

                                choice mode {
                                    case monitor {

                                        leaf monitor {
                                            type types-sros:named-item;
                                            sros-ext:immutable;
                                            description "Accounting on/off group name";
                                        }

                                    }
                                    case oper-state-change {

                                        container oper-state-change {
                                            presence "Enable the oper-state-change context";
                                            description "Enable the oper-state-change context";

                                            leaf group {
                                                type types-sros:named-item;
                                                sros-ext:immutable;
                                                description "Operational state for a group";
                                            }

                                        } // container oper-state-change

                                    }
                                }
                            } // container acct-on-off

                        } // list server-policy

                        list route-downloader {
                            key "name";
                            description "Enter the route-downloader list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "RADIUS route downloader name";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of this route downloader";
                            }

                            leaf radius-server-policy {
                                type types-sros:named-item;
                                description "RADIUS server policy referenced";
                            }

                            leaf download-interval {
                                type uint32 {
                                    range "1..1440";
                                }
                                units "minutes";
                                description "Wait time between consecutive runs of the process";
                            }

                            leaf default-metric {
                                type uint32 {
                                    range "0..254";
                                }
                                description "Default metric that RTM imported routes acquire";
                            }

                            leaf default-tag {
                                type uint32 {
                                    range "0..4294967295";
                                }
                                description "Default tag of this route downloader";
                            }

                            leaf max-routes {
                                type uint32 {
                                    range "1..200000";
                                }
                                description "Maximum routes imported by this route downloader";
                            }

                            leaf base-user-name {
                                type types-sros:named-item;
                                description "Prefix of the username used as access requests";
                            }

                            leaf password {
                                type types-sros:encrypted-leaf {
                                    length "1..71";
                                }
                                description "Route downloader password for RADIUS access requests";
                            }

                            container retry-interval {
                                description "Enter the retry-interval context";

                                leaf min {
                                    type uint32 {
                                        range "1..1440";
                                    }
                                    units "minutes";
                                    description "Minimum duration of the retry interval";
                                }

                                leaf max {
                                    type uint32 {
                                        range "1..1440";
                                    }
                                    units "minutes";
                                    description "Maximum duration of the retry interval";
                                }

                            } // container retry-interval

                        } // list route-downloader

                        list l2tp-accounting-policy {
                            key "name";
                            description "Enter the l2tp-accounting-policy list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "L2TP RADIUS accounting policy name";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf acct-tunnel-connection-fmt {
                                type types-sros:display-string {
                                    length "1..253";
                                    pattern "([^%]+|%[nsStTcC%])+";
                                }
                                description "Accounting tunnel connection ASCII specification";
                            }

                            leaf radius-server-policy {
                                type types-sros:named-item;
                                description "RADIUS server policy referenced";
                            }

                            container accounting-type {
                                description "Enter the accounting-type context";

                                leaf session {
                                    type boolean;
                                    description "Enable per-session accounting";
                                }

                                leaf tunnel {
                                    type boolean;
                                    description "Enable per-tunnel accounting";
                                }

                            } // container accounting-type

                            container include-radius-attribute {
                                description "Enter the include-radius-attribute context";

                                leaf calling-station-id {
                                    type boolean;
                                    description "Include the Calling-Station-Id attribute";
                                }

                                leaf nas-identifier {
                                    type boolean;
                                    description "Include the NAS-Identifier attribute";
                                }

                                container nas-port {
                                    presence "Enable the nas-port context";
                                    description "Enable the nas-port context";

                                    leaf bit-spec {
                                        type types-sros:binary-specification {
                                            pattern "([01]|(\\*[0123456789]+)?[oismpvc])+";
                                        }
                                        description "RADIUS NAS-Port attribute";
                                    }

                                } // container nas-port

                                container nas-port-id {
                                    presence "Enable the nas-port-id context";
                                    description "Enable the nas-port-id context";

                                    leaf prefix-string {
                                        type types-sros:string-not-all-spaces {
                                            length "1..8";
                                        }
                                        description "Prefix string added to RADIUS NAS-Port attribute";
                                    }

                                    leaf suffix {
                                        type enumeration {
                                            enum circuit-id                     { value 1; }
                                            enum remote-id                      { value 2; }
                                        }
                                        description "Suffix type to add to the RADIUS NAS port attribute";
                                    }

                                } // container nas-port-id

                                container nas-port-type {
                                    presence "Enable the nas-port-type context";
                                    description "Enable the nas-port-type context";

                                    leaf type {
                                        type union {
                                            type enumeration {
                                                enum rfc-aligned                    { value 1000; }
                                            }
                                            type uint32 {
                                                range "0..255";
                                            }
                                        }
                                        description "Value for RADIUS NAS-Port-Type attribute";
                                    }

                                } // container nas-port-type

                            } // container include-radius-attribute

                        } // list l2tp-accounting-policy

                        list isa-policy {
                            key "name";
                            description "Enter the isa-policy list instance";

                            leaf name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "ISA RADIUS policy name referenced by a NAT application";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf password {
                                type types-sros:encrypted-leaf {
                                    length "1..42";
                                }
                                description "Password used in the RADIUS access requests";
                            }

                            leaf nas-ip-address-origin {
                                type enumeration {
                                    enum system-ip                      { value 0; }
                                    enum isa-ip                         { value 1; }
                                }
                                description "RADIUS NAS-IP-Address attribute";
                            }

                            leaf python-policy {
                                type types-sros:named-item;
                                description "Python policy used for modifying RADIUS messages";
                            }

                            container accounting {
                                description "Enter the accounting context";

                                container include-attributes {
                                    description "Enter the include-attributes context";

                                    leaf acct-delay-time {
                                        type boolean;
                                        description "Include the accounting delay time attribute";
                                    }

                                    leaf acct-triggered-reason {
                                        type boolean;
                                        description "Include the accounting triggered reason attribute";
                                    }

                                    leaf called-station-id {
                                        type boolean;
                                        description "Include the Called-Station-Id attribute";
                                    }

                                    leaf calling-station-id {
                                        type boolean;
                                        description "Include the Calling-Station-Id attribute";
                                    }

                                    leaf circuit-id {
                                        type boolean;
                                        description "Include the Agent-Circuit-Id attribute";
                                    }

                                    leaf class {
                                        type boolean;
                                        description "Include the Class attribute";
                                    }

                                    leaf dhcp-options {
                                        type boolean;
                                        description "Include the Alc-ToServer-Dhcp-Options attribute";
                                    }

                                    leaf dhcp-vendor-class-id {
                                        type boolean;
                                        description "Include the Alc-Dhcp-Vendor-Class-Id attribute";
                                    }

                                    leaf frame-counters {
                                        type boolean;
                                        description "Include Acct-Input-Packets and Acct-Output-Packets";
                                    }

                                    leaf framed-ip-address {
                                        type boolean;
                                        description "Include the Framed-IP-Address attribute";
                                    }

                                    leaf framed-ip-netmask {
                                        type boolean;
                                        description "Include the Framed-IP-Netmask attribute";
                                    }

                                    leaf framed-ipv6-prefix {
                                        type boolean;
                                        description "Include the Framed-IPv6-Prefix attribute";
                                    }

                                    leaf hardware-timestamp {
                                        type boolean;
                                        description "Include the Event-Timestamp attribute";
                                    }

                                    leaf ipv6-address {
                                        type boolean;
                                        description "Include the Alc-Ipv6-Address attribute";
                                    }

                                    leaf mac-address {
                                        type boolean;
                                        description "Include the Alc-Client-Hardware-Addr attribute";
                                    }

                                    leaf multi-session-id {
                                        type boolean;
                                        description "Include the Acct-Multi-Session-Id attribute";
                                    }

                                    leaf nas-identifier {
                                        type boolean;
                                        description "Include the NAS-Identifier attribute";
                                    }

                                    leaf nas-ip-address {
                                        type boolean;
                                        description "Include the NAS-IP-Address attribute";
                                    }

                                    leaf nas-ipv6-address {
                                        type boolean;
                                        description "Include the NAS-IPv6-Address attribute";
                                    }

                                    leaf nas-port {
                                        type boolean;
                                        description "Include the NAS-Port attribute";
                                    }

                                    leaf nas-port-id {
                                        type boolean;
                                        description "Include the NAS-Port-Id attribute";
                                    }

                                    leaf nas-port-type {
                                        type boolean;
                                        description "Include the NAS-Port-Type attribute";
                                    }

                                    leaf nat-inside-service-id {
                                        type boolean;
                                        description "Include NAT inside service ID in Alc-Serv-Id attribute";
                                    }

                                    leaf nat-outside-ip-address {
                                        type boolean;
                                        description "Include the Alc-Nat-Outside-Ip-Addr attribute";
                                    }

                                    leaf nat-outside-service-id {
                                        type boolean;
                                        description "Include NAT outside service ID in Alc-Serv-Id attribute";
                                    }

                                    leaf nat-port-forward-logging {
                                        type boolean;
                                        description "Enable logging of port forwards via RADIUS";
                                    }

                                    leaf nat-port-range-block {
                                        type boolean;
                                        description "Include the Alc-Nat-Port-Range attribute";
                                    }

                                    leaf nat-port-time {
                                        type boolean;
                                        description "Enable the Alc-Nat-Port-Time RADIUS attribute";
                                    }

                                    leaf nat-subscriber-string {
                                        type boolean;
                                        description "Include the Alc-Subsc-ID-Str attribute";
                                    }

                                    leaf octet-counters {
                                        type boolean;
                                        description "Include Acct-Input-Octets and Acct-Output-Octets";
                                    }

                                    leaf proxied-subscriber-data {
                                        type boolean;
                                        description "Include subscriber data as RADIUS attributes";
                                    }

                                    leaf release-reason {
                                        type boolean;
                                        description "Include reason in the Acct-Terminate-Cause attribute";
                                    }

                                    leaf remote-id {
                                        type boolean;
                                        description "Include the Agent-Remote-Id attribute";
                                    }

                                    leaf rssi {
                                        type boolean;
                                        description "Include the Alc-RSSI attribute";
                                    }

                                    leaf session-time {
                                        type boolean;
                                        description "Include the Acct-Session-Time attribute";
                                    }

                                    leaf subscriber-id {
                                        type boolean;
                                        description "Include the Alc-Subsc-ID-Str attribute";
                                    }

                                    leaf toserver-dhcp6-options {
                                        type boolean;
                                        description "Include the Alc-ToServer-Dhcp6-Options attribute";
                                    }

                                    leaf ue-creation-type {
                                        type boolean;
                                        description "Include the Alc-Wlan-Ue-Creation-Type attribute";
                                    }

                                    leaf user-name {
                                        type boolean;
                                        description "Include the User-Name attribute";
                                    }

                                    leaf wlan-custom-user-group {
                                        type boolean;
                                        description "Include Wlan-Custom-User-Group attribute";
                                    }

                                    leaf wlan-ssid-vlan {
                                        type boolean;
                                        description "Include per-SSID VLAN in Alc-Wlan-SSID-VLAN attribute";
                                    }

                                    leaf xconnect-tunnel-local-ipv6-address {
                                        type boolean;
                                        description "Include the Alc-Xconnect-Tunnel-Local-Ipv6 attribute";
                                    }

                                    leaf xconnect-tunnel-remote-ipv6-address {
                                        type boolean;
                                        description "Include the Alc-Xconnect-Tunnel-Remote-Ipv6 attribute";
                                    }

                                    leaf xconnect-tunnel-service {
                                        type boolean;
                                        description "Include the Alc-Xconnect-Tunnel-Service attribute";
                                    }

                                    leaf xconnect-tunnel-type {
                                        type boolean;
                                        description "Include the Alc-Xconnect-Tunnel-Type attribute";
                                    }

                                    leaf xconnect-tunnel-home-address {
                                        type boolean;
                                        description "Include the Alc-Xconnect-Tunnel-Home-Ipv6 attribute";
                                    }

                                    leaf millisecond-event-timestamp {
                                        type boolean;
                                        description "Include the Alc-Millisecond-Event-Timestamp attribute";
                                    }

                                    leaf credit-control-quota {
                                        type boolean;
                                        description "Add unconsumed volume quota to Credit-Control-Quota";
                                    }

                                } // container include-attributes

                                container update-triggers {
                                    description "Enter the update-triggers context";

                                    leaf address-state {
                                        type boolean;
                                        description "Send an Interim-Update when address allocated or freed";
                                    }

                                    leaf soft-quota-exhausted {
                                        type boolean;
                                        description "Send interim update when soft volume quota is reached";
                                    }

                                } // container update-triggers

                                container nat-periodic-update {
                                    description "Enter the nat-periodic-update context";

                                    leaf interval {
                                        type types-sros:time-duration {
                                            range "1..72";
                                        }
                                        units "hours";
                                        description "Interval for periodic RADIUS Interim-Update messages";
                                    }

                                    leaf rate-limit {
                                        type union {
                                            type uint32 {
                                                range "1..100000";
                                            }
                                            type enumeration {
                                                enum unlimited                      { value 0; }
                                            }
                                        }
                                        units "packets per second";
                                        description "Rate limit for periodic RADIUS Interim-Update messages";
                                    }

                                } // container nat-periodic-update

                            } // container accounting

                            container authentication {
                                description "Enter the authentication context";

                                container include-attributes {
                                    description "Enter the include-attributes context";

                                    leaf called-station-id {
                                        type boolean;
                                        description "Include the Called-Station-Id attribute";
                                    }

                                    leaf calling-station-id {
                                        type boolean;
                                        description "Include the Calling-Station-Id attribute";
                                    }

                                    leaf circuit-id {
                                        type boolean;
                                        description "Include the Agent-Circuit-Id attribute";
                                    }

                                    leaf toserver-dhcp-options {
                                        type boolean;
                                        description "Include the Alc-ToServer-Dhcp-Options attribute";
                                    }

                                    leaf dhcp-vendor-class-id {
                                        type boolean;
                                        description "Include the Alc-DHCP-Vendor-Class-Id attribute";
                                    }

                                    leaf framed-ip-address {
                                        type boolean;
                                        description "Include the Framed-IP-Address attribute";
                                    }

                                    leaf ipv6-address {
                                        type boolean;
                                        description "Include the Alc-IPv6-address attribute";
                                    }

                                    leaf mac-address {
                                        type boolean;
                                        description "Include the Alc-Client-Hardware-Addr attribute";
                                    }

                                    leaf nas-identifier {
                                        type boolean;
                                        description "Include the NAS-Identifier attribute";
                                    }

                                    leaf nas-ip-address {
                                        type boolean;
                                        description "Include the NAS-IP-Address attribute";
                                    }

                                    leaf nas-ipv6-address {
                                        type boolean;
                                        description "Include the NAS-IPv6-Address attribute";
                                    }

                                    leaf nas-port {
                                        type boolean;
                                        description "Include the NAS-Port attribute";
                                    }

                                    leaf nas-port-id {
                                        type boolean;
                                        description "Include the NAS-Port-Id attribute";
                                    }

                                    leaf nas-port-type {
                                        type boolean;
                                        description "Include the NAS-Port-Type attribute";
                                    }

                                    leaf remote-id {
                                        type boolean;
                                        description "Include the Agent-Remote-Id attribute";
                                    }

                                    leaf toserver-dhcp6-options {
                                        type boolean;
                                        description "Include the Alc-ToServer-Dhcp6-Options attribute";
                                    }

                                    leaf wlan-ssid-vlan {
                                        type boolean;
                                        description "Include per-SSID VLAN in Alc-Wlan-SSID-VLAN attribute";
                                    }

                                    leaf xconnect-tunnel-home-address {
                                        type boolean;
                                        description "Include the Alc-Xconnect-Tunnel-Home-Ipv6 attribute";
                                    }

                                } // container include-attributes

                            } // container authentication

                            container user-name {
                                description "Enter the user-name context";

                                leaf format {
                                    type enumeration {
                                        enum mac                            { value 1; }
                                        enum mac-ip                         { value 2; }
                                        enum dhcp-vendor                    { value 3; }
                                        enum circuit-id                     { value 4; }
                                    }
                                    description "Username format in RADIUS message";
                                }

                                leaf mac-format {
                                    type types-nat:mac-format;
                                    description "MAC address format when contacting RADIUS server";
                                }

                            } // container user-name

                            container servers {
                                description "Enter the servers context";

                                leaf source-address-range {
                                    type types-sros:ipv4-unicast-address;
                                    description "Starting IP address of the IP address range";
                                }

                                leaf timeout {
                                    type types-sros:time-duration {
                                        range "1..90";
                                    }
                                    units "seconds";
                                    description "Timeout for a response from the RADIUS server";
                                }

                                leaf total-tries {
                                    type uint32 {
                                        range "1..10";
                                    }
                                    description "Maximum number of tries toward the same RADIUS server";
                                }

                                leaf router-instance {
                                    type types-services:service-name;
                                    description "Routing instance";
                                }

                                leaf access-algorithm {
                                    type types-radius:isa-server-selection-algo;
                                    description "Algorithm that accesses the RADIUS servers";
                                }

                                container ipv6 {
                                    description "Enter the ipv6 context";

                                    leaf mtu {
                                        type uint32 {
                                            range "1280..9000";
                                        }
                                        description "MTU used to fragment outgoing IPv6 RADIUS packets";
                                    }

                                    leaf source-prefix {
                                        type types-sros:ipv6-prefix;
                                        description "Prefix containing individual source addresses per ISA";
                                    }

                                } // container ipv6

                                list server {
                                    key "index";
                                    description "Enter the server list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..10";
                                            }
                                        }
                                        description "RADIUS server ID";
                                    }

                                    leaf admin-state {
                                        type types-sros:admin-state;
                                        description "Administrative state of the ISA RADIUS server";
                                    }

                                    leaf ip-address {
                                        type types-sros:ip-unicast-without-local-address;
                                        description "IP address of the RADIUS server";
                                    }

                                    leaf secret {
                                        type types-sros:encrypted-leaf {
                                            length "1..115";
                                        }
                                        description "Secret key to access the RADIUS server";
                                    }

                                    container purpose {
                                        description "Enter the purpose context";

                                        container accounting {
                                            presence "Enable the accounting context";
                                            description "Enable the accounting context";

                                            leaf udp-port {
                                                type types-sros:tcp-udp-port-non-zero;
                                                description "ISA RADIUS server accounting UDP port";
                                            }

                                        } // container accounting

                                        container authentication {
                                            presence "Enable the authentication context";
                                            description "Enable the authentication context";

                                            leaf udp-port {
                                                type types-sros:tcp-udp-port-non-zero;
                                                description "ISA RADIUS server authentication UDP port";
                                            }

                                        } // container authentication

                                        container coa {
                                            presence "Enable the coa context";
                                            description "Enable the coa context";

                                            leaf udp-port {
                                                type types-sros:tcp-udp-port-non-zero;
                                                description "ISA RADIUS server change of authorization UDP port";
                                            }

                                        } // container coa

                                    } // container purpose

                                } // list server

                            } // container servers

                        } // list isa-policy

                    } // container radius

                    container diameter {
                        description "Enter the diameter context";

                        list node {
                            key "origin-host";
                            description "Enter the node list instance";

                            leaf origin-host {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-diam:diam-fqdn;
                                }
                                description "Origin-Host AVP";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf origin-realm {
                                type types-diam:diam-fqdn;
                                sros-ext:immutable;
                                description "Origin-realm name";
                            }

                            leaf python-policy {
                                type types-sros:named-item;
                                description "Python policy for received or sent Diameter messages";
                            }

                            leaf router-instance {
                                type types-sros:named-item-64 {
                                    pattern ".{1,32}" {
                                        error-message "vRtrName needs to be extended to 64 to support this name";
                                    }
                                }
                                description "Router in which this node connects to its peers";
                            }

                            container connection {
                                description "Enter the connection context";

                                leaf timer {
                                    type types-sros:time-duration {
                                        range "1..1000";
                                    }
                                    units "seconds";
                                    description "Connection reestablishment timer for the Diameter peer";
                                }

                                container ipv4 {
                                    description "Enter the ipv4 context";

                                    leaf local-address {
                                        type types-sros:ipv4-unicast-address;
                                        description "IPv4 source address for the TCP peer connection";
                                    }

                                    leaf allow-connections {
                                        type boolean;
                                        description "Listen on local address for incoming peer connections";
                                    }

                                } // container ipv4

                                container ipv6 {
                                    description "Enter the ipv6 context";

                                    leaf local-address {
                                        type types-sros:ipv6-unicast-address;
                                        description "IPv6 source address for the TCP peer connection";
                                    }

                                    leaf allow-connections {
                                        type boolean;
                                        description "Listen on local address for incoming peer connections";
                                    }

                                } // container ipv6

                            } // container connection

                            list peer {
                                key "index";
                                description "Enter the peer list instance";

                                leaf index {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "1..5";
                                        }
                                    }
                                    description "Index of a peer within the node";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the Diameter peer";
                                }

                                leaf address {
                                    type types-sros:ip-unicast-address;
                                    description "Diameter peer address";
                                }

                                leaf destination-host {
                                    type types-diam:diam-fqdn;
                                    sros-ext:immutable;
                                    description "Destination-Host AVP string for Diameter messages";
                                }

                                leaf connection-timer {
                                    type types-sros:time-duration {
                                        range "1..1000";
                                    }
                                    units "seconds";
                                    description "Wait time before attempting reconnection to peer";
                                }

                                leaf preference {
                                    type uint32 {
                                        range "1..100";
                                    }
                                    description "Diameter routing preference for a peer";
                                }

                                leaf watchdog-timer {
                                    type types-sros:time-duration {
                                        range "1..1000";
                                    }
                                    units "seconds";
                                    description "Time between consecutive watchdog messages";
                                }

                                leaf default-peer {
                                    type boolean;
                                    description "Use the peer as default route for realm-based routing";
                                }

                                list route {
                                    key "index";
                                    description "Enter the route list instance";

                                    leaf index {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..15";
                                            }
                                        }
                                        description "Static Diameter route ID";
                                    }

                                    leaf realm {
                                        type types-diam:diam-fqdn;
                                        sros-ext:immutable;
                                        description "Destination realm reachable via the static route";
                                    }

                                    leaf application {
                                        type enumeration {
                                            enum nasreq                         { value 1; }
                                            enum gy                             { value 4; }
                                            enum gx                             { value 16777238; }
                                        }
                                        sros-ext:immutable;
                                        description "Diameter application to which the route applies";
                                    }

                                    leaf preference {
                                        type uint32 {
                                            range "1..100";
                                        }
                                        description "Static route preference; lower value is preferred";
                                    }

                                } // list route

                            } // list peer

                        } // list node

                        list peer-policy {
                            status obsolete;
                            key "name";
                            description "Enter the peer-policy list instance";

                            leaf name {
                                status obsolete;
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Diameter peer policy name";
                            }

                            leaf description {
                                status obsolete;
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf origin-host {
                                status obsolete;
                                type string {
                                    length "1..80";
                                }
                                description "Origin-Host AVP sent in all Diameter messages";
                            }

                            leaf origin-realm {
                                status obsolete;
                                type string {
                                    length "1..80";
                                }
                                description "Origin-Realm AVP sent in all Diameter messages";
                            }

                            leaf router-instance {
                                status obsolete;
                                type types-sros:named-item-64 {
                                    pattern ".{1,32}" {
                                        error-message "vRtrName needs to be extended to 64 to support this name";
                                    }
                                }
                                description "Diameter peer policy router";
                            }

                            leaf ipv4-source-address {
                                status obsolete;
                                type types-sros:ipv4-unicast-address;
                                description "IPv4 source address for peering connection";
                            }

                            leaf ipv6-source-address {
                                status obsolete;
                                type types-sros:ipv6-unicast-address;
                                description "IPv6 source address for IPv6 peering connection";
                            }

                            leaf watchdog-timer {
                                status obsolete;
                                type types-sros:time-duration {
                                    range "1..1000";
                                }
                                units "seconds";
                                description "Time between consecutive watchdog messages";
                            }

                            leaf connection-timer {
                                status obsolete;
                                type types-sros:time-duration {
                                    range "1..1000";
                                }
                                units "seconds";
                                description "Wait time before attempting reconnection to peer";
                            }

                            leaf transaction-timer {
                                status obsolete;
                                type types-sros:time-duration {
                                    range "1..1000";
                                }
                                units "seconds";
                                description "Timeout for base Diameter messages (DWR, CER, DPR)";
                            }

                            leaf vendor-support {
                                status obsolete;
                                type types-diam:diam-vendor-support;
                                description "Vendor support announced in the capability exchange";
                            }

                            leaf python-policy {
                                status obsolete;
                                type types-sros:named-item;
                                description "Name of the python policy for Diameter processing";
                            }

                            leaf role {
                                status obsolete;
                                type enumeration {
                                    enum client                         { value 0; }
                                    enum proxy                          { value 1; }
                                }
                                sros-ext:immutable;
                                description "Client or proxy role of a Diameter peer policy";
                            }

                            container applications {
                                status obsolete;
                                description "Enter the applications context";

                                leaf gx {
                                    status obsolete;
                                    type boolean;
                                    description "Advertise Gx application support in CER messages";
                                }

                                leaf gy {
                                    status obsolete;
                                    type boolean;
                                    description "Advertise Gy application support in CER messages";
                                }

                                leaf nasreq {
                                    status obsolete;
                                    type boolean;
                                    description "Advertise NASREQ application support in CER messages";
                                }

                            } // container applications

                            list peer {
                                status obsolete;
                                key "peer-name";
                                description "Enter the peer list instance";

                                leaf peer-name {
                                    status obsolete;
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Diameter peer name";
                                }

                                leaf admin-state {
                                    status obsolete;
                                    type types-sros:admin-state;
                                    description "Administrative state of the peer";
                                }

                                leaf address {
                                    status obsolete;
                                    type types-sros:ip-unicast-address;
                                    description "Diameter peer address";
                                }

                                leaf destination-host {
                                    status obsolete;
                                    type types-sros:string-not-all-spaces {
                                        length "1..80";
                                    }
                                    description "Destination-Host AVP string for Diameter messages";
                                }

                                leaf destination-realm {
                                    status obsolete;
                                    type types-sros:string-not-all-spaces {
                                        length "1..80";
                                    }
                                    description "Destination-Realm AVP string for Diameter messages";
                                }

                                leaf watchdog-timer {
                                    status obsolete;
                                    type types-sros:time-duration {
                                        range "1..1000";
                                    }
                                    units "seconds";
                                    description "Time between consecutive watchdog messages";
                                }

                                leaf connection-timer {
                                    status obsolete;
                                    type types-sros:time-duration {
                                        range "1..1000";
                                    }
                                    units "seconds";
                                    description "Wait time before attempting reconnection to a peer";
                                }

                                leaf transaction-timer {
                                    status obsolete;
                                    type types-sros:time-duration {
                                        range "1..1000";
                                    }
                                    units "seconds";
                                    description "Timeout for base Diameter messages (DWR, CER, DPR)";
                                }

                                leaf preference {
                                    status obsolete;
                                    type uint32 {
                                        range "1..100";
                                    }
                                    description "Peer preference of the Diameter peer policy";
                                }

                                container transport {
                                    status obsolete;
                                    description "Enter the transport context";

                                    leaf port-number {
                                        status obsolete;
                                        type uint32 {
                                            range "1..65535";
                                        }
                                        description "Destination TCP port number for the policy peer";
                                    }

                                } // container transport

                                container statistics {
                                    status obsolete;
                                    description "Enter the statistics context";

                                } // container statistics

                            } // list peer

                            container proxy {
                                status obsolete;
                                description "Enter the proxy context";

                                leaf admin-state {
                                    status obsolete;
                                    type types-sros:admin-state;
                                    description "Administrative state of Diameter proxy";
                                }

                                leaf router-instance {
                                    status obsolete;
                                    type types-sros:named-item-64 {
                                        pattern ".{1,32}" {
                                            error-message "vRtrName needs to be extended to 64 to support this name";
                                        }
                                    }
                                    description "Routing context associated with Diameter proxy";
                                }

                                leaf local-address {
                                    status obsolete;
                                    type types-sros:ip-unicast-address;
                                    description "Source IP address on which the Diameter proxy listens";
                                }

                                container mcs-peer {
                                    status obsolete;
                                    presence "Enable the mcs-peer context";
                                    description "Enable the mcs-peer context";

                                    leaf address {
                                        status obsolete;
                                        type types-sros:ip-unicast-address;
                                        sros-ext:immutable;
                                        description "MCS peer address";
                                    }

                                    leaf sync-tag {
                                        status obsolete;
                                        type types-sros:named-item;
                                        sros-ext:immutable;
                                        description "Synchronization tag shared by MCS peers";
                                    }

                                } // container mcs-peer

                            } // container proxy

                        } // list peer-policy

                    } // container diameter

                    container wpp {
                        presence "Enable the wpp context";
                        description "Enable the wpp context";

                        leaf system-name {
                            type string {
                                length "1..16";
                            }
                            description "System name used in WPP protocol messages";
                        }

                        list portal-group {
                            key "group-name";
                            description "Enter the portal-group list instance";

                            leaf group-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Portal group name";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the portal group";
                            }

                            list portal {
                                key "router-instance name";
                                description "Add a list entry for portal";

                                leaf router-instance {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item-64 {
                                            pattern ".{1,32}" {
                                                error-message "vRtrName needs to be extended to 64 to support this name";
                                            }
                                        }
                                    }
                                    description "Router on which the portal is configured";
                                }

                                leaf name {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:named-item;
                                    }
                                    description "Web portal server name";
                                }

                            } // list portal

                        } // list portal-group

                    } // container wpp

                } // container aaa

                container anysec {
                    presence "Enable the anysec context";
                    description "Enable the anysec context";

                    leaf reserved-label-block {
                        type types-sros:named-item-64;
                        description "ANYSec reserved label block";
                    }

                    container mka-over-ip {
                        description "Enter the mka-over-ip context";

                        leaf mka-udp-port {
                            type types-sros:tcp-udp-port {
                                range "1024..49151";
                            }
                            description "ANYSec MKA UDP port";
                        }

                    } // container mka-over-ip

                    container security-termination-policies {
                        description "Enter the security-termination-policies context";

                        list policy {
                            key "policy-name";
                            description "Enter the policy list instance";

                            leaf policy-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "ANYsec security termination policy name";
                            }

                            leaf local-address {
                                type types-sros:ip-unicast-address;
                                description "Local address of node SID associated with ANYsec tunnel";
                            }

                            leaf rx-must-be-encrypted {
                                type boolean;
                                description "Enforce encryption for received packets";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the security termination policy";
                            }

                            leaf protocol {
                                type types-security:anysec-protocol;
                                description "Protocol used to advertise node SID of incoming tunnel";
                            }

                            leaf igp-instance-id {
                                type types-security:anysec-igp-instance-id;
                                description "IGP instance ID";
                            }

                            leaf flex-algo-id {
                                type types-router:flex-algo-id;
                                description "Flexible algorithm ID";
                            }

                        } // list policy

                    } // container security-termination-policies

                    container tunnel-encryption {
                        description "Enter the tunnel-encryption context";

                        list security-termination-policy {
                            status obsolete;
                            key "policy-name";
                            description "Enter the security-termination-policy list instance";

                            leaf policy-name {
                                status obsolete;
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "ANYsec security termination policy name";
                            }

                            leaf local-address {
                                status obsolete;
                                type types-sros:ip-unicast-address;
                                description "Local address of node SID associated with ANYsec tunnel";
                            }

                            leaf rx-must-be-encrypted {
                                status obsolete;
                                type boolean;
                                description "Enforce encryption for received packets";
                            }

                            leaf admin-state {
                                status obsolete;
                                type types-sros:admin-state;
                                description "Administrative state of the security termination policy";
                            }

                            leaf protocol {
                                status obsolete;
                                type types-security:anysec-protocol;
                                description "Protocol used to advertise node SID of incoming tunnel";
                            }

                            leaf igp-instance-id {
                                status obsolete;
                                type types-security:anysec-igp-instance-id;
                                description "IGP instance ID";
                            }

                            leaf flex-algo-id {
                                status obsolete;
                                type types-router:flex-algo-id;
                                description "Flexible algorithm ID";
                            }

                        } // list security-termination-policy

                        list encryption-group {
                            key "group-name";
                            description "Enter the encryption-group list instance";

                            leaf group-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "ANYsec encryption group name";
                            }

                            leaf security-termination-policy {
                                type types-sros:named-item;
                                description "Security termination policy used by encryption group";
                            }

                            leaf encryption-label {
                                type types-sros:mpls-label-or-zero;
                                description "Label identifying packets sent from the node to peers";
                            }

                            leaf ca-name {
                                type string {
                                    length "1..32";
                                }
                                description "Connectivity association for the encryption group";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the encryption group";
                            }

                            leaf allow-entropy-label {
                                type boolean;
                                description "Allow EL and ELI by this encryption group";
                            }

                            container peer-tunnel-attributes {
                                description "Enter the peer-tunnel-attributes context";

                                leaf protocol {
                                    type types-security:anysec-protocol;
                                    description "Protocol used to advertise node SID of incoming tunnel";
                                }

                                leaf igp-instance-id {
                                    type types-security:anysec-igp-instance-id;
                                    description "IGP instance ID";
                                }

                                leaf flex-algo-id {
                                    type types-router:flex-algo-id;
                                    description "Flexible algorithm ID";
                                }

                            } // container peer-tunnel-attributes

                            list peer {
                                key "peer-ip-address";
                                description "Enter the peer list instance";

                                leaf peer-ip-address {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ip-unicast-address;
                                    }
                                    description "Peer IP address of the node SID";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the encryption group peer";
                                }

                            } // list peer

                        } // list encryption-group

                    } // container tunnel-encryption

                    container service-encryption {
                        description "Enter the service-encryption context";

                        list encryption-group {
                            key "group-name";
                            description "Enter the encryption-group list instance";

                            leaf group-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "ANYsec encryption group name";
                            }

                            leaf security-termination-policy {
                                type types-sros:named-item;
                                description "Security termination policy used by encryption group";
                            }

                            leaf encryption-label {
                                type types-sros:mpls-label-or-zero;
                                description "Label identifying packets sent from the node to peers";
                            }

                            leaf ca-name {
                                type string {
                                    length "1..32";
                                }
                                description "Connectivity association for the encryption group";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the encryption group";
                            }

                            list peer {
                                key "peer-ip-address";
                                description "Enter the peer list instance";

                                leaf peer-ip-address {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ip-unicast-address;
                                    }
                                    description "Peer IP address of the node SID";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the encryption group peer";
                                }

                            } // list peer

                        } // list encryption-group

                    } // container service-encryption

                } // container anysec

                container application-assurance {
                    presence "Enable the application-assurance context";
                    description "Enable the application-assurance context";

                    container usage-alert-thresholds {
                        description "Enter the usage-alert-thresholds context";

                        leaf bit-rate-high-wmark {
                            type union {
                                type int32 {
                                    range "1..100000";
                                }
                                type enumeration {
                                    enum max                            { value 1; }
                                }
                            }
                            units "megabps";
                            description "High watermark for bit rate alarms";
                        }

                        leaf bit-rate-low-wmark {
                            type uint32 {
                                range "0..99999";
                            }
                            description "Low watermark for bit rate alarms";
                        }

                        leaf datapath-cpu-high-wmark {
                            type union {
                                type int32 {
                                    range "0..100";
                                }
                                type enumeration {
                                    enum max                            { value 1; }
                                }
                            }
                            units "percent";
                            description "High watermark for datapath CPU alarms";
                        }

                        leaf datapath-cpu-low-wmark {
                            type int32 {
                                range "0..100";
                            }
                            units "percent";
                            description "Low watermark for datapath CPU alarms";
                        }

                        leaf flow-table-high-wmark {
                            type int32 {
                                range "0..100";
                            }
                            units "percent";
                            description "Flow table high watermark";
                        }

                        leaf flow-table-low-wmark {
                            type int32 {
                                range "0..100";
                            }
                            units "percent";
                            description "Flow table low watermark";
                        }

                        leaf flow-setup-rate-high-wmark {
                            type union {
                                type int32 {
                                    range "1..2000000";
                                }
                                type enumeration {
                                    enum max                            { value 1; }
                                }
                            }
                            description "High watermark for flow setup rate";
                        }

                        leaf flow-setup-rate-low-wmark {
                            type uint32 {
                                range "0..1999999";
                            }
                            description "Low watermark for flow setup rate";
                        }

                        leaf packet-rate-high-wmark {
                            type union {
                                type int32 {
                                    range "1..148809524";
                                }
                                type enumeration {
                                    enum max                            { value 1; }
                                }
                            }
                            description "Packet rate high watermark";
                        }

                        leaf packet-rate-low-wmark {
                            type uint32 {
                                range "0..148809523";
                            }
                            description "Packet rate low watermark";
                        }

                    } // container usage-alert-thresholds

                    list aarp {
                        key "aarp-id";
                        description "Enter the aarp list instance";

                        leaf aarp-id {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-services:bsx-aarp-id;
                            }
                            description "AARP ID";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the AARP instance";
                        }

                        leaf description {
                            type types-sros:description;
                            description "Text description";
                        }

                        leaf master-selection-mode {
                            type enumeration {
                                enum minimize-switchovers           { value 1; }
                                enum inter-chassis-efficiency       { value 2; }
                                enum priority-based-balance         { value 3; }
                            }
                            description "AARP master selection mode";
                        }

                        leaf peer {
                            type types-sros:ip-unicast-address;
                            description "AARP peer IP address";
                        }

                        leaf priority {
                            type uint32 {
                                range "0..255";
                            }
                            description "AARP priority";
                        }

                        container peer-endpoint {
                            description "Enter the peer-endpoint context";

                            choice endpoint-choice {
                                case sap {

                                    container sap {
                                        presence "Enable the sap context";
                                        description "Enable the sap context";

                                        leaf sap-id {
                                            type types-sros:sap;
                                            description "AARP peer endpoint SAP ID";
                                        }

                                        leaf encap-type {
                                            type types-port:ethernet-encap-type;
                                            description "Encapsulation type for peer endpoint SAP";
                                        }

                                    } // container sap

                                }
                                case spoke-sdp {

                                    leaf spoke-sdp {
                                        type types-services:sdp-bind-id;
                                        description "AARP peer endpoint spoke SDP";
                                    }

                                }
                            }
                        } // container peer-endpoint

                    } // list aarp

                    container cflowd {
                        description "Enter the cflowd context";

                        list field {
                            key "field-name";
                            description "Enter the field list instance";

                            leaf field-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Cflowd record field name";
                            }

                            leaf comment {
                                type types-sros:named-item;
                                description "User information comment";
                            }

                        } // list field

                    } // container cflowd

                    container flow-attribute {
                        description "Enter the flow-attribute context";

                        list attribute {
                            key "attribute-name";
                            description "Enter the attribute list instance";

                            leaf attribute-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "Attribute name";
                            }

                            leaf comment {
                                type types-sros:named-item;
                                description "User information comment";
                            }

                        } // list attribute

                    } // container flow-attribute

                    container http-enrich {
                        description "Enter the http-enrich context";

                        list field {
                            key "field-name";
                            description "Enter the field list instance";

                            leaf field-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "HTTP enrich field name (void, do not use)";
                            }

                            leaf comment {
                                type types-sros:named-item;
                                description "User information comment";
                            }

                        } // list field

                    } // container http-enrich

                    container http-error-redirect {
                        description "Enter the http-error-redirect context";

                        list error-code {
                            key "error-code-number";
                            description "Enter the error-code list instance";

                            leaf error-code-number {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type uint32 {
                                        range "400..999";
                                    }
                                }
                                description "Error code for HTTP error redirection";
                            }

                            leaf comment {
                                type types-sros:named-item;
                                description "User information comment";
                            }

                        } // list error-code

                        list template {
                            key "template-id";
                            description "Enter the template list instance";

                            leaf template-id {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type uint32;
                                }
                                description "HTTP error redirect template ID";
                            }

                            leaf comment {
                                type types-sros:named-item;
                                description "User information comment";
                            }

                        } // list template

                    } // container http-error-redirect

                    container http-notification {
                        description "Enter the http-notification context";

                        list template {
                            key "template-id";
                            description "Enter the template list instance";

                            leaf template-id {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type uint32;
                                }
                                description "HTTP notification template ID";
                            }

                            leaf comment {
                                type types-sros:named-item;
                                description "User information comment";
                            }

                        } // list template

                    } // container http-notification

                    container http-redirect {
                        description "Enter the http-redirect context";

                        list template {
                            key "template-id";
                            description "Enter the template list instance";

                            leaf template-id {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type uint32;
                                }
                                description "HTTP redirect template ID";
                            }

                            leaf comment {
                                type types-sros:named-item;
                                description "User information comment";
                            }

                        } // list template

                    } // container http-redirect

                    list protocol {
                        key "protocol-name";
                        description "Enter the protocol list instance";

                        leaf protocol-name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "AA protocol name";
                        }

                        leaf admin-state {
                            type types-sros:admin-state;
                            description "Administrative state of the protocol";
                        }

                    } // list protocol

                    list radius-accounting-policy {
                        key "rad-acct-plcy-name";
                        description "Enter the radius-accounting-policy list instance";

                        leaf rad-acct-plcy-name {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type types-sros:named-item;
                            }
                            description "AA RADIUS accounting policy name";
                        }

                        leaf description {
                            type types-sros:description;
                            description "Text description";
                        }

                        leaf interim-update-interval {
                            type uint32 {
                                range "5..1080";
                            }
                            units "minutes";
                            description "AA RADIUS accounting policy interim update interval";
                        }

                        leaf significant-change {
                            type uint32 {
                                range "1";
                            }
                            description "Change delta for RADIUS accounting record updates";
                        }

                        container radius-accounting-server {
                            description "Enter the radius-accounting-server context";

                            leaf access-algorithm {
                                type enumeration {
                                    enum direct                         { value 1; }
                                    enum round-robin                    { value 2; }
                                }
                                description "Access algorithm for the list of RADIUS servers";
                            }

                            leaf retry {
                                type uint32 {
                                    range "1..10";
                                }
                                description "Number of retries for contacting the RADIUS server";
                            }

                            leaf router-instance {
                                type types-sros:named-item-64 {
                                    pattern ".{1,32}" {
                                        error-message "vRtrName needs to be extended to 64 to support this name";
                                    }
                                }
                                description "Router or VPRN service name";
                            }

                            leaf source-address {
                                type types-sros:ipv4-unicast-address;
                                description "Source IP address of RADIUS packets";
                            }

                            leaf timeout {
                                type uint32 {
                                    range "1..90";
                                }
                                units "seconds";
                                description "RADIUS accounting server response timeout";
                            }

                            list server {
                                key "server-index";
                                description "Enter the server list instance";

                                leaf server-index {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type uint32 {
                                            range "1..5";
                                        }
                                    }
                                    description "RADIUS accounting server index";
                                }

                                leaf address {
                                    type types-sros:ipv4-unicast-address;
                                    description "RADIUS server IP address";
                                }

                                leaf port {
                                    type uint16 {
                                        range "1..65535";
                                    }
                                    description "RADIUS server UDP port used for authentication";
                                }

                                leaf secret {
                                    type types-sros:encrypted-leaf {
                                        length "1..54";
                                    }
                                    description "RADIUS server secret key";
                                }

                            } // list server

                        } // container radius-accounting-server

                    } // list radius-accounting-policy

                    list group {
                        key "aa-group-id";
                        description "Enter the group list instance";

                        leaf aa-group-id {
                            type union {
                                type string {
                                    length "1..64";
                                    pattern "<.*>" {
                                        error-message "Config Groups Regex Pattern";
                                    }
                                }
                                type uint32 {
                                    range "1..255";
                                }
                            }
                            description "AA group ID";
                        }

                        list certificate-profile {
                            key "cert-prof-name";
                            description "Enter the certificate-profile list instance";

                            leaf cert-prof-name {
                                type union {
                                    type string {
                                        length "1..64";
                                        pattern "<.*>" {
                                            error-message "Config Groups Regex Pattern";
                                        }
                                    }
                                    type types-sros:named-item;
                                }
                                description "AA group certificate profile name";
                            }

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of the AA certificate profile";
                            }

                            leaf description {
                                type types-sros:description;
                                description "Text description";
                            }

                            leaf file {
                                type types-aa:certificate-file;
                                description "Certificate file name";
                            }

                        } // list certificate-profile

                        container cflowd {
                            presence "Enable the cflowd context";
                            description "Enable the cflowd context";

                            leaf admin-state {
                                type types-sros:admin-state;
                                description "Administrative state of cflowd export";
                            }

                            leaf system-name {
                                type types-sros:named-item;
                                description "Node name to report in cflowd template";
                            }

                            leaf template-retransmit {
                                type uint32 {
                                    range "10..600";
                                }
                                units "seconds";
                                description "Template retransmit time";
                            }

                            container obfuscation {
                                description "Enter the obfuscation context";

                                leaf aes-128-encryption-key {
                                    type types-sros:encrypted-leaf {
                                        length "1..51";
                                    }
                                    description "AES-128 encryption key";
                                }

                                leaf aes-256-encryption-key {
                                    type types-sros:encrypted-leaf {
                                        length "1..71";
                                    }
                                    description "AES-256 encryption key";
                                }

                            } // container obfuscation

                            list collector {
                                key "ip-address port";
                                description "Enter the collector list instance";

                                leaf ip-address {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:ip-unicast-address;
                                    }
                                    description "IP address of the remote cflowd collector host";
                                }

                                leaf port {
                                    type union {
                                        type string {
                                            length "1..64";
                                            pattern "<.*>" {
                                                error-message "Config Groups Regex Pattern";
                                            }
                                        }
                                        type types-sros:tcp-udp-port-non-zero;
                                    }
                                    description "Cflowd collector host port number";
                                }

                                leaf admin-state {
                                    type types-sros:admin-state;
                                    description "Administrative state of the cflowd export";
                                }

                                leaf description {
                                    type types-sros:description;
                                    description "Text description";
                                }

                            } // list collector

                            container direct-export {
                                description "Enter the direct-export context";

                                leaf vlan-id {
                                    type types-sros:vlan-id;
                                    description "Cflowd direct export VLAN ID";
                                }

                                list collector {
                                    key "collector-id";
                                    description "Enter the collector list instance";

                                    leaf collector-id {
                                        type union {
                                            type string {
                                                length "1..64";
                                                pattern "<.*>" {
                                                    error-message "Config Groups Regex Pattern";
                                                }
                                            }
                                            type uint32 {
                                                range "1..65535";
                                            }
                                        }
                                        description "Cflowd direct export collector ID";
                                    }

                                    leaf description {
                                        type types-sros:description;
                                        description "Text description";
                                    }

                                    list address {
                                        key "ip-address port";
                                        description "Enter the address list instance";

                                        leaf ip-address {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type types-sros:ip-unicast-address;
                                            }
                                            description "IP address of the remote cflowd collector host";
                                        }

                                        leaf port {
                                            type union {
                                                type string {
                                                    length "1..64";
                                                    pattern "<.*>" {
                                                        error-message "Config Groups Regex Pattern";
                                                    }
                                                }
                                                type types-sros:tcp-udp-port-non-zero;
                                            }
                                            description "Cflowd collector host port number";
                                        }

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the direct export collector";
                                        }

                                    } // list address

                                } // list collector

                            } // container direct-export

                            container comprehensive {
                                presence "Enable the comprehensive context";
                                description "Enable the comprehensive context";

                                leaf flow-rate {
                                    type types-aa:cflowd-sample-rate;
                                    description "Cflowd flow sampling rate";
                                }

                                leaf flow-rate-2 {
                                    type types-aa:cflowd-sample-rate;
                                    description "Cflowd per-flow second sampling rate";
                                }

                                container template {
                                    presence "Enable the template context";
                                    description "Enable the template context";

                                    leaf field-selection {
                                        type types-aa:aa-grp-cflowd-template-select;
                                        description "Field selection method";
                                    }

                                    container dynamic-fields {
                                        description "Enter the dynamic-fields context";

                                        leaf admin-state {
                                            type types-sros:admin-state;
                                            description "Administrative state of the dynamic fields";
                                        }

                                        list field {
                                            key "field-name";
                                            description "Add a list entry for field";

